/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Arquitectura x86/x64/ARM cuando corresponda."},"3137":{"id":"/docs/red/v1/ingenieria/compatibilidad-9","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Transporte seleccionado."},"3138":{"id":"/docs/red/v1/ingenieria/compatibilidad-10","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Integración de Steam si se utiliza."},"3139":{"id":"/docs/red/v1/ingenieria/compatibilidad-11","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Plugins de serialización o networking externos."},"3140":{"id":"/docs/red/v1/ingenieria/compatibilidad-12","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Restricciones de builds dedicadas."},"3141":{"id":"/docs/red/v1/ingenieria/compatibilidad-13","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Código condicionado por plataforma."},"3142":{"id":"/docs/red/v1/ingenieria/compatibilidad-14","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#eco-y-tnet-upstream","content":"Eco procede de la arquitectura de TNet, pero su documentación y código pueden evolucionar independientemente. Las equivalencias nominales no garantizan equivalencia exacta de comportamiento."},"3143":{"id":"/docs/red/v1/ingenieria/compatibilidad-15","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#regla-para-actualizar","content":"Después de actualizar Eco