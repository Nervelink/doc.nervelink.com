o-canal-5","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"El `uid` puede cambiar"},"1924":{"id":"/docs/red/v1/guias/transferir-objeto-canal-6","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#objetos-estáticos-frente-a-dinámicos","content":"Objetos estáticos frente a dinámicos"},"1925":{"id":"/docs/red/v1/guias/transferir-objeto-canal-7","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencias-locales","content":"Referencias locales"},"1926":{"id":"/docs/red/v1/guias/transferir-objeto-canal-8","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"Qué no hacer"},"1927":{"id":"/docs/red/v1/guias/transferir-objeto-canal-9","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"1928":{"id":"/docs/red/v1/guias/transferir-objeto-canal-10","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Relación con ownership"},"1929":{"id":"/docs/red/v1/guias/transferir-objeto-canal-11","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-eco","content":"Referencia a Eco"},"1930":{"id":"/docs/red/v1/guias/transferir-objeto-canal-12","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Referencia a TNet"},"1931":{"id":"/docs/red/v1/guias/transferir-objeto-canal-13","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Eco permite transferir un objeto de red a otro canal. La operación no debe tratarse como un simple cambio local de `channelID`: el objeto cambia de contexto de red y la implementación debe coordinar la operación con el servidor."},"1932":{"id":"/docs/red/v1/guias/transferir-objeto-canal-14","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Durante una transferencia el objeto puede quedar temporalmente marcado como destruido para impedir que se envíen RFC en un estado intermedio. Espera a que la transferencia termine antes de asumir que el objeto está listo para comunicarse en el nuevo canal."},"1933":{"id":"/docs/red/v1/guias/transferir-objeto-canal-15","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Un `Objeto` pertenece siempre a un canal concreto y su identificador completo utiliza ambos datos:"},"1934":{"id":"/docs/red/v1/guias/transferir-objeto-canal-16","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Por eso moverlo de un canal a otro no es simplemente actualizar una variable local. El nuevo contexto forma parte de la identidad de red del objeto."},"1935":{"id":"/docs/red/v1/guias/transferir-objeto-canal-17","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"El flujo conceptual es:"},"1936":{"id":"/docs/red/v1/guias/transferir-objeto-canal-18","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"Durante el proceso Eco evita tratar el objeto como completamente operativo hasta que la transferencia ha finalizado."},"1937":{"id":"/docs/red/v1/guias/transferir-objeto-canal-19","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"`Objeto` expone el callback `onTransfer`, que recibe el nuevo canal y el nuevo ID:"},"1938":{"id":"/docs/red/v1/guias/transferir-objeto-canal-20","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"Esto permite reconstruir referencias locales que dependan del canal o del identificador dinámico."},"1939":{"id":"/docs/red/v1/guias/transferir-objeto-canal-21","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"Como `uid` combina el canal y el ID:"},"1940":{"id":"/docs/red/v1/guias/transferir-objeto-canal-22","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"no conviene guardar un `uid` como referencia permanente si el objeto puede transferirse. Después de la operación, vuelve a consultar `uid`, `channelID` e `id`."},"1941":{"id":"/docs/red/v1/guias/transferir-objeto-canal-23","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#objetos-estáticos-frente-a-dinámicos","content":"La propiedad de los objetos estáticos está restringida y no deben tratarse igual que los objetos dinámicos. Para transferencias dinámicas, el ciclo de vida debe mantenerse coordinado con el servidor."},"1942":{"id":"/docs/red/v1/guias/transferir-objeto-canal-24","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencias-locales","content":"Evita asumir que una referencia de un sistema externo sigue siendo válida sólo porque la instancia de Unity no ha cambiado. El objeto puede seguir siendo la misma instancia, pero su contexto de red habrá cambiado."},"1943":{"id":"/docs/red/v1/guias/transferir-objeto-canal-25","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"No cambies manualmente `channelID` para simular una transferencia. Tampoco continúes enviando mensajes usando el contexto antiguo mientras la operación está pendiente."},"1944":{"id":"/docs/red/v1/guias/transferir-objeto-canal-26","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"La transferencia es una operación del modelo de red, no una reasignación de datos de gameplay."},"1945":{"id":"/docs/red/v1/guias/transferir-objeto-canal-27","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Un caso habitual es mover entidades entre ámbitos de juego:"},"1946":{"id":"/docs/red/v1/guias/transferir-objeto-canal-28","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"La utilidad depende de que el objeto deba mantener continuidad lógica entre esos ámbitos. Cuando no sea necesario conservar la identidad, puede ser más sencillo destruir el objeto anterior y crear uno nuevo en el canal destino."},"1947":{"id":"/docs/red/v1/guias/transferir-objeto-canal-29","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Tr