o pulsado, mantenido y soltado y utiliza `velSalto` y `duracionSalto` para controlar la respuesta. Esto permite implementar saltos variables sin mezclar la lectura de entrada con la aplicación física."},"4681":{"id":"/docs/personaje/v1/fundamentos/index","page_id":"/docs/personaje/v1/fundamentos/index","type":"page","content":"Fundamentos","breadcrumbs":["Docs","Personaje","Personaje","Contenido","Fundamentos"],"tags":[],"url":"/docs/personaje/v1/fundamentos/index"},"4682":{"id":"/docs/personaje/v1/fundamentos/index-0","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Modelo mental y arquitectura interna del módulo Personaje."},"4683":{"id":"/docs/personaje/v1/fundamentos/index-1","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Cómo se separan control, locomoción, sensores y presentación."},"4684":{"id":"/docs/personaje/v1/fundamentos/index-2","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Diferencias entre `Personaje` y `Jugador`."},"4685":{"id":"/docs/personaje/v1/fundamentos/index-3","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Movimiento físico y detección del entorno."},"4686":{"id":"/docs/personaje/v1/fundamentos/index-4","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Separación entre input e implementación del movimiento."},"4687":{"id":"/docs/personaje/v1/fundamentos/index-5","page_id":"/docs/personaje/v1/fundamentos/index","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/index","content":"Presentación basada en el estado del controlador."},"4688":{"id":"/docs/personaje/v1/fundamentos/index-6","page_id":"/docs/personaje/v1/fundamentos/index","ta