 Remoto"},"1046":{"id":"/docs/red/v1/comunicacion-30","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCL`"},"1047":{"id":"/docs/red/v1/comunicacion-31","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`LCR`"},"1048":{"id":"/docs/red/v1/comunicacion-32","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Creación Local"},"1049":{"id":"/docs/red/v1/comunicacion-33","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Consulta Migración de TNet a Eco para más diferencias."},"1050":{"id":"/docs/red/v1/comunicacion-34","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Método Remoto."},"1051":{"id":"/docs/red/v1/comunicacion-35","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Creación Remota."},"1052":{"id":"/docs/red/v1/comunicacion-36","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Creación Local."},"1053":{"id":"/docs/red/v1/comunicacion-37","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Decide quién debe recibir una operación."},"1054":{"id":"/docs/red/v1/comunicacion/rcl","page_id":"/docs/red/v1/comunicacion/rcl","type":"page","content":"RCL","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcl"},"1055":{"id":"/docs/red/v1/comunicacion/rcl-0","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl","content":"Red Creación Local, el mecanismo de Eco para solicitar una creación l