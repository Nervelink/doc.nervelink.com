v1/ejemplos/auto-unirse-20","page_id":"/docs/red/v1/ejemplos/auto-unirse","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-unirse#cuándo-utilizarlo","content":"juegos donde no existe menú de selección de servidor."},"496":{"id":"/docs/red/v1/ejemplos/auto-unirse-21","page_id":"/docs/red/v1/ejemplos/auto-unirse","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-unirse#cuándo-utilizarlo","content":"Para juegos con matchmaking o múltiples destinos, es preferible implementar el flujo directamente sobre `Eco`."},"497":{"id":"/docs/red/v1/ejemplos/auto-unirse-22","page_id":"/docs/red/v1/ejemplos/auto-unirse","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-unirse#cuándo-utilizarlo","content":"`AutoUnirse` simplifica el workflow, pero la UI del juego debe seguir reaccionando a `Eco.alConectar`, `Eco.alDesconectar` y `Eco.alUnirseACanal`."},"498":{"id":"/docs/red/v1/ejemplos/auto-unirse-23","page_id":"/docs/red/v1/ejemplos/auto-unirse","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-unirse#fuente","content":"Implementación actual del helper."},"499":{"id":"/docs/red/v1/ejemplos/fisica-en-red","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"page","content":"Física en red","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red"},"500":{"id":"/docs/red/v1/ejemplos/fisica-en-red-0","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red","content":"Patrón para sincronizar vehículos y cuerpos físicos sin convertir cada frame de física en un mensaje fiable."},"501":{"id":"/docs/red/v1/ejemplos/fisica-en-red-1","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#física-en-red","content":"Física en red"},"502":{"id":"/docs/red/v1/ejemplos/fisica-en-red-2","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#separar-simulación-y-representación","content":"Separar simulación y representación"},"503":{"id":"/docs/red/v1/ejemplos/fisica-en-red-3","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Qué sincronizar"},"504":{"id":"/docs/red/v1/ejemplos/fisica-en-red-4","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"Autoridad"},"505":{"id":"/docs/red/v1/ejemplos/fisica-en-red-5","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"Frecuencia"},"506":{"id":"/docs/red/v1/ejemplos/fisica-en-red-6","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Anti-patrones"},"507":{"id":"/docs/red/v1/ejemplos/fisica-en-red-7","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#física-en-red","content":"La física es uno de los casos más difíciles de sincronizar porque genera cambios frecuentes y puede divergir ligeramente entre máquinas."},"508":{"id":"/docs/red/v1/ejemplos/fisica-en-red-8","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#separar-simulación-y-representación","content":"No es recomendable enviar cada contacto, fuerza o paso de `FixedUpdate` mediante una RFC fiable."},"509":{"id":"/docs/red/v1/ejemplos/fisica-en-red-9","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Normalmente basta con un estado reducido:"},"510":{"id":"/docs/red/v1/ejemplos/fisica-en-red-10","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Las clases `SincronizarRB` y `TransformSuave` existen precisamente para trabajar con este tipo de patrón."},"511":{"id":"/docs/red/v1/ejemplos/fisica-en-red-11","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Una réplica remota no necesita recibir exactamente todos los estados intermedios. Puede interpolar entre estados suficientemente frecuentes."},"512":{"id":"/docs/red/v1/ejemplos/fisica-en-red-12","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"Define primero quién controla el cuerpo:"},"513":{"id":"/docs/red/v1/ejemplos/fisica-en-red-13","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"O, en diseños concretos, el propietario puede controlar la simulación y el servidor actuar como coordinador."},"514":{"id":"/docs/red/v1/ejemplos/fisica-en-red-14","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"La física y la red no necesitan compartir frecuencia."},"515":{"id":"/docs/red/v1/ejemplos/fisica-en-red-15","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"La representación local interpola entre los estados recibidos."},"516":{"id":"/docs/red/v1/ejemplos/fisica-en-red-16","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"No envíes posición y rotación con RFC fiables en cada `FixedUpdate`. Genera tráfico, colas y latencia innecesarios y no garantiza una representación visual suave."},"517":{"id":"/docs/red/v1/ejemplos/fisica-en-red-17","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Implementación específica para cuerpos físicos."},"518":{"id":"/docs/red/v1/ejemplos/fisica-en-red-18","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Interpolación y representación remota."},"519":{"id":"/docs/red/v1/ejemplos","page_id":"/docs/red/v1/ejemplos","type":"page","content":"Ejemplos","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos"},"520":{"id":"/docs/red/v1/ejemplos-0","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos","content":"Ejemplos reales incluidos en el repositorio de Eco y su traducción al workflow actual del proyecto."},"521":{"id":"/docs/red/v1/ejemplos-1","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#ejemplos","content":"Ejemplos"},"522":{"id":"/docs/red/v1/ejemplos-2","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Mapa de ejemplos"},"523":{"id":"/docs/red/v1/ejemplos-3","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Ejemplos que todavía están en el repositorio"},"524":{"id":"/docs/red/v1/ejemplos-4","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#siguiente-paso","content":"Siguiente paso"},"525":{"id":"/docs/red/v1/ejemplos-5","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos","content":"El repositorio de Eco conserva una colección de ejemplos heredados de TNet, pero el código actual ya utiliza la nomenclatura de Eco. Esta sección convierte esos ejemplos en documentación práctica y enlaza directamente con sus fuentes."},"526":{"id":"/docs/red/v1/ejemplos-6","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos","content":"Los nombres de algunos PDFs y carpetas mantienen terminología de TNet. No significa que el runtime actual siga usando esa API. Para el comportamiento, consulta siempre el código C# de `eco`."},"527":{"id":"/docs/red/v1/ejemplos-7","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Conexión y entrada automática a un canal al iniciar el juego."},"528":{"id":"/docs/red/v1/ejemplos-8","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Sincronización automática de campos y propiedades de Unity."},"529":{"id":"/docs/red/v1/ejemplos-9","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Instanciación de un prefab al entrar en el canal apropiado."},"530":{"id":"/docs/red/v1/ejemplos-10","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Patrón clásico de Remote Function Call."},"531":{"id":"/docs/red/v1/ejemplos-11","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"El ejemplo que demuestra la capacidad multicanal de Eco."},"532":{"id":"/docs/red/v1/ejemplos-12","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Además de los recorridos anteriores, Eco conserva ejemplos de:"},"533":{"id":"/docs/red/v1/ejemplos-13","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Estos ejemplos no deben desaparecer sólo porque procedan de TNet. Son una fuente útil para descubrir comportamientos que todavía necesitan documentación específica."},"534":{"id":"/docs/red/v1/ejemplos-14","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#siguiente-paso","content":"Cuando un ejemplo te explique cómo funciona una característica, usa después la página conceptual correspondiente de `Fundamentos`, `Comunicación`, `Transporte` o `Runtime`."},"535":{"id":"/docs/red/v1/ejemplos/rfc","page_id":"/docs/red/v1/ejemplos/rfc","type":"page","content":"RFC","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/rfc"},"536":{"id":"/docs/red/v1/ejemplos/rfc-0","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc","content":"Ejemplo mínimo de una función remota y de la separación entre acción y estado."},"537":{"id":"/docs/red/v1/ejemplos/rfc-1","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc","content":"RFC"},"538":{"id":"/docs/red/v1/ejemplos/rfc-2","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#declarar-la-función","content":"Declarar la función"},"539":{"id":"/docs/red/v1/ejemplos/rfc-3","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#enviar","content":"Enviar"},"540":{"id":"/docs/red/v1/ejemplos/rfc-4","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#elegir-destinatarios","content":"Elegir destinatarios"},"541":{"id":"/docs/red/v1/ejemplos/rfc-5","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"RFC frente a estado"},"542":{"id":"/docs/red/v1/ejemplos/rfc-6","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"Persistencia"},"543":{"id":"/docs/red/v1/ejemplos/rfc-7","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#errores-habituales","content":"Errores habituales"},"544":{"id":"/docs/red/v1/ejemplos/rfc-8","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Método no encontrado"},"545":{"id":"/docs/red/v1/ejemplos/rfc-9","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Parámetros incompatibles"},"546":{"id":"/docs/red/v1/ejemplos/rfc-10","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#ejecutar-lógica-de-servidor-en-el-cliente","content":"Ejecutar lógica de servidor en el cliente"},"547":{"id":"/docs/red/v1/ejemplos/rfc-11","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#fuente","content":"Fuente"},"548":{"id":"/docs/red/v1/ejemplos/rfc-12","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc","content":"Una RFC permite ejecutar un método de un `Componente` asociado a un `Objeto` de red desde otra instancia de la sesión."},"549":{"id":"/docs/red/v1/ejemplos/rfc-13","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#declarar-la-función","content":"El atributo registra el método para que Eco pueda identificarlo y ejecutarlo cuando llegue el mensaje."},"550":{"id":"/docs/red/v1/ejemplos/rfc-14","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#enviar","content":"El método se invoca sobre el `Objeto` o mediante las ayudas disponibles desde `Componente`."},"551":{"id":"/docs/red/v1/ejemplos/rfc-15","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#enviar","content":"Para incluir datos:"},"552":{"id":"/docs/red/v1/ejemplos/rfc-16","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#elegir-destinatarios","content":"Consulta Objetivo para la tabla completa."},"553":{"id":"/docs/red/v1/ejemplos/rfc-17","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"Una RFC debe representar una acción o evento:"},"554":{"id":"/docs/red/v1/ejemplos/rfc-18","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"El estado debe representarse como datos:"},"555":{"id":"/docs/red/v1/ejemplos/rfc-19","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"Una buena prueba es preguntar qué debe conocer un jugador que entre cinco segundos después. Si la respuesta es “el resultado actual”, necesitas estado persistente; si es “la acción que acaba de ocurrir”, normalmente necesitas una RFC."},"556":{"id":"/docs/red/v1/ejemplos/rfc-20","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"El modelo de Eco permite RFC guardadas en el servidor. Una RFC persistente no es simplemente un mensaje con `true`: pasa a formar parte del estado que puede reconstruirse posteriormente."},"557":{"id":"/docs/red/v1/ejemplos/rfc-21","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Comprueba que el método está en un componente asociado al `Objeto` y que el atributo RMR/RFC utilizado pertenece a la API actual de Eco."},"558":{"id":"/docs/red/v1/ejemplos/rfc-22","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Los parámetros deben ser serializables y coincidir con lo que espera la función receptora."},"559":{"id":"/docs/red/v1/ejemplos/rfc-23","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#ejecutar-lógica-de-servidor-en-el-cliente","content":"Una RFC ejecuta código en la instancia receptora. No la confundas con una validación server-authoritative."},"560":{"id":"/docs/red/v1/ejemplos/rfc-24","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"El repositorio contiene los ejemplos heredados de RFC y sus escenas."},"561":{"id":"/docs/red/v1/ejemplos/rfc-25","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"Persistencia, callbacks y patrones avanzados."},"562":{"id":"/docs/red/v1/ejemplos/runtime-code","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"page","content":"Código en tiempo de ejecución","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/runtime-code"},"563":{"id":"/docs/red/v1/ejemplos/runtime-code-0","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code","content":"Integración avanzada de RuntimeCode para extensibilidad y herramientas dinámicas."},"564":{"id":"/docs/red/v1/ejemplos/runtime-code-1","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"Código en tiempo de ejecución"},"565":{"id":"/docs/red/v1/ejemplos/runtime-code-2","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#flujo-conceptual","content":"Flujo conceptual"},"566":{"id":"/docs/red/v1/ejemplos/runtime-code-3","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"567":{"id":"/docs/red/v1/ejemplos/runtime-code-4","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"Cuándo evitarlo"},"568":{"id":"/docs/red/v1/ejemplos/runtime-code-5","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Seguridad"},"569":{"id":"/docs/red/v1/ejemplos/runtime-code-6","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"`RuntimeCode` permite compilar y cargar código durante la ejecución. Es una capacidad avanzada heredada del ecosistema de TNet y debe utilizarse con un objetivo concreto."},"570":{"id":"/docs/red/v1/ejemplos/runtime-code-7","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"El código de gameplay principal debe compilarse con el proyecto. `RuntimeCode` resulta adecuado para herramientas, scripting controlado, extensiones o escenarios donde el contenido no puede conocerse por adelantado."},"571":{"id":"/docs/red/v1/ejemplos/runtime-code-8","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"herramientas internas"},"572":{"id":"/docs/red/v1/ejemplos/runtime-code-9","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"prototipos de lógica distribuible"},"573":{"id":"/docs/red/v1/ejemplos/runtime-code-10","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"sistemas de modding controlado"},"574":{"id":"/docs/red/v1/ejemplos/runtime-code-11","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"generación dinámica de comportamiento"},"575":{"id":"/docs/red/v1/ejemplos/runtime-code-12","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"No lo utilices para sustituir el sistema de escenas, prefabs o componentes normales si el código ya puede distribuirse con el juego."},"576":{"id":"/docs/red/v1/ejemplos/runtime-code-13","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"El código compilado durante la ejecución tiene las mismas implicaciones de seguridad que cualquier sistema de scripting dinámico. No ejecutes código recibido de clientes no confiables."},"577":{"id":"/docs/red/v1/ejemplos/runtime-code-14","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Configuración y detalles internos."},"578":{"id":"/docs/red/v1/ejemplos/runtime-code-15","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Más patrones avanzados de Eco."},"579":{"id":"/docs/red/v1/ejemplos/stress-test","page_id":"/docs/red/v1/ejemplos/stress-test","type":"page","content":"Prueba de estrés","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/stress-test"},"580":{"id":"/docs/red/v1/ejemplos/stress-test-0","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test","content":"Cómo diseñar una escena de prueba para medir objetos, RFC, sincronización, CPU y ancho de banda."},"581":{"id":"/docs/red/v1/ejemplos/stress-test-1","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Prueba de estrés"},"582":{"id":"/docs/red/v1/ejemplos/stress-test-2","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-medir","content":"Qué medir"},"583":{"id":"/docs/red/v1/ejemplos/stress-test-3","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"Escenario mínimo"},"584":{"id":"/docs/red/v1/ejemplos/stress-test-4","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#metodología","content":"Metodología"},"585":{"id":"/docs/red/v1/ejemplos/stress-test-5","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Línea base"},"586":{"id":"/docs/red/v1/ejemplos/stress-test-6","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Añadir objetos"},"587":{"id":"/docs/red/v1/ejemplos/stress-test-7","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Añadir frecuencia"},"588":{"id":"/docs/red/v1/ejemplos/stress-test-8","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Añadir jugadores"},"589":{"id":"/docs/red/v1/ejemplos/stress-test-9","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Encontrar el cuello de botella"},"590":{"id":"/docs/red/v1/ejemplos/stress-test-10","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#métricas-de-eco","content":"Métricas de Eco"},"591":{"id":"/docs/red/v1/ejemplos/stress-test-11","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Qué no medir de forma aislada"},"592":{"id":"/docs/red/v1/ejemplos/stress-test-12","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Una prueba de estrés debe medir el sistema que realmente quieres desplegar. Eco permite observar tráfico, latencia y procesamiento, pero una prueba útil combina esas métricas con un workload controlado."},"593":{"id":"/docs/red/v1/ejemplos/stress-test-13","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"No empieces con cientos de jugadores. Primero identifica el comportamiento de una sola variable y aumenta la carga de forma incremental."},"594":{"id":"/docs/red/v1/ejemplos/stress-test-14","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Ejecuta el escenario sin tráfico adicional y registra CPU, memoria y latencia."},"595":{"id":"/docs/red/v1/ejemplos/stress-test-15","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Incrementa la cantidad de entidades sin cambiar todavía la frecuencia de sincronización."},"596":{"id":"/docs/red/v1/ejemplos/stress-test-16","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Aumenta las actualizaciones por segundo y observa cuándo empieza a crecer la cola de entrada."},"597":{"id":"/docs/red/v1/ejemplos/stress-test-17","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Repite el experimento con varias conexiones y canales."},"598":{"id":"/docs/red/v1/ejemplos/stress-test-18","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Comprueba si el límite aparece en CPU, serialización, ancho de banda, servidor o cliente."},"599":{"id":"/docs/red/v1/ejemplos/stress-test-19","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Un ping bajo no garantiza un buen rendimiento. Una aplicación puede tener baja latencia y, aun así, saturar CPU o ancho de banda."},"600":{"id":"/docs/red/v1/ejemplos/stress-test-20","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Una simulación artificial de muchos paquetes pequeños puede ser peor o mejor que una partida real. Replica la distribución de RFC, sincronización, creación y destrucción de objetos que tendrá tu juego."},"601":{"id":"/docs/red/v1/ejemplos/stress-test-21","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Workflow para obtener una primera fotografía del estado de red."},"602":{"id":"/docs/red/v1/ejemplos/varios-canales","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"page","content":"Varios canales","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/varios-canales"},"603":{"id":"/docs/red/v1/ejemplos/varios-canales-0","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales","content":"Ejemplo práctico de una única conexión participando en varios canales simultáneamente."},"604":{"id":"/docs/red/v1/ejemplos/varios-canales-1","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Varios canales"},"605":{"id":"/docs/red/v1/ejemplos/varios-canales-2","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#modelo","content":"Modelo"},"606":{"id":"/docs/red/v1/ejemplos/varios-canales-3","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Entrar en varios canales"},"607":{"id":"/docs/red/v1/ejemplos/varios-canales-4","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Datos por canal"},"608":{"id":"/docs/red/v1/ejemplos/varios-canales-5","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Objetos por canal"},"609":{"id":"/docs/red/v1/ejemplos/varios-canales-6","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"Salir de un canal"},"610":{"id":"/docs/red/v1/ejemplos/varios-canales-7","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#patrón-recomendado","content":"Patrón recomendado"},"611":{"id":"/docs/red/v1/ejemplos/varios-canales-8","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Mantén el contexto explícito"},"612":{"id":"/docs/red/v1/ejemplos/varios-canales-9","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Pasa el canal a las operaciones"},"613":{"id":"/docs/red/v1/ejemplos/varios-canales-10","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Mantén los objetos ligados a su canal"},"614":{"id":"/docs/red/v1/ejemplos/varios-canales-11","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Relación con TNet"},"615":{"id":"/docs/red/v1/ejemplos/varios-canales-12","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Eco permite que una misma conexión participe en varios canales al mismo tiempo. Este comportamiento es especialmente importante en arquitecturas donde el jugador mantiene un contexto persistente y, simultáneamente, participa en una partida, chat, lobby o sesión secundaria."},"616":{"id":"/docs/red/v1/ejemplos/varios-canales-13","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"`Eco.idUltimoCanal` existe como ayuda de compatibilidad y para determinados callbacks. Cuando un jugador está en varios canales, especifica siempre el `idCanal` de la operación."},"617":{"id":"/docs/red/v1/ejemplos/varios-canales-14","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Comprueba cada canal por separado:"},"618":{"id":"/docs/red/v1/ejemplos/varios-canales-15","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Nunca asumas que `ObtenerDatosCanal` se refiere al último canal utilizado: recibe explícitamente el ID."},"619":{"id":"/docs/red/v1/ejemplos/varios-canales-16","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Los objetos tienen su propio `channelID`."},"620":{"id":"/docs/red/v1/ejemplos/varios-canales-17","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Las operaciones de instanciación y envío deben utilizar el canal del objeto o el canal explícito del contexto."},"621":{"id":"/docs/red/v1/ejemplos/varios-canales-18","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"La conexión continúa activa y el cliente puede seguir participando en los demás canales."},"622":{"id":"/docs/red/v1/ejemplos/varios-canales-19","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Guarda el ID del canal en el sistema que representa ese contexto (`mundo`, `partida`, `chat`, etc.)."},"623":{"id":"/docs/red/v1/ejemplos/varios-canales-20","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Evita depender de variables globales como `idUltimoCanal` para decidir dónde se ejecuta una operación."},"624":{"id":"/docs/red/v1/ejemplos/varios-canales-21","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Usa `objeto.channelID` como fuente de verdad para operaciones específicas de una entidad."},"625":{"id":"/docs/red/v1/ejemplos/varios-canales-22","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"La documentación histórica de TNet ya contemplaba múltiples canales, pero Eco lo incorpora como una capacidad fundamental del runtime actual y la expone mediante su fachada `Eco`."},"626":{"id":"/docs/red/v1/ejemplos/varios-canales-23","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Modelo completo de canales y pertenencia."},"627":{"id":"/docs/red/v1/ejemplos/varios-canales-24","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"API de la fachada para trabajar con varios canales."},"628":{"id":"/docs/red/v1/fundamentos/arquitectura","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"page","content":"Arquitectura","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/arquitectura"},"629":{"id":"/docs/red/v1/fundamentos/arquitectura-0","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura","content":"Cómo se relacionan las capas de Eco y cómo fluye la información entre ellas."},"630":{"id":"/docs/red/v1/fundamentos/arquitectura-1","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Arquitectura"},"631":{"id":"/docs/red/v1/fundamentos/arquitectura-2","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#mapa-de-la-arquitectura","content":"Mapa de la arquitectura"},"632":{"id":"/docs/red/v1/fundamentos/arquitectura-3","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Las cuatro capas que debes distinguir"},"633":{"id":"/docs/red/v1/fundamentos/arquitectura-4","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#modelo-de-red","content":"Modelo de red"},"634":{"id":"/docs/red/v1/fundamentos/arquitectura-5","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#canal","content":"Canal"},"635":{"id":"/docs/red/v1/fundamentos/arquitectura-6","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#jugador","content":"Jugador"},"636":{"id":"/docs/red/v1/fundamentos/arquitectura-7","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#objeto","content":"Objeto"},"637":{"id":"/docs/red/v1/fundamentos/arquitectura-8","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#componente","content":"Componente"},"638":{"id":"/docs/red/v1/fundamentos/arquitectura-9","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"Comunicación"},"639":{"id":"/docs/red/v1/fundamentos/arquitectura-10","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#runtime","content":"Runtime"},"640":{"id":"/docs/red/v1/fundamentos/arquitectura-11","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#flujo-de-una-operación","content":"Flujo de una operación"},"641":{"id":"/docs/red/v1/fundamentos/arquitectura-12","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#1-gameplay-step","content":"Gameplay [step]"},"642":{"id":"/docs/red/v1/fundamentos/arquitectura-13","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#2-modelo-de-red-step","content":"Modelo de red [step]"},"643":{"id":"/docs/red/v1/fundamentos/arquitectura-14","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#3-comunicación-step","content":"Comunicación [step]"},"644":{"id":"/docs/red/v1/fundamentos/arquitectura-15","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#4-serialización-step","content":"Serialización [step]"},"645":{"id":"/docs/red/v1/fundamentos/arquitectura-16","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#5-transporte-step","content":"Transporte [step]"},"646":{"id":"/docs/red/v1/fundamentos/arquitectura-17","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#6-aplicación-remota-step","content":"Aplicación remota [step]"},"647":{"id":"/docs/red/v1/fundamentos/arquitectura-18","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Relación con TNet"},"648":{"id":"/docs/red/v1/fundamentos/arquitectura-19","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#fuentes","content":"Fuentes"},"649":{"id":"/docs/red/v1/fundamentos/arquitectura-20","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Eco es la capa de red utilizada por Pandora. Parte de la arquitectura de TNet, pero utiliza la nomenclatura, organización y extensiones propias de Nervelink."},"650":{"id":"/docs/red/v1/fundamentos/arquitectura-21","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Piensa en Eco como un sistema por capas. `Canal`, `Objeto`, `Jugador`, `RFC`, `Paquete` y `Buffer` resuelven problemas distintos; no son sustitutos entre sí."},"651":{"id":"/docs/red/v1/fundamentos/arquitectura-22","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Define quién participa, qué objetos existen y en qué canal viven."},"652":{"id":"/docs/red/v1/fundamentos/arquitectura-23","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Define qué se quiere comunicar y quién debe recibirlo."},"653":{"id":"/docs/red/v1/fundamentos/arquitectura-24","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Convierte la operación en un mensaje serializado y lo transporta."},"654":{"id":"/docs/red/v1/fundamentos/arquitectura-25","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Ejecuta cliente y servidor y mantiene sus ciclos de vida."},"655":{"id":"/docs/red/v1/fundamentos/arquitectura-26","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#canal","content":"Un `Canal` delimita un ámbito de jugadores y estado. Una conexión puede pertenecer a varios canales simultáneamente; esto es una propiedad del modelo de Eco, no una conexión física adicional."},"656":{"id":"/docs/red/v1/fundamentos/arquitectura-27","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#jugador","content":"`Jugador` representa una participación en la sesión. Su identidad es independiente de la conexión física y dispone de datos propios que pueden sincronizarse."},"657":{"id":"/docs/red/v1/fundamentos/arquitectura-28","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#objeto","content":"`Objeto` aporta identidad de red, ownership, canal, datos y ciclo de vida. Su `uid` combina el contexto del canal con la identidad del objeto."},"658":{"id":"/docs/red/v1/fundamentos/arquitectura-29","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#componente","content":"`Componente` es la capa de integración con `MonoBehaviour`: permite acceder cómodamente al objeto de red y es el punto habitual desde el que se declaran RFC, datos y operaciones de instanciación."},"659":{"id":"/docs/red/v1/fundamentos/arquitectura-30","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"Una operación empieza en gameplay y acaba convertida en un mensaje de protocolo."},"660":{"id":"/docs/red/v1/fundamentos/arquitectura-31","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"La selección de destinatario se realiza antes de que el mensaje abandone el contexto de Eco. Por eso Destinatarios pertenece conceptualmente a Comunicación y no a Transporte."},"661":{"id":"/docs/red/v1/fundamentos/arquitectura-32","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#runtime","content":"El cliente mantiene su conexión y representación local. El servidor mantiene el estado compartido, administra jugadores y canales y procesa las solicitudes que requieren autoridad del servidor."},"662":{"id":"/docs/red/v1/fundamentos/arquitectura-33","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#1-gameplay-step","content":"Tu código decide qué quiere hacer: cambiar estado, ejecutar una acción, crear un objeto o cambiar de canal."},"663":{"id":"/docs/red/v1/fundamentos/arquitectura-34","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#2-modelo-de-red-step","content":"Eco determina el `Objeto`, `Canal`, propietario y contexto de la operación."},"664":{"id":"/docs/red/v1/fundamentos/arquitectura-35","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#3-comunicación-step","content":"Se selecciona RFC, sincronización o una operación de protocolo existente y se determinan sus destinatarios."},"665":{"id":"/docs/red/v1/fundamentos/arquitectura-36","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#4-serialización-step","content":"Los parámetros se convierten a una representación binaria mediante `Buffer` y las herramientas de serialización."},"666":{"id":"/docs/red/v1/fundamentos/arquitectura-37","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#5-transporte-step","content":"El mensaje viaja mediante TCP, UDP cuando corresponde, o una conexión personalizada."},"667":{"id":"/docs/red/v1/fundamentos/arquitectura-38","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#6-aplicación-remota-step","content":"El receptor procesa el paquete, actualiza el estado correspondiente y ejecuta los callbacks asociados."},"668":{"id":"/docs/red/v1/fundamentos/arquitectura-39","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"TNet"},"669":{"id":"/docs/red/v1/fundamentos/arquitectura-40","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Eco"},"670":{"id":"/docs/red/v1/fundamentos/arquitectura-41","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Responsabilidad"},"671":{"id":"/docs/red/v1/fundamentos/arquitectura-42","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNManager`"},"672":{"id":"/docs/red/v1/fundamentos/arquitectura-43","page_id":"/docs/red/v1/fund