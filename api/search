me/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#tiempo-y-diagnóstico","content":"Tiempo y diagnóstico"},"2791":{"id":"/docs/red/v1/runtime/cliente-12","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#datos-del-jugador","content":"Datos del jugador"},"2792":{"id":"/docs/red/v1/runtime/cliente-13","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#servidor-local","content":"Servidor local"},"2793":{"id":"/docs/red/v1/runtime/cliente-14","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#desconexión","content":"Desconexión"},"2794":{"id":"/docs/red/v1/runtime/cliente-15","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#correspondencia-con-tnet","content":"Correspondencia con TNet"},"2795":{"id":"/docs/red/v1/runtime/cliente-16","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#referencias","content":"Referencias"},"2796":{"id":"/docs/red/v1/runtime/cliente-17","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#cliente","content":"`ClienteJuego` contiene la lógica cliente de Eco: conexión, procesamiento de paquetes, canales, jugador local, transporte y modo servidor local."},"2797":{"id":"/docs/red/v1/runtime/cliente-18","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#cliente","content":"Desde gameplay normalmente trabajarás con la fachada `Eco` y componentes de alto nivel. `ClienteJuego` es el runtime que mantiene el estado y ejecuta las operaciones de red."},"2798":{"id":"/docs/red/v1/runtime/cliente-19","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#anatomía","content":"Gestiona TCP y las etapas del handshake."},"2799":{"id":"/docs/red/v1/runtime/cliente-20","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#anatomía","content":"Mantiene los canales activos y las solicitudes de unión pendientes."},"2800":{"id":"/docs/red/v1/runtime/cliente-21","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#anatomía","content":"Expone identidad, nombre y `playerData` del participante local."},"2801":{"id":"/docs/red/v1/runtime/cliente-22","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#anatomía","content":"Utiliza TCP como camino principal, UDP cuando está disponible y `IConnection` para conexiones personalizadas."},"2802":{"id":"/docs/red/v1/runtime/cliente-23","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#estados-de-sesión","content":"Estos estados no son intercambiables. Estar conectado no implica pertenecer a un canal."},"2803":{"id":"/docs/red/v1/runtime/cliente-24","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#esperar-el-handshake-step","content":"`Connect` sólo inicia el proceso. Comprueba `isConnected` antes de usar operaciones que requieren una sesión confirmada."},"2804":{"id":"/docs/red/v1/runtime/cliente-25","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#canales","content":"El cliente mantiene una colección de canales y otra de identificadores que todavía se están uniendo."},"2805":{"id":"/docs/red/v1/runtime/cliente-26","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#canales","content":"Puede participar simultáneamente en varios canales:"},"2806":{"id":"/docs/red/v1/runtime/cliente-27","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#canales","content":"Consulta Canales para entender qué significa esta pertenencia."},"2807":{"id":"/docs/red/v1/runtime/cliente-28","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#transporte","content":"Es el transporte principal de la sesión y del protocolo fiable."},"2808":{"id":"/docs/red/v1/runtime/cliente-29","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#transporte","content":"Es opcional y se utiliza cuando la configuración y la plataforma permiten tráfico de baja latencia."},"2809":{"id":"/docs/red/v1/runtime/cliente-30","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#transporte","content":"Permite abstraer la conexión subyacente para integraciones personalizadas que no utilizan directamente el socket estándar."},"2810":{"id":"/docs/red/v1/runtime/cliente-31","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#procesamiento-de-paquetes","content":"El cliente recibe datos y los convierte en `Paquete` y operaciones de runtime."},"2811":{"id":"/docs/red/v1/runtime/cliente-32","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#procesamiento-de-paquetes","content":"`ClienteJuego` mantiene además contadores de paquetes y bytes enviados/recibidos. Su implementación contempla opciones para limitar y perfilar el trabajo realizado por frame."},"2812":{"id":"/docs/red/v1/runtime/cliente-33","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#tiempo-y-diagnóstico","content":"El cliente expone información como:"},"2813":{"id":"/docs/red/v1/runtime/cliente-34","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#tiempo-y-diagnóstico","content":"Estos valores son útiles para diagnóstico, pero no deben utilizarse como fuente única de verdad para reglas de game