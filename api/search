/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#observar-tráfico","content":"un cliente conectado que no recibe tráfico;"},"1108":{"id":"/docs/red/v1/guias/diagnosticar-conexion-18","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#observar-tráfico","content":"un envío excesivamente frecuente;"},"1109":{"id":"/docs/red/v1/guias/diagnosticar-conexion-19","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#observar-tráfico","content":"una operación que genera más datos de los esperados;"},"1110":{"id":"/docs/red/v1/guias/diagnosticar-conexion-20","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#observar-tráfico","content":"diferencias entre tráfico TCP y UDP."},"1111":{"id":"/docs/red/v1/guias/diagnosticar-conexion-21","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#udp","content":"`canUseUDP` indica si el cliente puede utilizar UDP en la sesión actual. Que UDP exista en la implementación no significa que todo mensaje deba utilizarlo."},"1112":{"id":"/docs/red/v1/guias/diagnosticar-conexion-22","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#udp","content":"Para datos críticos, revisa primero qué garantías necesita la operación y qué transporte utiliza realmente."},"1113":{"id":"/docs/red/v1/guias/diagnosticar-conexion-23","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Estados y propiedades del cliente de Eco."},"1114":{"id":"/docs/red/v1/guias/diagnosticar-conexion-24","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Paquetes, buffers, serialización y protocolos."},"1115":{"id":"/docs/red/v1/guias/diagnosticar-conexion-25","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Restricciones conocidas de la integración."},"1116":{"id":"/docs/red/v1/guias/enviar-accion","page_id":"/docs/red/v1/guias/enviar-accion","type":"page","content":"Enviar una acción","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/enviar-accion"},"1117":{"id":"/docs/red/v1/guias/enviar-accion-0","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion","content":"Ejecuta una acción remotamente mediante RFC y elige correctamente sus destinatarios."},"1118":{"id":"/docs/red/v1/guias/enviar-accion-1","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Enviar una acción"},"1119":{"id":"/docs/red/v1/guias/enviar-accion-2","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"Crear el comportamiento remoto"},"1120":{"id":"/docs/red/v1/guias/enviar-accion-3","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Enviar la acción"},"1121":{"id":"/docs/red/v1/guias/enviar-accion-4","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Elegir destinatarios"},"1122":{"id":"/docs/red/v1/guias/enviar-accion-5","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#4-no-mezclar-acción-y-estado","content":"No mezclar acción y estado"},"1123":{"id":"/docs/red/v1/guias/enviar-accion-6","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#5-autoridad","content":"Autoridad"},"1124":{"id":"/docs/red/v1/guias/enviar-accion-7","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#6-acciones-y-múltiples-canales","content":"Acciones y múltiples canales"},"1125":{"id":"/docs/red/v1/guias/enviar-accion-8","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#7-persistencia","content":"Persistencia"},"1126":{"id":"/docs/red/v1/guias/enviar-accion-9","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Cuándo usar cada mecanismo"},"1127":{"id":"/docs/red/v1/guias/enviar-accion-10","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencia-a-tnet","content":"Referencia a TNet"},"1128":{"id":"/docs/red/v1/guias/enviar-accion-11","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencias","content":"Referencias"},"1129":{"id":"/docs/red/v1/guias/enviar-accion-12","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una **RFC** (*Remote Function Call*) se utiliza cuando la intención es ejecutar comportamiento en otro extremo de la red. Es especialmente adecuada para acciones puntuales: atacar, recoger un objeto, reproducir un efecto, solicitar una operación o notificar un evento."},"1130":{"id":"/docs/red/v1/guias/enviar-accion-13","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una RFC comunica que algo debe ocurrir. La sincronización comunica cuál es el estado actual. Si necesitas mantener `vida = 75`, sincroniza el dato; si necesitas ejecutar `RecibirDaño(25)`, una RFC representa mejor la intención."},"1131":{"id":"/docs/red/v1/guias/enviar-accion-14","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"El comportamiento de red vive normalmente en un `Componente` asociado a un `Objeto`."},"1132":{"id":"/docs/red/v1/guias/enviar-accion-15","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"`Componente` proporciona acceso al `Objeto` mediante `ero`, por lo que el código de gameplay no necesita construir manualmente el `Paquete`."},"1133":{"id":"/docs/red/v1/guias/enviar-accion-16","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"El envío se realiza con `Send`, indicando el nombre de la función y el objetivo de la comunicación."},"1134":{"id":"/docs/red/v1/guias/enviar-accion-17","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Cuando la acción necesita argumentos, estos forman parte de la llamada:"},"1135":{"id":"/docs/red/v1/guias/enviar-accion-18","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"La serialización de esos argumentos termina formando parte del `Buffer` asociado al paquete de protocolo."},"1136":{"id":"/docs/red/v1/guias/enviar-accion-19","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"El objetivo determina quién debe recibir la operación. No debe asumirse que una RFC siempre significa «todos»."},"1137":{"id":"/docs/red/v1/guias/env