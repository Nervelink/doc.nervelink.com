ismo"},"2880":{"id":"/docs/red/v1/transporte/serializacion-22","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Datos jerárquicos y configurables"},"2881":{"id":"/docs/red/v1/transporte/serializacion-23","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo`"},"2882":{"id":"/docs/red/v1/transporte/serializacion-24","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Mensajes compactos de red"},"2883":{"id":"/docs/red/v1/transporte/serializacion-25","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Serialización binaria"},"2884":{"id":"/docs/red/v1/transporte/serializacion-26","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Formato personalizado de una clase"},"2885":{"id":"/docs/red/v1/transporte/serializacion-27","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`IBinarySerializable`"},"2886":{"id":"/docs/red/v1/transporte/serializacion-28","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Persistencia estructurada"},"2887":{"id":"/docs/red/v1/transporte/serializacion-29","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo` + serialización"},"2888":{"id":"/docs/red/v1/transporte/serializacion-30","page_id":"/docs/red/v1/transporte/serializacion","tag