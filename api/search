ismo de creación adecuado."},"1286":{"id":"/docs/red/v1/comunicacion/rcl-10","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Creación Remota."},"1287":{"id":"/docs/red/v1/comunicacion/rcl-11","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Método Remoto."},"1288":{"id":"/docs/red/v1/comunicacion/rcl-12","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Workflow práctico del ciclo de vida de un objeto."},"1289":{"id":"/docs/red/v1/comunicacion/rcr","page_id":"/docs/red/v1/comunicacion/rcr","type":"page","content":"RCR","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcr"},"1290":{"id":"/docs/red/v1/comunicacion/rcr-0","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr","content":"Red Creación Remota, el mecanismo de Eco para crear objetos sincronizados desde la red."},"1291":{"id":"/docs/red/v1/comunicacion/rcr-1","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#rcr--red-creación-remota","content":"RCR — Red Creación Remota"},"1292":{"id":"/docs/red/v1/comunicacion/rcr-2","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#ciclo-conceptual","content":"Ciclo conceptual"},"1293":{"id":"/docs/red/v1/comunicacion/rcr-3","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"Cuándo aparece"},"1294":{"id":"/docs/red/v1/comunicacion/rcr-4","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#relación-con-eco","content":"Relación con Eco"},"1295":{"id":"/docs/red/v1/co