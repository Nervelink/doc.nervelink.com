1/guias/persistir-partida-46","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Cache temporal"},"1722":{"id":"/docs/red/v1/guias/persistir-partida-47","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"No"},"1723":{"id":"/docs/red/v1/guias/persistir-partida-48","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"La persistencia debe representar el mundo, no el historial completo de cada frame."},"1724":{"id":"/docs/red/v1/guias/persistir-partida-49","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistencia-frente-a-guardado-del-juego","content":"En un juego real probablemente tendrás dos capas:"},"1725":{"id":"/docs/red/v1/guias/persistir-partida-50","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistencia-frente-a-guardado-del-juego","content":"Eco debe conservar aquello que necesita reconstruir su propio estado de red. El sistema de guardado del juego debe conservar datos de negocio como inventario, progreso, economía, estadísticas y configuración."},"1726":{"id":"/docs/red/v1/guias/persistir-partida-51","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#recomendación-de-diseño","content":"Antes de marcar un objeto como persistente, define:"},"1727":{"id":"/docs/red/v1/guias/persistir-partida-52","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#recomendación-de-diseño","content":"Esta decisión evita llenar el almacenamiento con objetos cuya vida real dura unos pocos segundos."},"1728":{"id":"/docs/red/v1/guias/persistir-partida-53","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#relación-con-tnet","content":"La persistencia de canales, objetos creados, RFC guardadas y estado del servidor procede del modelo de TNet que Eco conserva y renombra."},"1729":{"id":"/docs/red/v1/guias/persistir-partida-54","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#relación-con-tnet","content":"Para conocer los nombres equivalentes y los cambios realizados por Eco, consulta la sección de Referencia."},"1730":{"id":"/docs/red/v1/guias/persistir-partida-55","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Cómo `ServidorJuego` mantiene y restaura el estado de los canales."},"1731":{"id":"/docs/red/v1/guias/persistir-partida-56","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Cómo se transmite el estado antes y durante la persistencia."},"1732":{"id":"/docs/red/v1/guias/persistir-partida-57","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Identidad, propietario y ciclo de vida de los objetos persistentes."},"1733":{"id":"/docs/red/v1/guias/persistir-partida-58","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Repositorio upstream de la arquitectura heredada."},"1734":{"id":"/docs/red/v1/guias/primer-cliente","page_id":"/docs/red/v1/guias/primer-cliente","type":"page","content":"Primer cliente","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-cliente"},"1735":{"id":"/docs/red/v1/guias/primer-cliente-0","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente","content":"Conecta un cliente de Eco, espera el handshake, entra en un canal y valida la sesión."},"1736":{"id":"/docs/red/v1/guias/primer-cliente-1","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Primer cliente"},"1737":{"id":"/docs/red/v1/guias/primer-cliente-2","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#flujo","content":"Flujo"},"1738":{"id":"/docs/red/v1/guias/primer-cliente-3","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#preparación","content":"Preparación"},"1739":{"id":"/docs/red/v1/guias/primer-cliente-4","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#conectar","content":"Conectar"},"1740":{"id":"/docs/red/v1/guias/primer-cliente-5","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#1-crear-la-intención-de-conexión-step","content":"Crear la intención de conexión [step]"},"1741":{"id":"/docs/red/v1/guias/primer-cliente-6","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#2-esperar-el-handshake-step","content":"Esperar el handshake [step]"},"1742":{"id":"/docs/red/v1/guias/primer-cliente-7","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#3-solicitar-un-canal-step","content":"Solicitar un canal [step]"},"1743":{"id":"/docs/red/v1/guias/primer-cliente-8","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#4-esperar-la-entrada-step","content":"Esperar la entrada [step]"},"1744":{"id":"/docs/red/v1/guias/primer-cliente-9","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#5-validar-el-canal-step","content":"Validar el canal [step]"},"1745":{"id":"/docs/red/v1/guias/primer-cliente-10","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"Cliente remoto vs local"},"1746":{"id":"/docs/red/v1/guias/primer-cliente-11","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#estado-de-la-sesión","content":"Estado de la sesión"},"1747":{"id":"/docs/red/v1/guias/primer-cliente-12","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"A partir de aquí"},"1748":{"id":"/docs/red/v1/guias/primer-cliente-13","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"Errores frecuentes"},"1749":{"id":"/docs/red/v1/guias/primer-cliente-14","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"Desconexión"},"1750":{"id":"/docs/red/v1/guias/primer-cliente-15","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Referencias"},"1751":{"id":"/docs/red/v1/guias/primer-cliente-16","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Esta guía cubre el recorrido mínimo desde una instancia de juego sin sesión hasta un cliente conectado y dentro de un canal."},"1752":{"id":"/docs/red/v1/guias/primer-cliente-17","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Al terminar tendrás una secuencia fiable: conexión → handshake → canal → comprobación de estado. No añadiremos objetos ni gameplay hasta que este flujo sea estable."},"1753":{"id":"/docs/red/v1/guias/primer-cliente-18","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#preparación","content":"La lógica de cliente se concentra en `ClienteJuego`. La fachada de Pandora puede exponerlo de otra forma, pero el modelo interno sigue teniendo estados independientes para conexión y pertenencia a canales."},"1754":{"id":"/docs/red/v1/guias/primer-cliente-19","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#1-crear-la-intención-de-conexión-step","content":"`Connect` inicia el proceso; no implica que la sesión esté lista en la misma instrucción."},"1755":{"id":"/docs/red/v1/guias/primer-cliente-20","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#2-esperar-el-handshake-step","content":"Comprueba el estado de conexión antes de solicitar operaciones dependientes del servidor."},"1756":{"id":"/docs/red/v1/guias/primer-cliente-21","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#4-esperar-la-entrada-step","content":"Mientras Eco espera la respuesta, `IsJoiningChannel(1)` puede indicar que la operación todavía está pendiente."},"1757":{"id":"/docs/red/v1/guias/primer-cliente-22","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"`ClienteJuego` utiliza la conexión de red y el protocolo normal. Es el entorno que debes utilizar para validar comportamiento real entre procesos o máquinas."},"1758":{"id":"/docs/red/v1/guias/primer-cliente-23","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"Eco puede asociar un `ServidorJuego` local para ejecutar cliente y servidor en el mismo proceso. Es excelente para pruebas, pero no reproduce todas las condiciones de una conexión real."},"1759":{"id":"/docs/red/v1/guias/primer-cliente-24","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#estado-de-la-sesión","content":"Estos estados son independientes. Conectar no te introduce automáticamente en una partida."},"1760":{"id":"/docs/red/v1/guias/primer-cliente-25","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Una vez dentro del canal puedes:"},"1761":{"id":"/docs/red/v1/guias/primer-cliente-26","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Añadir una entidad con identidad de red."},"1762":{"id":"/docs/red/v1/guias/primer-cliente-27","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Mantener datos de la entidad sincronizados."},"1763":{"id":"/docs/red/v1/guias/primer-cliente-28","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Ejecutar una RFC con destinatarios concretos."},"1764":{"id":"/docs/red/v1/guias/primer-cliente-29","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"La conexión sólo establece la sesión con el servidor. La entrada a uno o varios canales es una operación posterior."},"1765":{"id":"/docs/red/v1/guias/primer-cliente-30","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"Eco mantiene varios canales por cliente. Evita diseñar tu estado alrededor de un único `channels[0]`."},"1766":{"id":"/docs/red/v1/guias/primer-cliente-31","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"Cuando termines la sesión:"},"1767":{"id":"/docs/red/v1/guias/primer-cliente-32","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"No necesitas convertir la desconexión en una secuencia manual de abandono de canales; el cierre de la sesión forma parte del ciclo de vida del cliente."},"1768":{"id":"/docs/red/v1/guias/primer-cliente-33","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Funcionamiento del runtime de cliente."},"1769":{"id":"/docs/red/v1/guias/primer-cliente-34","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Modelo de uno o varios canales."},"1770":{"id":"/docs/red/v1/guias/primer-cliente-35","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Código fuente actual."},"1771":{"id":"/docs/red/v1/guias/primer-objeto","page_id":"/docs/red/v1/guias/primer-objeto","type":"page","content":"Primer objeto","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-objeto"},"1772":{"id":"/docs/red/v1/guias/primer-objeto-0","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#primer-objeto","content":"Primer objeto"},"1773":{"id":"/docs/red/v1/guias/primer-objeto-1","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#1-crear-la-entidad","content":"Crear la entidad"},"1774":{"id":"/docs/red/v1/guias/primer-objeto-2","page_id":"/docs/red/v1/guias/primer-objeto","type":