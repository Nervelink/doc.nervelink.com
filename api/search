acion/rcl-2","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"Diferencia con RCR"},"1123":{"id":"/docs/red/v1/comunicacion/rcl-3","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#ciclo-conceptual","content":"Ciclo conceptual"},"1124":{"id":"/docs/red/v1/comunicacion/rcl-4","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Cuándo documentarlo"},"1125":{"id":"/docs/red/v1/comunicacion/rcl-5","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"En Eco, el concepto histórico `LCR` (*Local Creation Request / Call*) de TNet se denomina **RCL — Red Creación Local**."},"1126":{"id":"/docs/red/v1/comunicacion/rcl-6","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"RCL pertenece al conjunto de mecanismos de creación y sirve para representar la solicitud de que una entidad sea creada localmente en el contexto adecuado de red."},"1127":{"id":"/docs/red/v1/comunicacion/rcl-7","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"La diferencia no debe entenderse únicamente como «cliente» frente a «servidor». Lo relevante es quién origina la operación y qué parte del flujo de creación debe resolverse de forma local o remota."},"1128":{"id":"/docs/red/v1/comunicacion/rcl-8","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"RCL es especialmente útil cuando se describen workflows de creación donde el código local inicia la incorporación de una entidad al modelo de red."},"1129":{"id":"/docs/red/v1/comunicacion/rcl-9","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Para una integración habitual, el desarrollador debería pensar primero en el resultado deseado —crear un objeto de red válido— y después elegir el mecanismo de creación adecuado."},"1130":{"id":"/docs/red/v1/comunicacion/rcl-10","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Creación Remota."},"1131":{"id":"/docs/red/v1/comunicacion/rcl-11","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Método Remoto."},"1132":{"id":"/docs/red/v1/comunicacion/rcl-12","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Workflow práctico del ciclo de vida de un objeto."},"1133":{"id":"/docs/red/v1/comunicacion/rcr","page_id":"/docs/red/v1/comunicacion/rcr","type":"page","content":"RCR","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcr"},"1134":{"id":"/docs/red/v1/comunicacion/rcr-0","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr","content":"Red Creación Remota, el mecanismo de Eco para crear objetos sincronizados desde la red."},"1135":{"id":"/docs/red/v1/comunicacion/rcr-1","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#rcr--red-creación-remota","content":"RCR — Red Creación Remota"},"1136":{"id":"/docs/red/v1/comunicacion/rcr-2","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#ciclo-conceptual","content":"Ciclo conceptual"},"1137":{"id":"/docs/red/v1/comunicacion/rcr-3","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"Cuándo aparece"},"1138":{"id":"/docs/red/v1/comunicacion/rcr-4","page_id":"/docs/red/v1/comunicacion/rcr","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcr#relación-con-eco","content":"Relación con Eco"},"1139":{"id":"/docs/red/v1/comunicacion/rcr-5","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#rcr--red-creación-remota","content":"En Eco, el concepto histórico `RCC` (*Remote Creation Call*) de TNet se denomina **RCR — Red Creación Remota**."},"1140":{"id":"/docs/red/v1/comunicacion/rcr-6","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#rcr--red-creación-remota","content":"RCR se utiliza para resolver la creación de objetos que deben existir y ser conocidos por los participantes de una sesión."},"1141":{"id":"/docs/red/v1/comunicacion/rcr-7","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#rcr--red-creación-remota","content":"`RCR` describe la creación remota de un objeto. `RCL` describe una solicitud de creación local dentro del modelo de red de Eco."},"1142":{"id":"/docs/red/v1/comunicacion/rcr-8","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"RCR es relevante para:"},"1143":{"id":"/docs/red/v1/comunicacion/rcr-9","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"aparición de unidades;"},"1144":{"id":"/docs/red/v1/comunicacion/rcr-10","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"creación de torres;"},"1145":{"id":"/docs/red/v1/comunicacion/rcr-11","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#cuándo-aparece","content":"generación de objetos persistente