ia/upstream#qué-conserva-eco","content":"La base de Eco mantiene conceptos como:"},"840":{"id":"/docs/red/v1/referencia/upstream-9","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"canales y jugadores;"},"841":{"id":"/docs/red/v1/referencia/upstream-10","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"objetos de red y componentes;"},"842":{"id":"/docs/red/v1/referencia/upstream-11","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"RFC y mensajes del protocolo;"},"843":{"id":"/docs/red/v1/referencia/upstream-12","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"serialización mediante nodos y buffers;"},"844":{"id":"/docs/red/v1/referencia/upstream-13","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"transporte TCP/UDP;"},"845":{"id":"/docs/red/v1/referencia/upstream-14","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"persistencia y estado del servidor."},"846":{"id":"/docs/red/v1/referencia/upstream-15","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"Eco modifica principalmente la nomenclatura y la organización para integrarlas en la arquitectura de Nervelink y Pandora."},"847":{"id":"/docs/red/v1/referencia/upstream-16","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#consultar-tnet-sin-confundir-apis","content":"La documentación y ejemplos históricos de TNet pueden utilizar nombres que ya no existen en Eco. Cuando sea necesario consultar upstream, primero hay que traducir el concepto mediante la tabla de equivalencias de Eco."},"848":{"id":"/docs/red/v1/runtime/cliente","page_id":"/docs/red/v1/runtime/cliente","type":"page","content":"Cliente","breadcrumbs":["Docs","Red","Red","Contenido","Runtime"],"tags":[],"url":"/docs/red/v1/runtime/cliente"},"849":{"id":"/docs/red/v1/runtime/cliente-0","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente","content":"Ciclo de vida del cliente de Eco, conexión, transporte y gestión de la sesión."},"850":{"id":"/docs/red/v1/runtime/cliente-1","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#cliente","content":"Cliente"},"851":{"id":"/docs/red/v1/runtime/cliente-2","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#flujo","content":"Flujo"},"852":{"id":"/docs/red/v1/runtime/cliente-3","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#estados","content":"Estados"},"853":{"id":"/docs/red/v1/runtime/cliente-4","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#conexión","content":"Conexión"},"854":{"id":"/docs/red/v1/runtime/cliente-5","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#procesamiento","content":"Procesamiento"},"855":{"id":"/docs/red/v1/runtime/cliente-6","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#canales","content":"Canales"},"856":{"id":"/docs/red/v1/runtime/cliente-7","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#jugador-local","content":"Jugador local"},"857":{"id":"/docs/red/v1/runtime/cliente-8","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/r