/v1/runtime/servidor-21","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor-local","content":"`localClient` permite conectar un `ClienteJuego` al servidor dentro del mismo proceso, utilizando colas internas en lugar de sockets."},"539":{"id":"/docs/red/v1/runtime/servidor-22","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"Eco"},"540":{"id":"/docs/red/v1/runtime/servidor-23","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"TNet"},"541":{"id":"/docs/red/v1/runtime/servidor-24","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`ServidorJuego`"},"542":{"id":"/docs/red/v1/runtime/servidor-25","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`GameServer`"},"543":{"id":"/docs/red/v1/runtime/servidor-26","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`Jugador` / `Entidad`"},"544":{"id":"/docs/red/v1/runtime/servidor-27","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`Player`"},"545":{"id":"/docs/red/v1/runtime/servidor-28","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`Canal`"},"546":{"id":"/docs/red/v1/runtime/servidor-29","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`TNChannel`"},"547":{"id":"/docs/red/v1/runtime/servidor-30","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`Paquete`"},"548":{"id":"/docs/red/v1/runtime/servidor-31","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"`TNPacket`"},"549":{"id":"/docs/red/v1/runtime/servidor-32","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"Código fuente de Eco."},"550":{"id":"/docs/red/v1/runtime/servidor-33","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"Repositorio upstream."},"551":{"id":"/docs/red/v1/runtime/servidor-34","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#referencia-a-tnet","content":"Referencia externa para contrastar la arquitectura upstream."},"552":{"id":"/docs/red/v1/comunicacion/destinatarios","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"page","content":"Destinatarios","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/destinatarios"},"553":{"id":"/docs/red/v1/comunicacion/destinatarios-0","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios","content":"Cómo Eco determina quién recibe un mensaje dentro de un canal."},"554":{"id":"/docs/red/v1/comunicacion/destinatarios-1","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Destinatarios"},"555":{"id":"/docs/red/v1/comunicacion/destinatarios-2","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Contexto de canal"},"556":{"id":"/docs/red/v1/comunicacion/destinatarios-3","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivos habituales"},"557":{"id":"/docs/red/v1/comunicacion/destinatarios-4","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Propietario frente a canal"},"558":{"id":"/docs/red/v1/comunicacion/destinatarios-5","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Comunicación persistente"},"559":{"id":"/docs/red/v1/comunicacion/destinatarios-6","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#elección-práctica","content":"Elección práctica"},"560":{"id":"/docs/red/v1/comunicacion/destinatarios-7","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Relación con TNet"},"561":{"id":"/docs/red/v1/comunicacion/destinatarios-8","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Referencias"},"562":{"id":"/docs/red/v1/comunicacion/destinatarios-9","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Enviar un mensaje no significa necesariamente enviarlo a todos los participantes. Eco permite elegir el ámbito de destinatarios según el tipo de comunicación y el estado que se quiere mantener."},"563":{"id":"/docs/red/v1/comunicacion/destinatarios-10","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Antes de enviar un mensaje conviene decidir quién necesita conocerlo: el propietario, los demás jugadores, todo el canal o también los jugadores que entren posteriormente."},"564":{"id":"/docs/red/v1/comunicacion/destinatarios-11","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Los mensajes asociados a objetos se interpretan dentro de un `Canal`. El canal determina qué jugadores forman parte del ámbito de difusión."},"565":{"id":"/docs/red/v1/comunicacion/destinatarios-12","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"A partir de ese contexto, Eco puede excluir al emisor, incluirlo, conservar el mensaje para futuros participantes o dirigirlo a un participante concreto."},"566":{"id":"/docs/red/v1/comunicacion/destinatarios-13","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivo conceptual"},"567":{"id":"/docs/red/v1/comunicacion/destinatarios-14","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Uso"},"568":{"id":"/docs/red/v1/comunicacion/destinatarios-15","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Todos`"},"569":{"id":"/docs/red/v1/comunicacion/destinatarios-16","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos los jugadores del canal."},"570":{"id":"/docs/red/v1/comunicacion/destinatarios-17","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Otros`"},"571":{"id":"/docs/red/v1/comunicacion/destinatarios-18","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos salvo el emisor."},"572":{"id":"/docs/red/v1/comunicacion/destinatarios-19","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Propietario"},"573":{"id":"/docs/red/v1/comunicacion/destinatarios-20","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"El jugador que posee el objeto."},"574":{"id":"/docs/red/v1/comunicacion/destinatarios-21","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Persistente"},"575":{"id":"/docs/red/v1/comunicacion/destinatarios-22","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"También debe estar disponible para participantes posteriores."},"576":{"id":"/docs/red/v1/comunicacion/destinatarios-23","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Jugador concreto"},"577":{"id":"/docs/red/v1/comunicacion/destinatarios-24","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Un único participante identificado."},"578":{"id":"/docs/red/v1/comunicacion/destinatarios-25","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Los nombres exactos disponibles dependen de la API de `Objetivo` y del método utilizado para enviar el mensaje."},"579":{"id":"/docs/red/v1/comunicacion/destinatarios-26","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"La propiedad y la visibilidad son conceptos diferentes:"},"580":{"id":"/docs/red/v1/comunicacion/destinatarios-27","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Que un objeto tenga propietario no significa que únicamente ese jugador pueda recibir sus actualizaciones."},"581":{"id":"/docs/red/v1/comunicacion/destinatarios-28","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Un mensaje marcado para persistir puede formar parte del estado que Eco mantiene asociado al canal u objeto. Esto resulta útil cuando el contenido debe estar disponible también para jugadores que todavía no estaban conectados cuando ocurrió la comunicación."},"582":{"id":"/docs/red/v1/comunicacion/destinatarios-29","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"No debe utilizarse persistencia sólo porque un mensaje se considere importante: debe existir una necesidad real de reconstruir ese estado posteriormente."},"583":{"id":"/docs/red/v1/comunicacion/destinatarios-30","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Eco conserva el modelo de objetivos de TNet, pero utiliza la nomenclatura propia del proyecto. Las equivalencias deben comprobarse siempre contra la implementación actual de `Eco` y `Objeto`."},"584":{"id":"/docs/red/v1/comunicacion/destinatarios-31","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Implementación actual."},"585":{"id":"/docs/red/v1/comunicacion/destinatarios-32","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Repositorio upstream."},"586":{"id":"/docs/red/v1/comunicacion/destinatarios-33","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Referencia generada para contrastar el diseño upstream."},"587":{"id":"/docs/red/v1/comunicacion","page_id":"/docs/red/v1/comunicacion","type":"page","content":"Comunicación","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion"},"588":{"id":"/docs/red/v1/comunicacion-0","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion","content":"Cómo Eco envía acciones, mantiene estado y dirige mensajes a sus destinatarios."},"589":{"id":"/docs/red/v1/comunicacion-1","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación","content":"Comunicación"},"590":{"id":"/docs/red/v1/comunicacion-2","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Esta sección reúne los mecanismos mediante los que los objetos de Eco se comunican a través de la red."},"591":{"id":"/docs/red/v1/comunicacion-3","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Modelo general de mensajes, RFC, destinatarios y flujo cliente-servidor."},"592":{"id":"/docs/red/v1/comunicacion-4","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Sincronización de estado, `Set`, `Nodo` y actualización automática."},"593":{"id":"/docs/red/v1/comunicacion/rfc","page_id":"/docs/red/v1/comunicacion/rfc","type":"page","content":"RFC","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rfc"},"594":{"id":"/docs/red/v1/comunicacion/rfc-0","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc","content":"Llamadas de funciones remotas en Eco."},"595":{"id":"/docs/red/v1/comunicacion/rfc-1","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#rfc","content":"RFC"},"596":{"id":"/docs/red/v1/comunicacion/rfc-2","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#estructura","content":"Estructura"},"597":{"id":"/docs/red/v1/comunicacion/rfc-3","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#flujo","content":"Flujo"},"598":{"id":"/docs/red/v1/comunicacion/rfc-4","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#rfc-identificadas-por-nombre-o-id","content":"RFC identificadas por nombre o ID"},"599":{"id":"/docs/red/v1/comunicacion/rfc-5","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#persistencia","content":"Persistencia"},"600":{"id":"/docs/red/v1/comunicacion/rfc-6","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#rfc-desde-un-componente","content":"RFC desde un `Componente`"},"601":{"id":"/docs/red/v1/comunicacion/rfc-7","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Cuándo utilizar una RFC"},"602":{"id":"/docs/red/v1/comunicacion/rfc-8","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"Relación con TNet"},"603":{"id":"/docs/red/v1/comunicacion/rfc-9","page_id":"/docs/red/v1/comunicacion/rfc","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc#referencias","content":"Referencias"},"604":{"id":"/docs/red/v1/comunicacion/rfc-10","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc","content":"Una RFC (*Remote Function Call*) representa una llamada a una función asociada a un `Objeto` que debe ejecutarse remotamente."},"605":{"id":"/docs/red/v1/comunicacion/rfc-11","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc","content":"Una RFC es adecuada para comunicar que debe ocurrir algo. Para representar el valor actual de una propiedad conviene utilizar los mecanismos de estado y sincronización."},"606":{"id":"/docs/red/v1/comunicacion/rfc-12","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#estructura","content":"Eco conserva las RFC dentro del contexto del `Canal`. Cada entrada contiene, conceptualmente:"},"607":{"id":"/docs/red/v1/comunicacion/rfc-13","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#estructura","content":"El identificador permite localizar el objeto y la función. Cuando la llamada no utiliza un identificador numérico, se conserva el nombre de la función."},"608":{"id":"/docs/red/v1/comunicacion/rfc-14","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#flujo","content":"El canal forma parte del contexto de la comunicación, por lo que una RFC no debe entenderse como un mensaje global independiente de la sesión."},"609":{"id":"/docs/red/v1/comunicacion/rfc-15","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc-identificadas-por-nombre-o-id","content":"Eco puede trabajar con funciones identificadas mediante un ID compacto o mediante nombre. El nombre se utiliza cuando el identificador de función es `0`."},"610":{"id":"/docs/red/v1/comunicacion/rfc-16","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc-identificadas-por-nombre-o-id","content":"Esto permite mantener una comunicación más compacta cuando existe un identificador estable, dejando el nombre para los casos dinámicos o no registrados mediante ID."},"611":{"id":"/docs/red/v1/comunicacion/rfc-17","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#persistencia","content":"Algunas RFC pueden conservarse como parte del estado de un objeto o canal. `Canal` almacena las RFC asociadas a objetos dinámicos y puede exportarlas junto con los datos de creación del objeto."},"612":{"id":"/docs/red/v1/comunicacion/rfc-18","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#persistencia","content":"Por tanto, una RFC persistente puede formar parte del estado necesario para reconstruir un objeto, no solamente de una cola temporal de mensajes."},"613":{"id":"/docs/red/v1/comunicacion/rfc-19","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc-desde-un-componente","content":"Los componentes trabajan normalmente a través del `Objeto` asociado:"},"614":{"id":"/docs/red/v1/comunicacion/rfc-20","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#rfc-desde-un-componente","content":"`Componente` también proporciona acceso de conveniencia a la instanciación, destrucción y datos del objeto."},"615":{"id":"/docs/red/v1/comunicacion/rfc-21","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Utiliza RFC cuando el mensaje representa una acción o evento puntual:"},"616":{"id":"/docs/red/v1/comunicacion/rfc-22","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Situación"},"617":{"id":"/docs/red/v1/comunicacion/rfc-23","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"RFC"},"618":{"id":"/docs/red/v1/comunicacion/rfc-24","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Solicitar un ataque"},"619":{"id":"/docs/red/v1/comunicacion/rfc-25","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Sí"},"620":{"id":"/docs/red/v1/comunicacion/rfc-26","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Reproducir una acción"},"621":{"id":"/docs/red/v1/comunicacion/rfc-27","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Sí"},"622":{"id":"/docs/red/v1/comunicacion/rfc-28","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Ejecutar una habilidad"},"623":{"id":"/docs/red/v1/comunicacion/rfc-29","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Sí"},"624":{"id":"/docs/red/v1/comunicacion/rfc-30","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Notificar un evento puntual"},"625":{"id":"/docs/red/v1/comunicacion/rfc-31","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Sí"},"626":{"id":"/docs/red/v1/comunicacion/rfc-32","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/com