1/steam/callbacks-1","page_id":"/docs/red/v1/steam/callbacks","type":"heading","tags":[],"url":"/docs/red/v1/steam/callbacks#procesamiento","content":"Procesamiento"},"3012":{"id":"/docs/red/v1/steam/callbacks-2","page_id":"/docs/red/v1/steam/callbacks","type":"heading","tags":[],"url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"Eventos relevantes"},"3013":{"id":"/docs/red/v1/steam/callbacks-3","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks","content":"Steamworks es un sistema basado en callbacks. Eco encapsula su procesamiento dentro del sistema `Steam`."},"3014":{"id":"/docs/red/v1/steam/callbacks-4","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#procesamiento","content":"La integración ejecuta `SteamAPI.RunCallbacks()` periódicamente. Cuando hay actividad de servidor o conexión P2P puede procesarlos con mayor frecuencia para reducir el retraso entre la recepción de información y su tratamiento. fileciteturn190file0"},"3015":{"id":"/docs/red/v1/steam/callbacks-5","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"La implementación actual registra callbacks relacionados con:"},"3016":{"id":"/docs/red/v1/steam/callbacks-6","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"solicitudes de sesión P2P;"},"3017":{"id":"/docs/red/v1/steam/callbacks-7","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"fallos de conexión P2P;"},"3018":{"id":"/docs/red/v1/steam/callbacks-8","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"solicitudes de unión mediante Rich Presence."},"3019":{"id":"/docs/red/v1/steam/callbacks-9","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"Estos callbacks son infraestructura. El gameplay debería reaccionar a los estados de Eco resultantes, no acoplar cada sistema del juego directamente a Steamworks."},"3020":{"id":"/docs/red/v1/steam/callbacks-10","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"Steam callback → integración Steam → Eco → sistema de juego."},"3021":{"id":"/docs/red/v1/steam/callbacks-11","page_id":"/docs/red/v1/steam/callbacks","tags":[],"type":"text","url":"/docs/red/v1/steam/callbacks#eventos-relevantes","content":"Evita Steam callback → Torre, Steam callback → UI, Steam callback → combate, etc."},"3022":{"id":"/docs/red/v1/steam/conexion-p2p","page_id":"/docs/red/v1/steam/conexion-p2p","type":"page","content":"Conexión P2P","breadcrumbs":["Docs","Red","Red","Contenido","Steam"],"tags":[],"url":"/docs/red/v1/steam/conexion-p2p"},"3023":{"id":"/docs/red/v1/steam/conexion-p2p-0","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p","content":"Cómo Steam transporta una conexión Eco entre dos usuarios."},"3024":{"id":"/docs/red/v1/steam/conexion-p2p-1","page_id":"/docs/red/v1/steam/conexion-p2p","type":"heading","tags":[],"url":"/docs/red/v1/steam/conexion-p2p#flujo","content":"Flujo"},"3025":{"id":"/docs/red/v1/steam/conexion-p2p-2","page_id":"/docs/red/v1/steam/conexion-p2p","type":"heading","tags":[],"url":"/docs/red/v1/steam/conexion-p2p#conectar-manualmente","content":"Conectar manualmente"},"3026":{"id":"/docs/red/v1/steam/conexion-p2p-3","page_id":"/docs/red/v1/steam/conexion-p2p","type":"heading","tags":[],"url":"/docs/red/v1/steam/conexion-p2p#sesiones","content":"Sesiones"},"3027":{"id":"/docs/red/v1/steam/conexion-p2p-4","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p","content":"Eco implementa una conexión personalizada sobre Steam P2P mediante `IConnection`. La clase interna `P2PConnection` convierte los buffers de Eco en paquetes enviados al Steam ID remoto. fileciteturn190file0"},"3028":{"id":"/docs/red/v1/steam/conexion-p2p-5","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p#flujo","content":"El gameplay no necesita cambiar su protocolo sólo porque el transporte sea Steam."},"3029":{"id":"/docs/red/v1/steam/conexion-p2p-6","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p#conectar-manualmente","content":"La integración expone `Steam.Conectar(string)` para iniciar una conexión P2P mediante el Steam ID del usuario remoto. El README original de la integración utiliza un Steam ID numérico como ejemplo. fileciteturn189file0"},"3030":{"id":"/docs/red/v1/steam/conexion-p2p-7","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p#conectar-manualmente","content":"Si la cadena no representa un Steam ID válido, la integración no intenta tratarla como una conexión P2P y Eco puede continuar con su flujo normal."},"3031":{"id":"/docs/red/v1/steam/conexion-p2p-8","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p#sesiones","content":"La integración registra conexiones abiertas y cerradas y transforma la desconexión P2P en un estado de conexión que Eco puede procesar. fileciteturn190file0"},"3032":{"id":"/docs/red/v1/steam/conexion-p2p-9","page_id":"/docs/red/v1/steam/conexion-p2p","tags":[],"type":"text","url":"/docs/red/v1/steam/conexion-p2p#sesiones","content":"El transporte puede ser P2P, pero tu juego puede seguir siendo servidor-autoritativo. P2P describe el camino de comunicación, no quién decide el resultado de la partida."},"3033":{"id":"/docs/red/v1/steam/configuracion","page_id":"/docs/red/v1/steam/co