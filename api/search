cs/red/v1/fundamentos/conceptos-7","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"Propietario"},"1093":{"id":"/docs/red/v1/fundamentos/conceptos-8","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Paquete"},"1094":{"id":"/docs/red/v1/fundamentos/conceptos-9","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Buffer"},"1095":{"id":"/docs/red/v1/fundamentos/conceptos-10","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Estado"},"1096":{"id":"/docs/red/v1/fundamentos/conceptos-11","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"1097":{"id":"/docs/red/v1/fundamentos/conceptos-12","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"1098":{"id":"/docs/red/v1/fundamentos/conceptos-13","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#referencias","content":"Referencias"},"1099":{"id":"/docs/red/v1/fundamentos/conceptos-14","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Eco organiza la red alrededor de unas pocas piezas fundamentales. Entender su relación evita confundir conexión, canal, jugador, objeto y componente."},"1100":{"id":"/docs/red/v1/fundamentos/conceptos-15","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Una conexión representa la comunicación con el servidor; un jugador representa a un participante; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"1101":{"id":"/docs/red/v1/fundamentos/conceptos-16","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. No define por sí sola qué objetos o estado debe conocer el cliente."},"1102":{"id":"/docs/red/v1/fundamentos/conceptos-17","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. Sirve para identificar presencia, propiedad y destinatarios."},"1103":{"id":"/docs/red/v1/fundamentos/conceptos-18","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Un mismo jugador puede participar simultáneamente en varios canales."},"1104":{"id":"/docs/red/v1/fundamentos/conceptos-19","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"1105":{"id":"/docs/red/v1/fundamentos/conceptos-20","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Esta separación permite mantener la identidad de red independiente de la funcionalidad concreta."},"1106":{"id":"/docs/red/v1/fundamentos/conceptos-21","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"El propietario identifica al jugador que tiene autoridad sobre determinadas operaciones del objeto. La propiedad no implica que el objeto sea invisible para los demás participantes."},"1107":{"id":"/docs/red/v1/fundamentos/conceptos-22","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Un `Paquete` representa una unidad del protocolo de Eco. Transporta comandos, eventos y datos entre clientes y servidor."},"1108":{"id":"/docs/red/v1/fundamentos/conceptos-23","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"1109":{"id":"/docs/red/v1/fundamentos/conceptos-24","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Eco distingue entre comunicar una acción y mantener un estado. Una RFC puede comunicar que algo ocurrió; un mecanismo de sincronización mantiene valores que deben converger entre participantes."},"1110":{"id":"/docs/red/v1/fundamentos/conceptos-25","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Eco"},"1111":{"id":"/docs/red/v1/fundamentos/conceptos-26","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"TNet"},"1112":{"id":"/docs/red/v1/fundamentos/conceptos-27","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Función"},"1113":{"id":"/docs/red/v1/fundamentos/conceptos-28","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/re