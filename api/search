entes."},"3476":{"id":"/docs/red/v1/transporte/serializacion-profunda-30","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"Herramienta"},"3477":{"id":"/docs/red/v1/transporte/serializacion-profunda-31","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"Problema que resuelve"},"3478":{"id":"/docs/red/v1/transporte/serializacion-profunda-32","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Buffer`"},"3479":{"id":"/docs/red/v1/transporte/serializacion-profunda-33","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"transporte binario y protocolo"},"3480":{"id":"/docs/red/v1/transporte/serializacion-profunda-34","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Nodo`"},"3481":{"id":"/docs/red/v1/transporte/serializacion-profunda-35","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"datos jerárquicos y estado estructurado"},"3482":{"id":"/docs/red/v1/transporte/serializacion-profunda-36","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Paquete`"},"3483":{"id":"/docs/red/v1/transporte/serializacion-profunda-37","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/doc