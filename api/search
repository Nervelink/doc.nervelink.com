/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"Sincronizar una transformación continuamente"},"1348":{"id":"/docs/red/v1/comunicacion/rfc-35","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#cuándo-utilizar-una-rfc","content":"No"},"1349":{"id":"/docs/red/v1/comunicacion/rfc-36","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"Eco"},"1350":{"id":"/docs/red/v1/comunicacion/rfc-37","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"TNet"},"1351":{"id":"/docs/red/v1/comunicacion/rfc-38","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"RFC"},"1352":{"id":"/docs/red/v1/comunicacion/rfc-39","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"RFC"},"1353":{"id":"/docs/red/v1/comunicacion/rfc-40","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"`Objeto`"},"1354":{"id":"/docs/red/v1/comunicacion/rfc-41","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"`TNObject`"},"1355":{"id":"/docs/red/v1/comunicacion/rfc-42","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"`Componente`"},"1356":{"id":"/docs/red/v1/comunicacion/rfc-43","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content":"`TNBehaviour`"},"1357":{"id":"/docs/red/v1/comunicacion/rfc-44","page_id":"/docs/red/v1/comunicacion/rfc","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc#relación-con-tnet","content"