:"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"datos persistentes / RFC guardada"},"680":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-33","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"Enviar una orden a un jugador concreto"},"681":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-34","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"RFC con destinatario explícito"},"682":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-35","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#errores-habituales","content":"No uses una RFC para enviar la posición de una unidad cada frame si lo que realmente quieres es sincronizar su estado. Tampoco asumas que llamar una RFC significa que el emisor es necesariamente el propietario del objeto: la autoridad debe comprobarse según el flujo de la operación."},"683":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-36","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#referencias","content":"Modelo general de comunicación de Eco."},"684":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-37","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#referencias","content":"Selección de receptores y alcance de una llamada."},"685":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-38","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#referencias","content":"Implementación de referencia heredada."},"686":{"id":"/docs/red/v1/comunicacion/rfc","page_id":"/docs/red/v1/comunicacion/rfc","type":"page","content":"R