requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#escenas-y-canales","content":"Por eso los flujos de cambio de nivel y transferencia de objetos deben tratarse como operaciones de red coordinadas."},"408":{"id":"/docs/red/v1/requisitos-35","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Parte"},"409":{"id":"/docs/red/v1/requisitos-36","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Recomendación"},"410":{"id":"/docs/red/v1/requisitos-37","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"API de alto nivel de Eco"},"411":{"id":"/docs/red/v1/requisitos-38","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Utilízala como contrato de gameplay"},"412":{"id":"/docs/red/v1/requisitos-39","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Implementación interna"},"413":{"id":"/docs/red/v1/requisitos-40","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Puede evolucionar sin aviso de API estable"},"414":{"id":"/docs/red/v1/requisitos-41","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"TNet upstream"},"415":{"id":"/docs/red/v1/requisitos-42","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Referencia histórica/comparativa"},"416":{"id":"/docs/red/v1/requisitos-43","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos#qué-debe-considerarse-estable","content":"Ejemplos