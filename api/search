d/v1/transporte/tcp-udp-en-profundidad-23","page_id":"/docs/red/v1/transporte/tcp-udp-en-profundidad","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp-en-profundidad#regla-de-diseño","content":"No selecciones UDP para “hacerlo más rápido” sin definir primero qué sucede cuando un paquete llega tarde, duplicado o nunca llega. Si la lógica no puede tolerarlo, el dato necesita un flujo fiable o una estrategia explícita de corrección."},"4275":{"id":"/docs/red/v1/transporte/tcp-udp-en-profundidad-24","page_id":"/docs/red/v1/transporte/tcp-udp-en-profundidad","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp-en-profundidad#referencias","content":"Operaciones de protocolo relacionadas con TCP y UDP."},"4276":{"id":"/docs/red/v1/transporte/tcp-udp-en-profundidad-25","page_id":"/docs/red/v1/transporte/tcp-udp-en-profundidad","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp-en-profundidad#referencias","content":"Ciclo de conexión y disponibilidad del transporte."},"4277":{"id":"/docs/red/v1/transporte/tcp-udp","page_id":"/docs/red/v1/transporte/tcp-udp","type":"page","content":"TCP y UDP","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/tcp-udp"},"4278":{"id":"/docs/red/v1/transporte/tcp-udp-0","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp","content":"Cómo Eco combina transporte fiable y transporte de baja latencia."},"4279":{"id":"/docs/red/v1/transporte/tcp-udp-1","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"TCP y UDP"},"4280":{"id":"/docs/red/v1/transporte/tcp-udp-2","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP"},"4281":{"id":"/docs/red/v1/transporte/tcp-udp-3","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/tr