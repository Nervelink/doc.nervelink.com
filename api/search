p-udp-31","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Latencia potencial"},"4375":{"id":"/docs/red/v1/transporte/tcp-udp-32","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Mayor bajo pérdida/congestión"},"4376":{"id":"/docs/red/v1/transporte/tcp-udp-33","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Menor para tráfico tolerante a pérdida"},"4377":{"id":"/docs/red/v1/transporte/tcp-udp-34","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Estado crítico"},"4378":{"id":"/docs/red/v1/transporte/tcp-udp-35","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Adecuado"},"4379":{"id":"/docs/red/v1/transporte/tcp-udp-36","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No suele ser adecuado"},"4380":{"id":"/docs/red/v1/transporte/tcp-udp-37","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Actualizaciones frecuentes"},"4381":{"id":"/docs/red/v1/transporte/tcp-udp-38","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Puede ser adecuado"},"4382":{"id":"/docs/red/v1/transporte/tcp-udp-39","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Suele ser más apropiado"},"4383":{"id":"/docs/red/v1/transporte/tcp-udp-40","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No se debe elegir UDP simplemente por ser más rápido: si el dato necesita entrega garantizada, hay que utilizar un mecanismo fiable."},"4384":{"id":"/docs/red/v1/transporte/tcp-udp-41","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"Eco abstrae gran parte de esta decisión detrás de sus operaciones de envío. `Send` representa el camino normal, mientras que `SendQuickly` permite utilizar el camino optimizado para datos donde la fiabilidad completa no sea necesaria."},"4385":{"id":"/docs/red/v1/transporte/tcp-udp-42","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"La capa de gameplay no debería construir datagramas manualmente salvo que esté implementando una extensión de transporte."},"4386":{"id":"/docs/red/v1/transporte/tcp-udp-43","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"`ClienteJuego.noDelay` permite activar o desactivar el algoritmo de Nagle. Activarlo puede reducir la latencia de pequeños mensajes a costa de aumentar el tráfico."},"4387":{"id":"/docs/red/v1/transporte/tcp-udp-44","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"La misma configuración se comunica al servidor para mantener el comportamiento coherente del socket TCP."},"4388":{"id":"/docs/red/v1/transporte/tcp-udp-45","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"`ServidorJuego` puede abrir un puerto TCP y, opcionalmente, un puerto UDP al arrancar."},"4389":{"id":"/docs/red/v1/transporte/tcp-udp-46","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"El puerto UDP sólo se activa cuando se proporciona uno válido durante el arranque."},"4390":{"id":"/docs/red/v1/transporte/tcp-udp-47","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"La disponibilidad de UDP depende de la plataforma y de las compilaciones de Eco. Algunas configuraciones, como determinados entornos antiguos de Unity o modos de modificación, deshabilitan explícitamente UDP."},"4391":{"id":"/docs/red/v1/transporte/tcp-udp-48","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Por eso la aplicación debe consultar la disponibilidad real (`canUseUDP`) en lugar de asumir que UDP siempre está disponible."},"4392":{"id":"/docs/red/v1/transporte/tcp-udp-49","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El transporte no cambia el significado de un `Paquete`."},"4393":{"id":"/docs/red/v1/transporte/tcp-udp-50","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El mismo concepto de protocolo puede utilizar distintas rutas de transporte según el tipo de mensaje."},"4394":{"id":"/docs/red/v1/transporte/tcp-udp-51","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"El modelo corresponde al de los protocolos TCP y UDP de TNet, pero Eco utiliza `ProtocoloTcp`, `ProtocoloUdp`, `ClienteJuego` y `ServidorJuego` como API interna."},"4395":{"id":"/docs/red/v1/transporte/tcp-udp-52","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión cliente de TCP, UDP y envío de paquetes."},"4396":{"id":"/docs/red/v1/transporte/tcp-udp-53","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión servidor de listeners TCP/UDP."},"4397":{"id":"/docs/red/v1/transporte/tcp-udp-54","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Repositorio upstream."},"4398":{"id":"/docs/red/v1/referencia/api/bajo-nivel","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"page","content":"APIs de bajo nivel","breadcrumbs":["Docs","Red","Red","Contenido","Referencia","API"],"tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel"},"4399":{"id":"/docs/red/v1/referencia/api/bajo-nivel-0","page_id":"/docs/red/v1/referencia/api/bajo-nivel","tags":[],"type":"text","url":"/docs/red/v1/referencia/api/bajo-nivel","content":"Primitivas internas de Eco para paquetes, buffers, callbacks, caché, serialización y transporte personalizado."},"4400":{"id":"/docs/red/v1/referencia/api/bajo-nivel-1","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#apis-de-bajo-nivel","content":"APIs de bajo nivel"},"4401":{"id":"/docs/red/v1/referencia/api/bajo-nivel-2","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#capas","content":"Capas"},"4402":{"id":"/docs/red/v1/referencia/api/bajo-nivel-3","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#paquete","content":"Paquete"},"4403":{"id":"/docs/red/v1/referencia/api/bajo-nivel-4","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#buffer","content":"Buffer"},"4404":{"id":"/docs/red/v1/referencia/api/bajo-nivel-5","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"hea