emplos/rfc"},"1599":{"id":"/docs/red/v1/ejemplos/rfc-0","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc","content":"Ejemplo mínimo de una función remota y de la separación entre acción y estado."},"1600":{"id":"/docs/red/v1/ejemplos/rfc-1","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc","content":"RFC"},"1601":{"id":"/docs/red/v1/ejemplos/rfc-2","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#declarar-la-función","content":"Declarar la función"},"1602":{"id":"/docs/red/v1/ejemplos/rfc-3","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#enviar","content":"Enviar"},"1603":{"id":"/docs/red/v1/ejemplos/rfc-4","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#elegir-destinatarios","content":"Elegir destinatarios"},"1604":{"id":"/docs/red/v1/ejemplos/rfc-5","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"RFC frente a estado"},"1605":{"id":"/docs/red/v1/ejemplos/rfc-6","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"Persistencia"},"1606":{"id":"/docs/red/v1/ejemplos/rfc-7","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#errores-habituales","content":"Errores habituales"},"1607":{"id":"/docs/red/v1/ejemplos/rfc-8","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Método no encontrado"},"1608":{"id":"/docs/red/v1/ejemplos/rfc-9","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Parámetros incompatibles"},"1609":{"id":"/docs/red/v1/ejemplos/rfc-10","page_id":"/docs/