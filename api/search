ia/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Pérdida"},"3200":{"id":"/docs/red/v1/ingenieria/testing-23","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Robustez"},"3201":{"id":"/docs/red/v1/ingenieria/testing-24","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Spam de RFC"},"3202":{"id":"/docs/red/v1/ingenieria/testing-25","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Seguridad / carga"},"3203":{"id":"/docs/red/v1/ingenieria/testing-26","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Servidor reiniciado"},"3204":{"id":"/docs/red/v1/ingenieria/testing-27","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#matriz-mínima","content":"Recuperación"},"3205":{"id":"/docs/red/v1/ingenieria/testing-28","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#orden","content":"Empieza por dos clientes. Un problema que sólo aparece con cuatro suele ser más difícil de aislar si la base no está validada."},"3206":{"id":"/docs/red/v1/ingenieria/testing-29","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#invariantes","content":"Define reglas que nunca pueden romperse:"},"3207":{"id":"/docs/red/v1/ingenieria/testing-30","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#invariantes","content":"Los tests deben intentar romper esas invariantes desde clientes distintos."},"3208":{"id":"/docs/red/v1/ingenieria/testing-31","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#latencia-y-pérdida","content":"Prueba artificialmente condiciones peores que las esperadas. El objetivo es comprobar que la partida sigue siendo coherente, no que la animación sea idéntica en todos los clientes."},"3209":{"id":"/docs/red/v1/ingenieria/testing-32","page_id":"/docs/red/v1/ingenieria/testing","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/testing#latencia-y-pérdida","content":"Conecta un cliente después de que la partida ya tenga torres, unidades, recursos y oleadas activas. Si no puede reconstruir el estado correcto, la arquitectura depende demasiado de eventos históricos."},"3210":{"id":"/docs/red/v1/modelo/canales","page_id":"/docs/red/v1/modelo/canales","type":"page","content":"Canales","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo/canales"},"3211":{"id":"/docs/red/v1/modelo/canales-0","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales","content":"Ámbitos de estado compartido, pertenencia, persistencia y ciclo de vida de los canales de Eco."},"3212":{"id":"/docs/red/v1/modelo/canales-1","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#canales","content":"Canales"},"3213":{"id":"/docs/red/v1/modelo/canales-2","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#qué-contiene-un-canal","content":"Qué contiene un canal"},"3214":{"id":"/docs/red/v1/modelo/canales-3","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#modelo-mental","content":"Modelo mental"},"3215":{"id":"/docs/red/v1/modelo/canales-4","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#estado-relevante","content":"Estado relevante"},"3216":{"id":"/docs/red/v1/modelo/canales-5","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#entrada-al-canal","content":"Entrada al canal"},"3217":{"id":"/docs/red/v1/modelo/canales-6","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#1-solicitar-la-entrada-step","content":"Solicitar la entrada [step]"},"3218":{"id":"/docs/red/v1/modelo/canales-7","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#2-esperar-la-confirmación-step","content":"Esperar la confirmación [step]"},"3219":{"id":"/docs/red/v1/modelo/canales-8","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#3-comprobar-la-pertenencia-step","content":"Comprobar la pertenencia [step]"},"3220":{"id":"/docs/red/v1/modelo/canales-9","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#varios-canales","content":"Varios canales"},"3221":{"id":"/docs/red/v1/modelo/canales-10","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#salir-de-un-canal","content":"Salir de un canal"},"3222":{"id":"/docs/red/v1/modelo/canales-11","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#nivel-host-y-persistencia","content":"Nivel, host y persistencia"},"3223":{"id":"/docs/red/v1/modelo/canales-12","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Reglas de diseño"},"3224":{"id":"/docs/red/v1/modelo/canales-13","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"Correspondencia con TNet"},"3225":{"id":"/docs/red/v1/modelo/canales-14","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#referencias","content":"Referencias"},"3226":{"id":"/docs/red/v1/modelo/canales-15","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Un `Canal` define un ámbito de estado compartido dentro de Eco. Agrupa jugadores, objetos, nivel, datos y operaciones persistentes que pertenecen a una misma sesión lógica."},"3227":{"id":"/docs/red/v1/modelo/canales-16","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Una conexión física puede participar en varios canales simultáneamente. Nunca modeles un canal como si fuera un socket."},"3228":{"id":"/docs/red/v1/modelo/canales-17","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#qué-contiene-un-canal","content":"Participantes que pertenecen al ámbito del canal y pueden recibir su estado."},"3229":{"id":"/docs/red/v1/modelo/canales-18","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#qué-contiene-un-canal","content":"Entidades de red cuyo `channelID` identifica el contexto donde viven."},"3230":{"id":"/docs/red/v1/modelo/canales-19","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#qué-contiene-un-canal","content":"Nivel, datos del canal y RFC/estado que deben poder reconstruirse."},"3231":{"id":"/docs/red/v1/modelo/canales-20","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#qué-contiene-un-canal","content":"Host, ownership y reglas de modificación que dependen del contexto del canal."},"3232":{"id":"/docs/red/v1/modelo/canales-21","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#estado-relevante","content":"La implementación mantiene propiedades como `id`, `level`, `isPersistent`, `isClosed`, `isLeaving`, `playerLimit`, `jugadores`, `rfcs`, `created`, `destroyed` y `host`."},"3233":{"id":"/docs/red/v1/modelo/canales-22","page_