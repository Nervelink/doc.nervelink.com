/red/v1/referencia/equivalencias-55","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"Por ejemplo, si un ejemplo de TNet habla de `TNObject`, el punto de partida equivalente en Eco es `Objeto`. A partir de ahí debe consultarse la API de Eco, ya que otros tipos y nombres pueden haber cambiado."},"2119":{"id":"/docs/red/v1/referencia/equivalencias-56","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-nomenclatura","content":"La refactorización de Eco busca que los nombres estén alineados con la nomenclatura de Pandora. Esto permite que el código de red se integre con el resto del proyecto sin mantener permanentemente la terminología histórica de TNet."},"2120":{"id":"/docs/red/v1/referencia/equivalencias-57","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"Una equivalencia de nombres no implica que las dos implementaciones tengan exactamente el mismo comportamiento. Eco puede haber incorporado refactorizaciones, cambios de arquitectura o funcionalidades propias."},"2121":{"id":"/docs/red/v1/referencia/equivalencias-58","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"La referencia definitiva siempre debe ser el código actual de `Nervelink/eco`."},"2122":{"id":"/docs/red/v1/referencia","page_id":"/docs/red/v1/referencia","type":"page","content":"Referencia","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia"},"2123":{"id":"/docs/red/v1/referencia-0","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia","content":"Fuentes, API, equivalencias y material de consulta para trabajar con Eco."},"2124":{"id":"/docs/red/v1/referencia-1","page_id":"/docs/red/v1/referencia","type":"heading","tags":[],"url":"/docs/red/v1/referencia#referencia","content":"Referencia"},"2125":{"id":"/docs/red/v1/referencia-2","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Esta sección está orientada a la consulta rápida. Aquí no se vuelve a explicar el concepto completo de cada sistema: se documenta la API, se comparan implementaciones y se enlazan las fuentes que definen el comportamiento real."},"2126":{"id":"/docs/red/v1/referencia-3","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Consulta clases, propiedades, métodos, eventos y tipos que forman la API pública de Eco."},"2127":{"id":"/docs/red/v1/referencia-4","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Repositorio original del que parte la implementación de Eco."},"2128":{"id":"/docs/red/v1/referencia-5","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Documentación generada sobre el repositorio actual de TNet."},"2129":{"id":"/docs/red/v1/referencia-6","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Código fuente que define el comportamiento normativo de Eco."},"2130":{"id":"/docs/red/v1/referencia-7","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Cuando exista una diferencia, utiliza este orden: código actual de Eco → documentación de Eco → TNet upstream → documentación histórica de TNet → DeepWiki."},"2131":{"id":"/docs/red/v1/referencia/upstream","page_id":"/docs/red/v1/referencia/upstream","type":"page","content":"TNet upstream","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia/upstream"},"2132":{"id":"/docs/red/v1/referencia/upstream-0","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream","content":"Relación de Eco con la implementación original de TNet."},"2133":{"id":"/docs/red/v1/referencia/upstream-1","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"TNet upstream"},"2134":{"id":"/docs/red/v1/referencia/upstream-2","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#repositorio","content":"Repositorio"},"2135":{"id":"/docs/red/v1/referencia/upstream-3","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"Qué conserva Eco"},"2136":{"id":"/docs/red/v1/referencia/upstream-4","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#consultar-tnet-sin-confundir-apis","content":"Consultar TNet sin confundir APIs"},"2137":{"id":"/docs/red/v1/referencia/upstream-5","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"Eco parte de TNet 3 y conserva gran parte de su modelo de red. Esta referencia permite entender qué conceptos proceden de upstream y dónde consultar su implementación original."},"2138":{"id":"/docs/red/v1/referencia/upstream-6","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"Para desarrollar con Eco, la fuente normativa es `Nervelink/eco`. TNet se utiliza como referencia histórica y arquitectónica."},"2139":{"id":"/docs/red/v1/referencia/upstream-7","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#repositorio","content":"Repositorio oficial de TNet mantenido por Tasharen."},"2140":{"id":"/docs/red/v1/referencia/upstream-8","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"La base de Eco mantiene conceptos como:"},"2141":{"id":"/docs/red/v1/referencia/upstream-9","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"canales y jugadores;"},"2142":{"id":"/docs/red/v1/referencia/upstream-10","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"objetos de red y componentes;"},"2143":{"id":"/docs/red/v1/referencia/upstream-11","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"RFC y mensajes del protocolo;"},"2144":{"id":"/docs/red/v1/referencia/upstream-12","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"serialización mediante nodos y buffers;"},"2145":{"id":"/docs/red/v1/referencia/upstream-13","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"transporte TCP/UDP;"},"2146":{"id":"/docs/red/v1/referencia/upstream-14","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"persistencia y estado del servidor."},"2147":{"id":"/docs/red/v1/referencia/upstream-15","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"Eco modifica principalmente la nomenclatura y la organización para integrarlas en la arquitectura de Nervelink y Pandora."},"2148":{"id":"/docs/red/v1/referencia/upstream-16","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#consultar-tnet-sin-confundir-apis","content":"La documentación y ejemplos históricos de TNet pueden utilizar nombres que ya no existen en Eco. Cuando sea necesario consultar upstream, primero hay que traducir el concepto mediante la tabla de equivalencias de Eco."},"2149":{"id":"/docs/red/v1/runtime/cliente-avanzado","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"page","content":"Cliente avanzado","breadcrumbs":["Docs","Red","Red","Contenido","Runtime"],"tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado"},"2150":{"id":"/docs/red/v1/runtime/cliente-avanzado-0","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado","content":"Estados de conexión, canales, datos de jugador y extensiones del cliente de Eco."},"2151":{"id":"/docs/red/v1/runtime/cliente-avanzado-1","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#cliente-avanzado","content":"Cliente avanzado"},"2152":{"id":"/docs/red/v1/runtime/cliente-avanzado-2","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#estados-importantes","content":"Estados importantes"},"2153":{"id":"/docs/red/v1/runtime/cliente-avanzado-3","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#canales","content":"Canales"},"2154":{"id":"/docs/red/v1/runtime/cliente-avanzado-4","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-jugador","content":"Datos del jugador"},"2155":{"id":"/docs/red/v1/runtime/cliente-avanzado-5","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-servidor","content":"Datos del servidor"},"2156":{"id":"/docs/red/v1/runtime/cliente-avanzado-6","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#ping-y-métricas","content":"Ping y métricas"},"2157":{"id":"/docs/red/v1/runtime/cliente-avanzado-7","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#desconexión","content":"Desconexión"},"2158":{"id":"/docs/red/v1/runtime/cliente-avanzado-8","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Referencias"},"2159":{"id":"/docs/red/v1/runtime/cliente-avanzado-9","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#cliente-avanzado","content":"`ClienteJuego` centraliza el estado de sesión del cliente: conexión, jugador local, canales, datos del servidor y jugador, TCP, UDP y colas. La implementación expone además el estado de unión a canales y soporte para servidor local sin sockets. fileciteturn216file0"},"2160":{"id":"/docs/red/v1/runtime/cliente-avanzado-10","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#estados-importantes","content":"No confundas `isConnected`, `isJoiningChannel` e `isInChannel`: representan estados distintos."},"2161":{"id":"/docs/red/v1/runtime/cliente-avanzado-11","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#canales","content":"`channels` contiene los canales actuales y `IsJoiningChannel(id)` / `IsInChannel(id)` permiten consultar un canal concreto. Esto es fundamental en un cliente multicanal."},"2162":{"id":"/docs/red/v1/runtime/cliente-avanzado-12","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-jugador","content":"`playerData` y `SetPlayerData` proporcionan almacenamiento asociado al jugador, separado del `Nodo` de un objeto. `SyncPlayerData()` permite forzar la sincronización del árbol completo. fileciteturn216file0"},"2163":{"id":"/docs/red/v1/runtime/cliente-avanzado-13","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-servidor","content":"`serverData` representa configuración global asociada al servidor. No debe utilizarse como sustituto del estado de una partida o del estado individual de un jugador."},"2164":{"id":"/docs/red/v1/runtime/cliente-avanzado-14","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#ping-y-métricas","content":"El cliente expone `ping`, bytes y paquetes enviados/recibidos y el tiempo del servidor. Estos valores son útiles para diagnóstico y telemetría, pero no deben utilizarse directamente como lógica de gameplay sin una estrategia de tolerancia a latencia."},"2165":{"id":"/docs/red/v1/runtime/cliente-avanzado-15","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#desconexión","content":"La desconexión debe tratarse como un cambio de estado de la sesión. Los objetos y canales locales pueden quedar inválidos aunque referencias de Unity sigan existiendo; la integración debe escuchar los eventos apropiados y limpiar su estado."},"2166":{"id":"/docs/red/v1/runtime/cliente-avanzado-16","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Referencia general del cliente."},"2167":{"id":"/docs/red/v1/runtime/cliente-avanzado-17","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Workflow práctico de diagnóstico."},"2168":{"id":"/docs/red/v1/runtime/cliente","page_id":"/docs/red/v1/runtime/cliente","type":"