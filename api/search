our` de Unity."},"1896":{"id":"/docs/red/v1/modelo/objetos-71","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Cómo se propaga el estado de una entidad."},"1897":{"id":"/docs/red/v1/modelo/objetos-72","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Implementación actual de `Objeto`."},"1898":{"id":"/docs/red/v1/modelo/objetos-73","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Implementación actual de `Componente`."},"1899":{"id":"/docs/red/v1/modelo/ownership-y-transferencia","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"page","content":"Ownership y transferencia","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia"},"1900":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-0","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia","content":"Propiedad de objetos, autoridad, IDs de red y transferencia entre canales en Eco."},"1901":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-1","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#ownership-y-transferencia","content":"Ownership y transferencia"},"1902":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-2","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#identidad-del-objeto","content":"Identidad del objeto"},"1903":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-3","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#propietario","content":"Propietario"},"1904":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-4","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#autoridad-no-es-lo-mismo-que-visibilidad","content":"Autoridad no es lo mismo que visibilidad"},"1905":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-5","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#transferencia-entre-canales","content":"Transferencia entre canales"},"1906":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-6","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#jerarquías-de-objetos","content":"Jerarquías de objetos"},"1907":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-7","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#eliminación","content":"Eliminación"},"1908":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-8","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","type":"heading","tags":[],"url":"/docs/red/v1/modelo/ownership-y-transferencia#relación-con-tnet","content":"Relación con TNet"},"1909":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-9","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#ownership-y-transferencia","content":"Un `Objeto` no es sólo un GameObject que todos pueden ver. Tiene identidad de red, canal y un propietario. Estas tres piezas permiten decidir quién puede originar determinadas operaciones y cómo se conserva la entidad cuando cambia su contexto."},"1910":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-10","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#identidad-del-objeto","content":"Eco asigna un identificador de red al objeto y lo registra dentro de su canal. En el código de bajo nivel el identificador puede empaquetarse junto con el identificador de la RFC para realizar despachos eficientes."},"1911":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-11","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#identidad-del-objeto","content":"No confíes en `GetInstanceID()` de Unity como identidad de red. Ese identificador sólo representa la instancia local del motor."},"1912":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-12","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#propietario","content":"Un `Objeto` puede consultar su propietario y si pertenece al jugador local."},"1913":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-13","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#propietario","content":"El nombre concreto de la propiedad debe consultarse en la API de Eco de tu versión; conceptualmente, la propiedad representa la relación objeto → `Jugador` propietario."},"1914":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-14","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#autoridad-no-es-lo-mismo-que-visibilidad","content":"Todos los jugadores de un canal pueden recibir un objeto y sus eventos. Eso no significa que todos deban tener permiso para decidir su estado."},"1915":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-15","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#autoridad-no-es-lo-mismo-que-visibilidad","content":"Un patrón seguro es:"},"1916":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-16","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#autoridad-no-es-lo-mismo-que-visibilidad","content":"Una RFC recibida correctamente no convierte sus parámetros en datos confiables. La validación de reglas de juego debe permanecer en la autoridad real."},"1917":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-17","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#transferencia-entre-canales","content":"Eco conserva la capacidad heredada de TNet de transferir un objeto a otro canal. Durante el proceso la representación local puede quedar temporalmente en estado de transferencia y el objeto puede recibir un nuevo identificador en el canal destino."},"1918":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-18","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#transferencia-entre-canales","content":"El cambio de canal no debe tratarse como un simple cambio de `channelID` local. El servidor coordina la operación para que los clientes de origen y destino reciban la transición correcta."},"1919":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-19","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#jerarquías-de-objetos","content":"Un objeto puede tener relación jerárquica con otros objetos de red. Al transferir una jerarquía, los clientes que entren posteriormente en el canal destino no necesariamente reconstruirán automáticamente todas las relaciones que dependían de la jerarquía anterior."},"1920":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-20","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#jerarquías-de-objetos","content":"Cuando la jerarquía sea relevante para gameplay, conviene sincronizar explícitamente la relación padre-hijo o una ruta equivalente después de la transferencia."},"1921":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-21","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#eliminación","content":"`Objeto.DestroySelf()` representa una destrucción de red, no sólo un `Destroy(gameObject)` local. El servidor elimina el objeto de su estado y los clientes reciben la orden correspondiente."},"1922":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-22","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#eliminación","content":"Existe también una variante retardada para casos donde necesitas dejar tiempo para completar otras operaciones."},"1923":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-23","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#eliminación","content":"Destruir directamente el GameObject puede dejar a otros participantes con una representación fantasma. Para entidades registradas utiliza el ciclo de destrucción de `Objeto`."},"1924":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-24","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#relación-con-tnet","content":"DeepWiki identifica esta misma separación en TNet mediante `TNObject`, `owner`, `ownerID`, `uid`, `parent` y transferencia entre canales. Eco conserva el concepto porque forma parte del modelo de red, pero los tipos y nombres públicos son los de Eco."},"1925":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-25","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#relación-con-tnet","content":"Modelo completo de las entidades de red."},"1926":{"id":"/docs/red/v1/modelo/ownership-y-transferencia-26","page_id":"/docs/red/v1/modelo/ownership-y-transferencia","tags":[],"type":"text","url":"/docs/red/v1/modelo/ownership-y-transferencia#relación-con-tnet","content":"Ejemplo práctico de varios canales simultáneos."},"1927":{"id":"/docs/red/v1/persistencia/canales","page_id":"/docs/red/v1/persistencia/canales","type":"page","content":"Canales persistentes","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/canales"},"1928":{"id":"/docs/red/v1/persistencia/canales-0","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#canales-persistentes","content":"Canales persistentes"},"1929":{"id":"/docs/red/v1/persistencia/canales-1","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#canal-normal","content":"Canal normal"},"1930":{"id":"/docs/red/v1/persistencia/canales-2","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#canal-persistente","content":"Canal persistente"},"1931":{"id":"/docs/red/v1/persistencia/canales-3","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#persistente-no-significa-inmortal","content":"Persistente no significa inmortal"},"1932":{"id":"/docs/red/v1/persistencia/canales-4","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#memoria","content":"Memoria"},"1933":{"id":"/docs/red/v1/persistencia/canales-5","page_id":"/docs/red/v1/persistencia/canales","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Elegir persistencia"},"1934":{"id":"/docs/red/v1/persistencia/canales-6","page_i