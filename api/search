/v1/guias/multiples-canales-9","page_id":"/docs/red/v1/guias/multiples-canales","type":"heading","tags":[],"url":"/docs/red/v1/guias/multiples-canales#ejemplo-mundo--partida","content":"Ejemplo: mundo + partida"},"517":{"id":"/docs/red/v1/guias/multiples-canales-10","page_id":"/docs/red/v1/guias/multiples-canales","type":"heading","tags":[],"url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Cuándo utilizar canales"},"518":{"id":"/docs/red/v1/guias/multiples-canales-11","page_id":"/docs/red/v1/guias/multiples-canales","type":"heading","tags":[],"url":"/docs/red/v1/guias/multiples-canales#relación-con-tnet","content":"Relación con TNet"},"519":{"id":"/docs/red/v1/guias/multiples-canales-12","page_id":"/docs/red/v1/guias/multiples-canales","type":"heading","tags":[],"url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Referencias"},"520":{"id":"/docs/red/v1/guias/multiples-canales-13","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#varios-canales-simultáneos","content":"Una de las características importantes del modelo de Eco es que un cliente puede pertenecer a varios canales al mismo tiempo. La pertenencia a un canal no sustituye a la anterior: cada `Canal` mantiene su propio contexto de red dentro de la misma conexión."},"521":{"id":"/docs/red/v1/guias/multiples-canales-14","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#varios-canales-simultáneos","content":"Un cliente puede estar conectado una sola vez al servidor y participar simultáneamente en varios canales. Cada canal representa un ámbito independiente de estado compartido."},"522":{"id":"/docs/red/v1/guias/multiples-canales-15","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#escenario","content":"Un caso práctico puede ser un juego que mantiene:"},"523":{"id":"/docs/red/v1/guias/multiples-canales-16","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#escenario","content":"El jugador puede permanecer en `Mundo` mientras entra y sale de `Partida` y `Evento`."},"524":{"id":"/docs/red/v1/guias/multiples-canales-17","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#entrar-en-varios-canales","content":"El cliente puede solicitar sucesivas entradas sin abandonar el canal anterior:"},"525":{"id":"/docs/red/v1/guias/multiples-canales-18","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#entrar-en-varios-canales","content":"Las solicitudes de entrada quedan registradas como pendientes hasta que Eco recibe la confirmación correspondiente. Esto permite que el estado local diferencie entre un canal ya activo y uno que todavía está completando su incorporación."},"526":{"id":"/docs/red/v1/guias/multiples-canales-19","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#consultar-la-pertenencia","content":"También puede comprobarse si una entrada concreta sigue pendiente:"},"527":{"id":"/docs/red/v1/guias/multiples-canales-20","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#los-canales-no-son-sockets","content":"La presencia en varios canales no implica crear varias conexiones TCP o UDP."},"528":{"id":"/docs/red/v1/guias/multiples-canales-21","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#los-canales-no-son-sockets","content":"El transporte sigue perteneciendo a la conexión. El canal determina el contexto de estado y los destinatarios que corresponden a esa parte de la sesión."},"529":{"id":"/docs/red/v1/guias/multiples-canales-22","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#los-canales-no-son-sockets","content":"No mantengas una conexión por canal salvo que exista una necesidad específica fuera del modelo de Eco. Normalmente los canales deben utilizarse como ámbitos lógicos dentro de una misma conexión."},"530":{"id":"/docs/red/v1/guias/multiples-canales-23","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#objetos-y-canales","content":"Los objetos de red tienen un `channelID` y su identidad completa utiliza también el contexto del canal. Por eso dos objetos con el mismo identificador local pueden pertenecer a canales diferentes sin representar la misma entidad de red."},"531":{"id":"/docs/red/v1/guias/multiples-canales-24","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#objetos-y-canales","content":"Para operaciones de red, el canal forma parte del contexto necesario para localizar correctamente el objeto."},"532":{"id":"/docs/red/v1/guias/multiples-canales-25","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#salir-de-un-canal","content":"Abandonar un canal no desconecta al cliente del servidor ni afecta automáticamente a los demás canales:"},"533":{"id":"/docs/red/v1/guias/multiples-canales-26","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#salir-de-un-canal","content":"Después de la salida:"},"534":{"id":"/docs/red/v1/guias/multiples-canales-27","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#salir-de-un-canal","content":"También existe `LeaveAllChannels()` para solicitar la salida de todos los canales activos."},"535":{"id":"/docs/red/v1/guias/multiples-canales-28","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cambiar-el-nivel-de-un-canal","content":"El nivel asociado a un canal es parte de su estado. Eco permite solicitar el cambio de nivel para un canal concreto:"},"536":{"id":"/docs/red/v1/guias/multiples-canales-29","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cambiar-el-nivel-de-un-canal","content":"Esto debe entenderse como una operación coordinada del canal y no simplemente como una llamada local a `SceneManager.LoadScene`."},"537":{"id":"/docs/red/v1/guias/multiples-canales-30","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cambiar-el-nivel-de-un-canal","content":"El cambio de nivel forma parte además del motivo por el que Eco mantiene protecciones durante la entrada a canales: mientras la transición está en curso, evita que determinadas operaciones de la escena anterior se ejecuten fuera de contexto."},"538":{"id":"/docs/red/v1/guias/multiples-canales-31","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#ejemplo-mundo--partida","content":"Un patrón habitual es mantener un canal persistente para el mundo y otro temporal para una partida:"},"539":{"id":"/docs/red/v1/guias/multiples-canales-32","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#ejemplo-mundo--partida","content":"La lógica puede tratar cada canal de forma independiente:"},"540":{"id":"/docs/red/v1/guias/multiples-canales-33","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#ejemplo-mundo--partida","content":"Esto resulta especialmente útil cuando diferentes partes del juego necesitan ciclos de vida distintos."},"541":{"id":"/docs/red/v1/guias/multiples-canales-34","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Un canal es apropiado cuando quieres separar un ámbito de estado compartido entre participantes."},"542":{"id":"/docs/red/v1/guias/multiples-canales-35","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Necesidad"},"543":{"id":"/docs/red/v1/guias/multiples-canales-36","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"¿Canal?"},"544":{"id":"/docs/red/v1/guias/multiples-canales-37","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Mundo persistente compartido"},"545":{"id":"/docs/red/v1/guias/multiples-canales-38","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Sí"},"546":{"id":"/docs/red/v1/guias/multiples-canales-39","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Partida independiente"},"547":{"id":"/docs/red/v1/guias/multiples-canales-40","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Sí"},"548":{"id":"/docs/red/v1/guias/multiples-canales-41","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Evento temporal con jugadores concretos"},"549":{"id":"/docs/red/v1/guias/multiples-canales-42","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-util