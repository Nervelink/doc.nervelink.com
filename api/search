/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`ProtocoloTcp`"},"754":{"id":"/docs/red/v1/referencia/equivalencias-46","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`TcpProtocol`"},"755":{"id":"/docs/red/v1/referencia/equivalencias-47","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Transporte TCP"},"756":{"id":"/docs/red/v1/referencia/equivalencias-48","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`ProtocoloUdp`"},"757":{"id":"/docs/red/v1/referencia/equivalencias-49","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`UdpProtocol`"},"758":{"id":"/docs/red/v1/referencia/equivalencias-50","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Transporte UDP"},"759":{"id":"/docs/red/v1/referencia/equivalencias-51","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`AutoSincronizar`"},"760":{"id":"/docs/red/v1/referencia/equivalencias-52","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`TNAutoSync`"},"761":{"id":"/docs/red/v1/referencia/equivalencias-53","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Sincronización automática"},"762":{"id":"/docs/red/v1/referencia/equivalencias-54","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"La equivalencia sirve para traducir conceptos, no para asumir compatibilidad literal de APIs."},"763":{"id":"/docs/red/v1/referencia/equivalencias-55","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"Por ejemplo, si un ejemplo de TNet habla de `TNObject`, el punto de partida equivalente en Eco es `Objeto`. A partir de ahí debe consultarse la API de Eco, ya que otros tipos y nombres pueden haber cambiado."},"764":{"id":"/docs/red/v1/referencia/equivalencias-56","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-nomenclatura","content":"La refactorización de Eco busca que los nombres estén alineados con la nomenclatura de Pandora. Esto permite que el código de red se integre con el resto del proyecto sin mantener permanentemente la terminología histórica de TNet."},"765":{"id":"/docs/red/v1/referencia/equivalencias-57","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"Una equivalencia de nombres no implica que las dos implementaciones tengan exactamente el mismo comportamiento. Eco puede haber incorporado refactorizaciones, cambios de arquitectura o funcionalidades propias."},"766":{"id":"/docs/red/v1/referencia/equivalencias-58","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"La referencia definitiva siempre debe ser el código actual de `Nervelink/eco`."},"767":{"id":"/docs/red/v1/referencia","page_id":"/docs/red/v1/referencia","type":"page","content":"Referencia","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referen