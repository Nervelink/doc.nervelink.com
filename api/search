 en la posición y rotación recibidas."},"442":{"id":"/docs/red/v1/ejemplos/auto-crear-19","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#rcr-local","content":"Esto ilustra el patrón de creación remota de Eco: la operación se describe con datos serializables y cada cliente reconstruye la entidad localmente."},"443":{"id":"/docs/red/v1/ejemplos/auto-crear-20","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#fuente","content":"Implementación actual del ejemplo."},"444":{"id":"/docs/red/v1/ejemplos/auto-crear-21","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#fuente","content":"Workflow completo de ciclo de vida de objetos."},"445":{"id":"/docs/red/v1/ejemplos/auto-sincronizar","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"page","content":"AutoSincronizar","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar"},"446":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-0","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar","content":"Sincronización automática de campos y propiedades de Unity mediante reflexión."},"447":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-1","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"AutoSincronizar"},"448":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-2","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"Configuración"},"449":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-3","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#modelo-de-actualización","cont