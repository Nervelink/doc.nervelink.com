:"Implementación actual de las utilidades UPnP."},"529":{"id":"/docs/red/v1/comunicacion/destinatarios","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"page","content":"Destinatarios","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/destinatarios"},"530":{"id":"/docs/red/v1/comunicacion/destinatarios-0","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios","content":"Cómo Eco determina quién recibe un mensaje dentro de un canal."},"531":{"id":"/docs/red/v1/comunicacion/destinatarios-1","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Destinatarios"},"532":{"id":"/docs/red/v1/comunicacion/destinatarios-2","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Contexto de canal"},"533":{"id":"/docs/red/v1/comunicacion/destinatarios-3","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivos habituales"},"534":{"id":"/docs/red/v1/comunicacion/destinatarios-4","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Propietario frente a canal"},"535":{"id":"/docs/red/v1/comunicacion/destinatarios-5","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Comunicación persistente"},"536":{"id":"/docs/red/v1/comunicacion/destinatarios-6","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#elección-práctica","content":"Elección práctica"},"537"