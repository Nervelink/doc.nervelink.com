s/red/v1/modelo/objetos-42","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"cambios de escena;"},"3322":{"id":"/docs/red/v1/modelo/objetos-43","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"creación dinámica;"},"3323":{"id":"/docs/red/v1/modelo/objetos-44","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"transferencia entre canales;"},"3324":{"id":"/docs/red/v1/modelo/objetos-45","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"destrucción."},"3325":{"id":"/docs/red/v1/modelo/objetos-46","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#destrucción-y-transferencia","content":"`onDestroy` y `onTransfer` permiten observar eventos del ciclo de vida de red:"},"3326":{"id":"/docs/red/v1/modelo/objetos-47","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#destrucción-y-transferencia","content":"Consulta Instanciar y destruir objetos y Transferir un objeto entre canales."},"3327":{"id":"/docs/red/v1/modelo/objetos-48","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#qué-no-debe-hacer-un-objeto","content":"`Objeto` no debería convertirse en tu sistema de gameplay. Utilízalo como identidad, ownership, estado y puerta de entrada a la comunicación; coloca reglas de gameplay en `Componente`."},"3328":{"id":"/docs/red/v1/modelo/objetos-49","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Eco"},"3329":{"id":"/docs/red/v1/modelo/objetos-50","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"TNet"},"3330":{"id":"/docs/red/v1/modelo/objetos-51","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Función"},"3331":{"id":"/docs/red/v1/modelo/objetos-52","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`Objeto`"},"3332":{"id":"/docs/red/v1/modelo/objetos-53","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`TNObject`"},"3333":{"id":"/docs/red/v1/modelo/objetos-54","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Identidad y estado de red"},"3334":{"id":"/docs/red/v1/modelo/objetos-55","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`Componente`"},"3335":{"id":"/docs/red/v1/modelo/objetos-56","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`TNBehaviour`"},"3336":{"id":"/docs/red/v1/modelo/objetos-57","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Comportamiento asociado"},"3337":{"id":"/docs/red/v1/modelo/objetos-58","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`owner`"},"3338":{"id":"/docs/red/v1/modelo/objetos-59","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"`owner`"},"3339":{"id":"/docs/red/v1/modelo/objetos-60","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet"