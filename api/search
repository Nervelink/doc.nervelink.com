/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Workflow para obtener una primera fotografía del estado de red."},"1550":{"id":"/docs/red/v1/ejemplos/varios-canales","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"page","content":"Varios canales","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/varios-canales"},"1551":{"id":"/docs/red/v1/ejemplos/varios-canales-0","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales","content":"Ejemplo práctico de una única conexión participando en varios canales simultáneamente."},"1552":{"id":"/docs/red/v1/ejemplos/varios-canales-1","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Varios canales"},"1553":{"id":"/docs/red/v1/ejemplos/varios-canales-2","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#modelo","content":"Modelo"},"1554":{"id":"/docs/red/v1/ejemplos/varios-canales-3","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Entrar en varios canales"},"1555":{"id":"/docs/red/v1/ejemplos/varios-canales-4","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Datos por canal"},"1556":{"id":"/docs/red/v1/ejemplos/varios-canales-5","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Objetos por canal"},"1557":{"id":"/docs/red/v1/ejemplos/varios-canales-6","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"Salir de un canal"},"1558":{"id":"/docs/red/v1/ejemplos/varios-canales-7","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#patrón-recomendado","content":"Patrón recomendado"},"1559":{"id":"/docs/red/v1/ejemplos/varios-canales-8","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Mantén el contexto explícito"},"1560":{"id":"/docs/red/v1/ejemplos/varios-canales-9","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Pasa el canal a las operaciones"},"1561":{"id":"/docs/red/v1/ejemplos/varios-canales-10","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Mantén los objetos ligados a su canal"},"1562":{"id":"/docs/red/v1/ejemplos/varios-canales-11","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Relación con TNet"},"1563":{"id":"/docs/red/v1/ejemplos/varios-canales-12","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Eco permite que una misma conexión participe en varios canales al mismo tiempo. Este comportamiento es especialmente importante en arquitecturas donde el jugador mantiene un contexto persistente y, simultáneamente, participa en una partida, chat, lobby o sesión secundaria."},"1564":{"id":"/docs/red/v1/ejemplos/varios-canales-13","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"`Eco.idUltimoCanal` existe como ayuda de compatibilidad y para determinados callbacks. Cuando un jugador está en varios canales, especifica siempre el `idCanal` de la operación."},"1565":{"id":"/docs/red/v1/ejemplos/varios-canales-14","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Comprueba cada canal por separado:"},"1566":{"id":"/docs/red/v1/ejemplos/varios-canales-15","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Nunca asumas que `ObtenerDatosCanal` se refiere al último canal utilizado: recibe explícitamente el ID."},"1567":{"id":"/docs/red/v1/ejemplos/varios-canales-16","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Los objetos tienen su propio `channelID`."},"1568":{"id":"/docs/red/v1/ejemplos/varios-canales-17","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Las operaciones de instanciación y envío deben utilizar el canal del objeto o el canal explícito del contexto."},"1569":{"id":"/docs/red/v1/ejemplos/varios-canales-18","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"La conexión continúa activa y el cliente puede seguir participando en los demás canales."},"1570":{"id":"/docs/red/v1/ejemplos/varios-canales-19","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Guarda el ID del canal en el sistema que representa ese contexto (`mundo`, `partida`, `chat`, etc.)."},"1571":{"id":"/docs/red/v1/ejemplos/varios-canales-20","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Evita depender de variables globales como `idUltimoCanal` para decidir dónde se ejecuta una operación."},"1572":{"id":"/docs/red/v1/ejemplos/varios-canales-21","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Usa `objeto.channelID` como fuente de verdad para operaciones específicas de una entidad."},"1573":{"id":"/docs/red/v1/ejemplos/varios-canales-22","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"La documentación histórica de TNet ya contemplaba múltiples canales, pero Eco lo incorpora como una capacidad fundamental del runtime actual y la expone mediante su fachada `Eco`."},"1574":{"id":"/docs/red/v1/ejemplos/varios-canales-23","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Modelo completo de canales y pertenencia."},"1575":{"id":"/docs/red/v1/ejemplos/varios-canales-24","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"API de la fachada para trabajar con varios canales."},"1576":{"id":"/docs/red/v1/fundamentos/arquitectura","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"page","content":"Arquitectura","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/arquitectura"},"1577":{"id":"/docs/red/v1/fundamentos/arquitectura-0","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura","content":"Cómo se relacionan las capas de Eco y cómo fluye la información entre ellas."},"1578":{"id":"/docs/red/v1/fundamentos/arquitectura-1","page_id":"/docs/red/v1/fundamentos/arquitectur