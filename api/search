/v1/ejemplos/auto-crear-8","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#persistencia","content":"Persistencia"},"565":{"id":"/docs/red/v1/ejemplos/auto-crear-9","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#rcr-local","content":"RCR local"},"566":{"id":"/docs/red/v1/ejemplos/auto-crear-10","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#fuente","content":"Fuente"},"567":{"id":"/docs/red/v1/ejemplos/auto-crear-11","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#autocrear","content":"`AutoCrear` es un helper que espera a que el cliente termine de entrar en un canal y crea después un prefab de red en la posición del `GameObject` que contiene el componente."},"568":{"id":"/docs/red/v1/ejemplos/auto-crear-12","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#configuración","content":"Cuando `channelID` es menor que `1`, utiliza el último canal registrado por Eco. En proyectos multicanal es preferible establecer el canal explícitamente."},"569":{"id":"/docs/red/v1/ejemplos/auto-crear-13","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#resolver-canal","content":"Si no se ha indicado un canal, toma el último canal registrado por Eco."},"570":{"id":"/docs/red/v1/ejemplos/auto-crear-14","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#esperar-disponibilidad","content":"Espera mientras Eco se está uniendo a canales o mientras el canal indicado todavía no está activo."},"571":{"id":"/docs/red/v1/ejemplos/auto-crear-15","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#crear","content":"Llama a `Eco.Instanciar(...)` con la posición y rotación del objeto."},"572":{"id":"/docs/red/v1/ejemplos/auto-crear-16","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#eliminar-helper","content":"El `AutoCrear` original se destruye porque su trabajo ha terminado."},"573":{"id":"/docs/red/v1/ejemplos/auto-crear-17","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#persistencia","content":"`persistent = false` es apropiado para avatares o entidades ligadas al jugador. Usa `true` cuando la entidad deba permanecer en el canal aunque abandone su creador."},"574":{"id":"/docs/red/v1/ejemplos/auto-crear-18","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#rcr-local","content":"El ejemplo registra una RCR mediante `[RCR]` para crear el prefab en la posición y rotación recibidas."},"575":{"id":"/docs/red/v1/ejemplos/auto-crear-19","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#rcr-local","content":"Esto ilustra el patrón de creación remota de Eco: la operación se describe con datos serializables y cada cliente reconstruye la entidad localmente."},"576":{"id":"/docs/red/v1/ejemplos/auto-crear-20","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#fuente","content":"Implementación actual del ejemplo."},"577":{"id":"/docs/red/v1/ejemplos/auto-crear-21","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear#fuente","content":"Workflow completo de ciclo de vida de objetos."},"578":{"id":"/docs/red/v1/ejemplos/auto-sincronizar","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"page","content":"AutoSincronizar","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar"},"579":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-0","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar","content":"Sincronización automática de campos y propiedades de Unity mediante reflexión."},"580":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-1","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"AutoSincronizar"},"581":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-2","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"Configuración"},"582":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-3","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#modelo-de-actualización","content":"Modelo de actualización"},"583":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-4","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#frecuencia","content":"Frecuencia"},"584":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-5","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#fiabilidad","content":"Fiabilidad"},"585":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-6","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#autoridad","content":"Autoridad"},"586":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-7","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#persistencia","content":"Persistencia"},"587":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-8","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#fuente","content":"Fuente"},"588":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-9","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"`AutoSincronizar` sincroniza automáticamente una lista de campos o propiedades de un componente asociado a un `Objeto`."},"589":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-10","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"Es una herramienta de conveniencia y prototipado, no un sustituto universal de una arquitectura de sincronización específica."},"590":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-11","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"Cada entrada contiene:"},"591":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-12","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"El componente localiza el campo o propiedad mediante reflexión al iniciar."},"592":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-13","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#modelo-de-actualización","content":"El sistema no envía actualizaciones cuando los valores no han cambiado."},"593":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-14","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#frecuencia","content":"`updatesPerSecond` limita la frecuencia de comprobación."},"594":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-15","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#frecuencia","content":"Con `0`, el bucle periódico no envía actualizaciones; los valores se pueden entregar a jugadores nuevos mediante el mecanismo específico de entrada."},"595":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-16","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#fiabilidad","content":"`isImportant` determina el camino de transporte utilizado:"},"596":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-17","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#fiabilidad","content":"Usa el segundo caso para datos frecuentes donde perder valores intermedios sea aceptable."},"597":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-18","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autoridad","content":"`onlyOwnerCanSync` limita el envío al propietario del objeto."},"598":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-19","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autoridad","content":"Es una buena configuración por defecto para evitar que varios clientes intenten publicar el mismo estado."},"599":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-20","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#persistencia","content":"`isSavedOnServer` determina si la actualización se guarda como estado del servidor. Si está desactivado, el componente registra un callback de entrada y envía el estado al jugador nuevo directamente."},"600":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-21","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#persistencia","content":"`AutoSincronizar` usa reflexión para leer y escribir las propiedades. Para unidades con actualización frecuente, define una sincronización especializada en lugar de aumentar indiscriminadamente `updatesPerSecond`."},"601":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-22","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#fuente","content":"Implementación actual."},"602":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-23","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#fuente","content":"Modelo de sincronización de estado de Eco."},"603":{"id":"/docs/red/v1/ejemplos/auto-unirse","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"page","content":"AutoUnirse","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse"},"604":{"id":"/docs/red/v1/ejemplos/auto-unirse-0","page_id":"/docs/red/v1/ejemplos/auto-unirse","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-unirse","content":"Conexión y entrada automática a un canal mediante el componente AutoUnirse."},"605":{"id":"/docs/red/v1/ejemplos/auto-unirse-1","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse#autounirse","content":"AutoUnirse"},"606":{"id":"/docs/red/v1/ejemplos/auto-unirse-2","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse#configuración","content":"Configuración"},"607":{"id":"/docs/red/v1/ejemplos/auto-unirse-3","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse#flujo","content":"Flujo"},"608":{"id":"/docs/red/v1/ejemplos/auto-unirse-4","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse#arranque","content":"Arranque"},"609":{"id":"/docs/red/v1/ejemplos/auto-unirse-5","page_id":"/docs/red/v1/ejemplos/auto-unirse","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-unirse#conexión","content":"Conexión"},"610":{"id":"/docs/red/v1/