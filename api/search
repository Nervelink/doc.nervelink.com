/v1/transporte/tcp-udp-18","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"La elección depende de la semántica del mensaje:"},"4674":{"id":"/docs/red/v1/transporte/tcp-udp-19","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Característica"},"4675":{"id":"/docs/red/v1/transporte/tcp-udp-20","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"TCP"},"4676":{"id":"/docs/red/v1/transporte/tcp-udp-21","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"UDP"},"4677":{"id":"/docs/red/v1/transporte/tcp-udp-22","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Entrega fiable"},"4678":{"id":"/docs/red/v1/transporte/tcp-udp-23","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"4679":{"id":"/docs/red/v1/transporte/tcp-udp-24","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"4680":{"id":"/docs/red/v1/transporte/tcp-udp-25","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Orden de llegada"},"4681":{"id":"/docs/red/v1/transporte/tcp-udp-26","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"4682":{"id":"/docs/red/v1/transporte/tcp-udp-27","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No garantizado"},"4683":{"id":"/docs/red/v1/transporte/tcp-udp-28","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Retransmisión"},"4684":{"id":"/docs/red/v1/transporte/tcp-udp-29","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"4685":{"id":"/docs/red/v1/transporte/tcp-udp-30","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"4686":{"id":"/docs/red/v1/transporte/tcp-udp-31","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Latencia potencial"},"4687":{"id":"/docs/red/v1/transporte/tcp-udp-32","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Mayor bajo pérdida/congestión"},"4688":{"id":"/docs/red/v1/transporte/tcp-udp-33","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Menor para tráfico tolerante a pérdida"},"4689":{"id":"/docs/red/v1/transporte/tcp-udp-34","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Estado crítico"},"4690":{"id":"/docs/red/v1/transporte/tcp-udp-35","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Adecuado"},"4691":{"id":"/docs/red/v1/transporte/tcp-udp-36","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No suele ser adecuado"},"4692":{"id":"/docs/red/v1/transporte/tcp-udp-37","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Actualizaciones frecuentes"},"4693":{"id":"/docs/red/v1/transporte/tcp-udp-38","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Puede ser adecuado"},"4694":{"id":"/docs/red/v1/transporte/tcp-udp-39","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Suele ser más apropiado"},"4695":{"id":"/docs/red/v1/transporte/tcp-udp-40","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No se debe elegir UDP simplemente por ser más rápido: si el dato necesita entrega garantizada, hay que utilizar un mecanismo fiable."},"4696":{"id":"/docs/red/v1/transporte/tcp-udp-41","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"Eco abstrae gran parte de esta decisión detrás de sus operaciones de envío. `Send` representa el camino normal, mientras que `SendQuickly` permite utilizar el camino optimizado para datos donde la fiabilidad completa no sea necesaria."},"4697":{"id":"/docs/red/v1/transporte/tcp-udp-42","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"La capa de gameplay no debería construir datagramas manualmente salvo que esté implementando una extensión de transporte."},"4698":{"id":"/docs/red/v1/transporte/tcp-udp-43","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"`ClienteJuego.noDelay` permite activar o desactivar el algoritmo de Nagle. Activarlo puede reducir la latencia de pequeños mensajes a costa de aumentar el tráfico."},"4699":{"id":"/docs/red/v1/transporte/tcp-udp-44","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"La misma configuración se comunica al servidor para mantener el comportamiento coherente del socket TCP."},"4700":{"id":"/docs/red/v1/transporte/tcp-udp-45","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"`ServidorJuego` puede abrir un puerto TCP y, opcionalmente, un puerto UDP al arrancar."},"4701":{"id":"/docs/red/v1/transporte/tcp-udp-46","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"El puerto UDP sólo se activa cuando se proporciona uno válido durante el arranque."},"4702":{"id":"/docs/red/v1/transporte/tcp-udp-47","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"La disponibilidad de UDP depende de la plataforma y de las compilaciones de Eco. Algunas configuraciones, como determinados entornos antiguos de Unity o modos de modificación, deshabilitan explícitamente UDP."},"4703":{"id":"/docs/red/v1/transporte/tcp-udp-48","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Por eso la aplicación debe consultar la disponibilidad real (`canUseUDP`) en lugar de asumir que UDP siempre está disponible."},"4704":{"id":"/docs/red/v1/transporte/tcp-udp-49","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El transporte no cambia el significado de un `Paquete`."},"4705":{"id":"/docs/red/v1/transporte/tcp-udp-50","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El mismo concepto de protocolo puede utilizar distintas rutas de transporte según el tipo de mensaje."},"4706":{"id":"/docs/red/v1/transporte/tcp-udp-51","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"El modelo corresponde al de los protocolos TCP y UDP de TNet, pero Eco utiliza `ProtocoloTcp`, `ProtocoloUdp`, `ClienteJuego` y `ServidorJuego` como API interna."},"4707":{"id":"/docs/red/v1/transporte/tcp-udp-52","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión cliente de TCP, UDP y envío de paquetes."},"4708":{"id":"/docs/red/v1/transporte/tcp-udp-53","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión servidor de listeners TCP/UDP."},"4709":{"id":"/docs/red/v1/transporte/tcp-udp-54","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Repositorio upstream."},"4710":{"id":"/docs/red/v1/referencia/api/bajo-nivel","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"page","content":"APIs de bajo nivel","breadcrumbs":["Docs","Red","Red","Contenido","Referencia","API"],"tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel"},"4711":{"id":"/docs/red/v1/referencia/api/bajo-nivel-0","page_id":"/docs/red/v1/referencia/api/bajo-nivel","tags":[],"type":"text","url":"/docs/red/v1/referencia/api/bajo-nivel","content":"Primitivas internas de Eco para paquetes, buffers, callbacks, caché, serialización y transporte personalizado."},"4712":{"id":"/docs/red/v1/referencia/api/bajo-nivel-1","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#apis-de-bajo-nivel","content":"APIs de bajo nivel"},"4713":{"id":"/docs/red/v1/referencia/api/bajo-nivel-2","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#capas","content":"Capas"},"4714":{"id":"/docs/red/v1/referencia/api/bajo-nivel-3","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#paquete","content":"Paquete"},"4715":{"id":"/docs/red/v1/referencia/api/bajo-nivel-4","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#buffer","content":"Buffer"},"4716":{"id":"/docs/red/v1/referencia/api/bajo-nivel-5","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#rfc-y-retorno","content":"RFC y retorno"},"4717":{"id":"/docs/red/v1/referencia/api/bajo-nivel-6","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#caché-y-archivos","content":"Caché y archivos"},"4718":{"id":"/docs/red/v1/referencia/api/bajo-nivel-7","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#tiempo-y-diagnóstico","content":"Tiempo y diagnóstico"},"4719":{"id":"/docs/red/v1/referencia/api/bajo-nivel-8","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#conexiones-personalizadas","content":"Conexiones personalizadas"},"4720":{"id":"/docs/red/v1/referencia/api/bajo-nivel-9","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#cuándo-bajar-de-nivel","content":"Cuándo bajar de nivel"},"4721":{"id":"/docs/red/v1/referencia/api/bajo-nivel-10","page_id":"/docs/red/v1/referencia/api/bajo-nivel","type":"heading","tags":[],"url":"/docs/red/v1/referencia/api/bajo-nivel#código-fuente","content":"Código fuente"},"4722":{"id":"/docs/red/v1/referencia/api/bajo-nive