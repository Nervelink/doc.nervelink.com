do inicial y modelo mental de Eco."},"309":{"id":"/docs/red/v1/preguntas-frecuentes-88","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#por-dónde-debería-empezar-a-estudiar-eco","content":"Workflows prácticos para integrar la red en un proyecto."},"310":{"id":"/docs/red/v1/requisitos","page_id":"/docs/red/v1/requisitos","type":"page","content":"Requisitos y limitaciones","breadcrumbs":["Docs","Red","Red","Introducción"],"tags":[],"url":"/docs/red/v1/requisitos"},"311":{"id":"/docs/red/v1/requisitos-0","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos","content":"Compatibilidad, dependencias, restricciones y condiciones que afectan a una integración de Eco."},"312":{"id":"/docs/red/v1/requisitos-1","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#requisitos-y-limitaciones","content":"Requisitos y limitaciones"},"313":{"id":"/docs/red/v1/requisitos-2","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#matriz-de-integración","content":"Matriz de integración"},"314":{"id":"/docs/red/v1/requisitos-3","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#componentes-del-entorno","content":"Componentes del entorno"},"315":{"id":"/docs/red/v1/requisitos-4","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#transporte","content":"Transporte"},"316":{"id":"/docs/red/v1/requisitos-5","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#limitaciones-del-modelo","content":"Limitaciones del modelo"},"317":{"id":"/docs/red/v1/requisitos-6","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#rendimiento","content":"Rendimiento"},"318":{"id":"/docs/red/v1/requisitos-7","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],