s las simulaciones, pero es un excelente punto de partida para diseñar juegos cooperativos y competitivos con Eco."},"756":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-34","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Aislamiento y pertenencia de jugadores."},"757":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-35","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Datos y objetos que sobreviven a la sesión inmediata."},"758":{"id":"/docs/red/v1/fundamentos/conceptos","page_id":"/docs/red/v1/fundamentos/conceptos","type":"page","content":"Conceptos","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/conceptos"},"759":{"id":"/docs/red/v1/fundamentos/conceptos-0","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"760":{"id":"/docs/red/v1/fundamentos/conceptos-1","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Conceptos"},"761":{"id":"/docs/red/v1/fundamentos/conceptos-2","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"Conexión"},"762":{"id":"/docs/red/v1/fundamentos/conceptos-3","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Jugador"},"763":{"id":"/docs/red/v1/fundamentos/conceptos-4","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Canal"},"764":{"id":"/docs/red/v1/fundamentos/conceptos-5","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Objeto"},"765":{"id":"/docs/red/v1/fundamentos/conceptos-6","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Componente"},"766":{"id":"/docs/red/v1/fundamentos/conceptos-7","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"Propietario"},"767":{"id":"/docs/red/v1/fundamentos/conceptos-8","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Paquete"},"768":{"id":"/docs/red/v1/fundamentos/conceptos-9","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Buffer"},"769":{"id":"/docs/red/v1/fundamentos/conceptos-10","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Estado"},"770":{"id":"/docs/red/v1/fundamentos/conceptos-11","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"771":{"id":"/docs/red/v1/fundamentos/conceptos-12","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"772":{"id":"/docs/red/v1/fundamentos/conceptos-13","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#referencias","content":"Referencias"},"773":{"id":"/docs/red/v1/fundamentos/conceptos-14","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Eco organiza la red alrededor de unas pocas piezas fundamentales. Entender su relación evita confundir conexión, canal, jugador, objeto y componente."},"774":{"id":"/docs/red/v1/fundamentos/conceptos-15","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Una conexión representa la comunicación con el servidor; un jugador representa a un participante; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"775":{"id":"/docs/red/v1/fundamentos/conceptos-16","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. No define por sí sola qué objetos o estado debe conocer el cliente."},"776":{"id":"/docs/red/v1/fundamentos/conceptos-17","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. Sirve para identificar presencia, propiedad y destinatarios."},"777":{"id":"/docs/red/v1/fundamentos/conceptos-18","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Un mismo jugador puede participar simultáneamente en varios canales."},"778":{"id":"/docs/red/v1/fundamentos/conceptos-19","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"779":{"id":"/docs/red/v1/fundamentos/conceptos-20","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Esta separación permite mantener la identidad de red independiente de la funcionalidad concreta."},"780":{"id":"/docs/red/v1/fundamentos/conceptos-21","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"El propietario identifica al jugador que tiene autoridad sobre determinadas operaciones del objeto. La propiedad no implica que el objeto sea invisible para los demás participantes."},"781":{"id":"/docs/red/v1/fundamentos/conceptos-22","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Un `Paquete` representa una unidad del protocolo de Eco. Transporta comandos, eventos y datos entre clientes y servidor."},"782":{"id":"/docs/red/v1/fundamentos/conceptos-23","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"783":{"id":"/docs/red/v1/fundamentos/conceptos-24","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Eco distingue entre comunicar una acción y mantener un estado. Una RFC puede comunicar que algo ocurrió; un mecanismo de sincronización mantiene valores que deben converger entre participantes."},"784":{"id":"/docs/red/v1/fundamentos/conceptos-25","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Eco"},"785":{"id":"/docs/red/v1/fundamentos/conceptos-26","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"TNet"},"786":{"id":"/docs/red/v1/fundamentos/conceptos-27","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Función"},"787":{"id":"/docs/red/v1/fundamentos/conceptos-28","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Eco`"},"788":{"id":"/docs/red/v1/fundamentos/conceptos-29","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`TNManager`"},"789":{"id":"/docs/red/v1/fundamentos/conceptos-30","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Gestión principal del cliente"},"790":{"id":"/docs/red/v1/fundamentos/conceptos-31","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Jugador`"},"791":{"id":"/docs/red/v1/fundamentos/conceptos-32","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Player`"},"792":{"id":"/docs/red/v1/fundamentos/conceptos-33","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Participante de la sesión"},"793":{"id":"/docs/red/v1/fundamentos/conceptos-34","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Canal`"},"794":{"id":"/docs/red/v1/fundamentos/conceptos-35","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Channel` / `TNChannel`"},"795":{"id":"/d