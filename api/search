cia/canales-15","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Mundo persistente"},"3619":{"id":"/docs/red/v1/persistencia/canales-16","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Sí"},"3620":{"id":"/docs/red/v1/persistencia/canales-17","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Evento que debe desaparecer al terminar"},"3621":{"id":"/docs/red/v1/persistencia/canales-18","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"No"},"3622":{"id":"/docs/red/v1/persistencia/canales-19","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Lobby estable"},"3623":{"id":"/docs/red/v1/persistencia/canales-20","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Puede serlo"},"3624":{"id":"/docs/red/v1/persistencia/canales-21","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#referencias","content":"Uso de varios canales desde un único cliente."},"3625":{"id":"/docs/red/v1/persistencia/estado","page_id":"/docs/red/v1/persistencia/estado","type":"page","content":"Estado persistente","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/estado"},"3626":{"id":"/docs/red/v1/persistencia/estado-0","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"Estado persistente"},"3627":{"id":"/docs/red/v1/persistencia/estado-1","page_id":"/d