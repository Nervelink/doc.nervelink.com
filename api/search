id":"/docs/red/v1/guias/primer-cliente-9","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#intentar-enviar-antes-de-estar-conectado","content":"Intentar enviar antes de estar conectado"},"689":{"id":"/docs/red/v1/guias/primer-cliente-10","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#confundir-connect-con-ya-estoy-dentro-de-una-partida","content":"Confundir `Connect` con \"ya estoy dentro de una partida\""},"690":{"id":"/docs/red/v1/guias/primer-cliente-11","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#suponer-que-sólo-existe-un-canal","content":"Suponer que sólo existe un canal"},"691":{"id":"/docs/red/v1/guias/primer-cliente-12","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#siguiente-paso","content":"Siguiente paso"},"692":{"id":"/docs/red/v1/guias/primer-cliente-13","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Referencias"},"693":{"id":"/docs/red/v1/guias/primer-cliente-14","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Esta guía muestra el recorrido mínimo para conectar un cliente de Eco a un servidor y comprobar que la sesión está operativa."},"694":{"id":"/docs/red/v1/guias/primer-cliente-15","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Esta guía asume que ya conoces la estructura básica de Eco y que el proyecto incluye las partes de cliente necesarias. Para entender la arquitectura antes de escribir código, consulta Fundamentos."},"695":{"id":"/docs/red/v1/guias/primer-cliente-16","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#1-obtener-el-cliente","content":"La implementación de Eco concentra la gestión de sesión en `ClienteJuego`. La fachada que utilices desde tu proyecto debe proporcionar acceso a esa instancia según la arquitectura de Pandora."},"696":{"id":"/docs/red/v1/guias/primer-cliente-17","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#1-obtener-el-cliente","content":"Conceptualmente:"},"697":{"id":"/docs/red/v1/guias/primer-cliente-18","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#2-conectar","content":"El cliente puede conectarse a un servidor remoto mediante su endpoint de red."},"698":{"id":"/docs/red/v1/guias/primer-cliente-19","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#2-conectar","content":"En este punto comienza el ciclo de conexión y handshake. No asumas que la conexión está lista inmediatamente después de llamar a `Connect`."},"699":{"id":"/docs/red/v1/guias/primer-cliente-20","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#3-esperar-el-estado-conectado","content":"Comprueba el estado de la sesión antes de realizar operaciones que dependan del servidor."},"700":{"id":"/docs/red/v1/guias/primer-cliente-21","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#3-esperar-el-estado-conectado","content":"El cliente también mantiene estados separados para el intento de conexión y la entrada a canales."},"701":{"id":"/docs/red/v1/guias/primer-cliente-22","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#4-entrar-en-un-canal","content":"Una vez establecida la conexión, solicita la entrada en un canal."},"702":{"id":"/docs/red/v1/guias/primer-cliente-23","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#4-entrar-en-un-canal","content":"La operación es asíncrona desde el punto de vista del cliente. Eco mantiene la solicitud como pendiente hasta recibir la respuesta del servidor."},"703":{"id":"/docs/red/v1/guias/primer-cliente-24","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#4-entrar-en-un-canal","content":"Consulta Canales para conocer el modelo multi-canal y las restricciones de entrada y salida."},"704":{"id":"/docs/red/v1/guias/primer-cliente-25","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#5-comprobar-el-canal","content":"Cuando la respuesta de unión ha sido procesada puedes consultar la pertenencia:"},"705":{"id":"/docs/red/v1/guias/primer-cliente-26","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#5-comprobar-el-canal","content":"No utilices la existencia de una solicitud de unión como si significara que el cliente ya está dentro del canal."},"706":{"id":"/docs/red/v1/guias/primer-cliente-27","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#6-comprobar-la-comunicación","content":"A partir de este punto puedes crear objetos, enviar RFC o modificar datos de estado según las necesidades del juego."},"707":{"id":"/docs/red/v1/guias/primer-cliente-28","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#6-comprobar-la-comunicación","content":"La separación recomendada es:"},"708":{"id":"/docs/red/v1/guias/primer-cliente-29","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#7-desconectar-correctamente","content":"Cuando el juego termina la sesión, utiliza el mecanismo de desconexión de Eco para liberar la sesión y los recursos de transporte."},"709":{"id":"/docs/red/v1/guias/primer-cliente-30","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#7-desconectar-correctamente","content":"No es necesario abandonar manualmente cada canal para poder cerrar la conexión; la desconexión gestiona el estado de la sesión."},"710":{"id":"/docs/red/v1/guias/primer-cliente-31","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#intentar-enviar-antes-de-estar-conectado","content":"Un objeto puede existir localmente antes de que el cliente tenga un canal válido y una conexión utilizable. Comprueba siempre el estado antes de depender de una operación de red."},"711":{"id":"/docs/red/v1/guias/primer-cliente-32","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#confundir-connect-con-ya-estoy-dentro-de-una-partida","content":"Conectar establece la sesión con el servidor. Entrar en un canal es una operación distinta."},"712":{"id":"/docs/red/v1/guias/primer-cliente-33","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#suponer-que-sólo-existe-un-canal","content":"Eco permite mantener varios canales simultáneamente. No diseñes tu gestión de sesión como si `cliente.channels[0]` fuera necesariamente el único contexto de juego."},"713":{"id":"/docs/red/v1/guias/primer-cliente-34","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#siguiente-paso","content":"Continúa con Primer objeto para pasar de una conexión funcional a una entidad de red."},"714":{"id":"/docs/red/v1/guias/primer-cliente-35","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Referencia conceptual y de ciclo de vida de `ClienteJuego`."},"715":{"id":"/docs/red/v1/guias/primer-cliente-36","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Cómo se gestiona la pertenencia a canales."},"716":{"id":"/docs/red/v1/guias/primer-cliente-37","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Código fuente de la implementación actual."},"717":{"id":"/docs/red/v1/guias/primer-objeto","page_id":"/docs/red/v1/guias/primer-objeto","type":"page","content":"Primer objeto","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-objeto"},"718":{"id":"/docs/red/v1/guias/primer-objeto-0","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#primer-objeto","content":"Primer objeto"},"719":{"id":"/docs/red/v1/guias/primer-objeto-1","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#1-crear-la-entidad","content":"1\\. Crear la entidad"},"720":{"id":"/docs/red/v1/guias/primer-objeto-2","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#2-añadir-un-componente-de-red","content":"2\\. Añadir un componente de red"},"721":{"id":"/docs/red/v1/guias/primer-objeto-3","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#3-leer-y-modificar-estado","content":"3\\. Leer y modificar estado"},"722":{"id":"/docs/red/v1/guias/primer-objeto-4","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#4-comprobar-propiedad","content":"4\\. Comprobar propiedad"},"723":{"id":"/docs/red/v1/guias/primer-objeto-5","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#5-enviar-u