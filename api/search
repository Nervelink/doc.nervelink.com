red/v1/comunicacion/sincronizacion-7","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#4-propagación-step","content":"Propagación [step]"},"765":{"id":"/docs/red/v1/comunicacion/sincronizacion-8","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#5-cola-temporal-step","content":"Cola temporal [step]"},"766":{"id":"/docs/red/v1/comunicacion/sincronizacion-9","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#autoridad","content":"Autoridad"},"767":{"id":"/docs/red/v1/comunicacion/sincronizacion-10","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#qué-sincronizar","content":"Qué sincronizar"},"768":{"id":"/docs/red/v1/comunicacion/sincronizacion-11","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#autosincronizar","content":"`AutoSincronizar`"},"769":{"id":"/docs/red/v1/comunicacion/sincronizacion-12","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#frecuencia","content":"Frecuencia"},"770":{"id":"/docs/red/v1/comunicacion/sincronizacion-13","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Persistencia"},"771":{"id":"/docs/red/v1/comunicacion/sincronizacion-14","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#errores-habituales","content":"Errores habituales"},"772":{"id":"/docs/red/v1/comunicacion/sincronizacion-15","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#relación-con-tnet","content":"Relación con TNet"},"773":{"id":"/docs/red/v1/comunicacion/sincronizacion-16","page_id":"/docs/red/v1/comunicacion/sincronizacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Referencias"},"774":{"id":"/docs/red/v1/comunicacion/sincronizacion-17","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#sincronización","content":"La sincronización responde a una pregunta distinta de una RFC: &#x2A;*¿cómo hago que todos conozcan el estado actual de una entidad?**"},"775":{"id":"/docs/red/v1/comunicacion/sincronizacion-18","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#sincronización","content":"Una RFC representa normalmente un evento puntual. Un dato sincronizado representa el estado actual y puede necesitar volver a enviarse o reconstruirse para un jugador que entra más tarde."},"776":{"id":"/docs/red/v1/comunicacion/sincronizacion-19","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#modelo-de-datos","content":"Las operaciones principales son `Get` y `Set`."},"777":{"id":"/docs/red/v1/comunicacion/sincronizacion-20","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#1-estado-local-step","content":"Eco actualiza primero el `Nodo` local. Esto permite que el código que acaba de cambiar el dato lo vea inmediatamente."},"778":{"id":"/docs/red/v1/comunicacion/sincronizacion-21","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#2-comprobación-de-capacidad-step","content":"Se comprueba que el objeto tenga identidad válida, pertenezca a un contexto enviable y no esté atravesando una transición donde la transmisión todavía no sea posible."},"779":{"id":"/docs/red/v1/comunicacion/sincronizacion-22","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#3-comprobación-de-autoridad-step","content":"Si el llamador es propietario, puede distribuir el cambio. Si no lo es, la operación se dirige al propietario para que siga el flujo de autoridad."},"780":{"id":"/docs/red/v1/comunicacion/sincronizacion-23","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#4-propagación-step","content":"El cambio se comunica a los destinatarios y el estado puede actualizarse también en la representación persistente del servidor."},"781":{"id":"/docs/red/v1/comunicacion/sincronizacion-24","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#5-cola-temporal-step","content":"Si el objeto no puede enviar todavía, el cambio puede quedar pendiente hasta que la transmisión vuelva a estar disponible."},"782":{"id":"/docs/red/v1/comunicacion/sincronizacion-25","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#autoridad","content":"Esto evita que varios clientes actúen como fuente de verdad simultánea para una propiedad."},"783":{"id":"/docs/red/v1/comunicacion/sincronizacion-26","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#qué-sincronizar","content":"Vida, inventario, reglas de partida y cualquier valor cuyo estado actual deba ser consistente. Prioriza claridad y autoridad sobre frecuencia extrema."},"784":{"id":"/docs/red/v1/comunicacion/sincronizacion-27","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#qué-sincronizar","content":"Transformaciones o valores que cambian muchas veces por segundo pueden usar mecanismos rápidos si perder estados intermedios es aceptable."},"785":{"id":"/docs/red/v1/comunicacion/sincronizacion-28","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#qué-sincronizar","content":"Datos necesarios para reconstruir un objeto cuando aparece o cuando entra un jugador nuevo deben formar parte de un estado que pueda recuperarse."},"786":{"id":"/docs/red/v1/comunicacion/sincronizacion-29","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#autosincronizar","content":"`AutoSincronizar` automatiza parte de este trabajo para campos y propiedades de componentes de Unity. Su configuración incluye conceptos como frecuencia, persistencia y autoridad del propietario."},"787":{"id":"/docs/red/v1/comunicacion/sincronizacion-30","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#autosincronizar","content":"`AutoSincronizar` es útil para prototipos y propiedades sencillas. En sistemas de producción conviene controlar explícitamente qué datos viajan, quién los modifica y con qué frecuencia."},"788":{"id":"/docs/red/v1/comunicacion/sincronizacion-31","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#frecuencia","content":"Si una propiedad cambia a alta frecuencia, transmitir todos sus valores puede generar tráfico innecesario."},"789":{"id":"/docs/red/v1/comunicacion/sincronizacion-32","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#frecuencia","content":"`updatesPerSecond` establece una frecuencia máxima para el sistema automático."},"790":{"id":"/docs/red/v1/comunicacion/sincronizacion-33","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"La sincronización de estado y la persistencia no son lo mismo:"},"791":{"id":"/docs/red/v1/comunicacion/sincronizacion-34","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Concepto"},"792":{"id":"/docs/red/v1/comunicacion/sincronizacion-35","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Pregunta"},"793":{"id":"/docs/red/v1/comunicacion/sincronizacion-36","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Sincronización"},"794":{"id":"/docs/red/v1/comunicacion/sincronizacion-37","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"¿Quién necesita conocer el estado ahora?"},"795":{"id":"/docs/red/v1/comunicacion/sincronizacion-38","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Persistencia"},"796":{"id":"/docs/red/v1/comunicacion/sincronizacion-39","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"¿Debe poder reconstruirse el estado después?"},"797":{"id":"/docs/red/v1/comunicacion/sincronizacion-40","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"RFC guardada"},"798":{"id":"/docs/red/v1/comunicacion/sincronizacion-41","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"¿Debe reproducirse una operación al reconstruir?"},"799":{"id":"/docs/red/v1/comunicacion/sincronizacion-42","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#persistencia","content":"Consulta Persistencia cuando el objetivo sea sobrevivir a la ausencia de jugadores."},"800":{"id":"/docs/red/v1/comunicacion/sincronizacion-43","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#errores-habituales","content":"Si una unidad tiene `vida = 74`, no necesitas una RFC por cada cambio si lo único importante es que los clientes conozcan el valor actual. Sincroniza el estado."},"801":{"id":"/docs/red/v1/comunicacion/sincronizacion-44","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#errores-habituales","content":"La frecuencia debe depender de la percepción del jugador y de la necesidad real del sistema, no del `Update()` de Unity."},"802":{"id":"/docs/red/v1/comunicacion/sincronizacion-45","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#relación-con-tnet","content":"El modelo procede conceptualmente de `TNObject.Set/Get` y `TNAutoSync`, pero los nombres y el comportamiento deben comprobarse en la implementación de Eco."},"803":{"id":"/docs/red/v1/comunicacion/sincronizacion-46","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Identidad y datos del objeto."},"804":{"id":"/docs/red/v1/comunicacion/sincronizacion-47","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Cuándo una acción debe ser un evento remoto."},"805":{"id":"/docs/red/v1/comunicacion/sincronizacion-48","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Implementación práctica de este flujo."},"806":{"id":"/docs/red/v1/comunicacion/sincronizacion-49","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Cómo hacer que el estado sobreviva a la ausencia temporal de jugadores."},"807":{"id":"/docs/red/v1/ejemplos/auto-crear","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"page","content":"AutoCrear","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/auto-crear"},"808":{"id":"/docs/red/v1/ejemplos/auto-crear-0","page_id":"/docs/red/v1/ejemplos/auto-crear","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-crear","content":"Instanciación automática de un prefab en un canal después de completar la entrada."},"809":{"id":"/docs/red/v1/ejemplos/auto-crear-1","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#autocrear","content":"AutoCrear"},"810":{"id":"/docs/red/v1/ejemplos/auto-crear-2","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#configuración","content":"Configuración"},"811":{"id":"/docs/red/v1/ejemplos/auto-crear-3","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#flujo","content":"Flujo"},"812":{"id":"/docs/red/v1/ejemplos/auto-crear-4","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#resolver-canal","content":"Resolver canal"},"813":{"id":"/docs/red/v1/ejemplos/auto-crear-5","page_id":"/docs/red/v1/ejemplos/auto-crear","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-crear#esperar-disponibilidad","content":"Esperar disponibilidad"},"814":{"id":"/docs/red/v1/ejemplos/auto-crear-6","page_id":"/docs/red/v1/e