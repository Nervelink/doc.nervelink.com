omprobación periódica de propiedades. Para sistemas de producción conviene definir explícitamente qué estado existe, quién tiene autoridad, cuándo cambia, con qué frecuencia se transmite, si debe persistir y qué pérdida de paquetes es aceptable."},"271":{"id":"/docs/red/v1/comunicacion/sincronizacion-42","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#relación-con-tnet","content":"`AutoSincronizar` deriva conceptualmente de `TNAutoSync`, mientras que `Objeto.Set` y `Objeto.Get` corresponden al modelo de datos asociado al antiguo `TNObject`."},"272":{"id":"/docs/red/v1/comunicacion/sincronizacion-43","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#relación-con-tnet","content":"La fuente de verdad para Eco sigue siendo `Nervelink/eco`."},"273":{"id":"/docs/red/v1/comunicacion/sincronizacion-44","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Código fuente de la implementación actual."},"274":{"id":"/docs/red/v1/comunicacion/sincronizacion-45","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Repositorio upstream."},"275":{"id":"/docs/red/v1/comunicacion/sincronizacion-46","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Referencia generada sobre el TNet actual."},"276":{"id":"/docs/red/v1/guias/crear-partida","page_id":"/docs/red/v1/guias/crear-partida","type":"page","content":"Crear una partida","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/crear-partida"},"277":{"id":"/docs/red/v1/guias/crear-partida-0","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida","content":"Flujo completo para conectar jugadores, crear un canal y preparar el estado inicial de una partida."},"278":{"id":"/docs/red/v1/guias/crear-partida-1","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Crear una partida"},"279":{"id":"/docs/red/v1/guias/crear-partida-2","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"1\\. Conectar el cliente"},"280":{"id":"/docs/red/v1/guias/crear-partida-3","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"2\\. Crear o seleccionar el canal"},"281":{"id":"/docs/red/v1/guias/crear-partida-4","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"3\\. Esperar la entrada al canal"},"282":{"id":"/docs/red/v1/guias/crear-partida-5","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"4\\. Crear el estado de la partida"},"283":{"id":"/docs/red/v1/guias/crear-partida-6","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"5\\. Sincronizar el estado inicial"},"284":{"id":"/docs/red/v1/guias/crear-partida-7","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"6\\. Enviar acciones de juego"},"285":{"id":"/docs/red/v1/guias/crear-partida-8","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"7\\. Un segundo jugador entra"},"286":{"id":"/docs/red/v1/guias/crear-partida-9","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"8\\. Finalizar la partida"},"287":{"id":"/docs/red/v1/guias/crear-partida-10","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#flujo-completo","content":"Flujo completo"},"288":{"id":"/docs/red/v1/guias/crear-partida-11","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#errores-habituales","content":"Errores habituales"},"289":{"id":"/docs/red/v1/guias/crear-partida-12","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Crear objetos antes de completar la unión"},"290":{"id":"/docs/red/v1/guias/crear-partida-13","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Utilizar RFC para representar todo el estado"},"291":{"id":"/docs/red/v1/guias/crear-partida-14","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Confundir desconexión con salida del canal"},"292":{"id":"/docs/red/v1/guias/crear-partida-15","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"No definir la autoridad"},"293":{"id":"/docs/red/v1/guias/crear-partida-16","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Véase también"},"294":{"id":"/docs/red/v1/guias/crear-partida-17","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Una partida en Eco puede entenderse como la combinación de una conexión de red, un canal y el estado de juego que vive dentro de ese canal."},"295":{"id":"/docs/red/v1/guias/crear-partida-18","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"El cliente necesita establecer primero una conexión con el servidor."},"296":{"id":"/docs/red/v1/guias/crear-partida-19","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"Antes de intentar entrar en la partida conviene esperar a que `isConnected` sea verdadero."},"297":{"id":"/docs/red/v1/guias/crear-partida-20","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"El servidor es quien mantiene el estado del canal. El cliente solicita entrar mediante `JoinChannel`."},"298":{"id":"/docs/red/v1/guias/crear-partida-21","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"La unión no es instantánea. Eco mantiene la solicitud como pendiente hasta recibir la respuesta del servidor."},"299":{"id":"/docs/red/v1/guias/crear-partida-22","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"Los jugadores, objetos dinámicos y estado asociado a la partida deben entenderse dentro del contexto del canal. La conexión puede permanecer activa mientras el cliente cambia de un canal a otro o participa en varios simultáneamente."},"300":{"id":"/docs/red/v1/guias/crear-partida-23","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"No es recomendable empezar a crear lógica de partida inmediatamente después de llamar a `JoinChannel`. Primero debe completarse la unión y, cuando corresponda, la carga del nivel asociado."},"301":{"id":"/docs/red/v1/guias/crear-partida-24","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"Durante esta transición Eco protege el flujo de paquetes para evitar que operaciones pertenecientes a una escena anterior sean procesadas fuera de contexto."},"302":{"id":"/docs/red/v1/guias/crear-partida-25","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Una vez dentro del canal se pueden crear los objetos dinámicos que representan el estado de la partida."},"303":{"id":"/docs/red/v1/guias/crear-partida-26","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Por ejemplo:"},"304":{"id":"/docs/red/v1/guias/crear-partida-27","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Los objetos deben tener un propietario claro cuando su estado vaya a ser modificado por un cliente."},"305":{"id":"/docs/red/v1/guias/crear-partida-28","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"El estado que necesitan los demás jugadores debe modelarse como datos de red, no como una sucesión de acciones."},"306":{"id":"/docs/red/v1/guias/crear-partida-29","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"Si el estado debe actualizarse de forma continua puede utilizarse un sistema de sincronización apropiado. Para prototipos sencillos, `AutoSincronizar` puede servir como punto de partida."},"307":{"id":"/docs/red/v1/guias/crear-partida-30","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Las acciones puntuales de la partida deben utilizar el sistema de comunicación correspondiente."},"308":{"id":"/docs/red/v1/guias/crear-partida-31","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Por ejemplo, cambiar la vida actual de una unidad representa un cambio de estado, mientras que solicitar que una unidad ejecute una habilidad representa una acción."},"309":{"id":"/docs/red/v1/guias/crear-partida-32","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"La partida debe poder reconstruirse desde el estado del canal y de sus objetos."},"310":{"id":"/docs/red/v1/guias/crear-partida-33","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"Dependiendo de cómo se configure el objeto o componente, el estado puede conservarse en servidor o ser enviado explícitamente al nuevo participante."},"311":{"id":"/docs/red/v1/guias/crear-partida-34","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"Al terminar una partida pueden utilizarse distintos niveles de limpieza:"},"312":{"id":"/docs/red/v1/guias/crear-partida-35","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"La elección depende de si el cliente debe continuar conectado a otros canales o sesiones."},"313":{"id":"/docs/red/v1/guias/crear-partida-36","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Puede producir objetos locales que todavía no están correctamente registrados en el contexto de red de la partida."},"314":{"id":"/docs/red/v1/guias/crear-partida-37","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Las RFC son adecuadas para acciones. El estado debe modelarse como estado para que un jugador que entre posteriormente pueda obtener los valores actuales."},"315":{"id":"/docs/red/v1/guias/crear-partida-38","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Salir de un canal no obliga a desconectar al cliente. Eco permite mantener la conexión y continuar en otros canales."},"316":{"id":"/docs/red/v1/guias/crear-partida-39","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"Si varios clientes pueden modificar el mismo dato sin una autoridad clara, el estado puede entrar en conflicto. Define el propietario antes de diseñar la sincronización."},"317":{"id":"/docs/red/v1/guias/crear-partida-40","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Ciclo de vida y gestión de los canales."},"318":{"id":"/docs/red/v1/guias/crear-partida-41","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Identidad, propiedad y ciclo de vida de los objetos de red."},"319":{"id":"/docs/red/v1/guias/crear-partida-42","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Cómo mantener el estado coherente entre participantes."},"320":{"id":"/docs/red/v1/guias/crear-partida-43","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"RFC, destinatarios y comunicación de alto nivel."},"321":{"id":"/docs/red/v1/guias/enviar-accion","page_id":"/docs/red/v1/guias/enviar-accion","type":"page","content":"Enviar una acción","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/enviar-accion"},"322":{"id":"/docs/red/v1/guias/enviar-accion-0","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion","content":"Ejecuta una acción remotamente mediante RFC y elige correctamente sus destinatarios."},"323":{"id":"/docs/red/v1/guias/enviar-accion-1","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Enviar una acción"},"324":{"id":"/docs/red/v1/guias/enviar-accion-2","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"1\\. Crear el comportamiento remoto"},"325":{"id":"/docs/red/v1/guias/enviar-accion-3","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"2\\. Enviar la acción"},"326":{"id":"/docs/red/v1/guias/enviar-accion-4","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"3\\. Elegir destinatarios"},"327":{"id":"/docs/red/v1/guias/enviar-accion-5","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#4-no-mezclar-acción-y-estado","content":"4\\. No mezclar acción y estado"},"328":{"id":"/docs/red/v1/guias/enviar-accion-6","page_id":"/docs/red/