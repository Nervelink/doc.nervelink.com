undamentos/arquitectura#relación-con-tnet","content":"`Jugador`"},"965":{"id":"/docs/red/v1/fundamentos/arquitectura-36","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Código fuente de la implementación de Eco."},"966":{"id":"/docs/red/v1/fundamentos/arquitectura-37","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Repositorio original del que procede la base de Eco."},"967":{"id":"/docs/red/v1/fundamentos/arquitectura-38","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Documentación generada sobre el repositorio actual de TNet."},"968":{"id":"/docs/red/v1/fundamentos/conceptos","page_id":"/docs/red/v1/fundamentos/conceptos","type":"page","content":"Conceptos","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/conceptos"},"969":{"id":"/docs/red/v1/fundamentos/conceptos-0","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"970":{"id":"/docs/red/v1/fundamentos/conceptos-1","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Conceptos"},"971":{"id":"/docs/red/v1/fundamentos/conceptos-2","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"Conexión"},"972":{"id":"/docs/red/v1/fundamentos/conceptos-3","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Jugador"},"973":{"id":"/docs/red/v1/fundamentos/conceptos-4","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Canal"},"974":{"id":"/docs/red/v1/fundamentos/conceptos-5","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Objeto"},"975":{"id":"/docs/red/v1/fundamentos/conceptos-6","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Componente"},"976":{"id":"/docs/red/v1/fundamentos/conceptos-7","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"Propietario"},"977":{"id":"/docs/red/v1/fundamentos/conceptos-8","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Paquete"},"978":{"id":"/docs/red/v1/fundamentos/conceptos-9","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Buffer"},"979":{"id":"/docs/red/v1/fundamentos/conceptos-10","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Estado"},"980":{"id":"/docs/red/v1/fundamentos/conceptos-11","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"981":{"id":"/docs/red/v1/fundamentos/conceptos-12","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"982":{"id":"/docs/red/v1/fundamentos/conceptos-13","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#referencias","content":"Referencias"},"983":{"id":"/docs/red/v1/fundamentos/conceptos-14","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Eco organiza la red alrededor de unas pocas piezas fundamentales. Entender su relación evita confundir conexión, canal, jugador, objeto y componente."},"984":{"id":"/docs/red/v1/fundamentos/conceptos-15","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Una conexión representa la comunicación con el servidor; un jugador representa a un participante; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"985":{"id":"/docs/red/v1/fundamentos/conceptos-16","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. No define por sí sola qué objetos o estado debe conocer el cliente."},"986":{"id":"/docs/red/v1/fundamentos/conceptos-17","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. Sirve para identificar presencia, propiedad y destinatarios."},"987":{"id":"/docs/red/v1/fundamentos/conceptos-18","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Un mismo jugador puede participar simultáneamente en varios canales."},"988":{"id":"/docs/red/v1/fundamentos/conceptos-19","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"989":{"id":"/docs/red/v1/fundamentos/conceptos-20","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Esta separación permite mantener la identidad de red independiente de la funcionalidad concreta."},"990":{"id":"/docs/red/v1/fundamentos/conceptos-21","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"El propietario identifica al jugador que tiene autoridad sobre determinadas operaciones del objeto. La propiedad no implica que el objeto sea invisible para los demás participantes."},"991":{"id":"/docs/red/v1/fundamentos/conceptos-22","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Un `Paquete` representa una unidad del protocolo de Eco. Transporta comandos, eventos y datos entre clientes y servidor."},"992":{"id":"/docs/red/v1/fundamentos/conceptos-23","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"993":{"id":"/docs/red/v1/fundamentos/conceptos-24","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Eco distingue entre comunicar una acción y mantener un estado. Una RFC puede comunicar que algo ocurrió; un mecanismo de sincronización mantiene valores que deben converger entre participantes."},"994":{"id":"/docs/red/v1/fundamentos/conceptos-25","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Eco"},"995":{"id":"/docs/red/v1/fundamentos/conceptos-26",