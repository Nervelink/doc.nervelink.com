erpretar el contenido que sigue."},"3085":{"id":"/docs/red/v1/transporte/paquetes-protocolo-10","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"Cada capa responde a una pregunta diferente:"},"3086":{"id":"/docs/red/v1/transporte/paquetes-protocolo-11","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"Capa"},"3087":{"id":"/docs/red/v1/transporte/paquetes-protocolo-12","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"Pregunta"},"3088":{"id":"/docs/red/v1/transporte/paquetes-protocolo-13","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"RFC / estado"},"3089":{"id":"/docs/red/v1/transporte/paquetes-protocolo-14","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"¿Qué quiere hacer el juego?"},"3090":{"id":"/docs/red/v1/transporte/paquetes-protocolo-15","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"`Paquete`"},"3091":{"id":"/docs/red/v1/transporte/paquetes-protocolo-16","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"¿Qué operación de protocolo es?"},"3092":{"id":"/docs/red/v1/transporte/paquetes-protocolo-17","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes-protocolo#capas","content":"`Buffer`"},"3093":{"id":"/docs/red/v1/transporte/paquetes-protocolo-18","page_id":"/docs/red/v1/transporte/paquetes-protocolo","tags":[],"type":"