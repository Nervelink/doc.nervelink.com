s/red/v1/ejemplos/rfc-19","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"Una buena prueba es preguntar qué debe conocer un jugador que entre cinco segundos después. Si la respuesta es “el resultado actual”, necesitas estado persistente; si es “la acción que acaba de ocurrir”, normalmente necesitas una RFC."},"1619":{"id":"/docs/red/v1/ejemplos/rfc-20","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"El modelo de Eco permite RFC guardadas en el servidor. Una RFC persistente no es simplemente un mensaje con `true`: pasa a formar parte del estado que puede reconstruirse posteriormente."},"1620":{"id":"/docs/red/v1/ejemplos/rfc-21","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Comprueba que el método está en un componente asociado al `Objeto` y que el atributo RMR/RFC utilizado pertenece a la API actual de Eco."},"1621":{"id":"/docs/red/v1/ejemplos/rfc-22","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Los parámetros deben ser serializables y coincidir con lo que espera la función receptora."},"1622":{"id":"/docs/red/v1/ejemplos/rfc-23","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#ejecutar-lógica-de-servidor-en-el-cliente","content":"Una RFC ejecuta código en la instancia receptora. No la confundas con una validación server-authoritative."},"1623":{"id":"/docs/red/v1/ejemplos/rfc-24","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"El repositorio contiene los ejemplos heredados de RFC y sus escenas."},"1624":{"id":"/docs/red/v1/ejemplos/rfc-25","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"Persistencia, callbacks y patrones avanzados."},"1625":{"id":"/docs/red/v1/ejemplos/runtime-code","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"page","content":"Código en tiempo de ejecución","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/runtime-code"},"1626":{"id":"/docs/red/v1/ejemplos/runtime-code-0","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code","content":"Integración avanzada de RuntimeCode para extensibilidad y herramientas dinámicas."},"1627":{"id":"/docs/red/v1/ejemplos/runtime-code-1","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"Código en tiempo de ejecución"},"1628":{"id":"/docs/red/v1/ejemplos/runtime-code-2","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#flujo-conceptual","content":"Flujo conceptual"},"1629":{"id":"/docs/red/v1/ejemplos/runtime-code-3","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"1630":{"id":"/docs/red/v1/ejemplos/runtime-code-4","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"Cuándo evitarlo"},"1631":{"id":"/docs/red/v1/ejemplos/runtime-code-5","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Seguridad"},"1632":{"id":"/docs/red/v1/ejemplos/runtime-code-6","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"`RuntimeCode` permite compilar y cargar código durante la ejecución. Es una capacidad avanzada heredada del ecosistema de TNet y debe utilizarse con un objetivo concreto."},"1633":{"id":"/docs/red/v1/ejemplos/runtime-code-7","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"El código de gameplay principal debe compilarse con el proyecto. `RuntimeCode` resulta adecuado para herramientas, scripting controlado, extensiones o escenarios donde el contenido no puede conocerse por adelantado."},"1634":{"id":"/docs/red/v1/ejemplos/runtime-code-8","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"herramientas internas"},"1635":{"id":"/docs/red/v1/ejemplos/runtime-code-9","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"prototipos de lógica distribuible"},"1636":{"id":"/docs/red/v1/ejemplos/runtime-code-10","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"sistemas de modding controlado"},"1637":{"id":"/docs/red/v1/ejemplos/runtime-code-11","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"generación dinámica de comportamiento"},"1638":{"id":"/docs/red/v1/ejemplos/runtime-code-12","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"No lo utilices para sustituir el sistema de escenas, prefabs o componentes normales si el código ya puede distribuirse con el juego."},"1639":{"id":"/docs/red/v1/ejemplos/runtime-code-13","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"El código compilado durante la ejecución tiene las mismas implicaciones de seguridad que cualquier sistema de scripting dinámico. No ejecutes código recibido de clientes no confiables."},"1640":{"id":"/docs/red/v1/ejemplos/runtime-code-14","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Configuración y detalles internos."},"1641":{"id":"/docs/red/v1/ejemplos/runtime-code-15","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Más patrones avanzados de Eco."},"1642":{"id":"/docs/red/v1/ejemplos/stress-test","page_id":"/docs/red/v1/ejemplos/stress-test","type":"page","content":"Prueba de estrés","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/stress-test"},"1643":{"id":"/docs/red/v1/ejemplos/stress-test-0","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test","content":"Cómo diseñar una escena de prueba para medir objetos, RFC, sincronización, CPU y ancho de banda."},"1644":{"id":"/docs/red/v1/ejemplos/stress-test-1","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Prueba de estrés"},"1645":{"id":"/docs/red/v1/ejemplos/stress-test-2","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-medir","content":"Qué medir"},"1646":{"id":"/docs/red/v1/ejemplos/stress-test-3","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"Escenario mínimo"},"1647":{"id":"/docs/red/v1/ejemplos/stress-test-4","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#metodología","content":"Metodología"},"1648":{"id":"/docs/red/v1/ejemplos/stress-test-5","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Línea base"},"1649":{"id":"/docs/red/v1/ejemplos/stress-test-6","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Añadir objetos"},"1650":{"id":"/docs/red/v1/ejemplos/stress-test-7","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Añadir frecuencia"},"1651":{"id":"/docs/red/v1/ejemplos/stress-test-8","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Añadir jugadores"},"1652":{"id":"/docs/red/v1/ejemplos/stress-test-9","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Encontrar el cuello de botella"},"1653":{"id":"/docs/red/v1/ejemplos/stress-test-10","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#métricas-de-eco","content":"Métricas de Eco"},"1654":{"id":"/docs/red/v1/ejemplos/stress-test-11","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Qué no medir de forma aislada"},"1655":{"id":"/docs/red/v1/ejemplos/stress-test-12","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Una prueba de estrés debe medir el sistema que realmente quieres desplegar. Eco permite observar tráfico, latencia y procesamiento, pero una prueba útil combina esas métricas con un workload controlado."},"1656":{"id":"/docs/red/v1/ejemplos/stress-test-13","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"No empieces con cientos de jugadores. Primero identifica el comportamiento de una sola variable y aumenta la carga de forma incremental."},"1657":{"id":"/docs/red/v1/ejemplos/stress-test-14","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Ejecuta el escenario sin tráfico adicional y registra CPU, memoria y latencia."},"1658":{"id":"/docs/red/v1/ejemplos/stress-test-15","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Incrementa la cantidad de entidades sin cambiar todavía la frecuencia de sincronización."},"1659":{"id":"/docs/red/v1/ejemplos/stress-test-16","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Aumenta las actualizaciones por segundo y observa cuándo empieza a crecer la cola de entrada."},"1660":{"id":"/docs/red/v1/ejemplos/stress-test-17","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Repite el experimento con varias conexiones y canales."},"1661":{"id":"/docs/red/v1/ejemplos/stress-test-18","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Comprueba si el límite aparece en CPU, serialización, ancho de banda, servidor o cliente."},"1662":{"id":"/docs/red/v1/ejemplos/stress-test-19","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Un ping bajo no garantiza un buen rendimiento. Una aplicación puede tener baja latencia y, aun así, saturar CPU o ancho de banda."},"1663":{"id":"/docs/red/v1/ejemplos/stress-test-20","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Una simulación artificial de muchos paquetes pequeños puede ser peor o mejor que una partida real. Replica la distribución de RFC, sincronización, creación y destrucción de objetos que tendrá tu juego."},"1664":{"id":"/docs/red/v1/ejemplos/stress-test-21","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Workflow para obtener una primera fotografía del estado de red."},"1665":{"id":"/docs/red/v1/ejemplos/varios-canales","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"page","content":"Varios canales","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/varios-canales"},"1666":{"id":"/docs/red/v1/ejemplos/varios-canales-0","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales","content":"Ejemplo práctico de una única conexión participando en varios canales simultáneamente."},"1667":{"id":"/docs/red/v1/ejemplos/varios-canales-1","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Varios canales"},"1668":{"id":"/docs/red/v1/ejemplos/varios-canales-2","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#modelo","content":"Modelo"},"1669":{"id":"/docs/red/v1/ejemplos/varios-canales-3","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Entrar en varios canales"},"1670":{"id":"/docs/red/v1/ejemplos/varios-canales-4","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Datos por canal"},"1671":{"id":"/docs/red/v1/ejemplos/varios-canales-5","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Objetos por canal"},"1672":{"id":"/docs/red/v1/ejemplos/varios-canales-6","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"Salir de un canal"},"1673":{"id":"/docs/red/v1/ejemplos/varios-canales-7","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#patrón-recomendado","content":"Patrón recomendado"},"1674":{"id":"/docs/red/v1/ejemplos/varios-canales-8","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Mantén el contexto explícito"},"1675":{"id":"/docs/red/v1/ejemplos/varios-canales-9","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Pasa el canal a las operaciones"},"1676":{"id":"/docs/red/v1/ejemplos/varios-canales-10","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Mantén los objetos ligados a su canal"},"1677":{"id":"/docs/red/v1/ejemplos/varios-canales-11","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Relación con TNet"},"1678":{"id":"/docs/red/v1/ejemplos/varios-canales-12","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Eco permite que una misma conexión participe en varios canales al mismo tiempo. Este comportamiento es especialmente importante en arquitecturas donde el jugador mantiene un contexto persistente y, simultáneamente, participa en una partida, chat, lobby o sesión secundaria."},"1679":{"id":"/docs/red/v1/ejemplos/varios-canales-13","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"`Eco.idUltimoCanal` existe como ayuda de compatibilidad y para determinados callbacks. Cuando un jugador está en varios canales, especifica siempre el `idCanal` de la operación."},"1680":{"id":"/docs/red/v1/ejemplos/varios-canales-14","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Comprueba cada canal por separado:"},"1681":{"id":"/docs/red/v1/ejemplos/varios-canales-15","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Nunca asumas que `ObtenerDatosCanal` se refiere al último canal utilizado: recibe explícitamente el ID."},"1682":{"id":"/docs/red/v1/ejemplos/varios-canales-16","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Los objetos tienen su propio `channelID`."},"1683":{"id":"/docs/red/v1/ejemplos/varios-canales-17","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Las operaciones de instanciación y envío deben utilizar el canal del objeto o el canal explícito del contexto."},"1684":{"id":"/docs/red/v1/ejemplos/varios-canales-18","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"La conexión continúa activa y el cliente puede seguir participando en los demás canales."},"1685":{"id":"/docs/red/v1/ejemplos/varios-canales-19","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Guarda el ID del canal en el sistema que representa ese contexto (`mundo`, `partida`, `chat`, etc.)."},"1686":{"id":"/docs/red/v1/ejemplos/varios-canales-20","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Evita depender de variables globales como `idUltimoCanal` para decidir dónde se ejecuta una operación."},"1687":{"id":"/docs/red/v1/ejemplos/varios-canales-21","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Usa `objeto.channelID` como fuente de verdad para operaciones específicas de una entidad."},"1688":{"id":"/docs/red/v1/ejemplos/varios-canales-22","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"La documentación histórica de TNet ya contemplaba múltiples canales, pero Eco lo incorpora como una capacidad fundamental del runtime actual y la expone mediante su fachada `Eco`."},"1689":{"id":"/docs/red/v1/ejemplos/varios-canales-23","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Modelo completo de canales y pertenencia."},"1690":{"id":"/docs/red/v1/ejemplos/varios-canales-24","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"API de la fachada para trabajar con varios canales."},"1691":{"id":"/docs/red/v1/fundamentos/arquitectura","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"page","content":"Arquitectura","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/arquitectura"},"1692":{"id":"/docs/red/v1/fundamentos/arquitectura-0","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura","content":"Cómo se relacionan las capas de Eco y cómo fluye la información entre ellas."},"1693":{"id":"/docs/red/v1/fundamentos/arquitectura-1","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Arquitectura"},"1694":{"id":"/docs/red/v1/fundamentos/arquitectura-2","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#mapa-de-la-arquitectura","content":"Mapa de la arquitectura"},"1695":{"id":"/docs/red/v1/fundamentos/arquitectura-3","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Las cuatro capas que debes distinguir"},"1696":{"id":"/docs/red/v1/fundamentos/arquitectura-4","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#modelo-de-red","content":"Modelo de red"},"1697":{"id":"/docs/red/v1/fundamentos/arquitectura-5","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#canal","content":"Canal"},"1698":{"id":"/docs/red/v1/fundamentos/arquitectura-6","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#jugador","content":"Jugador"},"1699":{"id":"/docs/red/v1/fundamentos/arquitectura-7","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#objeto","content":"Objeto"},"1700":{"id":"/docs/red/v1/fundamentos/arquitectura-8","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#componente","content":"Componente"},"1701":{"id":"/docs/red/v1/fundamentos/arquitectura-9","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"Comunicación"},"1702":{"id":"/docs/red/v1/fundamentos/arquitectura-10","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#runtime","content":"Runtime"},"1703":{"id":"/docs/red/v1/fundamentos/arquitectura-11","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#flujo-de-una-operación","content":"Flujo de una operación"},"1704":{"id":"/docs/red/v1/fundamentos/arquitectura-12","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#1-gameplay-step","content":"Gameplay [step]"},"1705":{"id":"/docs/red/v1/fundamentos/arquitectura-13","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#2-modelo-de-red-step","content":"Modelo de red [step]"},"1706":{"id":"/docs/red/v1/fundamentos/arquitectura-14","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#3-comunicación-step","content":"Comunicación [step]"},"1707":{"id":"/docs/red/v1/fundamentos/arquitectura-15","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#4-serialización-step","content":"Serialización [step]"},"1708":{"id":"/docs/red/v1/fundamentos/arquitectura-16","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#5-transporte-step","content":"Transporte [step]"},"1709":{"id":"/docs/red/v1/fundamentos/arquitectura-17","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#6-aplicación-remota-step","content":"Aplicación remota [step]"},"1710":{"id":"/docs/red/v1/fundamentos/arquitectura-18","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Relación con TNet"},"1711":{"id":"/docs/red/v1/fundamentos/arquitectura-19","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#fuentes","content":"Fuentes"},"1712":{"id":"/docs/red/v1/fundamentos/arquitectura-20","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Eco es la capa de red utilizada por Pandora. Parte de la arquitectura de TNet, pero utiliza la nomenclatura, organización y extensiones propias de Nervelink."},"1713":{"id":"/docs/red/v1/fundamentos/arquitectura-21","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura","content":"Piensa en Eco como un sistema por capas. `Canal`, `Objeto`, `Jugador`, `RFC`, `Paquete` y `Buffer` resuelven problemas distintos; no son sustitutos entre sí."},"1714":{"id":"/docs/red/v1/fundamentos/arquitectura-22","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Define quién participa, qué objetos existen y en qué canal viven."},"1715":{"id":"/docs/red/v1/fundamentos/arquitectura-23","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Define qué se quiere comunicar y quién debe recibirlo."},"1716":{"id":"/docs/red/v1/fundamentos/arquitectura-24","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Convierte la operación en un mensaje serializado y lo transporta."},"1717":{"id":"/docs/red/v1/fundamentos/arquitectura-25","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#las-cuatro-capas-que-debes-distinguir","content":"Ejecuta cliente y servidor y mantiene sus ciclos de vida."},"1718":{"id":"/docs/red/v1/fundamentos/arquitectura-26","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#canal","content":"Un `Canal` delimita un ámbito de jugadores y estado. Una conexión puede pertenecer a varios canales simultáneamente; esto es una propiedad del modelo de Eco, no una conexión física adicional."},"1719":{"id":"/docs/red/v1/fundamentos/arquitectura-27","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#jugador","content":"`Jugador` representa una participación en la sesión. Su identidad es independiente de la conexión física y dispone de datos propios que pueden sincronizarse."},"1720":{"id":"/docs/red/v1/fundamentos/arquitectura-28","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#objeto","content":"`Objeto` aporta identidad de red, ownership, canal, datos y ciclo de vida. Su `uid` combina el contexto del canal con la identidad del objeto."},"1721":{"id":"/docs/red/v1/fundamentos/arquitectura-29","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#componente","content":"`Componente` es la capa de integración con `MonoBehaviour`: permite acceder cómodamente al objeto de red y es el punto habitual desde el que se declaran RFC, datos y operaciones de instanciación."},"1722":{"id":"/docs/red/v1/fundamentos/arquitectura-30","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"Una operación empieza en gameplay y acaba convertida en un mensaje de protocolo."},"1723":{"id":"/docs/red/v1/fundamentos/arquitectura-31","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#comunicación","content":"La selección de destinatario se realiza antes de que el mensaje abandone el contexto de Eco. Por eso Destinatarios pertenece conceptualmente a Comunicación y no a Transporte."},"1724":{"id":"/docs/red/v1/fundamentos/arquitectura-32","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#runtime","content":"El cliente mantiene su conexión y representación local. El servidor mantiene el estado compartido, administra jugadores y canales y procesa las solicitudes que requieren autoridad del servidor."},"1725":{"id":"/docs/red/v1/fundamentos/arquitectura-33","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#1-gameplay-step","content":"Tu código decide qué quiere hacer: cambiar estado, ejecutar una acción, crear un objeto o cambiar de canal."},"1726":{"id":"/docs/red/v1/fundamentos/arquitectura-34","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#2-modelo-de-red-step","content":"Eco determina el `Objeto`, `Canal`, propietario y contexto de la operación."},"1727":{"id":"/docs/red/v1/fundamentos/arquitectura-35","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#3-comunicación-step","content":"Se selecciona RFC, sincronización o una operación de protocolo existente y se determinan sus destinatarios."},"1728":{"id":"/docs/red/v1/fundamentos/arquitectura-36","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#4-serialización-step","content":"Los parámetros se convierten a una representación binaria mediante `Buffer` y las herramientas de serialización."},"1729":{"id":"/docs/red/v1/fundamentos/arquitectura-37","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#5-transporte-step","content":"El mensaje viaja mediante TCP, UDP cuando corresponde, o una conexión personalizada."},"1730":{"id":"/docs/red/v1/fundamentos/arquitectura-38","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#6-aplicación-remota-step","content":"El receptor procesa el paquete, actualiza el estado correspondiente y ejecuta los callbacks asociados."},"1731":{"id":"/docs/red/v1/fundamentos/arquitectura-39","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"TNet"},"1732":{"id":"/docs/red/v1/fundamentos/arquitectura-40","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Eco"},"1733":{"id":"/docs/red/v1/fundamentos/arquitectura-41","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Responsabilidad"},"1734":{"id":"/docs/red/v1/fundamentos/arquitectura-42","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNManager`"},"1735":{"id":"/docs/red/v1/fundamentos/arquitectura-43","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Eco`"},"1736":{"id":"/docs/red/v1/fundamentos/arquitectura-44","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/