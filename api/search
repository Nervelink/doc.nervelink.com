cia/canales#elegir-persistencia","content":"Sí"},"1950":{"id":"/docs/red/v1/persistencia/canales-17","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Evento que debe desaparecer al terminar"},"1951":{"id":"/docs/red/v1/persistencia/canales-18","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"No"},"1952":{"id":"/docs/red/v1/persistencia/canales-19","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Lobby estable"},"1953":{"id":"/docs/red/v1/persistencia/canales-20","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Puede serlo"},"1954":{"id":"/docs/red/v1/persistencia/canales-21","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#referencias","content":"Uso de varios canales desde un único cliente."},"1955":{"id":"/docs/red/v1/persistencia/estado","page_id":"/docs/red/v1/persistencia/estado","type":"page","content":"Estado persistente","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/estado"},"1956":{"id":"/docs/red/v1/persistencia/estado-0","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"Estado persistente"},"1957":{"id":"/docs/red/v1/persistencia/estado-1","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#capas-de-estado","content":"Capas de estado"},"1958":{"id":"/docs/red/v1/persistencia/estado-2","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#qué-guardar","content":