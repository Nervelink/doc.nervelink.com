1/comunicacion/rcl","type":"page","content":"RCL","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcl"},"1432":{"id":"/docs/red/v1/comunicacion/rcl-0","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl","content":"Red Creación Local, el mecanismo de Eco para solicitar una creación local dentro del flujo de red."},"1433":{"id":"/docs/red/v1/comunicacion/rcl-1","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"RCL — Red Creación Local"},"1434":{"id":"/docs/red/v1/comunicacion/rcl-2","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"Diferencia con RCR"},"1435":{"id":"/docs/red/v1/comunicacion/rcl-3","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#ciclo-conceptual","content":"Ciclo conceptual"},"1436":{"id":"/docs/red/v1/comunicacion/rcl-4","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Cuándo documentarlo"},"1437":{"id":"/docs/red/v1/comunicacion/rcl-5","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"En Eco, el concepto histórico `LCR` (*Local Creation Request / Call*) de TNet se denomina **RCL — Red Creación Local**."},"1438":{"id":"/docs/red/v1/comunicacion/rcl-6","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"RCL pertenece al conjunto de mecanismos de creación y sirve para representar la solicitud de que una entidad sea creada localmente en el contexto adecuado de red."},"1439":{"id":"/docs/red/v1/comunicacion/rcl-7","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"La diferencia no debe entenderse únicamente como «cliente» frente a «servidor». Lo relevante es quién origina la operación y qué parte del flujo de creación debe resolverse de forma local o remota."},"1440":{"id":"/docs/red/v1/comunicacion/rcl-8","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"RCL es especialmente útil cuando se describen workflows de creación donde el código local inicia la incorporación de una entidad al modelo de red."},"1441":{"id":"/docs/red/v1/comunicacion/rcl-9","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Para una integración habitual, el desarrollador debería pensar primero en el resultado deseado —crear un objeto de red válido— y después elegir el mecanismo de creación adecuado."},"1442":{"id":"/docs/red/v1/comunicacion/rcl-10","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Creación Remota."},"1443":{"id":"/docs/red/v1/comunicacion/rcl-11","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Método Remoto."},"1444":{"id":"/docs/red/v1/comunicacion/rcl-12","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Workflow práctico del ciclo de vida de un objeto."},"1445":{"id":"/docs/red/v1/comunicacion/rcr","page_id":"/docs/red/v1/comunicacion/rcr","type":"page","content":"RCR","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcr"},"1446":{"id":"/docs/red/v1/comunicacion/rcr-0","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunic