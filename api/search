aquetes-10","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Eco conserva un conjunto de paquetes para operaciones como conexión, ping, canales, creación y destrucción de objetos, datos de jugador y forwarding de llamadas remotas."},"4110":{"id":"/docs/red/v1/transporte/paquetes-11","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Algunos ejemplos son:"},"4111":{"id":"/docs/red/v1/transporte/paquetes-12","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Paquete"},"4112":{"id":"/docs/red/v1/transporte/paquetes-13","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Propósito"},"4113":{"id":"/docs/red/v1/transporte/paquetes-14","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestID`"},"4114":{"id":"/docs/red/v1/transporte/paquetes-15","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Iniciar la identificación y negociación de la conexión."},"4115":{"id":"/docs/red/v1/transporte/paquetes-16","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestPing`"},"4116":{"id":"/docs/red/v1/transporte/paquetes-17","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Medir latencia y mantener la conexión activa."},"4117":{"id":"/docs/red/v1/transporte/paquetes-18","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestJoinChannel`"},"4118":{"id":"/docs/red/v1/transporte/paquetes-19","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Solicitar entrada a un canal."},"4119":{"id":"/docs/red/v1/transporte/paquetes-20","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestLeaveChannel`"},"4120":{"id":"/docs/red/v1/transporte/paquetes-21","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Abandonar un canal."},"4121":{"id":"/docs/red/v1/transporte/paquetes-22","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestCreateObject`"},"4122":{"id":"/docs/red/v1/transporte/paquetes-23","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Crear un objeto dinámico."},"4123":{"id":"/docs/red/v1/transporte/paquetes-24","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`RequestDestroyObject`"},"4124":{"id":"/docs/red/v1/transporte/paquetes-25","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Destruir un objeto de red."},"4125":{"id":"/docs/red/v1/transporte/paquetes-26","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"`ForwardToAll`"},"4126":{"id":"/docs/red/v1/transporte/paquetes-27","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#tipos-de-paquete","content":"Distribuir una llamada o mensaje al canal."},"4127":{"id":"