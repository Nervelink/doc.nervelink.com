idad"},"1345":{"id":"/docs/red/v1/guias/multiples-canales-36","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"¿Canal?"},"1346":{"id":"/docs/red/v1/guias/multiples-canales-37","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Mundo persistente compartido"},"1347":{"id":"/docs/red/v1/guias/multiples-canales-38","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Sí"},"1348":{"id":"/docs/red/v1/guias/multiples-canales-39","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Partida independiente"},"1349":{"id":"/docs/red/v1/guias/multiples-canales-40","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Sí"},"1350":{"id":"/docs/red/v1/guias/multiples-canales-41","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Evento temporal con jugadores concretos"},"1351":{"id":"/docs/red/v1/guias/multiples-canales-42","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Sí"},"1352":{"id":"/docs/red/v1/guias/multiples-canales-43","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Simplemente enviar un mensaje a un jugador"},"1353":{"id":"/docs/red/v1/guias/multiples-canales-44","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiple