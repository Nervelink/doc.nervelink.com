red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"proyectiles físicos;"},"476":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-18","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"objetos arrastrables;"},"477":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-19","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"props dinámicos;"},"478":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-20","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"cuerpos que necesitan continuidad visual."},"479":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-21","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"No es la mejor solución para entidades que realmente deberían ser controladas por un estado lógico determinista."},"480":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-22","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#cuándo-utilizarlo","content":"Enviar posición, velocidad y rotación desde todos los clientes crea una lucha de autoridades. Decide primero quién controla el cuerpo y qué datos son realmente necesarios."},"481":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-23","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#relación-con-transformsuave","content":"Para objetos sin simulación física, `TransformSuave` cubre una necesidad similar con una estrategia más sencilla de interpolación visual."},"482":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-24","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#relación-con-transformsuave","content":"Implementación actual."},"483":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-25","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody#relación-con-transformsuave","content":"Consulta el suavizado de transformaciones no físicas."},"484":{"id":"/docs/red/v1/avanzado/steam-y-conexiones","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"page","content":"Steam y conexiones personalizadas","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones"},"485":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-0","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones","content":"Uso de IConnection y del módulo Steam para sustituir sockets en integraciones compatibles."},"486":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-1","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#steam-y-conexiones-personalizadas","content":"Steam y conexiones personalizadas"},"487":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-2","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#modelo","content":"Modelo"},"488":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-3","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"Conexión personalizada"},"489":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-4","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#steam","content":"Steam"},"490":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-5","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"Casos de uso"},"491":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-6","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/steam-y-conexiones#fuentes","content":"Fuentes"},"492":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-7","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#steam-y-conexiones-personalizadas","content":"Eco separa la lógica de cliente/servidor de la implementación física de la conexión mediante `IConnection`. Esto permite integrar transportes alternativos sin reescribir el protocolo superior."},"493":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-8","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#modelo","content":"El protocolo superior sigue trabajando con paquetes y buffers mientras cambia la capa de transporte."},"494":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-9","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"La fachada de Eco expone `ProtocoloPersonalizado`:"},"495":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-10","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"Al asignar una implementación, Eco pasa al estado de verificación y envía el handshake de identidad sobre la conexión proporcionada."},"496":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-11","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"`IConnection` sustituye el transporte. No convierte automáticamente el protocolo de Eco en otro protocolo ni elimina las reglas de canales, objetos o sincronización."},"497":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-12","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#steam","content":"El repositorio incluye un módulo `Steam` y referencias a paquetes standalone de Steam Networking. La integración está diseñada para transportar la comunicación de Eco utilizando la infraestructura de Steam en lugar de depender únicamente de sockets directos."},"498":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-13","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"juegos distribuidos mediante Steam;"},"499":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-14","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"NAT traversal gestionado por Steam;"},"500":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-15","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"conexiones entre usuarios sin publicar endpoints TCP directamente;"},"501":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-16","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"integración del networking con una API de transporte existente."},"502":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-17","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#fuentes","content":"Código y material de integración Steam."},"503":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-18","p