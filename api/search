dor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#ciclo-de-vida","content":"Ciclo de vida"},"3734":{"id":"/docs/red/v1/runtime/servidor-4","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#preparación-step","content":"Preparación"},"3735":{"id":"/docs/red/v1/runtime/servidor-5","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#arranque-step","content":"Arranque"},"3736":{"id":"/docs/red/v1/runtime/servidor-6","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#aceptación-step","content":"Aceptación"},"3737":{"id":"/docs/red/v1/runtime/servidor-7","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#operación-step","content":"Operación"},"3738":{"id":"/docs/red/v1/runtime/servidor-8","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#cierre-step","content":"Cierre"},"3739":{"id":"/docs/red/v1/runtime/servidor-9","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#jugadores","content":"Jugadores"},"3740":{"id":"/docs/red/v1/runtime/servidor-10","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#canales","content":"Canales"},"3741":{"id":"/docs/red/v1/runtime/servidor-11","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"Persistencia y memoria"},"3742":{"id":"/docs/red/v1/runtime/servidor-12","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"Procesamiento multihilo"},"3743":{"id":"/docs/red/v1/runtime/servidor-13","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#paquetes-personalizados","content":"Paquetes personalizados"},"3744":{"id":"/docs/red/v1/runtime/servidor-14","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#administración-y-lobby","content":"Administración y lobby"},"3745":{"id":"/docs/red/v1/runtime/servidor-15","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#servidor-local","content":"Servidor local"},"3746":{"id":"/docs/red/v1/runtime/servidor-16","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#relación-con-tnet","content":"Relación con TNet"},"3747":{"id":"/docs/red/v1/runtime/servidor-17","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#referencias","content":"Referencias"},"3748":{"id":"/docs/red/v1/runtime/servidor-18","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor","content":"`ServidorJuego` concentra la lógica autoritativa de Eco: conexiones, jugadores, canales, objetos, paquetes, persistencia y servicios auxiliares."},"3749":{"id":"/docs/red/v1/runtime/servidor-19","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor","content":"El cliente puede solicitar una operación, pero el servidor es quien debe decidir si esa operación modifica el estado compartido cuando las reglas del juego requieren autoridad central."},"3750":{"id":"/docs/red/v1/runtime/servidor-20","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Acepta jugadores y mantiene sus estados de sesión."},"3751":{"id":"/docs/red/v1/runtime/servidor-21","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Mantiene los ámbitos activos y coordina jugadores, objetos y estado."},"3752":{"id":"/docs/red/v1/runtime/servidor-22","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Guarda y restaura el estado del mundo y puede dormir canales sin jugadores."},"3753":{"id":"/docs/red/v1/runtime/servidor-23","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Permite interceptar paquetes no gestionados mediante `onCustomPacket`."},"3754":{"id":"/docs/red/v1/runtime/servidor-24","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#preparación-step","content":"Configura identidad del servidor, persistencia, administración y transporte."},"3755":{"id":"/docs/red/v1/runtime/servidor-25","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#arranque-step","content":"`Start()` prepara TCP y el UDP opcional y activa el procesamiento de red."},"3756":{"id":"/docs/red/v1/runtime/servidor-26","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#aceptación-step","content":"`Listen()` mantiene la escucha de nuevas conexiones TCP y crea el estado asociado al participante."},"3757":{"id":"/docs/red/v1/runtime/servidor-27","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#operación-step","content":"El servidor procesa paquetes, actualiza jugadores y canales y ejecuta las operaciones autoritativas."},"3758":{"id":"/docs/red/v1/runtime/servidor-28","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#cierre-step","content":"La detención del servidor finaliza las conexiones y permite guardar el estado si la configuración lo requiere."},"3759":{"id":"/docs/red/v1/runtime/servidor-29","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#jugadores","content":"El servidor mantiene estructuras separadas para iterar y para resolver participantes por ID o endpoint."},"3760":{"id":"/docs/red/v1/runtime/servidor-30","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#jugadores","content":"Esto permite que un jugador sea tratado como participante lógico independientemente de la representación física de la conexión."},"3761":{"id":"/docs/red/v1/runtime/servidor-31","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#canales","content":"Los canales activos se almacenan en listas y diccionarios para combinar iteración y acceso rápido."},"3762":{"id":"/docs/red/v1/runtime/servidor-32","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#canales","content":"El mismo jugador puede pertenecer a más de un canal."},"3763":{"id":"/docs/red/v1/runtime/servidor-33","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"`ServidorJuego` dispone de un archivo de mundo y de funciones reemplazables de lectura/escritura."},"3764":{"id":"/docs/red/v1/runtime/servidor-34","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"`Sleep()` reduce la memoria utilizada por canales sin jugadores y `Wake()` permite restaurarlos. El servidor también puede realizar este tipo de reducción durante procesos de guardado."},"3765":{"id":"/docs/red/v1/runtime/servidor-35","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"Un canal persistente puede existir lógicamente aunque no todos sus datos permanezcan activos en memoria todo el tiempo."},"3766":{"id":"/docs/r