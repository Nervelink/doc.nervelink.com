1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/arquitectura#por-qué-está-separado","content":"La separación permite sustituir una fuente de movimiento sin reescribir la presentación. Un NPC puede utilizar una ruta mientras un jugador utiliza entrada humana y ambos reutilizan la misma locomoción, sensores y animación."},"767":{"id":"/docs/personaje/v1/fundamentos/controladores","page_id":"/docs/personaje/v1/fundamentos/controladores","type":"page","content":"Controladores","breadcrumbs":["Docs","Personaje","Personaje","Contenido","Fundamentos"],"tags":[],"url":"/docs/personaje/v1/fundamentos/controladores"},"768":{"id":"/docs/personaje/v1/fundamentos/controladores-0","page_id":"/docs/personaje/v1/fundamentos/controladores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/controladores","content":"Diferencias entre Personaje y Jugador y cuándo utilizar cada controlador."},"769":{"id":"/docs/personaje/v1/fundamentos/controladores-1","page_id":"/docs/personaje/v1/fundamentos/controladores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/controladores#personaje","content":"Personaje"},"770":{"id":"/docs/personaje/v1/fundamentos/controladores-2","page_id":"/docs/personaje/v1/fundamentos/controladores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/controladores#jugador","content":"Jugador"},"771":{"id":"/docs/personaje/v1/fundamentos/controladores-3","page_id":"/docs/personaje/v1/fundamentos/controladores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/controladores#comparación","content":"Comparación"},"772":{"id":"/docs/personaje/v1/fundamentos/controladores-4","page_id":"/docs/personaje/v1/fundamentos/controladores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/controladores#elección-recomendada","content":"Elección recomendada"},"773":{"id":"/docs/personaje/v1/fundamentos/controladores-5","page_id":"/docs/personaje/v1/fundamentos/controladore