/avanzado/servidor-interno#servidor-local","content":"El servidor interno también puede ejecutarse dentro del mismo proceso de Unity. Esto permite conectar un `ClienteJuego` contra el servidor local sin depender de sockets externos."},"399":{"id":"/docs/red/v1/avanzado/servidor-interno-26","page_id":"/docs/red/v1/avanzado/servidor-interno","tags":[],"type":"text","url":"/docs/red/v1/avanzado/servidor-interno#servidor-local","content":"Workflow práctico para pruebas locales."},"400":{"id":"/docs/red/v1/avanzado/servidor-interno-27","page_id":"/docs/red/v1/avanzado/servidor-interno","tags":[],"type":"text","url":"/docs/red/v1/avanzado/servidor-interno#código-fuente","content":"Implementación principal del servidor de juego."},"401":{"id":"/docs/red/v1/avanzado/servidor-interno-28","page_id":"/docs/red/v1/avanzado/servidor-interno","tags":[],"type":"text","url":"/docs/red/v1/avanzado/servidor-interno#código-fuente","content":"Integración del servidor con el runtime de Unity."},"402":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","type":"page","content":"Sincronizar Rigidbody","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/sincronizar-rigidbody"},"403":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-0","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","tags":[],"type":"text","url":"/docs/red/v1/avanzado/sincronizar-rigidbody","content":"Patrón de sincronización física para objetos de Unity con autoridad local y observadores remotos."},"404":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-1","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/sincronizar-rigidbody#sincronizar-rigidbody","content":"Sincronizar Rigidbody"},"405":{"id":"/docs/red/v1/avanzado/sincronizar-rigidbody-2","page_id":"/docs/red/v1/avanzado/sincronizar-rigidbody","type":"heading","tags":[],"url":"/docs/red/v1