-33","page_id":"/docs/red/v1/avanzado/transportes-personalizados","tags":[],"type":"text","url":"/docs/red/v1/avanzado/transportes-personalizados#cierre","content":"Integración específica con Steam y plataformas externas."},"503":{"id":"/docs/red/v1/avanzado/transportes-personalizados-34","page_id":"/docs/red/v1/avanzado/transportes-personalizados","tags":[],"type":"text","url":"/docs/red/v1/avanzado/transportes-personalizados#cierre","content":"Dónde encaja `IConnection` dentro del sistema."},"504":{"id":"/docs/red/v1/avanzado/upnp","page_id":"/docs/red/v1/avanzado/upnp","type":"page","content":"UPnP y NAT","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/upnp"},"505":{"id":"/docs/red/v1/avanzado/upnp-0","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp","content":"Utilidades para descubrir direcciones y solicitar apertura de puertos en routers compatibles."},"506":{"id":"/docs/red/v1/avanzado/upnp-1","page_id":"/docs/red/v1/avanzado/upnp","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/upnp#upnp-y-nat","content":"UPnP y NAT"},"507":{"id":"/docs/red/v1/avanzado/upnp-2","page_id":"/docs/red/v1/avanzado/upnp","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/upnp#el-problema","content":"El problema"},"508":{"id":"/docs/red/v1/avanzado/upnp-3","page_id":"/docs/red/v1/avanzado/upnp","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/upnp#qué-aporta-upnp","content":"Qué aporta UPnP"},"509":{"id":"/docs/red/v1/avanzado/upnp-4","page_id":"/docs/red/v1/avanzado/upnp","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/upnp#flujo-recomendado","content":"Flujo recomendado"},"510":{"id":"/docs/red/v1/avanzado/upnp-5","page_id":"/docs/red/v1/avanzado/upnp","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/upnp#detectar-soporte","content":"Detectar soporte"},"511":{"id":"/docs/red/v1/avanzado/upnp-6","page_id":"/docs/red/v1/avanzado/upnp","type"