d/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#nivel-host-y-persistencia","content":"El canal representa una sesión que puede cerrarse y liberar su estado cuando ya no quedan participantes y no existen condiciones que lo mantengan abierto."},"3241":{"id":"/docs/red/v1/modelo/canales-30","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#nivel-host-y-persistencia","content":"El canal puede mantener su estado sin jugadores activos para poder ser recuperado posteriormente."},"3242":{"id":"/docs/red/v1/modelo/canales-31","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Si dos sistemas necesitan ciclos de vida diferentes, considera separarlos en canales distintos. Si sólo necesitas enviar una orden diferente a un jugador, probablemente no necesitas otro canal."},"3243":{"id":"/docs/red/v1/modelo/canales-32","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Necesidad"},"3244":{"id":"/docs/red/v1/modelo/canales-33","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Canal"},"3245":{"id":"/docs/red/v1/modelo/canales-34","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Mundo persistente"},"3246":{"id":"/docs/red/v1/modelo/canales-35","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Sí"},"3247":{"id":"/docs/red/v1/modelo/canales-36","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#reglas-de-diseño","content":"Partida independiente"},"3248":{"id":"/docs/red/v1/modelo/canales-37","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/mod