/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#referencias","content":"Repositorio upstream de referencia."},"499":{"id":"/docs/red/v1/guias","page_id":"/docs/red/v1/guias","type":"page","content":"Guías","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias"},"500":{"id":"/docs/red/v1/guias-0","page_id":"/docs/red/v1/guias","tags":[],"type":"text","url":"/docs/red/v1/guias","content":"Recorridos prácticos para integrar y utilizar Eco en un proyecto de Unity."},"501":{"id":"/docs/red/v1/guias-1","page_id":"/docs/red/v1/guias","type":"heading","tags":[],"url":"/docs/red/v1/guias#guías","content":"Guías"},"502":{"id":"/docs/red/v1/guias-2","page_id":"/docs/red/v1/guias","tags":[],"type":"text","url":"/docs/red/v1/guias#guías","content":"Las guías muestran cómo utilizar Eco para resolver tareas concretas. No pretenden explicar toda la arquitectura interna; para ello consulta Fundamentos."},"503":{"id":"/docs/red/v1/guias-3","page_id":"/docs/red/v1/guias","tags":[],"type":"text","url":"/docs/red/v1/guias#guías","content":"Conecta un cliente de Unity a un servidor Eco y verifica el estado de la sesión."},"504":{"id":"/docs/red/v1/guias-4","page_id":"/docs/red/v1/guias","tags":[],"type":"text","url":"/docs/red/v1/guias#guías","content":"Crea y utiliza un objeto de red dentro de un canal."},"505":{"id":"/docs/red/v1/guias-5","page_id":"/docs/red/v1/guias","tags":[],"type":"text","url":"/docs/red/v1/guias#guías","content":"Mantén el estado de una entidad sincronizado y entiende el papel del propietario y la autoridad."},"506":{"id":"/docs/red/v1/guias/multiples-canales","page_id":"/docs/red/v1/guias/multiples-canales","type":"page","content":"Varios canales simultáneos","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/multiples-canales"},"507":{"id":"/docs/red/v1/guias/multiples-canales-0","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"ty