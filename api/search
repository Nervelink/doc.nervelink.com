gadores, objetos y estado."},"2298":{"id":"/docs/red/v1/runtime/servidor-22","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Guarda y restaura el estado del mundo y puede dormir canales sin jugadores."},"2299":{"id":"/docs/red/v1/runtime/servidor-23","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Permite interceptar paquetes no gestionados mediante `onCustomPacket`."},"2300":{"id":"/docs/red/v1/runtime/servidor-24","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#preparación-step","content":"Configura identidad del servidor, persistencia, administración y transporte."},"2301":{"id":"/docs/red/v1/runtime/servidor-25","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#arranque-step","content":"`Start()` prepara TCP y el UDP opcional y activa el procesamiento de red."},"2302":{"id":"/docs/red/v1/runtime/servidor-26","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#aceptación-step","content":"`Listen()` mantiene la escucha de nuevas conexiones TCP y crea el estado asociado al participante."},"2303":{"id":"/docs/red/v1/runtime/servidor-27","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#operación-step","content":"El servidor procesa paquetes, actualiza jugadores y canales y ejecuta las operaciones autoritativas."},"2304":{"id":"/docs/red/v1/runtime/servidor-28","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#cierre-step","content":"La detención del servidor finaliza las conexiones y permite guardar el estado si la configuración lo requiere."},"2305":{"id":"/docs/red/v1/runtime/servidor-29","page_id":"/docs/red/v1/runtime/servidor","tags":