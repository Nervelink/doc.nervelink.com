/comunicacion/rcr#relación-con-eco","content":"Ejecutar un método remoto sobre una entidad existente."},"1463":{"id":"/docs/red/v1/comunicacion/rcr-17","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#relación-con-eco","content":"Solicitud de creación local."},"1464":{"id":"/docs/red/v1/comunicacion/rcr-18","page_id":"/docs/red/v1/comunicacion/rcr","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcr#relación-con-eco","content":"Identidad, ownership y ciclo de vida de los objetos de Eco."},"1465":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"page","content":"RMR avanzadas","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas"},"1466":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-0","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas","content":"RMR, llamadas persistentes, respuesta y patrones avanzados de comunicación de Eco."},"1467":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-1","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rmr-avanzadas","content":"RMR avanzadas"},"1468":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-2","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rmr-básica","content":"RMR básica"},"1469":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-3","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#destinatarios","content":"Destinatarios"},"1470":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-4","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rmr-persistente","content":"RMR persistente"},