ersistentes, lobbies estables o espacios que no deben desaparecer simplemente porque estén vacíos."},"1814":{"id":"/docs/red/v1/persistencia/canales-9","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#persistente-no-significa-inmortal","content":"El servidor sigue pudiendo cerrar explícitamente el canal. `RequestCloseChannel` está definido como una operación que marca el canal para cierre y elimina sus datos guardados. fileciteturn227file0"},"1815":{"id":"/docs/red/v1/persistencia/canales-10","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#memoria","content":"La persistencia y la memoria activa son conceptos distintos. `ServidorJuego.Sleep()` puede descargar de memoria canales sin jugadores y `Wake()` volver a activarlos. fileciteturn233file0"},"1816":{"id":"/docs/red/v1/persistencia/canales-11","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Caso"},"1817":{"id":"/docs/red/v1/persistencia/canales-12","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Persistente"},"1818":{"id":"/docs/red/v1/persistencia/canales-13","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Partida temporal de cuatro jugadores"},"1819":{"id":"/docs/red/v1/persistencia/canales-14","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Normalmente no"},"1820":{"id":"/docs/red/v1/persistencia/canales-15","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Mundo persistente"},"1821":{"id":"/docs/red/v1/persistencia/canales-16","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Sí"},"1822":{"id":"/docs/red/v1/persistencia/canales-17","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Evento que debe desaparecer al terminar"},"1823":{"id":"/docs/red/v1/persistencia/canales-18","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"No"},"1824":{"id":"/docs/red/v1/persistencia/canales-19","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Lobby estable"},"1825":{"id":"/docs/red/v1/persistencia/canales-20","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Puede serlo"},"1826":{"id":"/docs/red/v1/persistencia/canales-21","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#referencias","content":"Uso de varios canales desde un único cliente."},"1827":{"id":"/docs/red/v1/persistencia/estado","page_id":"/docs/red/v1/persistencia/estado","type":"page","content":"Estado persistente","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/estado"},"1828":{"id":"/docs/red/v1/persistencia/estado-0","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"Estado persistente"},"1829":{"id":"/docs/red/v1/persistencia/estado-1","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#capas-de-estado","content":"Capas de estado"},"1830":{"id":"/docs/red/v1/persistencia/estado-2","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"Qué guardar"},"1831":{"id":"/docs/red/v1/persistencia/estado-3","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#qué-no-guardar","content":"Qué no guardar"},"1832":{"id":"/docs/red/v1/persistencia/estado-4","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#guardado-y-sueño","content":"Guardado y sueño"},"1833":{"id":"/docs/red/v1/persistencia/estado-5","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#integración-con-el-guardado-del-juego","content":"Integración con el guardado del juego"},"1834":{"id":"/docs/red/v1/persistencia/estado-6","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"La persistencia registra información de red que debe sobrevivir a determinados cambios de sesión. No significa que cada dato enviado por el juego se escriba inmediatamente en disco."},"1835":{"id":"/docs/red/v1/persistencia/estado-7","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#capas-de-estado","content":"`ServidorJuego` mantiene un archivo de mundo y funciones de lectura/escritura que pueden sustituirse por otro almacenamiento, como un servicio externo. fileciteturn233file0"},"1836":{"id":"/docs/red/v1/persistencia/estado-8","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"Guarda aquello que otro proceso o jugador debe poder reconstruir sin depender de eventos que ya ocurrieron."},"1837":{"id":"/docs/red/v1/persistencia/estado-9","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","con