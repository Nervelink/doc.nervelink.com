1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red","content":"Actualizador centralizado de ciclos de vida y callbacks para reducir el número de MonoBehaviour con Update."},"226":{"id":"/docs/red/v1/avanzado/actualizador-red-1","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#actualizadorred","content":"ActualizadorRed"},"227":{"id":"/docs/red/v1/avanzado/actualizador-red-2","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#por-qué-existe","content":"Por qué existe"},"228":{"id":"/docs/red/v1/avanzado/actualizador-red-3","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#contratos","content":"Contratos"},"229":{"id":"/docs/red/v1/avanzado/actualizador-red-4","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#alta-y-baja","content":"Alta y baja"},"230":{"id":"/docs/red/v1/avanzado/actualizador-red-5","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#una-sola-ejecución","content":"Una sola ejecución"},"231":{"id":"/docs/red/v1/avanzado/actualizador-red-6","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#invoke-sin-monobehaviour","content":"Invoke sin MonoBehaviour"},"232":{"id":"/docs/red/v1/avanzado/actualizador-red-7","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#coroutines","content":"Coroutines"},"233":{"id":"/docs/red/v1/avanzado/actualizador-red-8","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"Thread safety"},"234":{"id":"/docs/red/v1/avanzado/actualizador-red-9","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Relación con Componente"},"235":{"id":"/docs/red/v1/avanzado/actualizador-red-10","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#actualizadorred","content":"`ActualizadorRed` es un scheduler centralizado utilizado por Eco para ejecutar `OnStart`, `OnUpdate`, `OnLateUpdate`, actualizaciones poco frecuentes, callbacks de una sola ejecución y pequeñas coroutines."},"236":{"id":"/docs/red/v1/avanzado/actualizador-red-11","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#por-qué-existe","content":"Unity ejecuta `Update` y `LateUpdate` de cada `MonoBehaviour` habilitado. Cuando un proyecto contiene cientos o miles de componentes pequeños, centralizar parte de esos ciclos puede reducir overhead y mejorar el control del scheduler."},"237":{"id":"/docs/red/v1/avanzado/actualizador-red-12","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#alta-y-baja","content":"La implementación utiliza conjuntos para las actualizaciones normales y colas auxiliares cuando un objeto se elimina durante el propio recorrido."},"238":{"id":"/docs/red/v1/avanzado/actualizador-red-13","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#una-sola-ejecución","content":"Esto es útil para diferir una operación al siguiente ciclo sin crear un `MonoBehaviour` adicional."},"239":{"id":"/docs/red/v1/avanzado/actualizador-red-14","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#coroutines","content":"El scheduler también puede mantener coroutines basadas en `TareaParalela.EnumFunc` y procesarlas fuera del `MonoBehaviour` que las originó."},"240":{"id":"/docs/red/v1/avanzado/actualizador-red-15","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"La implementación actual permite `THREAD_SAFE_UPDATER`, protegiendo las colecciones internas con lock. Esto es especialmente importante cuando una tarea de red o worker registra callbacks desde otro hilo."},"241":{"id":"/docs/red/v1/avanzado/actualizador-red-16","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"Que el scheduler sea seguro para registrar callbacks no significa que `UnityEngine` sea thread-safe. Los callbacks que toquen objetos de Unity deben ejecutarse en el hilo de Unity."},"242":{"id":"/docs/red/v1/avanzado/actualizador-red-17","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"`Componente.Awake()` registra su inicialización mediante `ActualizadorRed.AddStart(this)`. Por eso la documentación de `Componente` no debe asumir que toda la inicialización de red ocurre directamente en `Start()`."},"243":{"id":"/docs/red/v1/avanzado/actualizador-red-18","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Clase base que utiliza `ActualizadorRed` durante la inicialización."},"244":{"id":"/docs/red/v1/avanzado/actualizador-red-19","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Implementación actual del scheduler."},"245":{"id":"/docs/red/v1/avanzado","page_id":"/docs/red/v1/avanzado","type":"page","content":"Funciones avanzadas","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado"},"246":{"id":"/docs/red/v1/avanzado-0","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado","content":"Herramientas de Eco que amplían el runtime básico para rendimiento, integraciones y escenarios especializados."},"247":{"id":"/docs/red/v1/avanzado-1","page_id":"/docs/red/v1/avanzado","type":"heading","tags":[],"url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Funciones avanzadas"},"248":{"id":"/docs/red/v1/avanzado-2","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Esta sección reúne capacidades que no necesitas para una integración básica, pero que resultan relevantes cuando el proyecto crece o necesita integraciones específicas."},"249":{"id":"/docs/red/v1/avanzado-3","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Centraliza `OnStart`, `Update`, `LateUpdate`, callbacks one-shot, invocaciones y coroutines para reducir el coste de muchos `MonoBehaviour`."},"250":{"id":"/docs/red/v1/avanzado-4","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Sincronización orientada a física de Unity y separación entre propietario y observadores."},"251":{"id":"/docs/red/v1/avanzado-5","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Compilación y ejecución de código C# en runtime para casos de modding y extensibilidad."},"252":{"id":"/docs/red/v1/avanzado-6","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Descubrimiento y anuncio de servidores mediante el sistema de lobby de Eco."},"253":{"id":"/docs/red/v1/avanzado-7","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Integración con Steam Networking y sustitución de sockets mediante `IConnection`."},"254":{"id":"/docs/red/v1/avanzado-8","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Herramientas para descubrimiento de direcciones y apertura de puertos en routers compatibles."},"255":{"id":"/docs/red/v1/avanzado-9","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Estas herramientas existen para resolver necesidades concretas. Empieza por la API normal de `Eco` y añade estas capacidades cuando el problema que intentas resolver realmente las necesite."},"256":{"id":"/docs/red/v1/avanzado/lobby","page_id":"/docs/red/v1/avanzado/lobby","type":"page","content":"Lobby","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/lobby"},"257":{"id":"/docs/red/v1/avanzado/lobby-0","page_id":"/docs/red/v1/avanzado/lobby","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby","content":"Descubrimiento de servidores mediante el sistema de lobby de Eco."},"258":{"id":"/docs/red/v1/avanzado/lobby-1","page_id":"/docs/red/v1/avanzado/lobby","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby#lobby","content":"Lobby"},"259":{"id":"/docs/red/v1/avanzado/lobby-2","page_id":"/docs/red/v1/avanzado/lobby","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby#arquitectura","content":"Arquitectura"},"260":{"id":"/docs/red/v1/avanzado/lobby-3","page_id":"/docs/red/v1/avanzado/lobby","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"261":{"id":"/docs/red/v1/avanzado/lobby-4","page_id":"/docs/red/v1/avanzado/lobby","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby#datos-publicados","content":"Datos publicados"},"262":{"id":"/docs/red/v1/avanzado/lobby-5","page_id":"/docs/red/v1/avanza