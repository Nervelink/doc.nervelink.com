d/v1/objetos-21","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Rango"},"391":{"id":"/docs/red/v1/objetos-22","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Uso"},"392":{"id":"/docs/red/v1/objetos-23","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Estático"},"393":{"id":"/docs/red/v1/objetos-24","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"`1`–`32767`"},"394":{"id":"/docs/red/v1/objetos-25","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Objetos que ya existen en la escena"},"395":{"id":"/docs/red/v1/objetos-26","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Dinámico"},"396":{"id":"/docs/red/v1/objetos-27","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"`32768`–`16777215`"},"397":{"id":"/docs/red/v1/objetos-28","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Objetos creados durante la sesión"},"398":{"id":"/docs/red/v1/objetos-29","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"El objeto también expone `uid`, que combina el identificador del canal con el identificador del objeto:"},"399":{"id":"/docs/red/v1/objetos-30","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Esto permite distinguir el mismo identificador de objeto en diferentes canales. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"400":{"id":"/docs/red/v1/objetos-31","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#identidad-de-red","content":"Los objetos estáticos y dinámicos no tienen exactamente el mismo ciclo de vida. Entre otras diferencias, los objetos estáticos no permiten cambiar su propietario mediante `ownerID`, mientras que los dinámicos sí."},"401":{"id":"/docs/red/v1/objetos-32","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#canal","content":"Cada objeto tiene asociado un `channelID`. La asociación al canal define el contexto de red en el que ese objeto puede ser localizado y en el que se evalúan operaciones como propiedad, envío y transferencia."},"402":{"id":"/docs/red/v1/objetos-33","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#canal","content":"El código de Eco mantiene tablas de objetos indexadas por canal para permitir tanto iteración como búsqueda rápida. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"403":{"id":"/docs/red/v1/objetos-34","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#registro","content":"El objeto distingue entre haber sido registrado y estar todavía en proceso de creación."},"404":{"id":"/docs/red/v1/objetos-35","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#registro","content":"`hasBeenRegistered` indica que la creación ha terminado y que el objeto ya tiene asignado su identificador de red correspondiente. `hasBeenDestroyed` marca el objeto inmediatamente cuando comienza su destrucción para impedir que se sigan enviando mensajes durante el intervalo entre la solicitud y la confirmación del servidor. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"405":{"id":"/docs/red/v1/objetos-36","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#registro","content":"El estado útil para razonar sobre un objeto es, por tanto:"},"406":{"id":"/docs/red/v1/objetos-37","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#registro","content":"La creación y destrucción concretas, incluida la instanciación dinámica, se documentarán en su propio apartado cuando entremos en el ciclo de vida completo."},"407":{"id":"/docs/red/v1/objetos-38","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"`PuedeEnviar` indica si el objeto puede enviar mensajes en el estado actual."},"408":{"id":"/docs/red/v1/objetos-39","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"En una aplicación desconectada, el objeto no queda bloqueado por la capa de red. Una vez conectada la aplicación, el envío requiere que:"},"409":{"id":"/docs/red/v1/objetos-40","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"el objeto tenga un identificador válido;"},"410":{"id":"/docs/red/v1/objetos-41","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"no esté destruido;"},"411":{"id":"/docs/red/v1/objetos-42","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"el cliente pertenezca al canal del objeto;"},"412":{"id":"/docs/red/v1/objetos-43","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"el cliente no esté todavía completando la entrada en ese canal."},"413":{"id":"/docs/red/v1/objetos-44","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#capacidad-de-envío","content":"Esto es especialmente relevante durante cambios de escena o uniones a canales, donde un objeto puede existir localmente antes de que la conexión esté preparada para enviar sus mensajes. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"414":{"id":"/docs/red/v1/objetos-45","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#propiedad","content":"La propiedad determina qué `Jugador` controla un objeto dinámico para las operaciones que requieren autoridad."},"415":{"id":"/docs/red/v1/objetos-46","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#propiedad","content":"Las propiedades principales son:"},"416":{"id":"/docs/red/v1/objetos-47","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#propiedad","content":"`isMine` permite comprobar si el propietario es el jugador local. `owner` devuelve el objeto `Jugador` asociado y `ownerID` expone su identificador."},"417":{"id":"/docs/red/v1/objetos-48","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#propiedad","content":"Cuando se cambia `ownerID`, Eco actualiza primero el estado local y después envía `RequestSetOwner` al servidor. El nuevo propietario debe ser el jugador local, un jugador válido del canal o `0`. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"418":{"id":"/docs/red/v1/objetos-49","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#propiedad","content":"Ser visible para un jugador no significa ser suyo. Un objeto puede existir en varios clientes mientras uno de ellos mantiene la propiedad utilizada para determinadas operaciones de red."},"419":{"id":"/docs/red/v1/objetos-50","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#componentes","content":"Los `Componente` se asocian a un `Objeto` y contienen la lógica de red especializada."},"420":{"id":"/docs/red/v1/objetos-51","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#componentes","content":"Un `Componente` busca automáticamente un `Objeto` en su jerarquía de Unity durante `Awake`/`OnStart`. Si no encuentra uno y `ignoreMissingTNO` está desactivado, Eco puede crear un `Objeto` local para que el componente funcione, aunque el código advierte que esto por sí solo no garantiza una comunicación de red válida. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Componente.cs"},"421":{"id":"/docs/red/v1/objetos-52","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#componentes","content":"Esta relación es importante: `Objeto` proporciona la identidad de red y los `Componente` proporcionan el comportamiento."},"422":{"id":"/docs/red/v1/objetos-53","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#datos-asociados","content":"Cada objeto puede mantener un `Nodo` de datos accesible mediante `Get`, `Get<T>`, `Set` y `nodo`."},"423":{"id":"/docs/red/v1/objetos-54","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#datos-asociados","content":"El setter de datos modifica inmediatamente el estado local. Cuando la sincronización está activa, Eco decide cómo propagar el cambio en función de si el cliente actual es el propietario y de si el objeto puede enviar en ese momento. Los cambios pueden quedar en cola hasta que el objeto vuelva a estar preparado para enviar. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"424":{"id":"/docs/red/v1/objetos-55","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#datos-asociados","content":"La sincronización de estos datos se explica con detalle en la sección de sincronización."},"425":{"id":"/docs/red/v1/objetos-56","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#eventos-del-ciclo-de-vida","content":"`Objeto` expone callbacks específicos para dos transiciones relevantes:"},"426":{"id":"/docs/red/v1/objetos-57","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#eventos-del-ciclo-de-vida","content":"`onDestroy` se ejecuta antes de las notificaciones normales de `OnDestroy` de Unity. `onTransfer` permite reaccionar cuando el objeto se traslada a otro canal. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"427":{"id":"/docs/red/v1/objetos-58","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#eventos-del-ciclo-de-vida","content":"Esto permite separar el ciclo de vida de red del ciclo de vida del `GameObject` de Unity."},"428":{"id":"/docs/red/v1/objetos-59","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#relación-con-eco","content":"Aunque el objeto encapsula gran parte del estado de red, la gestión global pertenece a `Eco`. Por ejemplo, la pertenencia a canales y la conexión se consultan a través de Eco, mientras que el objeto decide si su propio estado permite enviar."},"429":{"id":"/docs/red/v1/objetos-60","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#correspondencia-con-tnet","content":"Eco"},"430":{"id":"/docs/red/v1/objetos-61","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#correspondencia-con-tnet","content":"TNet"},"431":{"id":"/docs/red/v1/objetos-62","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#correspondencia-con-tnet","content":"Función"},"432":{"id":"/docs/red/v1/objetos-63","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#correspondencia-con-tnet","content":"`Objeto`"},"433":{"id":"/docs/red/v1/objetos-64","page_id":"/docs/red/v1/objetos","tags":[],"type":"text","url":"/docs/red/v1/objetos#correspondencia-con-tnet","content":"`TNObject`"},"434":{"id":"/docs/red/v1/objetos-65","page_id"