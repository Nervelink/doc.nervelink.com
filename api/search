:[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"guardar todo como objeto persistente"},"690":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-32","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"crecimiento de estado y coste de restauración"},"691":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-33","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"No es una regla absoluta para todas las simulaciones, pero es un excelente punto de partida para diseñar juegos cooperativos y competitivos con Eco."},"692":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-34","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Aislamiento y pertenencia de jugadores."},"693":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-35","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Datos y objetos que sobreviven a la sesión inmediata."},"694":{"id":"/docs/red/v1/fundamentos/conceptos","page_id":"/docs/red/v1/fundamentos/conceptos","type":"page","content":"Conceptos","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/conceptos"},"695":{"id":"/docs/red/v1/fundamentos/conceptos-0","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"696":{"id":"/docs/red/v1/fundamentos/conceptos-1","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Conceptos"},"697":{"id":"/docs/red/v1/fundamentos/conceptos-2","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"Conexión"},"698":{"id":"/docs/red/v1/fundamentos/conceptos-3","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Jugador"},"699":{"id":"/docs/red/v1/fundamentos/conceptos-4","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Canal"},"700":{"id":"/docs/red/v1/fundamentos/conceptos-5","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Objeto"},"701":{"id":"/docs/red/v1/fundamentos/conceptos-6","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Componente"},"702":{"id":"/docs/red/v1/fundamentos/conceptos-7","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"Propietario"},"703":{"id":"/docs/red/v1/fundamentos/conceptos-8","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Paquete"},"704":{"id":"/docs/red/v1/fundamentos/conceptos-9","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Buffer"},"705":{"id":"/docs/red/v1/fundamentos/conceptos-10","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Estado"},"706":{"id":"/docs/red/v1/fundamentos/conceptos-11","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"707":{"id":"/docs/red/v1/fundamentos/conceptos-12","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"708":{"id":"/docs/red/v1/fundamentos/conceptos-13","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#referencias","content":"Referencias"},"709":{"id":"/docs/red/v1/fundamentos/conceptos-14","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Eco organiza la red alrededor de unas pocas piezas fundamentales. Entender su relación evita confundir conexión, canal, jugador, objeto y componente."},"710":{"id":"/docs/red/v1/fundamentos/conceptos-15","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Una conexión representa la comunicación con el servidor; un jugador representa a un participante; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"711":{"id":"/docs/red/v1/fundamentos/conceptos-16","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. No define por sí sola qué objetos o estado debe conocer el cliente."},"712":{"id":"/docs/red/v1/fundamentos/conceptos-17","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. Sirve para identificar presencia, propiedad y destinatarios."},"713":{"id":"/docs/red/v1/fundamentos/conceptos-18","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Un mismo jugador puede participar simultáneamente en varios canales."},"714":{"id":"/docs/red/v1/fundamentos/conceptos-19","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"715":{"id":"/docs/red/v1/fundamentos/conceptos-20","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Esta separación permite mantener la identidad de red independiente de la funcionalidad concreta."},"716":{"id":"/docs/red/v1/fundamentos/conceptos-21","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"El propietario identifica al jugador que tiene autoridad sobre determinadas operaciones del objeto. La propiedad no implica que el objeto sea invisible para los demás participantes."},"717":{"id":"/docs/red/v1/fundamentos/conceptos-22","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Un `Paquete` representa una unidad del protocolo de Eco. Transporta comandos, eventos y datos entre clientes y servidor."},"718":{"id":"/docs/red/v1/fundamentos/conceptos-23","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"719":{"id":"/docs/red/v1/fundamentos/conceptos-24","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Eco distingue entre comunicar una acción y mantener un estado. Una RFC puede comunicar que algo ocurrió; un mecanismo de sincronización mantiene valores que deben converger entre participantes."},"720":{"id":"/docs/red/v1/fundamentos/conceptos-25","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Eco"},"721":{"id":"/docs/red/v1/fundamentos/conceptos-26","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"TNet"},"722":{"id":"/docs/red/v1/fundamentos/conceptos-27","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Función"},"723":{"id":"/docs/red/v1/fundamentos/conceptos-28","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Eco`"},"724":{"id":"/docs/red/v1/fundamentos/conceptos-29","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`TNManager`"},"725":{"id":"/docs/red/v1/fundamentos/conceptos-30","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Gestión principal del cliente"},"726":{"id":"/docs/red/v1/fundamentos/conceptos-31","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Jugador`"},"727":{"id":"/docs/red/v1/fundamentos/conceptos-32","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":