tos/conceptos-5","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Objeto"},"183":{"id":"/docs/red/v1/fundamentos/conceptos-6","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Componente"},"184":{"id":"/docs/red/v1/fundamentos/conceptos-7","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"Propietario"},"185":{"id":"/docs/red/v1/fundamentos/conceptos-8","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Paquete"},"186":{"id":"/docs/red/v1/fundamentos/conceptos-9","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Buffer"},"187":{"id":"/docs/red/v1/fundamentos/conceptos-10","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Estado"},"188":{"id":"/docs/red/v1/fundamentos/conceptos-11","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"189":{"id":"/docs/red/v1/fundamentos/conceptos-12","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"190":{"id":"/docs/red/v1/fundamentos/conceptos-13","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#referencias","content":"Referencias"},"191":{"id":"/docs/red/v1/fundamentos/conceptos-14","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Eco organiza la red alrededor de unas pocas piezas fundamentales. Entender su relación evita confundir conexión, canal, jugador, objeto y componente."},"192":{"id":"/docs/red/v1/fundamentos/conceptos-15","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Una conexión representa la comunicación con el servidor; un jugador representa a un participante; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"193":{"id":"/docs/red/v1/fundamentos/conceptos-16","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. No define por sí sola qué objetos o estado debe conocer el cliente."},"194":{"id":"/docs/red/v1/fundamentos/conceptos-17","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. Sirve para identificar presencia, propiedad y destinatarios."},"195":{"id":"/docs/red/v1/fundamentos/conceptos-18","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Un mismo jugador puede participar simultáneamente en varios canales."},"196":{"id":"/docs/red/v1/fundamentos/conceptos-19","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"197":{"id":"/docs/red/v1/fundamentos/conceptos-20","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Esta separación permite mantener la identidad de red independiente de la funcionalidad concreta."},"198":{"id":"/docs/red/v1/fundamentos/conceptos-21","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#propietario","content":"El propietario identifica al jugador que tiene autoridad sobre determinadas operaciones del objeto. La propiedad no implica que el objeto sea invisible para los demás participantes."},"199":{"id":"/docs/red/v1/fundamentos/conceptos-22","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#paquete","content":"Un `Paquete` representa una unidad del protocolo de Eco. Transporta comandos, eventos y datos entre clientes y servidor."},"200":{"id":"/docs/red/v1/fundamentos/conceptos-23","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"201":{"id":"/docs/red/v1/fundamentos/conceptos-24","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#estado","content":"Eco distingue entre comunicar una acción y mantener un estado. Una RFC puede comunicar que algo ocurrió; un mecanismo de sincronización mantiene valores que deben converger entre participantes."},"202":{"id":"/docs/red/v1/fundamentos/conceptos-25","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Eco"},"203":{"id":"/docs/red/v1/fundamentos/conceptos-26","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"TNet"},"204":{"id":"/docs/red/v1/fundamentos/conceptos-27","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Función"},"205":{"id":"/docs/red/v1/fundamentos/conceptos-28","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Eco`"},"206":{"id":"/docs/red/v1/fundamentos/conceptos-29","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`TNManager`"},"207":{"id":"/docs/red/v1/fundamentos/conceptos-30","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Gestión principal del cliente"},"208":{"id":"/docs/red/v1/fundamentos/conceptos-31","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Jugador`"},"209":{"id":"/docs/red/v1/fundamentos/conceptos-32","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Player`"},"210":{"id":"/docs/red/v1/fundamentos/conceptos-33","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Participante de la sesión"},"211":{"id":"/docs/red/v1/fundamentos/conceptos-34","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Canal`"},"212":{"id":"/docs/red/v1/fundamentos/conceptos-35","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Channel` / `TNChannel`"},"213":{"id":"/docs/red/v1/fundamentos/conceptos-36","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Ámbito de estado compartido"},"214":{"id":"/docs/red/v1/fundamentos/conceptos-37","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Objeto`"},"215":{"id":"/docs/red/v1/fundamentos/conceptos-38","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`TNObject`"},"216":{"id":"/docs/red/v1/fundamentos/conceptos-39","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Identidad de red"},"217":{"id":"/docs/red/v1/fundamentos/conceptos-40","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Componente`"},"218":{"id":"/docs/red/v1/fundamentos/conceptos-41","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`TNBehaviour`"},"219":{"id":"/docs/red/v1/fundamentos/conceptos-42","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"Comportamiento asociado al objeto"},"220":{"id":"/docs/red/v1/fundamentos/conceptos-43","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Paquete`"},"221":{"id":"/docs/red/v1/fundamentos/conceptos-44","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos#correspondencia-con-tnet","content":"`Packet` / `TNPacket`"},"222":{"id":"/docs/red/v1/fu