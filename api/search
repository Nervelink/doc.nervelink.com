v1/guias/transferir-objeto-canal#referencias-locales","content":"Referencias locales"},"2865":{"id":"/docs/red/v1/guias/transferir-objeto-canal-8","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"Qué no hacer"},"2866":{"id":"/docs/red/v1/guias/transferir-objeto-canal-9","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"2867":{"id":"/docs/red/v1/guias/transferir-objeto-canal-10","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Relación con ownership"},"2868":{"id":"/docs/red/v1/guias/transferir-objeto-canal-11","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-eco","content":"Referencia a Eco"},"2869":{"id":"/docs/red/v1/guias/transferir-objeto-canal-12","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Referencia a TNet"},"2870":{"id":"/docs/red/v1/guias/transferir-objeto-canal-13","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Eco permite transferir un objeto de red a otro canal. La operación no debe tratarse como un simple cambio local de `channelID`: el objeto cambia de contexto de red y la implementación debe coordinar la operación con el servidor."},"2871":{"id":"/docs/red/v1/guias/transferir-objeto-canal-14","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Durante una transferencia el objeto puede quedar temporalmente marcado como destruido para impedir que se envíen RFC en un estado intermedio. Espera a que la transferencia termine antes de asumir que el objeto está listo para comunicarse en el nuevo canal."},"2872":{"id":"/docs/red/v1/guias/transferir-objeto-canal-15","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Un `Objeto` pertenece siempre a un canal concreto y su identificador completo utiliza ambos datos:"},"2873":{"id":"/docs/red/v1/guias/transferir-objeto-canal-16","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Por eso moverlo de un canal a otro no es simplemente actualizar una variable local. El nuevo contexto forma parte de la identidad de red del objeto."},"2874":{"id":"/docs/red/v1/guias/transferir-objeto-canal-17","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"El flujo conceptual es:"},"2875":{"id":"/docs/red/v1/guias/transferir-objeto-canal-18","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"Durante el proceso Eco evita tratar el objeto como completamente operativo hasta que la transferencia ha finalizado."},"2876":{"id":"/docs/red/v1/guias/transferir-objeto-canal-19","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"`Objeto` expone el callback `onTransfer`, que recibe el nuevo canal y el nuevo ID:"},"2877":{"id":"/docs/red/v1/guias/transferir-objeto-canal-20","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"Esto permite reconstruir referencias locales que dependan del canal o del identificador dinámico."},"2878":{"id":"/docs/red/v1/guias/transferir-objeto-canal-21","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"Como `uid` combina el canal y el ID:"},"2879":{"id":"/docs/red/v1/guias/transferir-objeto-canal-22","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"no conviene guardar un `uid` como referencia permanente si el objeto puede transferirse. Después de la operación, vuelve a consultar `uid`, `channelID` e `id`."},"2880":{"id":"/docs/red/v1/guias/transferir-objeto-canal-23","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#objetos-estáticos-frente-a-dinámicos","content":"La propiedad de los objetos estáticos está restringida y no deben tratarse igual que los objetos dinámicos. Para transferencias dinámicas, el ciclo de vida debe mantenerse coordinado con el servidor."},"2881":{"id":"/docs/red/v1/guias/transferir-objeto-canal-24","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencias-locales","content":"Evita asumir que una referencia de un sistema externo sigue siendo válida sólo porque la instancia de Unity no ha cambiado. El objeto puede seguir siendo la misma instancia, pero su contexto de red habrá cambiado."},"2882":{"id":"/docs/red/v1/guias/transferir-objeto-canal-25","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"No cambies manualmente `channelID` para simular una transferencia. Tampoco continúes enviando mensajes usando el contexto antiguo mientras la operación está pendiente."},"2883":{"id":"/docs/red/v1/guias/transferir-objeto-canal-26","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"La transferencia es una operación del modelo de red, no una reasignación de datos de gameplay."},"2884":{"id":"/docs/red/v1/guias/transferir-objeto-canal-27","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Un caso habitual es mover entidades entre ámbitos de juego:"},"2885":{"id":"/docs/red/v1/guias/transferir-objeto-canal-28","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"La utilidad depende de que el objeto deba mantener continuidad lógica entre esos ámbitos. Cuando no sea necesario conservar la identidad, puede ser más sencillo destruir el objeto anterior y crear uno nuevo en el canal destino."},"2886":{"id":"/docs/red/v1/guias/transferir-objeto-canal-29","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Transferir de canal y transferir ownership son operaciones distintas. El cambio de canal modifica el contexto al que pertenece el objeto; `owner` determina qué jugador tiene autoridad sobre ese objeto."},"2887":{"id":"/docs/red/v1/guias/transferir-objeto-canal-30","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"No asumas que una transferencia de canal equivale automáticamente a transferir propiedad."},"2888":{"id":"/docs/red/v1/guias/transferir-objeto-canal-31","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-eco","content":"La implementación de `Objeto` expone `channelID`, `id`, `uid`, `hasBeenDestroyed`, `onTransfer` y la lógica relacionada con el ciclo de vida del objeto. La documentación debe considerarse subordinada al comportamiento del repositorio actual."},"2889":{"id":"/docs/red/v1/guias/transferir-objeto-canal-32","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"El concepto procede del modelo de objetos por canal de TNet, pero la API utilizada aquí pertenece a Eco. Los ejemplos antiguos de TNet no deben utilizarse como API literal."},"2890":{"id":"/docs/red/v1/guias/transferir-objeto-canal-33","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Referencia del ciclo de vida e identidad de los objetos de red."},"2891":{"id":"/docs/red/v1/guias/transferir-objeto-canal-34","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Uso práctico de varios canales desde una misma conexión."},"2892":{"id":"/docs/red/v1/guias/transferir-objeto-canal-35","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Diferencia entre cambiar de canal y cambiar de propietario."},"2893":{"id":"/docs/red/v1/guias/transferir-objeto-canal-36","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Código fuente de la implementación actual."},"2894":{"id":"/docs/red/v1/guias/transferir-propiedad","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"page","content":"Transferir la propiedad de un objeto","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/transferir-propiedad"},"2895":{"id":"/docs/red/v1/guias/transferir-propiedad-0","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#transferir-la-propiedad-de-un-objeto","content":"Transferir la propiedad de un objeto"},"2896":{"id":"/docs/red/v1/guias/transferir-propiedad-1","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#identificar-al-propietario","content":"Identificar al propietario"},"2897":{"id":"/docs/red/v1/guias/transferir-propiedad-2","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#transferir-a-otro-jugador","content":"Transferir a otro jugador"},"2898":{"id":"/docs/red/v1/guias/transferir-propiedad-3","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#condición-mismo-canal","content":"Condición: mismo canal"},"2899":{"id":"/docs/red/v1/guias/transferir-propiedad-4","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#transferencia-a-nadie","content":"Transferencia a nadie"},"2900":{"id":"/docs/red/v1/guias/transferir-propiedad-5","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#autoridad-y-diseño-de-gameplay","content":"Autoridad y diseño de gameplay"},"2901":{"id":"/docs/red/v1/guias/transferir-propiedad-6","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-propiedad#propiedad-y-sincronización","content":"Propiedad y sincronización"},"2902":{"id":"/docs/red/v1/guias/transferir-propiedad-7","page_id":"/docs/red/v1/guias/transferir-propi