-canales-45","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Separar transporte físico"},"1708":{"id":"/docs/red/v1/guias/multiples-canales-46","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"No"},"1709":{"id":"/docs/red/v1/guias/multiples-canales-47","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"Representar una entidad del mundo"},"1710":{"id":"/docs/red/v1/guias/multiples-canales-48","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#cuándo-utilizar-canales","content":"No; utiliza un `Objeto`"},"1711":{"id":"/docs/red/v1/guias/multiples-canales-49","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#relación-con-tnet","content":"El modelo multicanal procede de la arquitectura de TNet y Eco mantiene esta capacidad con su propia API. Para consultar el comportamiento actual, la fuente normativa es `ClienteJuego` y `Canal` dentro de `Nervelink/eco`."},"1712":{"id":"/docs/red/v1/guias/multiples-canales-50","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#relación-con-tnet","content":"La ventaja de esta documentación frente a los ejemplos antiguos es que **no debemos asumir un único canal activo por cliente**."},"1713":{"id":"/docs/red/v1/guias/multiples-canales-51","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Referencia completa del ciclo de vida y estado de un canal."},"1714":{"id":"/docs/red/v1/guias/multiples-canales-52","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Gestión de conexión y canales desde el cliente."},"1715":{"id":"/docs/red/v1/guias/multiples-canales-53","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Repositorio upstream de la arquitectura heredada."},"1716":{"id":"/docs/red/v1/guias/multiples-canales-54","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Referencia externa para contrastar el modelo de canales de TNet."},"1717":{"id":"/docs/red/v1/guias/persistir-partida","page_id":"/docs/red/v1/guias/persistir-partida","type":"page","content":"Persistir una partida","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/persistir-partida"},"1718":{"id":"/docs/red/v1/guias/persistir-partida-0","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#persistir-una-partida","content":"Persistir una partida"},"1719":{"id":"/docs/red/v1/guias/persistir-partida-1","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#qué-puede-persistir","content":"Qué puede persistir"},"1720":{"id":"/docs/red/v1/guias/persistir-partida-2","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#objetos-persistentes","content":"Objetos persistentes"},"1721":{"id":"/docs/red/v1/guias/persistir-partida-3","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#datos-persistentes","content":"Datos persistentes"},"1722":{"id":"/docs/red/v1/guias/persistir-partida-4","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#rfc-persistentes","content":"RFC persistentes"},"1723":{"id":"/docs/red/v1/guias/persistir-partida-5","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#guardado-del-servidor","content":"Guardado del servidor"},"1724":{"id":"/docs/red/v1/guias/persistir-partida-6","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#cargar-el-estado","content":"Cargar el estado"},"1725":{"id":"/docs/red/v1/guias/persistir-partida-7","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#dormir-y-despertar-canales","content":"Dormir y despertar canales"},"1726":{"id":"/docs/red/v1/guias/persistir-partida-8","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Qué no deberías persistir"},"1727":{"id":"/docs/red/v1/guias/persistir-partida-9","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#persistencia-frente-a-guardado-del-juego","content":"Persistencia frente a guardado del juego"},"1728":{"id":"/docs/red/v1/guias/persistir-partida-10","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#recomendación-de-diseño","content":"Recomendación de diseño"},"1729":{"id":"/docs/red/v1/guias/persistir-partida-11","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#relación-con-tnet","content":"Relación con TNet"},"1730":{"id":"/docs/red/v1/guias/persistir-partida-12","page_id":"/docs/red/v1/guias/persistir-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Referencias"},"1731":{"id":"/docs/red/v1/guias/persistir-partida-13","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistir-una-partida","content":"Eco permite conservar el estado de los canales y de sus objetos para que una sesión pueda restaurarse posteriormente. La persistencia debe entenderse como una propiedad del estado de red: no sustituye al guardado propio del juego, sino que proporciona un mecanismo para conservar el estado que Eco administra."},"1732":{"id":"/docs/red/v1/guias/persistir-partida-14","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistir-una-partida","content":"Un objeto o canal persistente puede sobrevivir a la desconexión de los jugadores y volver a estar disponible cuando el estado se restaura. Decide explícitamente qué parte del estado pertenece a Eco y qué parte debe seguir guardándose mediante tu sistema de partidas."},"1733":{"id":"/docs/red/v1/guias/persistir-partida-15","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-puede-persistir","content":"Dentro del modelo de Eco, la persistencia está relacionada especialmente con:"},"1734":{"id":"/docs/red/v1/guias/persistir-partida-16","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-puede-persistir","content":"El canal mantiene estructuras separadas para objetos creados, objetos destruidos y RFC persistentes. Esto permite reconstruir el estado de una sesión cuando vuelve a cargarse."},"1735":{"id":"/docs/red/v1/guias/persistir-partida-17","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#objetos-persistentes","content":"Al crear un objeto dinámico puede indicarse que debe conservarse:"},"1736":{"id":"/docs/red/v1/guias/persistir-partida-18","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#objetos-persistentes","content":"El parámetro `persistent` indica que el objeto forma parte del estado que el servidor debe conservar."},"1737":{"id":"/docs/red/v1/guias/persistir-partida-19","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#objetos-persistentes","content":"La persistencia es apropiada para entidades que representan estado del mundo, no para efectos efímeros como partículas, proyectiles o eventos visuales."},"1738":{"id":"/docs/red/v1/guias/persistir-partida-20","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#datos-persistentes","content":"El estado de un objeto puede almacenarse mediante su `Nodo`:"},"1739":{"id":"/docs/red/v1/guias/persistir-partida-21","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#datos-persistentes","content":"La sincronización y la persistencia son conceptos relacionados, pero no idénticos:"},"1740":{"id":"/docs/red/v1/guias/persistir-partida-22","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#datos-persistentes","content":"Un dato puede necesitar sincronizarse en tiempo real pero no conservarse después de destruir el objeto. Del mismo modo, un estado persistente puede necesitar cargarse para un nuevo jugador aunque no haya cambiado en ese momento."},"1741":{"id":"/docs/red/v1/guias/persistir-partida-23","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#rfc-persistentes","content":"Eco también mantiene RFC guardadas asociadas al canal. Son útiles cuando un comportamiento o configuración de red debe estar disponible para participantes que entren posteriormente."},"1742":{"id":"/docs/red/v1/guias/persistir-partida-24","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#rfc-persistentes","content":"No deben utilizarse como sustituto genérico de un sistema de eventos. Una RFC persistente representa una condición o información que debe formar parte del estado recuperable del canal."},"1743":{"id":"/docs/red/v1/guias/persistir-partida-25","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#guardado-del-servidor","content":"`ServidorJuego` mantiene funciones de lectura y escritura del estado del mundo y utiliza un archivo de estado por defecto, configurable mediante la infraestructura del servidor."},"1744":{"id":"/docs/red/v1/guias/persistir-partida-26","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#guardado-del-servidor","content":"La implementación permite sustituir el almacenamiento por callbacks propios. Esto permite integrar Eco con un sistema de guardado externo si el juego necesita bases de datos, archivos propios o almacenamiento remoto."},"1745":{"id":"/docs/red/v1/guias/persistir-partida-27","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#cargar-el-estado","content":"Al arrancar el servidor, el estado persistente puede restaurarse antes de que entren los jugadores. El flujo conceptual es:"},"1746":{"id":"/docs/red/v1/guias/persistir-partida-28","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#cargar-el-estado","content":"La restauración debe producirse antes de asumir que un canal representa un mundo nuevo."},"1747":{"id":"/docs/red/v1/guias/persistir-partida-29","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#dormir-y-despertar-canales","content":"Eco también contempla el ciclo `Sleep` / `Wake` para canales inactivos. El objetivo es reducir el uso de memoria de canales que no tienen jugadores activos sin perder su estado persistente."},"1748":{"id":"/docs/red/v1/guias/persistir-partida-30","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#dormir-y-despertar-canales","content":"Esto resulta especialmente útil en servidores que mantienen muchos mundos o partidas persistentes."},"1749":{"id":"/docs/red/v1/guias/persistir-partida-31","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"No todo lo que existe en una escena debe convertirse en estado persistente."},"1750":{"id":"/docs/red/v1/guias/persistir-partida-32","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Tipo de dato"},"1751":{"id":"/docs/red/v1/guias/persistir-partida-33","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Persistir"},"1752":{"id":"/docs/red/v1/guias/persistir-partida-34","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Inventario"},"1753":{"id":"/docs/red/v1/guias/persistir-partida-35","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Sí, si forma parte del estado del mundo"},"1754":{"id":"/docs/red/v1/guias/persistir-partida-36","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Progreso de misión"},"1755":{"id":"/docs/red/v1/guias/persistir-partida-37","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Sí"},"1756":{"id":"/docs/red/v1/guias/persistir-partida-38","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Posición de una entidad permanente"},"1757":{"id":"/docs/red/v1/guias/persistir-partida-39","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Habitualmente sí"},"1758":{"id":"/docs/red/v1/guias/persistir-partida-40","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Proyectil en vuelo"},"1759":{"id":"/docs/red/v1/guias/persistir-partida-41","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Normalmente no"},"1760":{"id":"/docs/red/v1/guias/persistir-partida-42","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Efecto visual"},"1761":{"id":"/docs/red/v1/guias/persistir-partida-43","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"No"},"1762":{"id":"/docs/red/v1/guias/persistir-partida-44","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Evento puntual"},"1763":{"id":"/docs/red/v1/guias/persistir-partida-45","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"No"},"1764":{"id":"/docs/red/v1/guias/persistir-partida-46","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"Cache temporal"},"1765":{"id":"/docs/red/v1/guias/persistir-partida-47","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"No"},"1766":{"id":"/docs/red/v1/guias/persistir-partida-48","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#qué-no-deberías-persistir","content":"La persistencia debe representar el mundo, no el historial completo de cada frame."},"1767":{"id":"/docs/red/v1/guias/persistir-partida-49","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistencia-frente-a-guardado-del-juego","content":"En un juego real probablemente tendrás dos capas:"},"1768":{"id":"/docs/red/v1/guias/persistir-partida-50","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#persistencia-frente-a-guardado-del-juego","content":"Eco debe conservar aquello que necesita reconstruir su propio estado de red. El sistema de guardado del juego debe conservar datos de negocio como inventario, progreso, economía, estadísticas y configuración."},"1769":{"id":"/docs/red/v1/guias/persistir-partida-51","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#recomendación-de-diseño","content":"Antes de marcar un objeto como persistente, define:"},"1770":{"id":"/docs/red/v1/guias/persistir-partida-52","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#recomendación-de-diseño","content":"Esta decisión evita llenar el almacenamiento con objetos cuya vida real dura unos pocos segundos."},"1771":{"id":"/docs/red/v1/guias/persistir-partida-53","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#relación-con-tnet","content":"La persistencia de canales, objetos creados, RFC guardadas y estado del servidor procede del modelo de TNet que Eco conserva y renombra."},"1772":{"id":"/docs/red/v1/guias/persistir-partida-54","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#relación-con-tnet","content":"Para conocer los nombres equivalentes y los cambios realizados por Eco, consulta la sección de Referencia."},"1773":{"id":"/docs/red/v1/guias/persistir-partida-55","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Cómo `ServidorJuego` mantiene y restaura el estado de los canales."},"1774":{"id":"/docs/red/v1/guias/persistir-partida-56","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Cómo se transmite el estado antes y durante la persistencia."},"1775":{"id":"/docs/red/v1/guias/persistir-partida-57","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Identidad, propietario y ciclo de vida de los objetos persistentes."},"1776":{"id":"/docs/red/v1/guias/persistir-partida-58","page_id":"/docs/red/v1/guias/persistir-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/persistir-partida#referencias","content":"Repositorio upstream de la arquitectura heredada."},"1777":{"id":"/docs/red/v1/guias/primer-cliente","page_id":"/docs/red/v1/guias/primer-cliente","type":"page","content":"Primer cliente","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-cliente"},"1778":{"id":"/docs/red/v1/guias/primer-cliente-0","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente","content":"Conecta un cliente de Eco, espera el handshake, entra en un canal y valida la sesión."},"1779":{"id":"/docs/red/v1/guias/primer-cliente-1","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Primer cliente"},"1780":{"id":"/docs/red/v1/guias/primer-cliente-2","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#flujo","content":"Flujo"},"1781":{"id":"/docs/red/v1/guias/primer-cliente-3","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#preparación","content":"Preparación"},"1782":{"id":"/docs/red/v1/guias/primer-cliente-4","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#conectar","content":"Conectar"},"1783":{"id":"/docs/red/v1/guias/primer-cliente-5","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#1-crear-la-intención-de-conexión-step","content":"Crear la intención de conexión [step]"},"1784":{"id":"/docs/red/v1/guias/primer-cliente-6","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#2-esperar-el-handshake-step","content":"Esperar el handshake [step]"},"1785":{"id":"/docs/red/v1/guias/primer-cliente-7","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#3-solicitar-un-canal-step","content":"Solicitar un canal [step]"},"1786":{"id":"/docs/red/v1/guias/primer-cliente-8","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#4-esperar-la-entrada-step","content":"Esperar la entrada [step]"},"1787":{"id":"/docs/red/v1/guias/primer-cliente-9","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#5-validar-el-canal-step","content":"Validar el canal [step]"},"1788":{"id":"/docs/red/v1/guias/primer-cliente-10","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"Cliente remoto vs local"},"1789":{"id":"/docs/red/v1/guias/primer-cliente-11","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#estado-de-la-sesión","content":"Estado de la sesión"},"1790":{"id":"/docs/red/v1/guias/primer-cliente-12","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"A partir de aquí"},"1791":{"id":"/docs/red/v1/guias/primer-cliente-13","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"Errores frecuentes"},"1792":{"id":"/docs/red/v1/guias/primer-cliente-14","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"Desconexión"},"1793":{"id":"/docs/red/v1/guias/primer-cliente-15","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Referencias"},"1794":{"id":"/docs/red/v1/guias/primer-cliente-16","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Esta guía cubre el recorrido mínimo desde una instancia de juego sin sesión hasta un cliente conectado y dentro de un canal."},"1795":{"id":"/docs/red/v1/guias/primer-cliente-17","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Al terminar tendrás una secuencia fiable: conexión → handshake → canal → comprobación de estado. No añadiremos objetos ni gameplay hasta que este flujo sea estable."},"1796":{"id":"/docs/red/v1/guias/primer-cliente-18","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#preparación","content":"La lógica de cliente se concentra en `ClienteJuego`. La fachada de Pandora puede exponerlo de otra forma, pero el modelo interno sigue teniendo estados independientes para conexión y pertenencia a canales."},"1797":{"id":"/docs/red/v1/guias/primer-cliente-19","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#1-crear-la-intención-de-conexión-step","content":"`Connect` inicia el proceso; no implica que la sesión esté lista en la misma instrucción."},"1798":{"id":"/docs/red/v1/guias/primer-cliente-20","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#2-esperar-el-handshake-step","content":"Comprueba el estado de conexión antes de solicitar operaciones dependientes del servidor."},"1799":{"id":"/docs/red/v1/guias/primer-cliente-21","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#4-esperar-la-entrada-step","content":"Mientras Eco espera la respuesta, `IsJoiningChannel(1)` puede indicar que la operación todavía está pendiente."},"1800":{"id":"/docs/red/v1/guias/primer-cliente-22","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"`ClienteJuego` utiliza la conexión de red y el protocolo normal. Es el entorno que debes utilizar para validar comportamiento real entre procesos o máquinas."},"1801":{"id":"/docs/red/v1/guias/primer-cliente-23","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#cliente-remoto-vs-local","content":"Eco puede asociar un `ServidorJuego` local para ejecutar cliente y servidor en el mismo proceso. Es excelente para pruebas, pero no reproduce todas las condiciones de una conexión real."},"1802":{"id":"/docs/red/v1/guias/primer-cliente-24","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#estado-de-la-sesión","content":"Estos estados son independientes. Conectar no te introduce automáticamente en una partida."},"1803":{"id":"/docs/red/v1/guias/primer-cliente-25","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Una vez dentro del canal puedes:"},"1804":{"id":"/docs/red/v1/guias/primer-cliente-26","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Añadir una entidad con identidad de red."},"1805":{"id":"/docs/red/v1/guias/primer-cliente-27","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Mantener datos de la entidad sincronizados."},"1806":{"id":"/docs/red/v1/guias/primer-cliente-28","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#a-partir-de-aquí","content":"Ejecutar una RFC con destinatarios concretos."},"1807":{"id":"/docs/red/v1/guias/primer-cliente-29","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"La conexión sólo establece la sesión con el servidor. La entrada a uno o varios canales es una operación posterior."},"1808":{"id":"/docs/red/v1/guias/primer-cliente-30","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#errores-frecuentes","content":"Eco mantiene varios canales por cliente. Evita diseñar tu estado alrededor de un único `channels[0]`."},"1809":{"id":"/docs/red/v1/guias/primer-cliente-31","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"Cuando termines la sesión:"},"1810":{"id":"/docs/red/v1/guias/primer-cliente-32","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#desconexión","content":"No necesitas convertir la desconexión en una secuencia manual de abandono de canales; el cierre de la sesión forma parte del ciclo de vida del cliente."},"1811":{"id":"/docs/red/v1/guias/primer-cliente-33","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Funcionamiento del runtime de cliente."},"1812":{"id":"/docs/red/v1/guias/primer-cliente-34","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Modelo de uno o varios canales."},"1813":{"id":"/docs/red/v1/guias/primer-cliente-35","page_id":"/docs/red/v1/guias/primer-cliente","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-cliente#referencias","content":"Código fuente actual."},"1814":{"id":"/docs/red/v1/guias/primer-objeto","page_id":"/docs/red/v1/guias/primer-objeto","type":"page","content":"Primer objeto","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-objeto"},"1815":{"id":"/docs/red/v1/guias/primer-objeto-0","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#primer-objeto","content":"Primer objeto"},"1816":{"id":"/docs/red/v1/guias/primer-objeto-1","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#1-crear-la-entidad","content":"Crear la entidad"},"1817":{"id":"/docs/red/v1/guias/primer-objeto-2","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#2-añadir-un-componente-de-red","content":"Añadir un componente de red"},"1818":{"id":"/docs/red/v1/guias/primer-objeto-3","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#3-leer-y-modificar-estado","content":"Leer y modificar estado"},"1819":{"id":"/docs/red/v1/guias/primer-objeto-4","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#4-comprobar-propiedad","content":"Comprobar propiedad"},"1820":{"id":"/docs/red/v1/guias/primer-objeto-5","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#5-enviar-una-acción","content":"Enviar una acción"},"1821":{"id":"/docs/red/v1/guias/primer-objeto-6","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#6-destruir-el-objeto","content":"Destruir el objeto"},"1822":{"id":"/docs/red/v1/guias/primer-objeto-7","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#7-probarlo-dentro-de-un-canal","content":"Probarlo dentro de un canal"},"1823":{"id":"/docs/red/v1/guias/primer-objeto-8","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#errores-frecuentes","content":"Errores frecuentes"},"1824":{"id":"/docs/red/v1/guias/primer-objeto-9","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#crear-un-componente-sin-un-objeto-válido","content":"Crear un `Componente` sin un `Objeto` válido"},"1825":{"id":"/docs/red/v1/guias/primer-objeto-10","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#utilizar-rpc-para-todo","content":"Utilizar RPC para todo"},"1826":{"id":"/docs/red/v1/guias/primer-objeto-11","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#ignorar-el-ownership","content":"Ignorar el ownership"},"1827":{"id":"/docs/red/v1/guias/primer-objeto-12","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#siguiente-paso","content":"Siguiente paso"},"1828":{"id":"/docs/red/v1/guias/primer-objeto-13","page_id":"/docs/red/v1/guias/primer-objeto","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-objeto#referencias","content":"Referencias"},"1829":{"id":"/docs/red/v1/guias/primer-objeto-14","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#primer-objeto","content":"Esta guía muestra el paso siguiente después de conectar el cliente: trabajar con una entidad que tenga identidad de red y comportamiento asociado."},"1830":{"id":"/docs/red/v1/guias/primer-objeto-15","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#primer-objeto","content":"En Eco, `Objeto` representa la identidad de red y `Componente` implementa el comportamiento asociado. No son conceptos intercambiables."},"1831":{"id":"/docs/red/v1/guias/primer-objeto-16","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#1-crear-la-entidad","content":"Un objeto puede corresponder a un `GameObject` de Unity que tenga un `Objeto` y uno o varios `Componente`."},"1832":{"id":"/docs/red/v1/guias/primer-objeto-17","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#1-crear-la-entidad","content":"El objeto necesita un identificador de red válido para participar en la comunicación con el servidor."},"1833":{"id":"/docs/red/v1/guias/primer-objeto-18","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#2-añadir-un-componente-de-red","content":"El patrón habitual es derivar de `Componente`:"},"1834":{"id":"/docs/red/v1/guias/primer-objeto-19","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#2-añadir-un-componente-de-red","content":"El componente se asocia al `Objeto` de su jerarquía y puede utilizarlo como contexto de red."},"1835":{"id":"/docs/red/v1/guias/primer-objeto-20","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#3-leer-y-modificar-estado","content":"Para datos de estado utiliza las operaciones de `Objeto` o sus accesos de conveniencia desde `Componente`:"},"1836":{"id":"/docs/red/v1/guias/primer-objeto-21","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#3-leer-y-modificar-estado","content":"El valor se modifica localmente y Eco determina cómo debe propagarse según la autoridad del objeto y el estado de la conexión."},"1837":{"id":"/docs/red/v1/guias/primer-objeto-22","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#4-comprobar-propiedad","content":"Antes de permitir determinadas operaciones, comprueba la propiedad del objeto:"},"1838":{"id":"/docs/red/v1/guias/primer-objeto-23","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#4-comprobar-propiedad","content":"Ser capaz de observar un objeto no implica ser su propietario."},"1839":{"id":"/docs/red/v1/guias/primer-objeto-24","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#5-enviar-una-acción","content":"Cuando lo que necesitas comunicar es una acción puntual, utiliza el mecanismo de RFC disponible en el objeto:"},"1840":{"id":"/docs/red/v1/guias/primer-objeto-25","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#5-enviar-una-acción","content":"La acción no debe confundirse con el estado. Si `vida` representa un valor persistente de la entidad, es preferible sincronizar ese dato en lugar de enviar continuamente llamadas que representen su valor."},"1841":{"id":"/docs/red/v1/guias/primer-objeto-26","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#6-destruir-el-objeto","content":"El ciclo de vida de red y el ciclo de vida de Unity están relacionados, pero no son idénticos. Utiliza la API de Eco para solicitar la destrucción de un objeto de red en lugar de asumir que `Destroy(gameObject)` informa automáticamente al servidor."},"1842":{"id":"/docs/red/v1/guias/primer-objeto-27","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#7-probarlo-dentro-de-un-canal","content":"El objeto debe existir en el contexto de un canal válido. Una prueba mínima debería ser:"},"1843":{"id":"/docs/red/v1/guias/primer-objeto-28","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#7-probarlo-dentro-de-un-canal","content":"Si alguno de estos estados falta, el comportamiento observado puede ser local aunque todavía no exista una entidad de red utilizable."},"1844":{"id":"/docs/red/v1/guias/primer-objeto-29","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#crear-un-componente-sin-un-objeto-válido","content":"El componente puede resolver o crear un objeto local en determinados casos, pero eso no significa que exista automáticamente una identidad registrada en el servidor."},"1845":{"id":"/docs/red/v1/guias/primer-objeto-30","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#utilizar-rpc-para-todo","content":"Una acción y un estado son problemas diferentes. Utiliza RFC para acciones puntuales y los mecanismos de datos/sincronización para estado."},"1846":{"id":"/docs/red/v1/guias/primer-objeto-31","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#ignorar-el-ownership","content":"Si varios clientes modifican el mismo estado sin una autoridad clara, el resultado será difícil de razonar y sincronizar."},"1847":{"id":"/docs/red/v1/guias/primer-objeto-32","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#siguiente-paso","content":"Continúa con Sincronización para definir autoridad, frecuencia y persistencia del estado."},"1848":{"id":"/docs/red/v1/guias/primer-objeto-33","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#referencias","content":"Identidad, ownership y ciclo de vida de `Objeto`."},"1849":{"id":"/docs/red/v1/guias/primer-objeto-34","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#referencias","content":"RFC, estado y destinatarios."},"1850":{"id":"/docs/red/v1/guias/primer-objeto-35","page_id":"/docs/red/v1/guias/primer-objeto","tags":[],"type":"text","url":"/docs/red/v1/guias/primer-objeto#referencias","content":"Código fuente de la implementación actual."},"1851":{"id":"/docs/red/v1/guias/servidor-local","page_id":"/docs/red/v1/guias/servidor-local","type":"page","content":"Servidor local","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/servidor-local"},"1852":{"id":"/docs/red/v1/guias/servidor-local-0","page_id":"/docs/red/v1/guias/servidor-local","tags":[],"type":"text","url":"/docs/red/v1/guias/servidor-local","content":"Ejecuta cliente y servidor de Eco dentro del mismo proceso sin utilizar sockets."},"1853":{"id":"/docs/red/v1/guias/servidor-local-1","page_id":"/docs/red/v1/guias/servidor-local","type":"heading","tags":[],"url":"/docs/red/v1/guias/servidor-local#servidor-local","content":"Servidor local"},"1854":{"id":"/docs/red/v1/guias/servidor-lo