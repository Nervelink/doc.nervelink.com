-test-7","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Añadir frecuencia"},"1536":{"id":"/docs/red/v1/ejemplos/stress-test-8","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Añadir jugadores"},"1537":{"id":"/docs/red/v1/ejemplos/stress-test-9","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Encontrar el cuello de botella"},"1538":{"id":"/docs/red/v1/ejemplos/stress-test-10","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#métricas-de-eco","content":"Métricas de Eco"},"1539":{"id":"/docs/red/v1/ejemplos/stress-test-11","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Qué no medir de forma aislada"},"1540":{"id":"/docs/red/v1/ejemplos/stress-test-12","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Una prueba de estrés debe medir el sistema que realmente quieres desplegar. Eco permite observar tráfico, latencia y procesamiento, pero una prueba útil combina esas métricas con un workload controlado."},"1541":{"id":"/docs/red/v1/ejemplos/stress-test-13","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"No empieces con cientos de jugadores. Primero identifica el comportamiento de una sola variable y aumenta la carga de forma incremental."},"1542":{"id":"/docs/red/v1/ejemplos/stress-test-14","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Ejecuta