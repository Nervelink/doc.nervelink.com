 de estado y coste de restauración"},"2876":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-33","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"No es una regla absoluta para todas las simulaciones, pero es un excelente punto de partida para diseñar juegos cooperativos y competitivos con Eco."},"2877":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-34","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Aislamiento y pertenencia de jugadores."},"2878":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-35","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Datos y objetos que sobreviven a la sesión inmediata."},"2879":{"id":"/docs/red/v1/fundamentos/conceptos","page_id":"/docs/red/v1/fundamentos/conceptos","type":"page","content":"Conceptos","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/conceptos"},"2880":{"id":"/docs/red/v1/fundamentos/conceptos-0","page_id":"/docs/red/v1/fundamentos/conceptos","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"2881":{"id":"/docs/red/v1/fundamentos/conceptos-1","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conceptos","content":"Conceptos"},"2882":{"id":"/docs/red/v1/fundamentos/conceptos-2","page_id":"/docs/red/v1/fundamentos/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/conceptos#conexión","content":"Conexión"},"2883":{"id":"/docs/red/v1/fundamentos/conceptos-3","page_id":"/docs/red/v1/fundamentos/conceptos","type":