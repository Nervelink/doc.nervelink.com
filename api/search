":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Propiedad de una entidad"},"1671":{"id":"/docs/red/v1/guias/transferir-archivos-16","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"`Nodo` / `Set`"},"1672":{"id":"/docs/red/v1/guias/transferir-archivos-17","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Acción puntual"},"1673":{"id":"/docs/red/v1/guias/transferir-archivos-18","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"RFC"},"1674":{"id":"/docs/red/v1/guias/transferir-archivos-19","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Estado compartido"},"1675":{"id":"/docs/red/v1/guias/transferir-archivos-20","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Sincronización"},"1676":{"id":"/docs/red/v1/guias/transferir-archivos-21","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Descargar contenido"},"1677":{"id":"/docs/red/v1/guias/transferir-archivos-22","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Carga de archivos"},"1678":{"id":"/docs/red/v1/guias/transferir-archivos-23","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Saber qué archivos existen"},"1679":{"id":"/docs/red/v1/guias/transferir-archivos-24","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#cuándo-utilizar-archivos","content":"Listado de archivos"},"1680":{"id":"/docs/red/v1/guias/transferir-archivos-25","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#precauciones","content":"No utilices el sistema de archivos como sustituto de la sincronización de gameplay. Descargar periódicamente un archivo para replicar una propiedad suele ser una arquitectura peor que modelar esa propiedad como estado de red."},"1681":{"id":"/docs/red/v1/guias/transferir-archivos-26","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#precauciones","content":"Tampoco debes asumir que todos los clientes tienen acceso arbitrario al sistema de archivos del servidor. El contenido disponible depende de la configuración y de las reglas del servidor."},"1682":{"id":"/docs/red/v1/guias/transferir-archivos-27","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#referencias","content":"Capas utilizadas para transportar solicitudes y respuestas."},"1683":{"id":"/docs/red/v1/guias/transferir-archivos-28","page_id":"/docs/red/v1/guias/transferir-archivos","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-archivos#referencias","content":"Cómo se representan los datos que viajan por la red."},"1684":{"id":"/docs/red/v1/guias/transferir-objeto-canal","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"page","content":"Transferir un objeto entre canales","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal"},"1685":{"id":"/docs/red/v1/guias/transferir-objeto-canal-0","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal","content":"Mueve un objeto de red entre canales conservando el control del ciclo de vida de la transferencia."},"1686":{"id":"/docs/red/v1/guias/transferir-objeto-canal-1","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Transferir un objeto entre canales"},"1687":{"id":"/docs/red/v1/guias/transferir-objeto-canal-2","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Qué cambia"},"1688":{"id":"/docs/red/v1/guias/transferir-objeto-canal-3","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"Ciclo de transferencia"},"1689":{"id":"/docs/red/v1/guias/transferir-objeto-canal-4","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"Detectar una transferencia"},"1690":{"id":"/docs/red/v1/guias/transferir-objeto-canal-5","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"El `uid` puede cambiar"},"1691":{"id":"/docs/red/v1/guias/transferir-objeto-canal-6","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#objetos-estáticos-frente-a-dinámicos","content":"Objetos estáticos frente a dinámicos"},"1692":{"id":"/docs/red/v1/guias/transferir-objeto-canal-7","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencias-locales","content":"Referencias locales"},"1693":{"id":"/docs/red/v1/guias/transferir-objeto-canal-8","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"Qué no hacer"},"1694":{"id":"/docs/red/v1/guias/transferir-objeto-canal-9","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"1695":{"id":"/docs/red/v1/guias/transferir-objeto-canal-10","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Relación con ownership"},"1696":{"id":"/docs/red/v1/guias/transferir-objeto-canal-11","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-eco","content":"Referencia a Eco"},"1697":{"id":"/docs/red/v1/guias/transferir-objeto-canal-12","page_id":"/docs/red/v1/guias/transferir-objeto-canal","type":"heading","tags":[],"url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Referencia a TNet"},"1698":{"id":"/docs/red/v1/guias/transferir-objeto-canal-13","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Eco permite transferir un objeto de red a otro canal. La operación no debe tratarse como un simple cambio local de `channelID`: el objeto cambia de contexto de red y la implementación debe coordinar la operación con el servidor."},"1699":{"id":"/docs/red/v1/guias/transferir-objeto-canal-14","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#transferir-un-objeto-entre-canales","content":"Durante una transferencia el objeto puede quedar temporalmente marcado como destruido para impedir que se envíen RFC en un estado intermedio. Espera a que la transferencia termine antes de asumir que el objeto está listo para comunicarse en el nuevo canal."},"1700":{"id":"/docs/red/v1/guias/transferir-objeto-canal-15","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Un `Objeto` pertenece siempre a un canal concreto y su identificador completo utiliza ambos datos:"},"1701":{"id":"/docs/red/v1/guias/transferir-objeto-canal-16","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-cambia","content":"Por eso moverlo de un canal a otro no es simplemente actualizar una variable local. El nuevo contexto forma parte de la identidad de red del objeto."},"1702":{"id":"/docs/red/v1/guias/transferir-objeto-canal-17","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"El flujo conceptual es:"},"1703":{"id":"/docs/red/v1/guias/transferir-objeto-canal-18","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#ciclo-de-transferencia","content":"Durante el proceso Eco evita tratar el objeto como completamente operativo hasta que la transferencia ha finalizado."},"1704":{"id":"/docs/red/v1/guias/transferir-objeto-canal-19","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"`Objeto` expone el callback `onTransfer`, que recibe el nuevo canal y el nuevo ID:"},"1705":{"id":"/docs/red/v1/guias/transferir-objeto-canal-20","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#detectar-una-transferencia","content":"Esto permite reconstruir referencias locales que dependan del canal o del identificador dinámico."},"1706":{"id":"/docs/red/v1/guias/transferir-objeto-canal-21","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"Como `uid` combina el canal y el ID:"},"1707":{"id":"/docs/red/v1/guias/transferir-objeto-canal-22","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#el-uid-puede-cambiar","content":"no conviene guardar un `uid` como referencia permanente si el objeto puede transferirse. Después de la operación, vuelve a consultar `uid`, `channelID` e `id`."},"1708":{"id":"/docs/red/v1/guias/transferir-objeto-canal-23","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#objetos-estáticos-frente-a-dinámicos","content":"La propiedad de los objetos estáticos está restringida y no deben tratarse igual que los objetos dinámicos. Para transferencias dinámicas, el ciclo de vida debe mantenerse coordinado con el servidor."},"1709":{"id":"/docs/red/v1/guias/transferir-objeto-canal-24","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencias-locales","content":"Evita asumir que una referencia de un sistema externo sigue siendo válida sólo porque la instancia de Unity no ha cambiado. El objeto puede seguir siendo la misma instancia, pero su contexto de red habrá cambiado."},"1710":{"id":"/docs/red/v1/guias/transferir-objeto-canal-25","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"No cambies manualmente `channelID` para simular una transferencia. Tampoco continúes enviando mensajes usando el contexto antiguo mientras la operación está pendiente."},"1711":{"id":"/docs/red/v1/guias/transferir-objeto-canal-26","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#qué-no-hacer","content":"La transferencia es una operación del modelo de red, no una reasignación de datos de gameplay."},"1712":{"id":"/docs/red/v1/guias/transferir-objeto-canal-27","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"Un caso habitual es mover entidades entre ámbitos de juego:"},"1713":{"id":"/docs/red/v1/guias/transferir-objeto-canal-28","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#cuándo-utilizarlo","content":"La utilidad depende de que el objeto deba mantener continuidad lógica entre esos ámbitos. Cuando no sea necesario conservar la identidad, puede ser más sencillo destruir el objeto anterior y crear uno nuevo en el canal destino."},"1714":{"id":"/docs/red/v1/guias/transferir-objeto-canal-29","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"Transferir de canal y transferir ownership son operaciones distintas. El cambio de canal modifica el contexto al que pertenece el objeto; `owner` determina qué jugador tiene autoridad sobre ese objeto."},"1715":{"id":"/docs/red/v1/guias/transferir-objeto-canal-30","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#relación-con-ownership","content":"No asumas que una transferencia de canal equivale automáticamente a transferir propiedad."},"1716":{"id":"/docs/red/v1/guias/transferir-objeto-canal-31","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-eco","content":"La implementación de `Objeto` expone `channelID`, `id`, `uid`, `hasBeenDestroyed`, `onTransfer` y la lógica relacionada con el ciclo de vida del objeto. La documentación debe considerarse subordinada al comportamiento del repositorio actual."},"1717":{"id":"/docs/red/v1/guias/transferir-objeto-canal-32","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"El concepto procede del modelo de objetos por canal de TNet, pero la API utilizada aquí pertenece a Eco. Los ejemplos antiguos de TNet no deben utilizarse como API literal."},"1718":{"id":"/docs/red/v1/guias/transferir-objeto-canal-33","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Referencia del ciclo de vida e identidad de los objetos de red."},"1719":{"id":"/docs/red/v1/guias/transferir-objeto-canal-34","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Uso práctico de varios canales desde una misma conexión."},"1720":{"id":"/docs/red/v1/guias/transferir-objeto-canal-35","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Diferencia entre cambiar de canal y cambiar de propietario."},"1721":{"id":"/docs/red/v1/guias/transferir-objeto-canal-36","page_id":"/docs/red/v1/guias/transferir-objeto-canal","tags":[],"type":"text","url":"/docs/red/v1/guias/transferir-objeto-canal#referencia-a-tnet","content":"Código fuente de la implementación actual."},"1722":{"id":"/docs/red/v1/guias/transferir-propiedad","page_id":"/docs/red/v1/guias/transferir-propiedad","type":"page","content":"Transferir la propiedad de un objeto","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/transferir-pr