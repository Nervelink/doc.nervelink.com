v1/guias/multiples-canales#relación-con-tnet","content":"La ventaja de esta documentación frente a los ejemplos antiguos es que **no debemos asumir un único canal activo por cliente**."},"558":{"id":"/docs/red/v1/guias/multiples-canales-51","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Referencia completa del ciclo de vida y estado de un canal."},"559":{"id":"/docs/red/v1/guias/multiples-canales-52","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Gestión de conexión y canales desde el cliente."},"560":{"id":"/docs/red/v1/guias/multiples-canales-53","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Repositorio upstream de la arquitectura heredada."},"561":{"id":"/docs/red/v1/guias/multiples-canales-54","page_id":"/docs/red/v1/guias/multiples-canales","tags":[],"type":"text","url":"/docs/red/v1/guias/multiples-canales#referencias","content":"Referencia externa para contrastar el modelo de canales de TNet."},"562":{"id":"/docs/red/v1/guias/primer-cliente","page_id":"/docs/red/v1/guias/primer-cliente","type":"page","content":"Primer cliente","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/primer-cliente"},"563":{"id":"/docs/red/v1/guias/primer-cliente-0","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#primer-cliente","content":"Primer cliente"},"564":{"id":"/docs/red/v1/guias/primer-cliente-1","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url":"/docs/red/v1/guias/primer-cliente#1-obtener-el-cliente","content":"1\\. Obtener el cliente"},"565":{"id":"/docs/red/v1/guias/primer-cliente-2","page_id":"/docs/red/v1/guias/primer-cliente","type":"heading","tags":[],"url"