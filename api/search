iones de protocolo relacionadas con TCP y UDP."},"4537":{"id":"/docs/red/v1/transporte/tcp-udp-en-profundidad-25","page_id":"/docs/red/v1/transporte/tcp-udp-en-profundidad","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp-en-profundidad#referencias","content":"Ciclo de conexión y disponibilidad del transporte."},"4538":{"id":"/docs/red/v1/transporte/tcp-udp","page_id":"/docs/red/v1/transporte/tcp-udp","type":"page","content":"TCP y UDP","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/tcp-udp"},"4539":{"id":"/docs/red/v1/transporte/tcp-udp-0","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp","content":"Cómo Eco combina transporte fiable y transporte de baja latencia."},"4540":{"id":"/docs/red/v1/transporte/tcp-udp-1","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"TCP y UDP"},"4541":{"id":"/docs/red/v1/transporte/tcp-udp-2","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP"},"4542":{"id":"/docs/red/v1/transporte/tcp-udp-3","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#udp","content":"UDP"},"4543":{"id":"/docs/red/v1/transporte/tcp-udp-4","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#activación","content":"Activación"},"4544":{"id":"/docs/red/v1/transporte/tcp-udp-5","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Qué transporte elegir"},"4545":{"id":"/docs/red/v1/transporte/tcp-udp-6","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"`Send` y `SendQuickly`"},"4546":{"id":"/d