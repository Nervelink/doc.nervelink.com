ed/v1/avanzado/actualizador-red#contratos","content":"Contratos"},"265":{"id":"/docs/red/v1/avanzado/actualizador-red-4","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#alta-y-baja","content":"Alta y baja"},"266":{"id":"/docs/red/v1/avanzado/actualizador-red-5","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#una-sola-ejecución","content":"Una sola ejecución"},"267":{"id":"/docs/red/v1/avanzado/actualizador-red-6","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#invoke-sin-monobehaviour","content":"Invoke sin MonoBehaviour"},"268":{"id":"/docs/red/v1/avanzado/actualizador-red-7","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#coroutines","content":"Coroutines"},"269":{"id":"/docs/red/v1/avanzado/actualizador-red-8","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"Thread safety"},"270":{"id":"/docs/red/v1/avanzado/actualizador-red-9","page_id":"/docs/red/v1/avanzado/actualizador-red","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Relación con Componente"},"271":{"id":"/docs/red/v1/avanzado/actualizador-red-10","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#actualizadorred","content":"`ActualizadorRed` es un scheduler centralizado utilizado por Eco para ejecutar `OnStart`, `OnUpdate`, `OnLateUpdate`, actualizaciones poco frecuentes, callbacks de una sola ejecución y pequeñas coroutines."},"272":{"id":"/docs/red/v1/avanzado/actualizador-red-11","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#por-qué-existe","content":"Unity ejecuta `Update` y `LateUpdate` de cada `MonoBehaviour` habilitado. Cuando un proyecto contiene cientos o miles de componentes pequeños, centralizar parte de esos ciclos puede reducir overhead y mejorar el control del scheduler."},"273":{"id":"/docs/red/v1/avanzado/actualizador-red-12","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#alta-y-baja","content":"La implementación utiliza conjuntos para las actualizaciones normales y colas auxiliares cuando un objeto se elimina durante el propio recorrido."},"274":{"id":"/docs/red/v1/avanzado/actualizador-red-13","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#una-sola-ejecución","content":"Esto es útil para diferir una operación al siguiente ciclo sin crear un `MonoBehaviour` adicional."},"275":{"id":"/docs/red/v1/avanzado/actualizador-red-14","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#coroutines","content":"El scheduler también puede mantener coroutines basadas en `TareaParalela.EnumFunc` y procesarlas fuera del `MonoBehaviour` que las originó."},"276":{"id":"/docs/red/v1/avanzado/actualizador-red-15","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"La implementación actual permite `THREAD_SAFE_UPDATER`, protegiendo las colecciones internas con lock. Esto es especialmente importante cuando una tarea de red o worker registra callbacks desde otro hilo."},"277":{"id":"/docs/red/v1/avanzado/actualizador-red-16","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#thread-safety","content":"Que el scheduler sea seguro para registrar callbacks no significa que `UnityEngine` sea thread-safe. Los callbacks que toquen objetos de Unity deben ejecutarse en el hilo de Unity."},"278":{"id":"/docs/red/v1/avanzado/actualizador-red-17","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"`Componente.Awake()` registra su inicialización mediante `ActualizadorRed.AddStart(this)`. Por eso la documentación de `Componente` no debe asumir que toda la inicialización de red ocurre directamente en `Start()`."},"279":{"id":"/docs/red/v1/avanzado/actualizador-red-18","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Clase base que utiliza `ActualizadorRed` durante la inicialización."},"280":{"id":"/docs/red/v1/avanzado/actualizador-red-19","page_id":"/docs/red/v1/avanzado/actualizador-red","tags":[],"type":"text","url":"/docs/red/v1/avanzado/actualizador-red#relación-con-componente","content":"Implementación actual del scheduler."},"281":{"id":"/docs/red/v1/avanzado/editor-y-herramientas","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"page","content":"Editor y herramientas","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas"},"282":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-0","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas","content":"Herramientas de desarrollo, diagnóstico y utilidades que acompañan al sistema de red de Eco."},"283":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-1","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#editor-y-herramientas","content":"Editor y herramientas"},"284":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-2","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Qué entra en esta categoría"},"285":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-3","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#diagnóstico-desde-eco","content":"Diagnóstico desde Eco"},"286":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-4","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#perfilado-de-paquetes","content":"Perfilado de paquetes"},"287":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-5","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#serialización-y-herramientas-de-datos","content":"Serialización y herramientas de datos"},"288":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-6","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#runtime-code","content":"Runtime Code"},"289":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-7","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/editor-y-herramientas#relación-con-tnet","content":"Relación con TNet"},"290":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-8","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#editor-y-herramientas","content":"Eco no es sólo el runtime que ejecuta la red. El ecosistema conserva varias herramientas pensadas para acelerar la configuración, depuración, serialización y análisis del tráfico."},"291":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-9","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#editor-y-herramientas","content":"Una herramienta de editor puede ayudar a generar, inspeccionar o preparar datos, pero no sustituye al runtime de `Eco`, `ClienteJuego` o `ServidorJuego`."},"292":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-10","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"El material heredado de TNet agrupa aquí varias capacidades:"},"293":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-11","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Área"},"294":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-12","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Uso"},"295":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-13","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Configuración"},"296":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-14","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Preparar proyectos y requisitos de ejecución."},"297":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-15","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Diagnóstico"},"298":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-16","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Inspeccionar estado, paquetes, ancho de banda y errores."},"299":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-17","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Serialización"},"300":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-18","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Convertir datos complejos a formatos persistibles."},"301":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-19","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Runtime Code"},"302":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-20","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Compilar código en tiempo de ejecución cuando el proyecto lo permite."},"303":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-21","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Profiling"},"304":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-22","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#qué-entra-en-esta-categoría","content":"Detectar operaciones o paquetes demasiado frecuentes."},"305":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-23","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#diagnóstico-desde-eco","content":"La propia fachada expone información útil para herramientas internas:"},"306":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-24","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#diagnóstico-desde-eco","content":"Esto permite construir paneles de diagnóstico sin acceder directamente al protocolo."},"307":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-25","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#perfilado-de-paquetes","content":"El upstream incluye mecanismos de perfilado y contadores de paquetes. Eco mantiene parte de este enfoque y además expone contadores de tráfico a través de `Eco`."},"308":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-26","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#perfilado-de-paquetes","content":"Un patrón útil durante desarrollo es medir:"},"309":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-27","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#perfilado-de-paquetes","content":"Reducir paquetes puede disminuir tráfico, pero también puede aumentar el tamaño de cada mensaje o retrasar información. La optimización debe medirse con latencia, ancho de banda y CPU."},"310":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-28","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#serialización-y-herramientas-de-datos","content":"El sistema `Nodo` puede utilizarse para datos jerárquicos y persistencia. El upstream también documenta formatos de texto, binario y compresión LZMA. En Eco, estas capacidades deben considerarse parte de la capa de datos, no del transporte TCP/UDP."},"311":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-29","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#runtime-code","content":"El soporte de `RuntimeCode` permite compilar código durante la ejecución cuando esta funcionalidad está incluida y configurada en el proyecto."},"312":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-30","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#runtime-code","content":"No debe utilizarse como mecanismo normal para lógica de gameplay. Su utilidad está más relacionada con herramientas, extensibilidad y escenarios donde el código no puede distribuirse previamente."},"313":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-31","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#runtime-code","content":"Guía de integración y límites del código ejecutado dinámicamente."},"314":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-32","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#relación-con-tnet","content":"DeepWiki identifica herramientas de editor para inspeccionar `TNObject`, auto-sincronización, instancias de servidor y exportación de `DataNode`. En Eco, cada una debe considerarse según la implementación que realmente exista en el repositorio; la documentación no asume que una ventana histórica de TNet siga existiendo con el mismo nombre."},"315":{"id":"/docs/red/v1/avanzado/editor-y-herramientas-33","page_id":"/docs/red/v1/avanzado/editor-y-herramientas","tags":[],"type":"text","url":"/docs/red/v1/avanzado/editor-y-herramientas#relación-con-tnet","content":"Usar como referencia histórica de las herramientas upstream."},"316":{"id":"/docs/red/v1/avanzado","page_id":"/docs/red/v1/avanzado","type":"page","content":"Funciones avanzadas","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado"},"317":{"id":"/docs/red/v1/avanzado-0","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado","content":"Herramientas de Eco que amplían el runtime básico para rendimiento, integraciones y escenarios especializados."},"318":{"id":"/docs/red/v1/avanzado-1","page_id":"/docs/red/v1/avanzado","type":"heading","tags":[],"url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Funciones avanzadas"},"319":{"id":"/docs/red/v1/avanzado-2","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Esta sección reúne capacidades que no necesitas para una integración básica, pero que resultan relevantes cuando el proyecto crece o necesita integraciones específicas."},"320":{"id":"/docs/red/v1/avanzado-3","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Centraliza `OnStart`, `Update`, `LateUpdate`, callbacks one-shot, invocaciones y coroutines para reducir el coste de muchos `MonoBehaviour`."},"321":{"id":"/docs/red/v1/avanzado-4","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Sincronización orientada a física de Unity y separación entre propietario y observadores."},"322":{"id":"/docs/red/v1/avanzado-5","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Compilación y ejecución de código C# en runtime para casos de modding y extensibilidad."},"323":{"id":"/docs/red/v1/avanzado-6","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Descubrimiento y anuncio de servidores mediante el sistema de lobby de Eco."},"324":{"id":"/docs/red/v1/avanzado-7","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Integración con Steam Networking y sustitución de sockets mediante `IConnection`."},"325":{"id":"/docs/red/v1/avanzado-8","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Herramientas para descubrimiento de direcciones y apertura de puertos en routers compatibles."},"326":{"id":"/docs/red/v1/avanzado-9","page_id":"/docs/red/v1/avanzado","tags":[],"type":"text","url":"/docs/red/v1/avanzado#funciones-avanzadas","content":"Estas herramientas existen para resolver necesidades concretas. Empieza por la API normal de `Eco` y añade estas capacidades cuando el problema que intentas resolver realmente las necesite."},"327":{"id":"/docs/red/v1/avanzado/lobby-y-discovery","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","type":"page","content":"Lobby y descubrimiento","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/lobby-y-discovery"},"328":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-0","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery","content":"Arquitectura de lobby, descubrimiento de servidores y separación entre el servicio de entrada y la partida."},"329":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-1","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby-y-discovery#lobby-y-descubrimiento","content":"Lobby y descubrimiento"},"330":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-2","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby-y-discovery#flujo-recomendado","content":"Flujo recomendado"},"331":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-3","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/lobby-y-discovery#descubrir-servidores","content":"Descubrir servidores"},"332":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-4","page_id":"/docs/red/v1/avanzado