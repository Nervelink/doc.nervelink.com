tos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Canal`"},"682":{"id":"/docs/red/v1/fundamentos/arquitectura-53","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Ámbito compartido"},"683":{"id":"/docs/red/v1/fundamentos/arquitectura-54","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Packet`"},"684":{"id":"/docs/red/v1/fundamentos/arquitectura-55","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Paquete`"},"685":{"id":"/docs/red/v1/fundamentos/arquitectura-56","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Protocolo"},"686":{"id":"/docs/red/v1/fundamentos/arquitectura-57","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Buffer`"},"687":{"id":"/docs/red/v1/fundamentos/arquitectura-58","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Buffer`"},"688":{"id":"/docs/red/v1/fundamentos/arquitectura-59","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Datos binarios"},"689":{"id":"/docs/red/v1/fundamentos/arquitectura-60","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Player`"},"690":{"id":"/docs/red/v1/fundamentos/arquitectura-61","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Jugador`"},"691":{"id":"/docs/red/v1/fundamentos/arquitectura-62","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Participante"},"692":{"id":"/docs/red/v1/fundamentos/arquitectura-63","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Los ejemplos históricos suelen asumir un único canal activo y una API distinta. En Eco debes seguir el comportamiento actual del repositorio y utilizar las páginas de Modelo de red y Guías como referencia práctica."},"693":{"id":"/docs/red/v1/fundamentos/arquitectura-64","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#fuentes","content":"Implementación actual."},"694":{"id":"/docs/red/v1/fundamentos/arquitectura-65","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#fuentes","content":"Código del que procede la arquitectura base."},"695":{"id":"/docs/red/v1/fundamentos/arquitectura-66","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#fuentes","content":"Índice externo útil para comparar la arquitectura upstream."},"696":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"page","content":"Ciclo de vida","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida"},"697":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-0","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida","content":"Cómo se inicializan, actualizan y apagan los principales sistemas de Eco en Unity."},"698":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-1","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#ciclo-de-vida","content":"Ciclo de vida"},"699":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-2","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#arranque-del-sistema","content":"Arranque del sistema"},"700":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-3","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#componente-y-actualizadorred","content":"Componente y ActualizadorRed"},"701":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-4","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#procesamiento-de-paquetes","content":"Procesamiento de paquetes"},"702":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-5","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#carga-de-escenas","content":"Carga de escenas"},"703":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-6","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#apagado","content":"Apagado"},"704":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-7","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/ciclo-de-vida#qué-aporta-esta-arquitectura","content":"Qué aporta esta arquitectura"},"705":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-8","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#ciclo-de-vida","content":"Una parte importante de la arquitectura de Eco ocurre fuera de las llamadas que haces desde gameplay. El sistema mantiene instancias de cliente, servidor, actualizadores y colas para evitar que cada componente tenga que implementar su propio ciclo de red."},"706":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-9","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#arranque-del-sistema","content":"`Eco` se integra con el arranque de Pandora y se inicializa como sistema. Su `Iniciar()` registra sus RCR, instala los eventos internos y crea el servidor local cuando corresponde."},"707":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-10","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#arranque-del-sistema","content":"No necesitas llamar manualmente a `Eco.Iniciar()` en el uso normal."},"708":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-11","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#componente-y-actualizadorred","content":"`Componente` no depende exclusivamente de los callbacks estándar de `MonoBehaviour` para integrar el objeto de red. En `Awake()` obtiene o prepara el `Objeto` asociado y registra el componente en `ActualizadorRed`."},"709":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-12","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#componente-y-actualizadorred","content":"Esto permite centralizar varias operaciones que de otro modo acabarían repartidas entre cientos de `Update`, `LateUpdate` y `Start`."},"710":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-13","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#componente-y-actualizadorred","content":"`ActualizadorRed` también admite `IUpdateable`, `ILateUpdateable`, `IInfrequentUpdateable`, callbacks de un solo uso, invocaciones retardadas y coroutines."},"711":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-14","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#procesamiento-de-paquetes","content":"El cliente recibe bytes del transporte, los convierte en `Buffer` y procesa los paquetes dentro del ciclo de actualización de Eco."},"712":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-15","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#procesamiento-de-paquetes","content":"El método `Eco.ProcesarPaquetes` es reemplazable para integraciones avanzadas. En la configuración normal procesa la cola del `ClienteJuego` una vez que las condiciones de carga de escena lo permiten."},"713":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-16","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#carga-de-escenas","content":"La carga de escena está coordinada con el canal. Cuando el servidor solicita un cambio de nivel, Eco registra el canal como “en carga”, limpia los objetos de ese canal y espera a que el `AsyncOperation` llegue al punto seguro antes de activar la escena."},"714":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-17","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#carga-de-escenas","content":"Esto explica por qué crear objetos inmediatamente durante un cambio de escena puede ser rechazado: el objetivo es evitar que un objeto se cree en una representación del canal que todavía está cambiando."},"715":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-18","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#apagado","content":"El apagado sigue el camino inverso:"},"716":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-19","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#apagado","content":"Eco marca internamente el estado de apagado para impedir nuevas operaciones de red mientras Unity está destruyendo objetos."},"717":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-20","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#apagado","content":"Crear manualmente otro `Eco`, llamar `Iniciar()` varias veces o mantener referencias a objetos de red durante el apagado puede romper las garantías de singleton y de limpieza."},"718":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-21","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#qué-aporta-esta-arquitectura","content":"La idea procede del patrón de TNet de centralizar la actualización y el procesamiento, pero en Eco el vocabulario y los puntos de entrada son propios. DeepWiki identifica este patrón como parte de la arquitectura de cliente de TNet; en Eco se refleja en `Eco`, `ClienteJuego`, `Objeto`, `Componente` y `ActualizadorRed`."},"719":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-22","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#qué-aporta-esta-arquitectura","content":"Referencia detallada del scheduler de actualización."},"720":{"id":"/docs/red/v1/fundamentos/ciclo-de-vida-23","page_id":"/docs/red/v1/fundamentos/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/ciclo-de-vida#qué-aporta-esta-arquitectura","content":"Visión general de todas las capas."},"721":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"page","content":"Cliente y servidor","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor"},"722":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-0","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor","content":"División de responsabilidades entre ClienteJuego, ServidorJuego, Eco y las entidades compartidas."},"723":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-1","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#cliente-y-servidor","content":"Cliente y servidor"},"724":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-2","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#cliente","content":"Cliente"},"725":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-3","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#servidor","content":"Servidor"},"726":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-4","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#flujo-cliente--servidor--clientes","content":"Flujo cliente → servidor → clientes"},"727":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-5","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#canal-como-unidad-de-aislamiento","content":"Canal como unidad de aislamiento"},"728":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-6","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#persistencia-del-servidor","content":"Persistencia del servidor"},"729":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-7","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#autoridad","content":"Autoridad"},"730":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-8","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Errores de diseño frecuentes"},"731":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-9","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#cliente-y-servidor","content":"La arquitectura de Eco distingue claramente el estado local del cliente de la autoridad del servidor. Esta separación aparece como una de las ideas centrales del análisis de TNet y es especialmente importante al diseñar gameplay multijugador."},"732":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-10","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#cliente","content":"`ClienteJuego` mantiene la sesión desde el lado de Unity:"},"733":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-11","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#cliente","content":"`Eco` actúa como fachada pública para que el código de juego no tenga que manipular directamente todos esos detalles."},"734":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-12","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#servidor","content":"El servidor mantiene el estado compartido y aplica operaciones que requieren autoridad:"},"735":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-13","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#servidor","content":"El servidor no es simplemente “otro cliente con más permisos”. Es el punto que mantiene la representación compartida del mundo de red."},"736":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-14","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#flujo-cliente--servidor--clientes","content":"Esta es la razón por la que una operación local no debe considerarse automáticamente una operación sincronizada."},"737":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-15","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#canal-como-unidad-de-aislamiento","content":"Los canales permiten que el servidor procese grupos independientes de jugadores y objetos. Un jugador puede pertenecer a varios canales, pero cada entidad de red sigue ligada a un contexto concreto."},"738":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-16","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#canal-como-unidad-de-aislamiento","content":"Las operaciones de objeto deben incluir el canal correcto; no conviene inferirlo a partir de un único “canal actual” cuando hay múltiples canales activos."},"739":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-17","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#persistencia-del-servidor","content":"En canales persistentes, Eco puede mantener información más allá de la presencia inmediata de un jugador. Los objetos persistentes forman parte de ese estado y se restauran para participantes que entran posteriormente cuando el modelo de canal lo requiere."},"740":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-18","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#persistencia-del-servidor","content":"Esto hace que red y persistencia estén relacionadas, pero no significa que Eco sustituya el sistema de guardado específico del juego."},"741":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-19","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#autoridad","content":"El servidor puede verificar permisos, propietario, canal y datos antes de aplicar una operación."},"742":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-20","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#autoridad","content":"No debes enviar desde el cliente el resultado final de una operación crítica cuando el servidor puede calcularlo por sí mismo."},"743":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-21","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Error"},"744":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-22","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"Consecuencia"},"745":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-23","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"confiar en cualquier RFC recibida"},"746":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-24","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"clientes pueden falsificar acciones"},"747":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-25","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/cliente-y-servidor#errores-de-diseño-frecuentes","content":"mantener autoridad sólo en UI/local"},"748":{"id":"/docs/red/v1/fundamentos/cliente-y-servidor-26","page_id":"/docs/red/v1/fundamentos/cliente-y-servidor","tags":[],"type":"text","ur