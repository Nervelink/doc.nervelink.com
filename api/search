/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#cliente","content":"El cliente mantiene la conexión, procesa paquetes y conserva el estado local de la sesión."},"804":{"id":"/docs/red/v1/runtime/cliente-11","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#cliente","content":"> El uso habitual de Eco se apoya en su API pública; `ClienteJuego` contiene gran parte de la implementación interna."},"805":{"id":"/docs/red/v1/runtime/cliente-12","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#estados","content":"`isConnected`, `isTryingToConnect`, `isJoiningChannel`, `isInChannel` y `stage` representan estados distintos de la sesión. Eco mantiene además colecciones separadas de canales activos y de uniones pendientes."},"806":{"id":"/docs/red/v1/runtime/cliente-13","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#conexión","content":"TCP es el transporte principal. Eco puede utilizar UDP cuando está disponible y admite una conexión personalizada mediante `IConnection`."},"807":{"id":"/docs/red/v1/runtime/cliente-14","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#procesamiento","content":"Los paquetes entrantes se procesan identificando su `Paquete` y ejecutando la operación correspondiente. El cliente también mantiene estadísticas de bytes y paquetes y puede limitar el tiempo de procesamiento por frame."},"808":{"id":"/docs/red/v1/runtime/cliente-15","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#canales","content":"El cliente puede participar en varios canales simultáneamente. `JoinChannel`, `LeaveChannel`, `LeaveAllChannels`, `IsInChannel`, `IsJoiningChannel` y `GetChannel` gestionan esta pertenencia."},"809":{"id":"/docs/red/v1/runtime/cliente-16","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#jugador-local","content":"El cliente expone `playerID`, `playerName`, `playerData`, `serverTime`, `serverUptime` y el acceso a sus canales."},"810":{"id":"/docs/red/v1/runtime/cliente-17","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#servidor-local","content":"Eco puede conectar un `ClienteJuego` directamente con un `ServidorJuego` dentro del mismo proceso, evitando sockets pero conservando el flujo lógico cliente-servidor."},"811":{"id":"/docs/red/v1/runtime/cliente-18","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"Eco"},"812":{"id":"/docs/red/v1/runtime/cliente-19","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"TNet"},"813":{"id":"/docs/red/v1/runtime/cliente-20","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"`ClienteJuego`"},"814":{"id":"/docs/red/v1/runtime/cliente-21","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"`GameClient`"},"815":{"id":"/docs/red/v1/runtime/cliente-22","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"`ProtocoloTcp`"},"816":{"id":"/docs/red/v1/runtime/cliente-23","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"`TcpProtocol`"},"817":{"id":"/docs/red/v1/runtime/cliente-24","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente#referencia-a-tnet","content":"`ProtocoloUdp`"},"818":{"id":"/docs/red/v1/runtime/cliente-25","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text",