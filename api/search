ion-2","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"Crear el comportamiento remoto"},"1115":{"id":"/docs/red/v1/guias/enviar-accion-3","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Enviar la acción"},"1116":{"id":"/docs/red/v1/guias/enviar-accion-4","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Elegir destinatarios"},"1117":{"id":"/docs/red/v1/guias/enviar-accion-5","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#4-no-mezclar-acción-y-estado","content":"No mezclar acción y estado"},"1118":{"id":"/docs/red/v1/guias/enviar-accion-6","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#5-autoridad","content":"Autoridad"},"1119":{"id":"/docs/red/v1/guias/enviar-accion-7","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#6-acciones-y-múltiples-canales","content":"Acciones y múltiples canales"},"1120":{"id":"/docs/red/v1/guias/enviar-accion-8","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#7-persistencia","content":"Persistencia"},"1121":{"id":"/docs/red/v1/guias/enviar-accion-9","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Cuándo usar cada mecanismo"},"1122":{"id":"/docs/red/v1/guias/enviar-accion-10","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencia-a-tnet","content":"Referencia a TNet"},"1123":{"id":"/docs/red/v1/guias/enviar-accion-11","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencias","content":"Referencias"},"1124":{"id":"/docs/red/v1/guias/enviar-accion-12","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una **RFC** (*Remote Function Call*) se utiliza cuando la intención es ejecutar comportamiento en otro extremo de la red. Es especialmente adecuada para acciones puntuales: atacar, recoger un objeto, reproducir un efecto, solicitar una operación o notificar un evento."},"1125":{"id":"/docs/red/v1/guias/enviar-accion-13","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una RFC comunica que algo debe ocurrir. La sincronización comunica cuál es el estado actual. Si necesitas mantener `vida = 75`, sincroniza el dato; si necesitas ejecutar `RecibirDaño(25)`, una RFC representa mejor la intención."},"1126":{"id":"/docs/red/v1/guias/enviar-accion-14","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"El comportamiento de red vive normalmente en un `Componente` asociado a un `Objeto`."},"1127":{"id":"/docs/red/v1/guias/enviar-accion-15","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"`Componente` proporciona acceso al `Objeto` mediante `ero`, por lo que el código de gameplay no necesita construir manualmente el `Paquete`."},"1128":{"id":"/docs/red/v1/guias/enviar-accion-16","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"El envío se realiza con `Send`, indicando el nombre de la función y el objetivo de la comunicación."},"1129":{"id":"/docs/red/v1/guias/enviar-accion-17","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Cuando la acción necesita argumentos, estos forman parte de la llamada:"},"1130":{"id":"/docs/red/v1/guias/enviar-accion-18","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"La serialización de esos argumentos termina formando parte del `Buffer` asociado al paquete de protocolo."},"1131":{"id":"/docs/red/v1/guias/enviar-accion-19","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"El objetivo determina quién debe recibir la operación. No debe asumirse que una RFC siempre significa «todos»."},"1132":{"id":"/docs/red/v1/guias/enviar-accion-20","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"La elección debe responder a la semántica de la acción:"},"1133":{"id":"/docs/red/v1/guias/enviar-accion-21","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Necesidad"},"1134":{"id":"/docs/red/v1/guias/enviar-accion-22","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Destinatario habitual"},"1135":{"id":"/docs/red/v1/guias/enviar-accion-23","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Ejecutar en otros participantes del canal"},"1136":{"id":"/docs/red/v1/guias/enviar-accion-24","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"`Objetivo.Otros`"},"1137":{"id":"/docs/red/v1/guias/enviar-accion-25","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Ejecutar también localmente"},"1138":{"id":"/docs/red/v1/guias/enviar-accion-26","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Objetivo que incluya al emisor"},"1139":{"id":"/docs/red/v1/guias/enviar-accion-27","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Enviar al propietario"},"1140":{"id":"/docs/red/v1/guias/enviar-accion-28","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Objetivo dirigido al propietario"},"1141":{"id":"/docs/red/v1/guias/enviar-accion-29","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Comunicación persistente"},"1142":{"id":"/docs/red/v1/guias/enviar-accion-30","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Mecanismo persistente correspondiente"},"1143":{"id":"/docs/red/v1/guias/enviar-accion-31","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"El conjunto exacto de objetivos disponibles debe consultarse en la API de Eco, ya que los nombres y combinaciones forman parte de su implementación actual."},"1144":{"id":"/docs/red/v1/guias/enviar-accion-32","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#4-no-mezclar-acción-y-estado","content":"Un error habitual es utilizar RFC para representar continuamente un valor que realmente es estado."},"1145":{"id":"/docs/red