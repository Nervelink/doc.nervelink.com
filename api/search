encia","content":"Utiliza una RFC persistente cuando el hecho de haber ejecutado o registrado la operación forme parte del estado que debe conservarse."},"1398":{"id":"/docs/red/v1/guias/enviar-accion-48","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#7-persistencia","content":"No utilices persistencia sólo porque necesites fiabilidad inmediata; son conceptos distintos."},"1399":{"id":"/docs/red/v1/guias/enviar-accion-49","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Problema"},"1400":{"id":"/docs/red/v1/guias/enviar-accion-50","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Mecanismo"},"1401":{"id":"/docs/red/v1/guias/enviar-accion-51","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Ataque puntual"},"1402":{"id":"/docs/red/v1/guias/enviar-accion-52","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"RFC"},"1403":{"id":"/docs/red/v1/guias/enviar-accion-53","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Abrir una puerta"},"1404":{"id":"/docs/red/v1/guias/enviar-accion-54","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"RFC"},"1405":{"id":"/docs/red/v1/guias/enviar-accion-55","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Cambiar vida"},"1406":{"id":"/docs/red/v1/guias/enviar-accion-56","page_id":"/docs/re