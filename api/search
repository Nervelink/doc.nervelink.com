":"/docs/red/v1/ingenieria/ciclo-de-vida-1","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#arranque","content":"Arranque"},"3003":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-2","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#entrada-en-un-canal","content":"Entrada en un canal"},"3004":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-3","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#creación-de-objetos","content":"Creación de objetos"},"3005":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-4","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"Desconexión"},"3006":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-5","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida","content":"Una sesión de red debe entenderse como un ciclo completo, no como una llamada aislada a conectar."},"3007":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-6","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#arranque","content":"El sistema de red debe inicializarse antes de que otros sistemas dependan de un estado conectado. Los sistemas de gameplay deberían poder representar explícitamente estados como `Desconectado`, `Conectando`, `Conectado` y `EnPartida`."},"3008":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-7","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#entrada-en-un-canal","content":"El canal define el ámbito en el que el participante recibe objetos y datos. Entrar en un canal no significa necesariamente estar autorizado para todas las acciones del juego: esa decisión pertenece al dominio."},"3009":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-8","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#creación-de-objetos","content":"Un cliente que entra tarde debe poder recibir suficiente estado para reconstruir la escena de gameplay. Esto es una de las razones por las que la persistencia y el estado sincronizado deben diseñarse desde el principio."},"3010":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-9","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"La salida debe provocar una política explícita para cada recurso propiedad del participante: destruir, transferir, conservar temporalmente o convertirlo en propiedad del servidor."},"3011":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-10","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"Diseña la desconexión antes de terminar el sistema de ownership. Si no existe una política clara, aparecerán objetos huérfanos, estados inconsistentes o recursos perdidos."},"3012":{"id":"/docs/red/v1/ingenieria/compatibilidad","page_id":"/docs/red/v1/ingenieria/compatibilidad","type":"page","content":"Compatibilidad","breadcrumbs":["Docs","Red","Red","Contenido","Ingeniería"],"tags":[],"url":"/docs/red/v1/ingenieria/compatibilidad"},"3013":{"id":"/docs/red/v1/ingenieria/compatibilidad-0","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad","content":"Qué debe comprobarse al integrar Eco en un proyecto real."},"3014":{"id":"/docs/red/v1/ingenieria/compatibilidad-1","page_id":"/docs/red/v1/ingenieria/compatibilidad","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Lista de comprobación"},"3015":{"id":"/docs/red/v1/ingenieria/compatibilidad-2","page_id":"/docs/red/v1/ingenieria/compatibilidad","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/compatibilidad#eco-y-tnet-upstream","content":"Eco y TNet upstream"},"3016":{"id":"/docs/red/v1/ingenieria/compatibilidad-3","page_id":"/docs/red/v1/ingenieria/compatibilidad","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/compatibilidad#regla-para-actualizar","content":"Regla para actualizar"},"3017":{"id":"/docs/red/v1/ingenieria/compatibilidad-4","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad","content":"La compatibilidad no depende sólo de que un proyecto compile. Deben comprobarse versión de Unity, backend de scripting, plataformas, transporte y dependencias externas."},"3018":{"id":"/docs/red/v1/ingenieria/compatibilidad-5","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Versión de Unity utilizada por el proyecto."},"3019":{"id":"/docs/red/v1/ingenieria/compatibilidad-6","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"API de .NET disponible."},"3020":{"id":"/docs/red/v1/ingenieria/compatibilidad-7","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Plataforma objetivo."},"3021":{"id":"/docs/red/v1/ingenieria/compatibilidad-8","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Arquitectura x86/x64/ARM cuando corresponda."},"3022":{"id":"/docs/red/v1/ingenieria/compatibilidad-9","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad#lista-de-comprobación","content":"Transporte seleccionado."},"