17":{"id":"/docs/red/v1/transporte/paquetes-32","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#request-y-response","content":"No todos los paquetes siguen exactamente este patrón. Algunos son notificaciones, forwarding o mensajes internos de transporte."},"618":{"id":"/docs/red/v1/transporte/paquetes-33","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#canal-dentro-del-protocolo","content":"Muchas operaciones contienen el identificador de canal porque el servidor necesita conocer el ámbito en el que debe realizar la operación."},"619":{"id":"/docs/red/v1/transporte/paquetes-34","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#canal-dentro-del-protocolo","content":"Esto permite que una misma conexión participe en varios canales sin mezclar sus estados."},"620":{"id":"/docs/red/v1/transporte/paquetes-35","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#objetos-y-paquetes","content":"Las operaciones relacionadas con objetos incluyen habitualmente un identificador de objeto. En RFC, el identificador puede combinar el objeto con un identificador compacto de función."},"621":{"id":"/docs/red/v1/transporte/paquetes-36","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#objetos-y-paquetes","content":"Cuando no existe un identificador numérico para la función, Eco puede transportar el nombre de la función."},"622":{"id":"/docs/red/v1/transporte/paquetes-37","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#fiabilidad","content":"Los paquetes se escriben sobre buffers y después se envían mediante las rutas fiables o rápidas que correspondan. La elección de TCP o UDP no cambia el significado del paquete: cambia cómo se transporta."},"623":{"id":"/docs/red/v1/transporte/paquetes-38","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#paquetes-personalizados","content":"El servidor y el cliente pueden exponer manejadores para paquetes que no formen parte del procesamiento estándar. Esto permite extender el protocolo cuando una aplicación necesita una operación específica."},"624":{"id":"/docs/red/v1/transporte/paquetes-39","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#paquetes-personalizados","content":"Los paquetes personalizados deben mantener una definición clara del formato binario y de quién es responsable de procesarlos."},"625":{"id":"/docs/red/v1/transporte/paquetes-40","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"`Paquete` corresponde conceptualmente al sistema de `Packet`/`TNPacket` de TNet. La enumeración y los nombres de Eco son la referencia válida para este proyecto."},"626":{"id":"/docs/red/v1/transporte/paquetes-41","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Implementación actual de los tipos de paquete."},"627":{"id":"/docs/red/v1/transporte/paquetes-42","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Repositorio upstream."},"628":{"id":"/docs/red/v1/transporte/paquetes-43","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Referencia para contrastar el protocolo heredado."},"629":{"id":"/docs/red/v1/transporte/serializacion","page_id":"/docs/red/v1/transporte/serializacion","type":"page","content":"Serialización","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/serializacion"},"630":{"id":"/docs/red/v1/transporte/serializacion-0","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion","content":"Cómo Eco convierte datos entre representaciones estructuradas y binarias."},"631":{"id":"/docs/red/v1/transporte/serializacion-1","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización","content":"Serialización"},"632":{"id":"/docs/red/v1/transporte/serializacion-2","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#nodo","content":"Nodo"},"633":{"id":"/docs/red/v1/transporte/serializacion-3","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Serialización binaria"},"634":{"id":"/docs/red/v1/transporte/serializacion-4","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"Serialización de tipos"},"635":{"id":"/docs/red/v1/transporte/serializacion-5","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Nodo frente a binario"},"636":{"id":"/docs/red/v1/transporte/serializacion-6","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"Relación con Buffer"},"637":{"id":"/docs/red/v1/transporte/serializacion-7","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-paquete","content":"Relación con Paquete"},"638":{"id":"/docs/red/v1/transporte/serializacion-8","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-tnet","content":"Relación con TNet"},"639":{"id":"/docs/red/v1/transporte/serializacion-9","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#referencias","content":"Referencias"},"640":{"id":"/docs/red/v1/transporte/serializacion-10","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"La serialización es la capa que transforma los datos que utiliza Eco en una representación que puede escribirse en un `Buffer`, almacenarse o enviarse por la red."},"641":{"id":"/docs/red/v1/transporte/serializacion-11","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"Eco distingue principalmente entre datos estructurados mediante `Nodo` y serialización binaria mediante `IBinarySerializable` y `Serializacion`."},"642":{"id":"/docs/red/v1/transporte/serializacion-12","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"`Nodo` describe datos. `Buffer` contiene bytes. `Paquete` describe un mensaje del protocolo. No son tres nombres para la misma cosa."},"643":{"id":"/docs/red/v1/transporte/serializacion-13","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo","content":"`Nodo` es una estructura jerárquica formada por nombre, valor y nodos hijos. Permite representar datos con rutas y convertir valores entre tipos compatibles."},"644":{"id":"/docs/red/v1/transporte/serializacion-14","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo","content":"Entre sus operaciones están `AddChild`, `GetChild`, `SetChild`, `GetHierarchy` y `SetHierarchy`."},"645":{"id":"/docs/red/v1/transporte/serializacion-15","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Las clases que necesitan controlar cómo se representan sus datos pueden implementar `IBinarySerializable`:"},"646":{"id":"/docs/red/v1/transporte/serializacion-16","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Esto permite definir una representación específica cuando la serialización automática no sea suficiente o cuando sea importante reducir el tamaño de los datos."},"647":{"id":"/docs/red/v1/transporte/serializacion-17","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"`Serializacion` proporciona extensiones para escribir y leer tipos básicos, estructuras de Unity, arrays, listas y objetos compatibles con el sistema de Eco."},"648":{"id":"/docs/red/v1/transporte/serializacion-18","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"La resolución de tipos puede utilizar nombres serializados y cachés de tipo para evitar repetir el trabajo de reflexión."},"649":{"id":"/docs/red/v1/transporte/serializacion-19","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Los dos mecanismos responden a necesidades distintas:"},"650":{"id":"/docs/red/v1/transporte/serializacion-20","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Necesidad"},"651":{"id":"/docs/red/v1/transporte/serializacion-21","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Mecanismo"},"652":{"id":"/docs/red/v1/transporte/serializacion-22","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Datos jerárquicos y configurables"},"653":{"id":"/docs/red/v1/transporte/serializacion-23","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo`"},"654":{"id":"/docs/red/v1/transporte/serializacion-24","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Mensajes compactos de red"},"655":{"id":"/docs/red/v1/transporte/serializacion-25","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Serialización binaria"},"656":{"id":"/docs/red/v1/transporte/serializacion-26","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Formato personalizado de una clase"},"657":{"id":"/docs/red/v1/transporte/serializacion-27","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`IBinarySerializable`"},"658":{"id":"/docs/red/v1/transporte/serializacion-28","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Persistencia estructurada"},"659":{"id":"/docs/red/v1/transporte/serializacion-29","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo` + serialización"},"660":{"id":"/docs/red/v1/transporte/serializacion-30","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"El resultado de una serialización binaria termina normalmente en un `Buffer`:"},"661":{"id":"/docs/red/v1/transporte/serializacion-31","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"El `Buffer` no decide qué significa el dato. Sólo proporciona el soporte de lectura y escritura binaria."},"662":{"id":"/docs/red/v1/transporte/serializacion-32","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-paquete","content":"Un `Paquete` añade significado de protocolo al flujo binario. Por ejemplo, dos mensajes pueden transportar datos con la misma representación binaria pero utilizar diferentes tipos de paquete y, por tanto, tener comportamientos distintos."},"663":{"id":"/docs/red/v1/transporte/serializacion-33","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-tnet","content":"Eco conserva el modelo de serialización heredado de TNet, incluyendo `DataNode`, `IBinarySerializable` y la infraestructura de escritura y lectura binaria. La nomenclatura de Eco utiliza `Nodo` y `Serializacion`."},"664":{"id":"/docs/red/v1/transporte/serializacion-34","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Código de `Nodo`, `Buffer` y serialización."},"665":{"id":"/docs/red/v1/transporte/serializacion-35","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Repositorio upstream de la implementación heredada."},"666":{"id":"/docs/red/v1/transporte/serializacion-36","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Referencia externa para contrastar el sistema de serialización de TNet."},"667":{"id":"/docs/red/v1/transporte/tcp-udp","page_id":"/docs/red/v1/transporte/tcp-udp","type":"page","content":"TCP y UDP","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/tcp-udp"},"668":{"id":"/docs/red/v1/transporte/tcp-udp-0","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp","content":"Cómo Eco combina transporte fiable y transporte de baja latencia."},"669":{"id":"/docs/red/v1/transporte/tcp-udp-1","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"TCP y UDP"},"670":{"id":"/docs/red/v1/transporte/tcp-udp-2","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP"},"671":{"id":"/docs/red/v1/transporte/tcp-udp-3","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#udp","content":"UDP"},"672":{"id":"/docs/red/v1/transporte/tcp-udp-4","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#activación","content":"Activación"},"673":{"id":"/docs/red/v1/transporte/tcp-udp-5","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Qué transporte elegir"},"674":{"id":"/docs/red/v1/transporte/tcp-udp-6","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"`Send` y `SendQuickly`"},"675":{"id":"/docs/red/v1/transporte/tcp-udp-7","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"Nagle y latencia TCP"},"676":{"id":"/docs/red/v1/transporte/tcp-udp-8","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"Servidor"},"677":{"id":"/docs/red/v1/transporte/tcp-udp-9","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Restricciones de plataforma"},"678":{"id":"/docs/red/v1/transporte/tcp-udp-10","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"Relación con Paquete"},"679":{"id":"/docs/red/v1/transporte/tcp-udp-11","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Relación con TNet"},"680":{"id":"/docs/red/v1/transporte/tcp-udp-12","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"Eco dispone de un transporte principal basado en TCP y de una ruta UDP para tráfico que puede beneficiarse de menor latencia o tolerar pérdida de paquetes."},"681":{"id":"/docs/red/v1/transporte/tcp-udp-13","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP es la vía principal de comunicación del cliente con el servidor. Se utiliza para operaciones que necesitan entrega fiable y ordenada."},"682":{"id":"/docs/red/v1/transporte/tcp-udp-14","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"El cliente mantiene `ProtocoloTcp` como su protocolo principal y expone el estado de conexión a través de `ClienteJuego`."},"683":{"id":"/docs/red/v1/transporte/tcp-udp-15","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#udp","content":"Cuando está disponible, `ProtocoloUdp` permite enviar tráfico que no necesita las garantías completas de TCP."},"684":{"id":"/docs/red/v1/transporte/tcp-udp-16","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#udp","content":"El cliente puede comprobar `canUseUDP` y conocer el puerto de escucha mediante `listeningPort`."},"685":{"id":"/docs/red/v1/transporte/tcp-udp-17","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#activación","content":"UDP no se considera disponible simplemente porque exista una instancia del protocolo. El servidor debe proporcionar un puerto UDP y el cliente debe completar su activación."},"686":{"id":"/docs/red/v1/transporte/tcp-udp-18","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"La elección depende de la semántica del mensaje:"},"687":{"id":"/docs/red/v1/transporte/tcp-udp-19","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Característica"},"688":{"id":"/docs/red/v1/transporte/tcp-udp-20","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"TCP"},"689":{"id":"/docs/red/v1/transporte/tcp-udp-21","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"UDP"},"690":{"id":"/docs/red/v1/transporte/tcp-udp-22","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Entrega fiable"},"691":{"id":"/docs/red/v1/transporte/tcp-udp-23","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"692":{"id":"/docs/red/v1/transporte/tcp-udp-24","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"693":{"id":"/docs/red/v1/transporte/tcp-udp-25","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Orden de llegada"},"694":{"id":"/docs/red/v1/transporte/tcp-udp-26","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"695":{"id":"/docs/red/v1/transporte/tcp-udp-27","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No garantizado"},"696":{"id":"/docs/red/v1/transporte/tcp-udp-28","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Retransmisión"},"697":{"id":"/docs/red/v1/transporte/tcp-udp-29","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"698":{"id":"/docs/red/v1/transporte/tcp-udp-30","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"699":{"id":"/docs/red/v1/transporte/tcp-udp-31","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Latencia potencial"},"700":{"id":"/docs/red/v1/transporte/tcp-udp-32","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Mayor bajo pérdida/congestión"},"701":{"id":"/docs/red/v1/transporte/tcp-udp-33","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Menor para tráfico tolerante a pérdida"},"702":{"id":"/docs/red/v1/transporte/tcp-udp-34","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Estado crítico"},"703":{"id":"/docs/red/v1/transporte/tcp-udp-35","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Adecuado"},"704":{"id":"/docs/red/v1/transporte/tcp-udp-36","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No suele ser adecuado"},"705":{"id":"/docs/red/v1/transporte/tcp-udp-37","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Actualizaciones frecuentes"},"706":{"id":"/docs/red/v1/transporte/tcp-udp-38","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Puede ser adecuado"},"707":{"id":"/docs/red/v1/transporte/tcp-udp-39","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Suele ser más apropiado"},"708":{"id":"/docs/red/v1/transporte/tcp-udp-40","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No se debe elegir UDP simplemente por ser más rápido: si el dato necesita entrega garantizada, hay que utilizar un mecanismo fiable."},"709":{"id":"/docs/red/v1/transporte/tcp-udp-41","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"Eco abstrae gran parte de esta decisión detrás de sus operaciones de envío. `Send` representa el camino normal, mientras que `SendQuickly` permite utilizar el camino optimizado para datos donde la fiabilidad completa no sea necesaria."},"710":{"id":"/docs/red/v1/transporte/tcp-udp-42","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"La capa de gameplay no debería construir datagramas manualmente salvo que esté implementando una extensión de transporte."},"711":{"id":"/docs/red/v1/transporte/tcp-udp-43","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"`ClienteJuego.noDelay` permite activar o desactivar el algoritmo de Nagle. Activarlo puede reducir la latencia de pequeños mensajes a costa de aumentar el tráfico."},"712":{"id":"/docs/red/v1/transporte/tcp-udp-44","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"La misma configuración se comunica al servidor para mantener el comportamiento coherente del socket TCP."},"713":{"id":"/docs/red/v1/transporte/tcp-udp-45","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"`ServidorJuego` puede abrir un puerto TCP y, opcionalmente, un puerto UDP al arrancar."},"714":{"id":"/docs/red/v1/transporte/tcp-udp-46","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"El puerto UDP sólo se activa cuando se proporciona uno válido durante el arranque."},"715":{"id":"/docs/red/v1/transporte/tcp-udp-47","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"La disponibilidad de UDP depende de la plataforma y de las compilaciones de Eco. Algunas configuraciones, como determinados entornos antiguos de Unity o modos de modificación, deshabilitan explícitamente UDP."},"716":{"id":"/docs/red/v1/transporte/tcp-udp-48","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Por eso la aplicación debe consultar la disponibilidad real (`canUseUDP`) en lugar de asumir que UDP siempre está disponible."},"717":{"id":"/docs/red/v1/transporte/tcp-udp-49","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El transporte no cambia el significado de un `Paquete`."},"718":{"id":"/docs/red/v1/transporte/tcp-udp-50","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El mismo concepto de protocolo puede utilizar distintas rutas de transporte según el tipo de mensaje."},"719":{"id":"/docs/red/v1/transporte/tcp-udp-51","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"El modelo corresponde al de los protocolos TCP y UDP de TNet, pero Eco utiliza `ProtocoloTcp`, `ProtocoloUdp`, `ClienteJuego` y `ServidorJuego` como API interna."},"720":{"id":"/docs/red/v1/transporte/tcp-udp-52","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión cliente de TCP, UDP y envío de paquetes."},"721":{"id":"/docs/red/v1/transporte/tcp-udp-53","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión servidor de listeners TCP/UDP."},"722":{"id":"/docs/red/v1/transporte/tcp-udp-54","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Repositorio upstream."},"723":{"id":"/docs/red/v1/fundamentos/arquitectura","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"page","content":"Arquitectura","breadcrumbs":["Docs","Red","Red","Contenido","Fundamentos"],"tags":[],"url":"/docs/red/v1/fundamentos/arquitectura"},"724":{"id":"/docs/red/v1/fundamentos/arquitectura-0","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura","content":"Cómo se organiza Eco y cómo fluye la información entre sus capas."},"725":{"id":"/docs/red/v1/fundamentos/arquitectura-1","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#arquitectura-de-eco","content":"Arquitectura de Eco"},"726":{"id":"/docs/red/v1/fundamentos/arquitectura-2","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#vista-general","content":"Vista general"},"727":{"id":"/docs/red/v1/fundamentos/arquitectura-3","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#capas-principales","content":"Capas principales"},"728":{"id":"/docs/red/v1/fundamentos/arquitectura-4","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#cliente","content":"Cliente"},"729":{"id":"/docs/red/v1/fundamentos/arquitectura-5","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#servidor","content":"Servidor"},"730":{"id":"/docs/red/v1/fundamentos/arquitectura-6","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#común","content":"Común"},"731":{"id":"/docs/red/v1/fundamentos/arquitectura-7","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#objetos-de-red","content":"Objetos de red"},"732":{"id":"/docs/red/v1/fundamentos/arquitectura-8","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#canales","content":"Canales"},"733":{"id":"/docs/red/v1/fundamentos/arquitectura-9","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#flujo-conceptual-de-un-mensaje","content":"Flujo conceptual de un mensaje"},"734":{"id":"/docs/red/v1/fundamentos/arquitectura-10","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Relación con TNet"},"735":{"id":"/docs/red/v1/fundamentos/arquitectura-11","page_id":"/docs/red/v1/fundamentos/arquitectura","type":"heading","tags":[],"url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Referencias"},"736":{"id":"/docs/red/v1/fundamentos/arquitectura-12","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura-de-eco","content":"Eco es la capa de red utilizada por Pandora. Su implementación procede de TNet 3, pero expone una nomenclatura y una organización propias de Nervelink."},"737":{"id":"/docs/red/v1/fundamentos/arquitectura-13","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura-de-eco","content":"La documentación de Eco describe el comportamiento del código actual de `Nervelink/eco`. Las equivalencias con TNet se utilizan como referencia, no como contrato de la API."},"738":{"id":"/docs/red/v1/fundamentos/arquitectura-14","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#arquitectura-de-eco","content":"Eco no debe entenderse como una colección de RPC aislados. Su arquitectura gira alrededor de conexiones, canales, jugadores, objetos de red, componentes, mensajes y sincronización de estado."},"739":{"id":"/docs/red/v1/fundamentos/arquitectura-15","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#cliente","content":"La capa cliente contiene la lógica que conecta una instancia del juego con un servidor, procesa el tráfico recibido y mantiene la representación local de los canales y objetos de red."},"740":{"id":"/docs/red/v1/fundamentos/arquitectura-16","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#servidor","content":"El servidor mantiene el estado compartido, administra canales y jugadores y procesa las operaciones que deben existir fuera de una instancia concreta del juego."},"741":{"id":"/docs/red/v1/fundamentos/arquitectura-17","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#común","content":"La capa común contiene los tipos que necesitan compartir cliente y servidor: paquetes, buffers, identificadores, serialización y estructuras utilizadas para representar el protocolo."},"742":{"id":"/docs/red/v1/fundamentos/arquitectura-18","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#objetos-de-red","content":"Un objeto de red representa una entidad que Eco puede identificar y sincronizar dentro de un canal."},"743":{"id":"/docs/red/v1/fundamentos/arquitectura-19","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#canales","content":"El `Canal` delimita el ámbito en el que se comparte estado entre jugadores. Una conexión puede participar en uno o varios canales."},"744":{"id":"/docs/red/v1/fundamentos/arquitectura-20","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"TNet"},"745":{"id":"/docs/red/v1/fundamentos/arquitectura-21","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"Eco"},"746":{"id":"/docs/red/v1/fundamentos/arquitectura-22","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNManager`"},"747":{"id":"/docs/red/v1/fundamentos/arquitectura-23","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Eco`"},"748":{"id":"/docs/red/v1/fundamentos/arquitectura-24","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNObject`"},"749":{"id":"/docs/red/v1/fundamentos/arquitectura-25","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Objeto`"},"750":{"id":"/docs/red/v1/fundamentos/arquitectura-26","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNBehaviour`"},"751":{"id":"/docs/red/v1/fundamentos/arquitectura-27","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Componente`"},"752":{"id":"/docs/red/v1/fundamentos/arquitectura-28","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNChannel` / `Channel`"},"753":{"id":"/docs/red/v1/fundamentos/arquitectura-29","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Canal`"},"754":{"id":"/docs/red/v1/fundamentos/arquitectura-30","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNPacket` / `Packet`"},"755":{"id":"/docs/red/v1/fundamentos/arquitectura-31","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Paquete`"},"756":{"id":"/docs/red/v1/fundamentos/arquitectura-32","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`TNBuffer`"},"757":{"id":"/docs/red/v1/fundamentos/arquitectura-33","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Buffer`"},"758":{"id":"/docs/red/v1/fundamentos/arquitectura-34","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Player`"},"759":{"id":"/docs/red/v1/fundamentos/arquitectura-35","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#relación-con-tnet","content":"`Jugador`"},"760":{"id":"/docs/red/v1/fundamentos/arquitectura-36","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Código fuente de la implementación de Eco."},"761":{"id":"/docs/red/v1/fundamentos/arquitectura-37","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Repositorio original del que procede la base de Eco."},"762":{"id":"/docs/red/v1/fundamentos/arquitectura-38","page_id":"/docs/red/v1/fundamentos/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/fundamentos/arquitectura#referencias","content":"Documentación generada sobre el repositorio actual de TNet."},"763":{"id":"/docs/red/v1/fundamentos/conceptos","page_id":"/docs/red/v1/fundamentos/c