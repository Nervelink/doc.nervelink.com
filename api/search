s/red/v1/referencia/equivalencias-51","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`AutoSincronizar`"},"2784":{"id":"/docs/red/v1/referencia/equivalencias-52","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`TNAutoSync`"},"2785":{"id":"/docs/red/v1/referencia/equivalencias-53","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Sincronización automática"},"2786":{"id":"/docs/red/v1/referencia/equivalencias-54","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"La equivalencia sirve para traducir conceptos, no para asumir compatibilidad literal de APIs."},"2787":{"id":"/docs/red/v1/referencia/equivalencias-55","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"Por ejemplo, si un ejemplo de TNet habla de `TNObject`, el punto de partida equivalente en Eco es `Objeto`. A partir de ahí debe consultarse la API de Eco, ya que otros tipos y nombres pueden haber cambiado."},"2788":{"id":"/docs/red/v1/referencia/equivalencias-56","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-nomenclatura","content":"La refactorización de Eco busca que los nombres estén alineados con la nomenclatura de Pandora. Esto permite que el código de red se integre con el resto del proyecto sin mantener permanentemente la terminología histórica de TNet."},"2789":{"id":"/docs/red/v1/referencia/equivalencias-57","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"Una equivalencia de nombres no implica que las dos implementaciones tengan exactamente el mismo comportamiento. Eco puede haber incorporado refactorizaciones, cambios de arquitectura o funcionalidades propias."},"2790":{"id":"/docs/red/v1/referencia/equivalencias-58","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"La referencia definitiva siempre debe ser el código actual de `Nervelink/eco`."},"2791":{"id":"/docs/red/v1/referencia","page_id":"/docs/red/v1/referencia","type":"page","content":"Referencia","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia"},"2792":{"id":"/docs/red/v1/referencia-0","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia","content":"Fuentes, API, equivalencias y material de consulta para trabajar con Eco."},"2793":{"id":"/docs/red/v1/referencia-1","page_id":"/docs/red/v1/referencia","type":"heading","tags":[],"url":"/docs/red/v1/referencia#referencia","content":"Referencia"},"2794":{"id":"/docs/red/v1/referencia-2","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Esta sección está orientada a la consulta rápida. Aquí no se vuelve a explicar el concepto completo de cada sistema: se documenta la API, se comparan implementaciones y se enlazan las fuentes que definen el comportamiento real."},"2795":{"id":"/docs/red/v1/referencia-3","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Consulta clases, propiedades, métodos, eventos y tipos que forman la API pública de Eco."},"2796":{"id":"/docs/red/v1/referencia-4","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Repositorio original del que parte la implementación de Eco."},"2797":{"id":"/docs/red/v1/referencia-5","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Documentación generada sobre el repositorio actual de TNet."},"2798":{"id":"/docs/red/v1/referencia-6","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Código fuente que define el comportamiento normativo de Eco."},"2799":{"id":"/docs/red/v1/referencia-7","page_id":"/docs/red/v1/referencia","tags":[],"type":"text","url":"/docs/red/v1/referencia#referencia","content":"Cuando exista una diferencia, utiliza este orden: código actual de Eco → documentación de Eco → TNet upstream → documentación histórica de TNet → DeepWiki."},"2800":{"id":"/docs/red/v1/referencia/upstream","page_id":"/docs/red/v1/referencia/upstream","type":"page","content":"TNet upstream","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia/upstream"},"2801":{"id":"/docs/red/v1/referencia/upstream-0","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream","content":"Relación de Eco con la implementación original de TNet."},"2802":{"id":"/docs/red/v1/referencia/upstream-1","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"TNet upstream"},"2803":{"id":"/docs/red/v1/referencia/upstream-2","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#repositorio","content":"Repositorio"},"2804":{"id":"/docs/red/v1/referencia/upstream-3","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"Qué conserva Eco"},"2805":{"id":"/docs/red/v1/referencia/upstream-4","page_id":"/docs/red/v1/referencia/upstream","type":"heading","tags":[],"url":"/docs/red/v1/referencia/upstream#consultar-tnet-sin-confundir-apis","content":"Consultar TNet sin confundir APIs"},"2806":{"id":"/docs/red/v1/referencia/upstream-5","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"Eco parte de TNet 3 y conserva gran parte de su modelo de red. Esta referencia permite entender qué conceptos proceden de upstream y dónde consultar su implementación original."},"2807":{"id":"/docs/red/v1/referencia/upstream-6","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#tnet-upstream","content":"Para desarrollar con Eco, la fuente normativa es `Nervelink/eco`. TNet se utiliza como referencia histórica y arquitectónica."},"2808":{"id":"/docs/red/v1/referencia/upstream-7","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#repositorio","content":"Repositorio oficial de TNet mantenido por Tasharen."},"2809":{"id":"/docs/red/v1/referencia/upstream-8","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"La base de Eco mantiene conceptos como:"},"2810":{"id":"/docs/red/v1/referencia/upstream-9","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"canales y jugadores;"},"2811":{"id":"/docs/red/v1/referencia/upstream-10","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"objetos de red y componentes;"},"2812":{"id":"/docs/red/v1/referencia/upstream-11","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"RFC y mensajes del protocolo;"},"2813":{"id":"/docs/red/v1/referencia/upstream-12","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"serialización mediante nodos y buffers;"},"2814":{"id":"/docs/red/v1/referencia/upstream-13","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"transporte TCP/UDP;"},"2815":{"id":"/docs/red/v1/referencia/upstream-14","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"persistencia y estado del servidor."},"2816":{"id":"/docs/red/v1/referencia/upstream-15","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#qué-conserva-eco","content":"Eco modifica principalmente la nomenclatura y la organización para integrarlas en la arquitectura de Nervelink y Pandora."},"2817":{"id":"/docs/red/v1/referencia/upstream-16","page_id":"/docs/red/v1/referencia/upstream","tags":[],"type":"text","url":"/docs/red/v1/referencia/upstream#consultar-tnet-sin-confundir-apis","content":"La documentación y ejemplos históricos de TNet pueden utilizar nombres que ya no existen en Eco. Cuando sea necesario consultar upstream, primero hay que traducir el concepto mediante la tabla de equivalencias de Eco."},"2818":{"id":"/docs/red/v1/runtime/cliente-avanzado","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"page","content":"Cliente avanzado","breadcrumbs":["Docs","Red","Red","Contenido","Runtime"],"tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado"},"2819":{"id":"/docs/red/v1/runtime/cliente-avanzado-0","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado","content":"Estados de conexión, canales, datos de jugador y extensiones del cliente de Eco."},"2820":{"id":"/docs/red/v1/runtime/cliente-avanzado-1","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#cliente-avanzado","content":"Cliente avanzado"},"2821":{"id":"/docs/red/v1/runtime/cliente-avanzado-2","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#estados-importantes","content":"Estados importantes"},"2822":{"id":"/docs/red/v1/runtime/cliente-avanzado-3","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#canales","content":"Canales"},"2823":{"id":"/docs/red/v1/runtime/cliente-avanzado-4","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-jugador","content":"Datos del jugador"},"2824":{"id":"/docs/red/v1/runtime/cliente-avanzado-5","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-servidor","content":"Datos del servidor"},"2825":{"id":"/docs/red/v1/runtime/cliente-avanzado-6","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#ping-y-métricas","content":"Ping y métricas"},"2826":{"id":"/docs/red/v1/runtime/cliente-avanzado-7","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#desconexión","content":"Desconexión"},"2827":{"id":"/docs/red/v1/runtime/cliente-avanzado-8","page_id":"/docs/red/v1/runtime/cliente-avanzado","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Referencias"},"2828":{"id":"/docs/red/v1/runtime/cliente-avanzado-9","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#cliente-avanzado","content":"`ClienteJuego` centraliza el estado de sesión del cliente: conexión, jugador local, canales, datos del servidor y jugador, TCP, UDP y colas. La implementación expone además el estado de unión a canales y soporte para servidor local sin sockets. fileciteturn216file0"},"2829":{"id":"/docs/red/v1/runtime/cliente-avanzado-10","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#estados-importantes","content":"No confundas `isConnected`, `isJoiningChannel` e `isInChannel`: representan estados distintos."},"2830":{"id":"/docs/red/v1/runtime/cliente-avanzado-11","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#canales","content":"`channels` contiene los canales actuales y `IsJoiningChannel(id)` / `IsInChannel(id)` permiten consultar un canal concreto. Esto es fundamental en un cliente multicanal."},"2831":{"id":"/docs/red/v1/runtime/cliente-avanzado-12","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-jugador","content":"`playerData` y `SetPlayerData` proporcionan almacenamiento asociado al jugador, separado del `Nodo` de un objeto. `SyncPlayerData()` permite forzar la sincronización del árbol completo. fileciteturn216file0"},"2832":{"id":"/docs/red/v1/runtime/cliente-avanzado-13","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#datos-del-servidor","content":"`serverData` representa configuración global asociada al servidor. No debe utilizarse como sustituto del estado de una partida o del estado individual de un jugador."},"2833":{"id":"/docs/red/v1/runtime/cliente-avanzado-14","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#ping-y-métricas","content":"El cliente expone `ping`, bytes y paquetes enviados/recibidos y el tiempo del servidor. Estos valores son útiles para diagnóstico y telemetría, pero no deben utilizarse directamente como lógica de gameplay sin una estrategia de tolerancia a latencia."},"2834":{"id":"/docs/red/v1/runtime/cliente-avanzado-15","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#desconexión","content":"La desconexión debe tratarse como un cambio de estado de la sesión. Los objetos y canales locales pueden quedar inválidos aunque referencias de Unity sigan existiendo; la integración debe escuchar los eventos apropiados y limpiar su estado."},"2835":{"id":"/docs/red/v1/runtime/cliente-avanzado-16","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Referencia general del cliente."},"2836":{"id":"/docs/red/v1/runtime/cliente-avanzado-17","page_id":"/docs/red/v1/runtime/cliente-avanzado","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente-avanzado#referencias","content":"Workflow práctico de diagnóstico."},"2837":{"id":"/docs/red/v1/runtime/cliente","page_id":"/docs/red/v1/runtime/cliente","type":"page","content":"Cliente","breadcrumbs":["Docs","Red","Red","Contenido","Runtime"],"tags":[],"url":"/docs/red/v1/runtime/cliente"},"2838":{"id":"/docs/red/v1/runtime/cliente-0","page_id":"/docs/red/v1/runtime/cliente","tags":[],"type":"text","url":"/docs/red/v1/runtime/cliente","content":"Ciclo de vida de ClienteJuego, conexión, canales, transporte y estado de sesión."},"2839":{"id":"/docs/red/v1/runtime/cliente-1","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#cliente","content":"Cliente"},"2840":{"id":"/docs/red/v1/runtime/cliente-2","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#anatomía","content":"Anatomía"},"2841":{"id":"/docs/red/v1/runtime/cliente-3","page_id":"/docs/red/v1/runtime/cliente","type":"heading","tags":[],"url":"/docs/red/v1/runtime/cliente#estados-de-sesión","content":"Estados de sesión"},"2842":{"id":"/docs/red/v1/runtime/cliente-4","page_id":"/docs