/canales#elegir-persistencia","content":"Persistente"},"1941":{"id":"/docs/red/v1/persistencia/canales-13","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Partida temporal de cuatro jugadores"},"1942":{"id":"/docs/red/v1/persistencia/canales-14","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Normalmente no"},"1943":{"id":"/docs/red/v1/persistencia/canales-15","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Mundo persistente"},"1944":{"id":"/docs/red/v1/persistencia/canales-16","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Sí"},"1945":{"id":"/docs/red/v1/persistencia/canales-17","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Evento que debe desaparecer al terminar"},"1946":{"id":"/docs/red/v1/persistencia/canales-18","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"No"},"1947":{"id":"/docs/red/v1/persistencia/canales-19","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Lobby estable"},"1948":{"id":"/docs/red/v1/persistencia/canales-20","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#elegir-persistencia","content":"Puede serlo"},"1949":{"id":"/docs/red/v1/persistencia/canales-21","page_id":"/docs/red/v1/persistencia/canales","tags":[],"type":"text","url":"/docs/red/v1/persistencia/canales#referencias","content":"Uso de varios canales desde un único cliente."},"1950":{"id":"/docs/red/v1/persistencia/estado","page_id":"/docs/red/v1/persistencia/estado","type":"page","content":"Estado persistente","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/estado"},"1951":{"id":"/docs/red/v1/persistencia/estado-0","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"Estado persistente"},"1952":{"id":"/docs/red/v1/persistencia/estado-1","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#capas-de-estado","content":"Capas de estado"},"1953":{"id":"/docs/red/v1/persistencia/estado-2","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"Qué guardar"},"1954":{"id":"/docs/red/v1/persistencia/estado-3","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#qué-no-guardar","content":"Qué no guardar"},"1955":{"id":"/docs/red/v1/persistencia/estado-4","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#guardado-y-sueño","content":"Guardado y sueño"},"1956":{"id":"/docs/red/v1/persistencia/estado-5","page_id":"/docs/red/v1/persistencia/estado","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/estado#integración-con-el-guardado-del-juego","content":"Integración con el guardado del juego"},"1957":{"id":"/docs/red/v1/persistencia/estado-6","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#estado-persistente","content":"La persistencia registra información de red que debe sobrevivir a determinados cambios de sesión. No significa que cada dato enviado por el juego se escriba inmediatamente en disco."},"1958":{"id":"/docs/red/v1/persistencia/estado-7","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#capas-de-estado","content":"`ServidorJuego` mantiene un archivo de mundo y funciones de lectura/escritura que pueden sustituirse por otro almacenamiento, como un servicio externo. fileciteturn233file0"},"1959":{"id":"/docs/red/v1/persistencia/estado-8","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"Guarda aquello que otro proceso o jugador debe poder reconstruir sin depender de eventos que ya ocurrieron."},"1960":{"id":"/docs/red/v1/persistencia/estado-9","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"Ejemplos:"},"1961":{"id":"/docs/red/v1/persistencia/estado-10","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"objetos persistentes;"},"1962":{"id":"/docs/red/v1/persistencia/estado-11","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"datos de canales;"},"1963":{"id":"/docs/red/v1/persistencia/estado-12","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"RFC guardadas necesarias para reconstrucción;"},"1964":{"id":"/docs/red/v1/persistencia/estado-13","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-guardar","content":"configuración global del servidor."},"1965":{"id":"/docs/red/v1/persistencia/estado-14","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#qué-no-guardar","content":"No conviertas el estado transitorio de cada frame en datos persistentes. Una posición temporal o una métrica de rendimiento normalmente necesita sincronización, interpolación o un guardado específico del juego, no formar parte del mundo persistido por Eco."},"1966":{"id":"/docs/red/v1/persistencia/estado-15","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#guardado-y-sueño","content":"El servidor puede reducir el uso de memoria de canales sin jugadores mediante `Sleep()` y recuperarlos con `Wake()`. Este mecanismo complementa el almacenamiento: libera memoria activa sin perder necesariamente el estado persistente. fileciteturn233file0"},"1967":{"id":"/docs/red/v1/persistencia/estado-16","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#integración-con-el-guardado-del-juego","content":"Eco y el juego pueden tener dos capas distintas:"},"1968":{"id":"/docs/red/v1/persistencia/estado-17","page_id":"/docs/red/v1/persistencia/estado","tags":[],"type":"text","url":"/docs/red/v1/persistencia/estado#integración-con-el-guardado-del-juego","content":"Evita guardar ambos sistemas en paralelo sin un contrato claro. La red debe poder reconstruirse desde su propio estado sin asumir detalles internos del save del juego."},"1969":{"id":"/docs/red/v1/persistencia","page_id":"/docs/red/v1/persistencia","type":"page","content":"Persistencia","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia"},"1970":{"id":"/docs/red/v1/persistencia-0","page_id":"/docs/red/v1/persistencia","tags":[],"type":"text","url":"/docs/red/v1/persistencia","content":"Cómo Eco conserva, restaura y reduce el estado de una sesión de juego."},"1971":{"id":"/docs/red/v1/persistencia-1","page_id":"/docs/red/v1/persistencia","type":"heading","tags":[],"url":"/docs/red/v1/persistencia#persistencia","content":"Persistencia"},"1972":{"id":"/docs/red/v1/persistencia-2","page_id":"/docs/red/v1/persistencia","tags":[],"type":"text","url":"/docs/red/v1/persistencia#persistencia","content":"La persistencia de Eco no es el guardado de partida del gameplay. Es la capacidad del servidor para conservar suficiente estado de red como para restaurar canales, objetos, datos y RFC cuando el proceso o los jugadores cambian de estado."},"1973":{"id":"/docs/red/v1/persistencia-3","page_id":"/docs/red/v1/persistencia","tags":[],"type":"text","url":"/docs/red/v1/persistencia#persistencia","content":"Qué se conserva y qué significa restaurarlo."},"1974":{"id":"/docs/red/v1/persistencia-4","page_id":"/docs/red/v1/persistencia","tags":[],"type":"text","url":"/docs/red/v1/persistencia#persistencia","content":"Ciclo de vida de un canal que permanece abierto sin jugadores."},"1975":{"id":"/docs/red/v1/persistencia-5","page_id":"/docs/red/v1/persistencia","tags":[],"type":"text","url":"/docs/red/v1/persistencia#persistencia","content":"Persistencia, ownership y reconstrucción de objetos dinámicos."},"1976":{"id":"/docs/red/v1/persistencia/objetos","page_id":"/docs/red/v1/persistencia/objetos","type":"page","content":"Objetos persistentes","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/objetos"},"1977":{"id":"/docs/red/v1/persistencia/objetos-0","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#objetos-persistentes","content":"Objetos persistentes"},"1978":{"id":"/docs/red/v1/persistencia/objetos-1","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#crear-un-objeto-persistente","content":"Crear un objeto persistente"},"1979":{"id":"/docs/red/v1/persistencia/objetos-2","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#estado-del-objeto","content":"Estado del objeto"},"1980":{"id":"/docs/red/v1/persistencia/objetos-3","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#ownership","content":"Ownership"},"1981":{"id":"/docs/red/v1/persistencia/objetos-4","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#destrucción","content":"Destrucción"},"1982":{"id":"/docs/red/v1/persistencia/objetos-5","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#restauración","content":"Restauración"},"1983":{"id":"/docs/red/v1/persistencia/objetos-6","page_id":"/docs/red/v1/persistencia/objetos","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/objetos#regla-de-diseño","content":"Regla de diseño"},"1984":{"id":"/docs/red/v1/persistencia/objetos-7","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#objetos-persistentes","content":"Los objetos dinámicos pueden configurarse para conservarse en el servidor. La persistencia afecta a su existencia y reconstrucción, no sólo a un campo individual."},"1985":{"id":"/docs/red/v1/persistencia/objetos-8","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#crear-un-objeto-persistente","content":"El protocolo distingue tipos de creación donde el objeto puede quedar guardado en el servidor. Entre las variantes descritas por Eco/TNet están los objetos guardados cuyo ownership se reasigna cuando el propietario abandona y los que se destruyen al abandonar el propietario. fileciteturn227file0"},"1986":{"id":"/docs/red/v1/persistencia/objetos-9","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#estado-del-objeto","content":"El `Objeto` mantiene un `Nodo` con datos sincronizados. Durante la creación puede establecerse el árbol completo; después conviene modificar propiedades individuales mediante `Set`. fileciteturn235file0"},"1987":{"id":"/docs/red/v1/persistencia/objetos-10","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#ownership","content":"Un objeto persistente puede sobrevivir al propietario. Por eso ownership y existencia no deben estar acoplados:"},"1988":{"id":"/docs/red/v1/persistencia/objetos-11","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#ownership","content":"`Objeto.ownerID` y `owner` representan el propietario actual y permiten cambiarlo para objetos dinámicos cuando el jugador destino pertenece al canal. Los objetos estáticos no pueden cambiar de propietario mediante esta API. fileciteturn234file0"},"1989":{"id":"/docs/red/v1/persistencia/objetos-12","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#destrucción","content":"`DestroySelf()` elimina el objeto de red; la persistencia no implica que el objeto sea indestructible. La decisión de destruirlo debe formar parte de las reglas de la partida."},"1990":{"id":"/docs/red/v1/persistencia/objetos-13","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#restauración","content":"Cuando un canal vuelve a tener participantes, el servidor necesita reproducir el estado persistente suficiente para reconstruir los objetos y sus datos. Por eso las operaciones guardadas y los datos persistentes deben ser deterministas y compatibles con la versión actual del juego."},"1991":{"id":"/docs/red/v1/persistencia/objetos-14","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#regla-de-diseño","content":"Un objeto persistente debería poder responder a esta pregunta:"},"1992":{"id":"/docs/red/v1/persistencia/objetos-15","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#regla-de-diseño","content":"> “Si ningún jugador estuviera conectado durante un tiempo, ¿qué información necesitaríamos para reconstruirlo correctamente?”"},"1993":{"id":"/docs/red/v1/persistencia/objetos-16","page_id":"/docs/red/v1/persistencia/objetos","tags":[],"type":"text","url":"/docs/red/v1/persistencia/objetos#regla-de-diseño","content":"Si la respuesta son cientos de eventos transitorios, probablemente el modelo de persistencia necesita simplificarse."},"1994":{"id":"/docs/red/v1/persistencia/persistencia-avanzada","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"page","content":"Persistencia avanzada","breadcrumbs":["Docs","Red","Red","Contenido","Persistencia"],"tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada"},"1995":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-0","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada","content":"Cómo Eco conserva objetos, RFC, datos de canal y estado para reconstruir una sesión."},"1996":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-1","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#persistencia-avanzada","content":"Persistencia avanzada"},"1997":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-2","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#objetos-persistentes","content":"Objetos persistentes"},"1998":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-3","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#rfc-persistentes","content":"RFC persistentes"},"1999":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-4","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#orden-de-las-rfc-guardadas","content":"Orden de las RFC guardadas"},"2000":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-5","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#canales-persistentes","content":"Canales persistentes"},"2001":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-6","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#reducción-de-memoria","content":"Reducción de memoria"},"2002":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-7","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#exportar-e-importar-objetos","content":"Exportar e importar objetos"},"2003":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-8","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","type":"heading","tags":[],"url":"/docs/red/v1/persistencia/persistencia-avanzada#qué-no-debe-guardarse-aquí","content":"Qué no debe guardarse aquí"},"2004":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-9","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#persistencia-avanzada","content":"La persistencia de Eco no consiste en hacer un `Save()` general de la escena. El servidor conserva determinadas operaciones y datos y puede reconstruir un canal a partir de ellos."},"2005":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-10","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#objetos-persistentes","content":"Al crear un objeto puedes marcarlo como persistente:"},"2006":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-11","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#objetos-persistentes","content":"La persistencia significa que el servidor conservará la información necesaria para reconstruir ese objeto cuando corresponda."},"2007":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-12","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#objetos-persistentes","content":"Un objeto persistente puede desaparecer visualmente de un cliente y reaparecer después. La persistencia describe cómo se reconstruye su existencia; la sincronización describe cómo se mantiene su estado durante la sesión."},"2008":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-13","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#rfc-persistentes","content":"Las RFC también pueden formar parte del estado persistente. Esto permite expresar el estado de un objeto como una secuencia de acciones reproducibles."},"2009":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-14","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#rfc-persistentes","content":"Existe además un patrón especialmente útil equivalente al antiguo `NoneSaved`: conservar la operación sin reenviarla inmediatamente a los clientes actuales."},"2010":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-15","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#rfc-persistentes","content":"Esto resulta apropiado para valores que pueden calcularse a partir del tiempo transcurrido, interpolación o estado base."},"2011":{"id":"/docs/red/v1/persistencia/persistencia-avanzada-16","page_id":"/docs/red/v1/persistencia/persistencia-avanzada","tags":[],"type":"text","url":"/docs/red/v1/persistencia/persistencia-avanzada#orden-de-las-rfc-guardadas","conte