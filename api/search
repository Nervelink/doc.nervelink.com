emplos/varios-canales#objetos-por-canal","content":"Objetos por canal"},"1712":{"id":"/docs/red/v1/ejemplos/varios-canales-6","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"Salir de un canal"},"1713":{"id":"/docs/red/v1/ejemplos/varios-canales-7","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#patrón-recomendado","content":"Patrón recomendado"},"1714":{"id":"/docs/red/v1/ejemplos/varios-canales-8","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Mantén el contexto explícito"},"1715":{"id":"/docs/red/v1/ejemplos/varios-canales-9","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Pasa el canal a las operaciones"},"1716":{"id":"/docs/red/v1/ejemplos/varios-canales-10","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Mantén los objetos ligados a su canal"},"1717":{"id":"/docs/red/v1/ejemplos/varios-canales-11","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Relación con TNet"},"1718":{"id":"/docs/red/v1/ejemplos/varios-canales-12","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Eco permite que una misma conexión participe en varios canales al mismo tiempo. Este comportamiento es especialmente importante en arquitecturas donde el jugador mantiene un contexto persistente y, simultáneamente, participa en una partida, chat, lobby o sesión secundaria."},"1719":{"id":"/docs/red/v1/ejemplos/varios-canales-13","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"`Eco.idUltimoCanal` existe como ayuda de compatibilidad y para determinados callbacks. Cuando un jugador está en varios canales, especifica siempre el `idCanal` de la operación."},"1720":{"id":"/docs/red/v1/ejemplos/varios-canales-14","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Comprueba cada canal por separado:"},"1721":{"id":"/docs/red/v1/ejemplos/varios-canales-15","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Nunca asumas que `ObtenerDatosCanal` se refiere al último canal utilizado: recibe explícitamente el ID."},"1722":{"id":"/docs/red/v1/ejemplos/varios-canales-16","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Los objetos tienen su propio `channelID`."},"1723":{"id":"/docs/red/v1/ejemplos/varios-canales-17","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Las operaciones de instanciación y envío deben utilizar el canal del objeto o el canal explícito del contexto."},"1724":{"id":"/docs/red/v1/ejemplos/varios-canales-18","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"La conexión continúa activa y el cliente puede seguir participando en los demás canales."},"1725":{"id":"/docs/red/v1/ejemplos/varios-canales-19","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Guarda el ID del 