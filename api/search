s/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Canal + identificador de objeto"},"779":{"id":"/docs/red/v1/modelo/objetos-59","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Implementación actual de `Objeto`."},"780":{"id":"/docs/red/v1/modelo/objetos-60","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Implementación de los componentes asociados a un objeto."},"781":{"id":"/docs/red/v1/modelo/objetos-61","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Repositorio upstream."},"782":{"id":"/docs/red/v1/modelo/objetos-62","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#referencias","content":"Referencia generada sobre la implementación actual de TNet."},"783":{"id":"/docs/red/v1/referencia/deepwiki","page_id":"/docs/red/v1/referencia/deepwiki","type":"page","content":"DeepWiki · TNet","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia/deepwiki"},"784":{"id":"/docs/red/v1/referencia/deepwiki-0","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki","content":"Referencia generada para explorar la arquitectura del TNet upstream."},"785":{"id":"/docs/red/v1/referencia/deepwiki-1","page_id":"/docs/red/v1/referencia/deepwiki","type":"heading","tags":[],"url":"/docs/red/v1/referencia/deepwiki#deepwiki--tnet","content":"DeepWiki · TNet"},"786":{"id":"/docs/red/v1/referencia/deepwiki-2","page_id":"/docs/red/v1/referencia/deepwiki","type":"heading","tags":[],"url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"Para qué utilizarlo"},"787":{"id":"/docs/red/v1/referencia/deepwiki-3","page_id":"/docs/red/v1/referencia/deepwiki","type":"heading","tags":[],"url":"/docs/red/v1/referencia/deepwiki#qué-no-debe-sustituir","content":"Qué no debe sustituir"},"788":{"id":"/docs/red/v1/referencia/deepwiki-4","page_id":"/docs/red/v1/referencia/deepwiki","type":"heading","tags":[],"url":"/docs/red/v1/referencia/deepwiki#flujo-recomendado","content":"Flujo recomendado"},"789":{"id":"/docs/red/v1/referencia/deepwiki-5","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#deepwiki--tnet","content":"DeepWiki puede ser útil para obtener una visión rápida y navegable del repositorio de TNet, especialmente cuando se necesita localizar una clase o entender las relaciones entre subsistemas."},"790":{"id":"/docs/red/v1/referencia/deepwiki-6","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#deepwiki--tnet","content":"Explorar la documentación generada del repositorio actual de TNet."},"791":{"id":"/docs/red/v1/referencia/deepwiki-7","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"DeepWiki resulta especialmente útil para:"},"792":{"id":"/docs/red/v1/referencia/deepwiki-8","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"localizar rápidamente una parte concreta del repositorio;"},"793":{"id":"/docs/red/v1/referencia/deepwiki-9","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"obtener una visión general de una arquitectura extensa;"},"794":{"id":"/docs/red/v1/referencia/deepwiki-10","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"descubrir relaciones entre clases y subsistemas;"},"795":{"id":"/docs/red/v1/referencia/deepwiki-11","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#para-qué-utilizarlo","content":"contrastar una implementación de Eco con su origen upstream."},"796":{"id":"/docs/red/v1/referencia/deepwiki-12","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#qué-no-debe-sustituir","content":"DeepWiki no sustituye al código de Eco ni a la documentación de esta versión. La implementación generada puede quedar desactualizada y puede describir nombres o flujos pertenecientes a TNet y no a Eco."},"797":{"id":"/docs/red/v1/referencia/deepwiki-13","page_id":"/docs/red/v1/referencia/deepwiki","tags":[],"type":"text","url":"/docs/red/v1/referencia/deepwiki#flujo-recomendado","content":"Cuando una página de Eco haga referencia a un concepto heredado, puede utilizarse DeepWiki para orientarse y después comprobar la implementación correspondiente en el repositorio de TNet y en `Nervelink/eco`."},"798":{"id":"/docs/red/v1/referencia/diferencias","page_id":"/docs/red/v1/referencia/diferencias","type":"page","content":"Diferencias de Eco","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia/diferencias"},"799":{"id":"/docs/red/v1/referencia/diferencias-0","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias","content":"Cambios de Eco respecto a la arquitectura heredada de TNet."},"800":{"id":"/docs/red/v1/referencia/diferencias-1","page_id":"/docs/red/v1/referencia/diferencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/diferencias#diferencias-de-eco","content":"Diferencias de Eco"},"801":{"id":"/docs/red/v1/referencia/diferencias-2","page_id":"/docs/red/v1/referencia/diferencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/diferencias#renombrado-de-la-api","content":"Renombrado de la API"},"802":{"id":"/docs/red/v1/referencia/diferencias-3","page_id":"/docs/red/v1/referencia/diferencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/diferencias#refactorizaciones","content":"Refactorizaciones"},"803":{"id":"/docs/red/v1/referencia/diferencias-4","page_id":"/docs/red/v1/referencia/diferencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/diferencias#evolución-independiente","content":"Evolución independiente"},"804":{"id":"/docs/red/v1/referencia/diferencias-5","page_id":"/docs/red/v1/referencia/diferencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/diferencias#regla-documental","content":"Regla documental"},"805":{"id":"/docs/red/v1/referencia/diferencias-6","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#diferencias-de-eco","content":"Eco comienza como una adaptación de TNet 3, pero su objetivo es que la infraestructura pueda evolucionar dentro de la arquitectura de Nervelink sin depender de la nomenclatura histórica de TNet."},"806":{"id":"/docs/red/v1/referencia/diferencias-7","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#renombrado-de-la-api","content":"La primera capa de cambio es la nomenclatura:"},"807":{"id":"/docs/red/v1/referencia/diferencias-8","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#renombrado-de-la-api","content":"Estos cambios no pretenden modificar por sí mismos la semántica de cada sistema. Su objetivo inicial es adaptar la API al vocabulario de Pandora."},"808":{"id":"/docs/red/v1/referencia/diferencias-9","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#refactorizaciones","content":"Además del renombrado, Eco introduce tipos y organización propios. Por eso no debe tratarse como una simple sustitución textual de nombres."},"809":{"id":"/docs/red/v1/referencia/diferencias-10","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#refactorizaciones","content":"Algunos ejemplos son la organización bajo `Pandora`, las abstracciones `Lista<T>`, `Nodo`, `Entidad` y la integración con los sistemas propios del proyecto."},"810":{"id":"/docs/red/v1/referencia/diferencias-11","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#evolución-independiente","content":"TNet continúa evolucionando upstream. Eco puede incorporar cambios seleccionados, refactorizarlos o mantener decisiones propias aunque la implementación de TNet cambie posteriormente."},"811":{"id":"/docs/red/v1/referencia/diferencias-12","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#evolución-independiente","content":"Esto hace necesario documentar siempre el comportamiento real de Eco y utilizar TNet como referencia secundaria."},"812":{"id":"/docs/red/v1/referencia/diferencias-13","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#regla-documental","content":"Cuando exista una diferencia entre un ejemplo de TNet y Eco, la documentación de Eco debe mostrar primero la solución de Eco y, cuando resulte útil, explicar la equivalencia o diferencia con TNet en una sección de referencia."},"813":{"id":"/docs/red/v1/referencia/diferencias-14","page_id":"/docs/red/v1/referencia/diferencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/diferencias#regla-documental","content":"La comparación detallada debe mantenerse aquí o en la página específica del sistema afectado, no dentro de cada guía de uso."},"814":{"id":"/docs/red/v1/referencia/equivalencias","page_id":"/docs/red/v1/referencia/equivalencias","type":"page","content":"Equivalencias Eco ↔ TNet","breadcrumbs":["Docs","Red","Red","Contenido","Referencia"],"tags":[],"url":"/docs/red/v1/referencia/equivalencias"},"815":{"id":"/docs/red/v1/referencia/equivalencias-0","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias","content":"Mapa de nomenclatura entre Eco y la implementación de TNet."},"816":{"id":"/docs/red/v1/referencia/equivalencias-1","page_id":"/docs/red/v1/referencia/equivalencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Equivalencias Eco ↔ TNet"},"817":{"id":"/docs/red/v1/referencia/equivalencias-2","page_id":"/docs/red/v1/referencia/equivalencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/equivalencias#cómo-utilizar-la-tabla","content":"Cómo utilizar la tabla"},"818":{"id":"/docs/red/v1/referencia/equivalencias-3","page_id":"/docs/red/v1/referencia/equivalencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/equivalencias#cambios-de-nomenclatura","content":"Cambios de nomenclatura"},"819":{"id":"/docs/red/v1/referencia/equivalencias-4","page_id":"/docs/red/v1/referencia/equivalencias","type":"heading","tags":[],"url":"/docs/red/v1/referencia/equivalencias#cambios-de-comportamiento","content":"Cambios de comportamiento"},"820":{"id":"/docs/red/v1/referencia/equivalencias-5","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Eco mantiene una relación directa con muchas de las abstracciones de TNet. Esta tabla permite localizar rápidamente el concepto equivalente cuando se consulta código, documentación o ejemplos upstream."},"821":{"id":"/docs/red/v1/referencia/equivalencias-6","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Eco"},"822":{"id":"/docs/red/v1/referencia/equivalencias-7","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"