[],"type":"text","url":"/docs/red/v1/runtime/servidor-local#diferencia-con-una-conexión-remota","content":"Mismo modelo lógico"},"3835":{"id":"/docs/red/v1/runtime/servidor","page_id":"/docs/red/v1/runtime/servidor","type":"page","content":"Servidor","breadcrumbs":["Docs","Red","Red","Contenido","Runtime"],"tags":[],"url":"/docs/red/v1/runtime/servidor"},"3836":{"id":"/docs/red/v1/runtime/servidor-0","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor","content":"Ciclo de vida de ServidorJuego, autoridad, jugadores, canales, persistencia y extensiones."},"3837":{"id":"/docs/red/v1/runtime/servidor-1","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#servidor","content":"Servidor"},"3838":{"id":"/docs/red/v1/runtime/servidor-2","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Responsabilidades"},"3839":{"id":"/docs/red/v1/runtime/servidor-3","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#ciclo-de-vida","content":"Ciclo de vida"},"3840":{"id":"/docs/red/v1/runtime/servidor-4","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#preparación-step","content":"Preparación"},"3841":{"id":"/docs/red/v1/runtime/servidor-5","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#arranque-step","content":"Arranque"},"3842":{"id":"/docs/red/v1/runtime/servidor-6","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#aceptación-step","content":"Aceptación"},"3843":{"id":"/docs/red/v1/runtime/servidor-7","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#operación-step","content":"Operación"},"3844":{"id":"/docs/red/v1/runtime/servidor-8","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#cierre-step","content":"Cierre"},"3845":{"id":"/docs/red/v1/runtime/servidor-9","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#jugadores","content":"Jugadores"},"3846":{"id":"/docs/red/v1/runtime/servidor-10","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#canales","content":"Canales"},"3847":{"id":"/docs/red/v1/runtime/servidor-11","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"Persistencia y memoria"},"3848":{"id":"/docs/red/v1/runtime/servidor-12","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"Procesamiento multihilo"},"3849":{"id":"/docs/red/v1/runtime/servidor-13","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#paquetes-personalizados","content":"Paquetes personalizados"},"3850":{"id":"/docs/red/v1/runtime/servidor-14","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#administración-y-lobby","content":"Administración y lobby"},"3851":{"id":"/docs/red/v1/runtime/servidor-15","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#servidor-local","content":"Servidor local"},"3852":{"id":"/docs/red/v1/runtime/servidor-16","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#relación-con-tnet","content":"Relación con TNet"},"3853":{"id":"/docs/red/v1/runtime/servidor-17","page_id":"/docs/red/v1/runtime/servidor","type":"heading","tags":[],"url":"/docs/red/v1/runtime/servidor#referencias","content":"Referencias"},"3854":{"id":"/docs/red/v1/runtime/servidor-18","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor","content":"`ServidorJuego` concentra la lógica autoritativa de Eco: conexiones, jugadores, canales, objetos, paquetes, persistencia y servicios auxiliares."},"3855":{"id":"/docs/red/v1/runtime/servidor-19","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor","content":"El cliente puede solicitar una operación, pero el servidor es quien debe decidir si esa operación modifica el estado compartido cuando las reglas del juego requieren autoridad central."},"3856":{"id":"/docs/red/v1/runtime/servidor-20","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Acepta jugadores y mantiene sus estados de sesión."},"3857":{"id":"/docs/red/v1/runtime/servidor-21","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Mantiene los ámbitos activos y coordina jugadores, objetos y estado."},"3858":{"id":"/docs/red/v1/runtime/servidor-22","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Guarda y restaura el estado del mundo y puede dormir canales sin jugadores."},"3859":{"id":"/docs/red/v1/runtime/servidor-23","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#responsabilidades","content":"Permite interceptar paquetes no gestionados mediante `onCustomPacket`."},"3860":{"id":"/docs/red/v1/runtime/servidor-24","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#preparación-step","content":"Configura identidad del servidor, persistencia, administración y transporte."},"3861":{"id":"/docs/red/v1/runtime/servidor-25","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#arranque-step","content":"`Start()` prepara TCP y el UDP opcional y activa el procesamiento de red."},"3862":{"id":"/docs/red/v1/runtime/servidor-26","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#aceptación-step","content":"`Listen()` mantiene la escucha de nuevas conexiones TCP y crea el estado asociado al participante."},"3863":{"id":"/docs/red/v1/runtime/servidor-27","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#operación-step","content":"El servidor procesa paquetes, actualiza jugadores y canales y ejecuta las operaciones autoritativas."},"3864":{"id":"/docs/red/v1/runtime/servidor-28","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#cierre-step","content":"La detención del servidor finaliza las conexiones y permite guardar el estado si la configuración lo requiere."},"3865":{"id":"/docs/red/v1/runtime/servidor-29","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#jugadores","content":"El servidor mantiene estructuras separadas para iterar y para resolver participantes por ID o endpoint."},"3866":{"id":"/docs/red/v1/runtime/servidor-30","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#jugadores","content":"Esto permite que un jugador sea tratado como participante lógico independientemente de la representación física de la conexión."},"3867":{"id":"/docs/red/v1/runtime/servidor-31","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#canales","content":"Los canales activos se almacenan en listas y diccionarios para combinar iteración y acceso rápido."},"3868":{"id":"/docs/red/v1/runtime/servidor-32","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#canales","content":"El mismo jugador puede pertenecer a más de un canal."},"3869":{"id":"/docs/red/v1/runtime/servidor-33","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"`ServidorJuego` dispone de un archivo de mundo y de funciones reemplazables de lectura/escritura."},"3870":{"id":"/docs/red/v1/runtime/servidor-34","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"`Sleep()` reduce la memoria utilizada por canales sin jugadores y `Wake()` permite restaurarlos. El servidor también puede realizar este tipo de reducción durante procesos de guardado."},"3871":{"id":"/docs/red/v1/runtime/servidor-35","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#persistencia-y-memoria","content":"Un canal persistente puede existir lógicamente aunque no todos sus datos permanezcan activos en memoria todo el tiempo."},"3872":{"id":"/docs/red/v1/runtime/servidor-36","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"La implementación contempla ejecución multihilo y expone `isMultiThreaded` según la configuración de compilación."},"3873":{"id":"/docs/red/v1/runtime/servidor-37","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"Es el comportamiento normal. El servidor puede procesar red y trabajo auxiliar fuera del hilo principal."},"3874":{"id":"/docs/red/v1/runtime/servidor-38","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"La directiva `SINGLE_THREADED` permite una configuración donde el procesamiento se coordina desde el ciclo de actualización."},"3875":{"id":"/docs/red/v1/runtime/servidor-39","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#procesamiento-multihilo","content":"No asumas que todo callback del servidor ocurre en el hilo principal de Unity. El código que acceda a objetos de Unity debe considerar explícitamente su contexto de ejecución."},"3876":{"id":"/docs/red/v1/runtime/servidor-40","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#paquetes-personalizados","content":"Cuando el servidor recibe un paquete que no procesa internamente puede utilizar `onCustomPacket`."},"3877":{"id":"/docs/red/v1/runtime/servidor-41","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#paquetes-personalizados","content":"Las extensiones deberían definir claramente versión, serialización, permisos y comportamiento ante datos inválidos."},"3878":{"id":"/docs/red/v1/runtime/servidor-42","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#administración-y-lobby","content":"El servidor puede mantener una lista de administradores y enlazarse con un servidor de lobby mediante `enlaceLobbyLink`."},"3879":{"id":"/docs/red/v1/runtime/servidor-43","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#administración-y-lobby","content":"Estas funciones son servicios alrededor de la sesión, no sustitutos del modelo de canales."},"3880":{"id":"/docs/red/v1/runtime/servidor-44","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor-local","content":"`ServidorJuego` puede conectarse a un `ClienteJuego` local, utilizando colas internas en lugar de sockets."},"3881":{"id":"/docs/red/v1/runtime/servidor-45","page_id":"/docs/red/v1/runtime/servidor","tags":[],"type":"text","url":"/docs/red/v1/runtime/servidor#servidor-local","content":"Consulta Servido