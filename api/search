gs":[],"url":"/docs/red/v1/guias/enviar-accion#4-no-mezclar-acción-y-estado","content":"No mezclar acción y estado"},"2295":{"id":"/docs/red/v1/guias/enviar-accion-6","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#5-autoridad","content":"Autoridad"},"2296":{"id":"/docs/red/v1/guias/enviar-accion-7","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#6-acciones-y-múltiples-canales","content":"Acciones y múltiples canales"},"2297":{"id":"/docs/red/v1/guias/enviar-accion-8","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#7-persistencia","content":"Persistencia"},"2298":{"id":"/docs/red/v1/guias/enviar-accion-9","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#8-cuándo-usar-cada-mecanismo","content":"Cuándo usar cada mecanismo"},"2299":{"id":"/docs/red/v1/guias/enviar-accion-10","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencia-a-tnet","content":"Referencia a TNet"},"2300":{"id":"/docs/red/v1/guias/enviar-accion-11","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#referencias","content":"Referencias"},"2301":{"id":"/docs/red/v1/guias/enviar-accion-12","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una **RFC** (*Remote Function Call*) se utiliza cuando la intención es ejecutar comportamiento en otro extremo de la red. Es especialmente adecuada para acciones puntuales: atacar, recoger un objeto, reproducir un efecto, solicitar una operación o notificar un evento."},"2302":{"id":"/docs/red/v1/guias/enviar-accion-13","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Una RFC comunica que algo debe ocurrir. La sincronización comunica cuál es el estado actual. Si necesitas mantener `vida = 75`, sincroniza el dato; si necesitas ejecutar `RecibirDaño(25)`, una RFC representa mejor la intención."},"2303":{"id":"/docs/red/v1/guias/enviar-accion-14","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"El comportamiento de red vive normalmente en un `Componente` asociado a un `Objeto`."},"2304":{"id":"/docs/red/v1/guias/enviar-accion-15","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"`Componente` proporciona acceso al `Objeto` mediante `ero`, por lo que el código de gameplay no necesita construir manualmente el `Paquete`."},"2305":{"id":"/docs/red/v1/guias/enviar-accion-16","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"El envío se realiza con `Send`, indicando el nombre de la función y el objetivo de la comunicación."},"2306":{"id":"/docs/red/v1/guias/enviar-accion-17","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Cuando la acción necesita argumentos, estos forman parte de la llamada:"},"2307":{"id":"/docs/red/v1/guias/enviar-accion-18","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"La serialización de esos argumentos termina formando parte del `Buffer` asociado al paquete de protocolo."},"2308":{"id":"/docs/red/v1/guias/enviar-accion-19","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"El objetivo determina quién debe recibir la operación. No debe asumirse que una RFC siempre significa «todos»."},"2309":{"id":"/docs/red/v1/guias/enviar-accion-20","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"La elección debe responder a la semántica de la acción:"},"2310":{"id":"/docs/red/v1/guias/enviar-accion-21","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Necesidad"},"2311":{"id":"/docs/red/v1/guias/enviar-accion-22","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Destinatario habitual"},"2312":{"id":"/docs/red/v1/guias/enviar-accion-23","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Ejecutar en otros participantes del canal"},"2313":{"id":"/docs/red/v1/guias/enviar-accion-24","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"`Objetivo.Otros`"},"2314":{"id":"/docs/red/v1/guias/enviar-accion-25","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Ejecutar también localmente"},"2315":{"id":"/docs/red/v1/guias/enviar-accion-26","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Objetivo que incluya al emisor"},"2316":{"id":"/docs/red/v1/guias/enviar-accion-27","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion#3-elegir-destinatarios","content":"Enviar al propietario"},"2317":{"id":"/docs/red/v1/guias/enviar-accion-28","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"ty