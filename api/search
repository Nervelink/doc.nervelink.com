d/v1/ejemplos/fisica-en-red","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"page","content":"Física en red","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red"},"862":{"id":"/docs/red/v1/ejemplos/fisica-en-red-0","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red","content":"Patrón para sincronizar vehículos y cuerpos físicos sin convertir cada frame de física en un mensaje fiable."},"863":{"id":"/docs/red/v1/ejemplos/fisica-en-red-1","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#física-en-red","content":"Física en red"},"864":{"id":"/docs/red/v1/ejemplos/fisica-en-red-2","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#separar-simulación-y-representación","content":"Separar simulación y representación"},"865":{"id":"/docs/red/v1/ejemplos/fisica-en-red-3","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Qué sincronizar"},"866":{"id":"/docs/red/v1/ejemplos/fisica-en-red-4","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"Autoridad"},"867":{"id":"/docs/red/v1/ejemplos/fisica-en-red-5","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"Frecuencia"},"868":{"id":"/docs/red/v1/ejemplos/fisica-en-red-6","page_id":"/docs/red/v1/ejemplos/fisica-en-red","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Anti-patrones"},"869":{"id":"/docs/red/v1/ejemplos/fisica-en-red-7","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#física-en-red","content":"La física es uno de los casos más difíciles de sincronizar porque genera cambios frecuentes y puede divergir ligeramente entre máquinas."},"870":{"id":"/docs/red/v1/ejemplos/fisica-en-red-8","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#separar-simulación-y-representación","content":"No es recomendable enviar cada contacto, fuerza o paso de `FixedUpdate` mediante una RFC fiable."},"871":{"id":"/docs/red/v1/ejemplos/fisica-en-red-9","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Normalmente basta con un estado reducido:"},"872":{"id":"/docs/red/v1/ejemplos/fisica-en-red-10","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Las clases `SincronizarRB` y `TransformSuave` existen precisamente para trabajar con este tipo de patrón."},"873":{"id":"/docs/red/v1/ejemplos/fisica-en-red-11","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#qué-sincronizar","content":"Una réplica remota no necesita recibir exactamente todos los estados intermedios. Puede interpolar entre estados suficientemente frecuentes."},"874":{"id":"/docs/red/v1/ejemplos/fisica-en-red-12","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"Define primero quién controla el cuerpo:"},"875":{"id":"/docs/red/v1/ejemplos/fisica-en-red-13","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#autoridad","content":"O, en diseños concretos, el propietario puede controlar la simulación y el servidor actuar como coordinador."},"876":{"id":"/docs/red/v1/ejemplos/fisica-en-red-14","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"La física y la red no necesitan compartir frecuencia."},"877":{"id":"/docs/red/v1/ejemplos/fisica-en-red-15","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#frecuencia","content":"La representación local interpola entre los estados recibidos."},"878":{"id":"/docs/red/v1/ejemplos/fisica-en-red-16","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"No envíes posición y rotación con RFC fiables en cada `FixedUpdate`. Genera tráfico, colas y latencia innecesarios y no garantiza una representación visual suave."},"879":{"id":"/docs/red/v1/ejemplos/fisica-en-red-17","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Implementación específica para cuerpos físicos."},"880":{"id":"/docs/red/v1/ejemplos/fisica-en-red-18","page_id":"/docs/red/v1/ejemplos/fisica-en-red","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/fisica-en-red#anti-patrones","content":"Interpolación y representación remota."},"881":{"id":"/docs/red/v1/ejemplos","page_id":"/docs/red/v1/ejemplos","type":"page","content":"Ejemplos","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos"},"882":{"id":"/docs/red/v1/ejemplos-0","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos","content":"Ejemplos reales incluidos en el repositorio de Eco y su traducción al workflow actual del proyecto."},"883":{"id":"/docs/red/v1/ejemplos-1","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#ejemplos","content":"Ejemplos"},"884":{"id":"/docs/red/v1/ejemplos-2","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Mapa de ejemplos"},"885":{"id":"/docs/red/v1/ejemplos-3","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Ejemplos que todavía están en el repositorio"},"886":{"id":"/docs/red/v1/ejemplos-4","page_id":"/docs/red/v1/ejemplos","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos#siguiente-paso","content":"Siguiente paso"},"887":{"id":"/docs/red/v1/ejemplos-5","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos","content":"El repositorio de Eco conserva una colección de ejemplos heredados de TNet, pero el código actual ya utiliza la nomenclatura de Eco. Esta sección convierte esos ejemplos en documentación práctica y enlaza directamente con sus fuentes."},"888":{"id":"/docs/red/v1/ejemplos-6","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos","content":"Los nombres de algunos PDFs y carpetas mantienen terminología de TNet. No significa que el runtime actual siga usando esa API. Para el comportamiento, consulta siempre el código C# de `eco`."},"889":{"id":"/docs/red/v1/ejemplos-7","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Conexión y entrada automática a un canal al iniciar el juego."},"890":{"id":"/docs/red/v1/ejemplos-8","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Sincronización automática de campos y propiedades de Unity."},"891":{"id":"/docs/red/v1/ejemplos-9","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Instanciación de un prefab al entrar en el canal apropiado."},"892":{"id":"/docs/red/v1/ejemplos-10","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"Patrón clásico de Remote Function Call."},"893":{"id":"/docs/red/v1/ejemplos-11","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#mapa-de-ejemplos","content":"El ejemplo que demuestra la capacidad multicanal de Eco."},"894":{"id":"/docs/red/v1/ejemplos-12","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Además de los recorridos anteriores, Eco conserva ejemplos de:"},"895":{"id":"/docs/red/v1/ejemplos-13","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#ejemplos-que-todavía-están-en-el-repositorio","content":"Estos ejemplos no deben desaparecer sólo porque procedan de TNet. Son una fuente útil para descubrir comportamientos que todavía necesitan documentación específica."},"896":{"id":"/docs/red/v1/ejemplos-14","page_id":"/docs/red/v1/ejemplos","tags":[],"type":"text","url":"/docs/red/v1/ejemplos#siguiente-paso","content":"Cuando un ejemplo te explique cómo funciona una característica, usa después la página conceptual correspondiente de `Fundamentos`, `Comunicación`, `Transporte` o `Runtime`."},"897":{"id":"/docs/red/v1/ejemplos/rfc","page_id":"/docs/red/v1/ejemplos/rfc","type":"page","content":"RFC","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/rfc"},"898":{"id":"/docs/red/v1/ejemplos/rfc-0","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc","content":"Ejemplo mínimo de una función remota y de la separación entre acción y estado."},"899":{"id":"/docs/red/v1/ejemplos/rfc-1","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc","content":"RFC"},"900":{"id":"/docs/red/v1/ejemplos/rfc-2","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#declarar-la-función","content":"Declarar la función"},"901":{"id":"/docs/red/v1/ejemplos/rfc-3","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#enviar","content":"Enviar"},"902":{"id":"/docs/red/v1/ejemplos/rfc-4","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#elegir-destinatarios","content":"Elegir destinatarios"},"903":{"id":"/docs/red/v1/ejemplos/rfc-5","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"RFC frente a estado"},"904":{"id":"/docs/red/v1/ejemplos/rfc-6","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"Persistencia"},"905":{"id":"/docs/red/v1/ejemplos/rfc-7","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#errores-habituales","content":"Errores habituales"},"906":{"id":"/docs/red/v1/ejemplos/rfc-8","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Método no encontrado"},"907":{"id":"/docs/red/v1/ejemplos/rfc-9","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Parámetros incompatibles"},"908":{"id":"/docs/red/v1/ejemplos/rfc-10","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#ejecutar-lógica-de-servidor-en-el-cliente","content":"Ejecutar lógica de servidor en el cliente"},"909":{"id":"/docs/red/v1/ejemplos/rfc-11","page_id":"/docs/red/v1/ejemplos/rfc","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/rfc#fuente","content":"Fuente"},"910":{"id":"/docs/red/v1/ejemplos/rfc-12","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc","content":"Una RFC permite ejecutar un método de un `Componente` asociado a un `Objeto` de red desde otra instancia de la sesión."},"911":{"id":"/docs/red/v1/ejemplos/rfc-13","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#declarar-la-función","content":"El atributo registra el método para que Eco pueda identificarlo y ejecutarlo cuando llegue el mensaje."},"912":{"id":"/docs/red/v1/ejemplos/rfc-14","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#enviar","content":"El método se invoca sobre el `Objeto` o mediante las ayudas disponibles desde `Componente`."},"913":{"id":"/docs/red/v1/ejemplos/rfc-15","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#enviar","content":"Para incluir datos:"},"914":{"id":"/docs/red/v1/ejemplos/rfc-16","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#elegir-destinatarios","content":"Consulta Objetivo para la tabla completa."},"915":{"id":"/docs/red/v1/ejemplos/rfc-17","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"Una RFC debe representar una acción o evento:"},"916":{"id":"/docs/red/v1/ejemplos/rfc-18","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"El estado debe representarse como datos:"},"917":{"id":"/docs/red/v1/ejemplos/rfc-19","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#rfc-frente-a-estado","content":"Una buena prueba es preguntar qué debe conocer un jugador que entre cinco segundos después. Si la respuesta es “el resultado actual”, necesitas estado persistente; si es “la acción que acaba de ocurrir”, normalmente necesitas una RFC."},"918":{"id":"/docs/red/v1/ejemplos/rfc-20","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#persistencia","content":"El modelo de Eco permite RFC guardadas en el servidor. Una RFC persistente no es simplemente un mensaje con `true`: pasa a formar parte del estado que puede reconstruirse posteriormente."},"919":{"id":"/docs/red/v1/ejemplos/rfc-21","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#método-no-encontrado","content":"Comprueba que el método está en un componente asociado al `Objeto` y que el atributo RMR/RFC utilizado pertenece a la API actual de Eco."},"920":{"id":"/docs/red/v1/ejemplos/rfc-22","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#parámetros-incompatibles","content":"Los parámetros deben ser serializables y coincidir con lo que espera la función receptora."},"921":{"id":"/docs/red/v1/ejemplos/rfc-23","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#ejecutar-lógica-de-servidor-en-el-cliente","content":"Una RFC ejecuta código en la instancia receptora. No la confundas con una validación server-authoritative."},"922":{"id":"/docs/red/v1/ejemplos/rfc-24","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"El repositorio contiene los ejemplos heredados de RFC y sus escenas."},"923":{"id":"/docs/red/v1/ejemplos/rfc-25","page_id":"/docs/red/v1/ejemplos/rfc","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/rfc#fuente","content":"Persistencia, callbacks y patrones avanzados."},"924":{"id":"/docs/red/v1/ejemplos/runtime-code","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"page","content":"Código en tiempo de ejecución","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/runtime-code"},"925":{"id":"/docs/red/v1/ejemplos/runtime-code-0","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code","content":"Integración avanzada de RuntimeCode para extensibilidad y herramientas dinámicas."},"926":{"id":"/docs/red/v1/ejemplos/runtime-code-1","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"Código en tiempo de ejecución"},"927":{"id":"/docs/red/v1/ejemplos/runtime-code-2","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#flujo-conceptual","content":"Flujo conceptual"},"928":{"id":"/docs/red/v1/ejemplos/runtime-code-3","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"929":{"id":"/docs/red/v1/ejemplos/runtime-code-4","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"Cuándo evitarlo"},"930":{"id":"/docs/red/v1/ejemplos/runtime-code-5","page_id":"/docs/red/v1/ejemplos/runtime-code","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Seguridad"},"931":{"id":"/docs/red/v1/ejemplos/runtime-code-6","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"`RuntimeCode` permite compilar y cargar código durante la ejecución. Es una capacidad avanzada heredada del ecosistema de TNet y debe utilizarse con un objetivo concreto."},"932":{"id":"/docs/red/v1/ejemplos/runtime-code-7","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#código-en-tiempo-de-ejecución","content":"El código de gameplay principal debe compilarse con el proyecto. `RuntimeCode` resulta adecuado para herramientas, scripting controlado, extensiones o escenarios donde el contenido no puede conocerse por adelantado."},"933":{"id":"/docs/red/v1/ejemplos/runtime-code-8","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"herramientas internas"},"934":{"id":"/docs/red/v1/ejemplos/runtime-code-9","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"prototipos de lógica distribuible"},"935":{"id":"/docs/red/v1/ejemplos/runtime-code-10","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"sistemas de modding controlado"},"936":{"id":"/docs/red/v1/ejemplos/runtime-code-11","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-utilizarlo","content":"generación dinámica de comportamiento"},"937":{"id":"/docs/red/v1/ejemplos/runtime-code-12","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#cuándo-evitarlo","content":"No lo utilices para sustituir el sistema de escenas, prefabs o componentes normales si el código ya puede distribuirse con el juego."},"938":{"id":"/docs/red/v1/ejemplos/runtime-code-13","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"El código compilado durante la ejecución tiene las mismas implicaciones de seguridad que cualquier sistema de scripting dinámico. No ejecutes código recibido de clientes no confiables."},"939":{"id":"/docs/red/v1/ejemplos/runtime-code-14","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Configuración y detalles internos."},"940":{"id":"/docs/red/v1/ejemplos/runtime-code-15","page_id":"/docs/red/v1/ejemplos/runtime-code","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/runtime-code#seguridad","content":"Más patrones avanzados de Eco."},"941":{"id":"/docs/red/v1/ejemplos/stress-test","page_id":"/docs/red/v1/ejemplos/stress-test","type":"page","content":"Prueba de estrés","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/stress-test"},"942":{"id":"/docs/red/v1/ejemplos/stress-test-0","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test","content":"Cómo diseñar una escena de prueba para medir objetos, RFC, sincronización, CPU y ancho de banda."},"943":{"id":"/docs/red/v1/ejemplos/stress-test-1","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Prueba de estrés"},"944":{"id":"/docs/red/v1/ejemplos/stress-test-2","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-medir","content":"Qué medir"},"945":{"id":"/docs/red/v1/ejemplos/stress-test-3","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"Escenario mínimo"},"946":{"id":"/docs/red/v1/ejemplos/stress-test-4","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#metodología","content":"Metodología"},"947":{"id":"/docs/red/v1/ejemplos/stress-test-5","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Línea base"},"948":{"id":"/docs/red/v1/ejemplos/stress-test-6","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Añadir objetos"},"949":{"id":"/docs/red/v1/ejemplos/stress-test-7","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Añadir frecuencia"},"950":{"id":"/docs/red/v1/ejemplos/stress-test-8","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Añadir jugadores"},"951":{"id":"/docs/red/v1/ejemplos/stress-test-9","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Encontrar el cuello de botella"},"952":{"id":"/docs/red/v1/ejemplos/stress-test-10","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#métricas-de-eco","content":"Métricas de Eco"},"953":{"id":"/docs/red/v1/ejemplos/stress-test-11","page_id":"/docs/red/v1/ejemplos/stress-test","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Qué no medir de forma aislada"},"954":{"id":"/docs/red/v1/ejemplos/stress-test-12","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#prueba-de-estrés","content":"Una prueba de estrés debe medir el sistema que realmente quieres desplegar. Eco permite observar tráfico, latencia y procesamiento, pero una prueba útil combina esas métricas con un workload controlado."},"955":{"id":"/docs/red/v1/ejemplos/stress-test-13","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#escenario-mínimo","content":"No empieces con cientos de jugadores. Primero identifica el comportamiento de una sola variable y aumenta la carga de forma incremental."},"956":{"id":"/docs/red/v1/ejemplos/stress-test-14","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#línea-base","content":"Ejecuta el escenario sin tráfico adicional y registra CPU, memoria y latencia."},"957":{"id":"/docs/red/v1/ejemplos/stress-test-15","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-objetos","content":"Incrementa la cantidad de entidades sin cambiar todavía la frecuencia de sincronización."},"958":{"id":"/docs/red/v1/ejemplos/stress-test-16","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-frecuencia","content":"Aumenta las actualizaciones por segundo y observa cuándo empieza a crecer la cola de entrada."},"959":{"id":"/docs/red/v1/ejemplos/stress-test-17","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#añadir-jugadores","content":"Repite el experimento con varias conexiones y canales."},"960":{"id":"/docs/red/v1/ejemplos/stress-test-18","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#encontrar-el-cuello-de-botella","content":"Comprueba si el límite aparece en CPU, serialización, ancho de banda, servidor o cliente."},"961":{"id":"/docs/red/v1/ejemplos/stress-test-19","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Un ping bajo no garantiza un buen rendimiento. Una aplicación puede tener baja latencia y, aun así, saturar CPU o ancho de banda."},"962":{"id":"/docs/red/v1/ejemplos/stress-test-20","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Una simulación artificial de muchos paquetes pequeños puede ser peor o mejor que una partida real. Replica la distribución de RFC, sincronización, creación y destrucción de objetos que tendrá tu juego."},"963":{"id":"/docs/red/v1/ejemplos/stress-test-21","page_id":"/docs/red/v1/ejemplos/stress-test","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/stress-test#qué-no-medir-de-forma-aislada","content":"Workflow para obtener una primera fotografía del estado de red."},"964":{"id":"/docs/red/v1/ejemplos/varios-canales","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"page","content":"Varios canales","breadcrumbs":["Docs","Red","Red","Contenido","Ejemplos"],"tags":[],"url":"/docs/red/v1/ejemplos/varios-canales"},"965":{"id":"/docs/red/v1/ejemplos/varios-canales-0","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales","content":"Ejemplo práctico de una única conexión participando en varios canales simultáneamente."},"966":{"id":"/docs/red/v1/ejemplos/varios-canales-1","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Varios canales"},"967":{"id":"/docs/red/v1/ejemplos/varios-canales-2","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#modelo","content":"Modelo"},"968":{"id":"/docs/red/v1/ejemplos/varios-canales-3","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Entrar en varios canales"},"969":{"id":"/docs/red/v1/ejemplos/varios-canales-4","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Datos por canal"},"970":{"id":"/docs/red/v1/ejemplos/varios-canales-5","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Objetos por canal"},"971":{"id":"/docs/red/v1/ejemplos/varios-canales-6","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"Salir de un canal"},"972":{"id":"/docs/red/v1/ejemplos/varios-canales-7","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#patrón-recomendado","content":"Patrón recomendado"},"973":{"id":"/docs/red/v1/ejemplos/varios-canales-8","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Mantén el contexto explícito"},"974":{"id":"/docs/red/v1/ejemplos/varios-canales-9","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Pasa el canal a las operaciones"},"975":{"id":"/docs/red/v1/ejemplos/varios-canales-10","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Mantén los objetos ligados a su canal"},"976":{"id":"/docs/red/v1/ejemplos/varios-canales-11","page_id":"/docs/red/v1/ejemplos/varios-canales","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Relación con TNet"},"977":{"id":"/docs/red/v1/ejemplos/varios-canales-12","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"Eco permite que una misma conexión participe en varios canales al mismo tiempo. Este comportamiento es especialmente importante en arquitecturas donde el jugador mantiene un contexto persistente y, simultáneamente, participa en una partida, chat, lobby o sesión secundaria."},"978":{"id":"/docs/red/v1/ejemplos/varios-canales-13","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#varios-canales","content":"`Eco.idUltimoCanal` existe como ayuda de compatibilidad y para determinados callbacks. Cuando un jugador está en varios canales, especifica siempre el `idCanal` de la operación."},"979":{"id":"/docs/red/v1/ejemplos/varios-canales-14","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#entrar-en-varios-canales","content":"Comprueba cada canal por separado:"},"980":{"id":"/docs/red/v1/ejemplos/varios-canales-15","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#datos-por-canal","content":"Nunca asumas que `ObtenerDatosCanal` se refiere al último canal utilizado: recibe explícitamente el ID."},"981":{"id":"/docs/red/v1/ejemplos/varios-canales-16","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Los objetos tienen su propio `channelID`."},"982":{"id":"/docs/red/v1/ejemplos/varios-canales-17","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#objetos-por-canal","content":"Las operaciones de instanciación y envío deben utilizar el canal del objeto o el canal explícito del contexto."},"983":{"id":"/docs/red/v1/ejemplos/varios-canales-18","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#salir-de-un-canal","content":"La conexión continúa activa y el cliente puede seguir participando en los demás canales."},"984":{"id":"/docs/red/v1/ejemplos/varios-canales-19","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-el-contexto-explícito","content":"Guarda el ID del canal en el sistema que representa ese contexto (`mundo`, `partida`, `chat`, etc.)."},"985":{"id":"/docs/red/v1/ejemplos/varios-canales-20","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#pasa-el-canal-a-las-operaciones","content":"Evita depender de variables globales como `idUltimoCanal` para decidir dónde se ejecuta una operación."},"986":{"id":"/docs/red/v1/ejemplos/varios-canales-21","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#mantén-los-objetos-ligados-a-su-canal","content":"Usa `objeto.channelID` como fuente de verdad para operaciones específicas de una entidad."},"987":{"id":"/docs/red/v1/ejemplos/varios-canales-22","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"La documentación histórica de TNet ya contemplaba múltiples canales, pero Eco lo incorpora como una capacidad fundamental del runtime actual y la expone mediante su fachada `Eco`."},"988":{"id":"/docs/red/v1/ejemplos/varios-canales-23","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"Modelo completo de canales y pertenencia."},"989":{"id":"/docs/red/v1/ejemplos/varios-canales-24","page_id":"/docs/red/v1/ejemplos/varios-canales","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/varios-canales#relación-con-tnet","content":"API de la fachada para trabajar con varios canales."},"990":{"id":"/docs/red/v1/guias/cambiar-nivel","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"page","content":"Cambiar el nivel de un canal","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/cambiar-nivel"},"991":{"id":"/docs/red/v1/guias/cambiar-nivel-0","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel","content":"Coordina el cambio de nivel de un canal sin tratarlo como una carga de escena local."},"992":{"id":"/docs/red/v1/guias/cambiar-nivel-1","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cambiar-el-nivel-de-un-canal","content":"Cambiar el nivel de un canal"},"993":{"id":"/docs/red/v1/guias/cambiar-nivel-2","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"994":{"id":"/docs/red/v1/guias/cambiar-nivel-3","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"Solicitar el cambio"},"995":{"id":"/docs/red/v1/guias/cambiar-nivel-4","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"Durante la transición"},"996":{"id":"/docs/red/v1/guias/cambiar-nivel-5","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"Cambiar de nivel no es abandonar el canal"},"997":{"id":"/docs/red/v1/guias/cambiar-nivel-6","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#errores-habituales","content":"Errores habituales"},"998":{"id":"/docs/red/v1/guias/cambiar-nivel-7","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cargar-la-escena-directamente-en-unity","content":"Cargar la escena directamente en Unity"},"999":{"id":"/docs/red/v1/guias/cambiar-nivel-8","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#operar-sobre-objetos-demasiado-pronto","content":"Operar sobre objetos demasiado pronto"},"1000":{"id":"/docs/red/v1/guias/cambiar-nivel-9","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#ignorar-el-contexto-multicanal","content":"Ignorar el contexto multicanal"},"1001":{"id":"/docs/red/v1/guias/cambiar-nivel-10","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Referencias"},"1002":{"id":"/docs/red/v1/guias/cambiar-nivel-11","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-el-nivel-de-un-canal","content":"En Eco, cambiar el nivel de un canal es una operación de red. El cambio debe coordinarse con el servidor y con el estado del canal; no es equivalente a llamar directamente a `SceneManager.LoadScene` en cada cliente."},"1003":{"id":"/docs/red/v1/guias/cambiar-nivel-12","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cuándo-utilizarlo","content":"Utiliza el cambio de nivel del canal cuando todos los participantes de un canal deban pasar a un nuevo estado o escena coordinadamente."},"1004":{"id":"/docs/red/v1/guias/cambiar-nivel-13","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"Desde el cliente, la operación se realiza sobre el canal concreto:"},"1005":{"id":"/docs/red/v1/guias/cambiar-nivel-14","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"La selección del canal es importante cuando el cliente participa en varios canales: el cambio afecta al contexto indicado y no convierte automáticamente el resto de canales en candidatos al cambio."},"1006":{"id":"/docs/red/v1/guias/cambiar-nivel-15","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"La entrada en un canal y los cambios de nivel tienen estados transitorios. Durante estas fases Eco evita que ciertas operaciones de objetos y paquetes pertenecientes al contexto anterior se procesen fuera de orden."},"1007":{"id":"/docs/red/v1/guias/cambiar-nivel-16","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"Por eso no conviene asumir que inmediatamente después de solicitar el cambio:"},"1008":{"id":"/docs/red/v1/guias/cambiar-nivel-17","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"El código de juego debe esperar a los callbacks o estados apropiados antes de empezar a operar con el nuevo contenido."},"1009":{"id":"/docs/red/v1/guias/cambiar-nivel-18","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"El canal continúa siendo el mismo ámbito lógico:"},"1010":{"id":"/docs/red/v1/guias/cambiar-nivel-19","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"Por tanto, las operaciones de salida (`LeaveChannel`) y las de cambio de nivel cumplen funciones diferentes."},"1011":{"id":"/docs/red/v1/guias/cambiar-nivel-20","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cargar-la-escena-directamente-en-unity","content":"Puede dejar al cliente fuera de sincronía respecto al servidor. El cambio debe pasar por la infraestructura de Eco cuando el nivel forma parte del estado del canal."},"1012":{"id":"/docs/red/v1/guias/cambiar-nivel-21","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#operar-sobre-objetos-demasiado-pronto","content":"Durante la transición algunos objetos pueden no estar todavía registrados. Comprueba `hasBeenRegistered`, pertenencia al canal y los callbacks apropiados antes de utilizarlos."},"1013":{"id":"/docs/red/v1/guias/cambiar-nivel-22","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#ignorar-el-contexto-multicanal","content":"Si el cliente está en varios canales, especifica siempre el canal que debe cambiar. No presupongas que el canal activo del juego es el único contexto de red existente."},"1014":{"id":"/docs/red/v1/guias/cambiar-nivel-23","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Estado, jugadores y ciclo de vida de un canal."},"1015":{"id":"/docs/red/v1/guias/cambiar-nivel-24","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Gestión de varios ámbitos de red desde una misma conexión."},"1016":{"id":"/docs/red/v1/guias/crear-partida","page_id":"/docs/red/v1/guias/crear-partida","type":"page","content":"Crear una partida","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/crear-partida"},"1017":{"id":"/docs/red/v1/guias/crear-partida-0","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida","content":"Flujo completo para conectar jugadores, crear un canal y preparar el estado inicial de una partida."},"1018":{"id":"/docs/red/v1/guias/crear-partida-1","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Crear una partida"},"1019":{"id":"/docs/red/v1/guias/crear-partida-2","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"Conectar el cliente"},"1020":{"id":"/docs/red/v1/guias/crear-partida-3","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"Crear o seleccionar el canal"},"1021":{"id":"/docs/red/v1/guias/crear-partida-4","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"Esperar la entrada al canal"},"1022":{"id":"/docs/red/v1/guias/crear-partida-5","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Crear el estado de la partida"},"1023":{"id":"/docs/red/v1/guias/crear-partida-6","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"Sincronizar el estado inicial"},"1024":{"id":"/docs/red/v1/guias/crear-partida-7","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Enviar acciones de juego"},"1025":{"id":"/docs/red/v1/guias/crear-partida-8","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"Un segundo jugador entra"},"1026":{"id":"/docs/red/v1/guias/crear-partida-9","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"Finalizar la partida"},"1027":{"id":"/docs/red/v1/guias/crear-partida-10","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#flujo-completo","content":"Flujo completo"},"1028":{"id":"/docs/red/v1/guias/crear-partida-11","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#errores-habituales","content":"Errores habituales"},"1029":{"id":"/docs/red/v1/guias/crear-partida-12","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Crear objetos antes de completar la unión"},"1030":{"id":"/docs/red/v1/guias/crear-partida-13","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Utilizar RFC para representar todo el estado"},"1031":{"id":"/docs/red/v1/guias/crear-partida-14","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Confundir desconexión con salida del canal"},"1032":{"id":"/docs/red/v1/guias/crear-partida-15","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"No definir la autoridad"},"1033":{"id":"/docs/red/v1/guias/crear-partida-16","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Véase también"},"1034":{"id":"/docs/red/v1/guias/crear-partida-17","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Una partida en Eco puede entenderse como la combinación de una conexión de red, un canal y el estado de juego que vive dentro de ese canal."},"1035":{"id":"/docs/red/v1/guias/crear-partida-18","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"El cliente necesita establecer primero una conexión con el servidor."},"1036":{"id":"/docs/red/v1/guias/crear-partida-19","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"Antes de intentar entrar en la partida conviene esperar a que `isConnected` sea verdadero."},"1037":{"id":"/docs/red/v1/guias/crear-partida-20","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"El servidor es quien mantiene el estado del canal. El cliente solicita entrar mediante `JoinChannel`."},"1038":{"id":"/docs/red/v1/guias/crear-partida-21","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"La unión no es instantánea. Eco mantiene la solicitud como pendiente hasta recibir la respuesta del servidor."},"1039":{"id":"/docs/red/v1/guias/crear-partida-22","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"Los jugadores, objetos dinámicos y estado asociado a la partida deben entenderse dentro del contexto del canal. La conexión puede permanecer activa mientras el cliente cambia de un canal a otro o participa en varios simultáneamente."},"1040":{"id":"/docs/red/v1/guias/crear-partida-23","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"No es recomendable empezar a crear lógica de partida inmediatamente después de llamar a `JoinChannel`. Primero debe completarse la unión y, cuando corresponda, la carga del nivel asociado."},"1041":{"id":"/docs/red/v1/guias/crear-partida-24","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"Durante esta transición Eco protege el flujo de paquetes para evitar que operaciones pertenecientes a una escena anterior sean procesadas fuera de contexto."},"1042":{"id":"/docs/red/v1/guias/crear-partida-25","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Una vez dentro del canal se pueden crear los objetos dinámicos que representan el estado de la partida."},"1043":{"id":"/docs/red/v1/guias/crear-partida-26","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Por ejemplo:"},"1044":{"id":"/docs/red/v1/guias/crear-partida-27","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Los objetos deben tener un propietario claro cuando su estado vaya a ser modificado por un cliente."},"1045":{"id":"/docs/red/v1/guias/crear-partida-28","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"El estado que necesitan los demás jugadores debe modelarse como datos de red, no como una sucesión de acciones."},"1046":{"id":"/docs/red/v1/guias/crear-partida-29","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"Si el estado debe actualizarse de forma continua puede utilizarse un sistema de sincronización apropiado. Para prototipos sencillos, `AutoSincronizar` puede servir como punto de partida."},"1047":{"id":"/docs/red/v1/guias/crear-partida-30","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Las acciones puntuales de la partida deben utilizar el sistema de comunicación correspondiente."},"1048":{"id":"/docs/red/v1/guias/crear-partida-31","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Por ejemplo, cambiar la vida actual de una unidad representa un cambio de estado, mientras que solicitar que una unidad ejecute una habilidad representa una acción."},"1049":{"id":"/docs/red/v1/guias/crear-partida-32","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"La partida debe poder reconstruirse desde el estado del canal y de sus objetos."},"1050":{"id":"/docs/red/v1/guias/crear-partida-33","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"Dependiendo de cómo se configure el objeto o componente, el estado puede conservarse en servidor o ser enviado explícitamente al nuevo participante."},"1051":{"id":"/docs/red/v1/guias/crear-partida-34","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"Al terminar una partida pueden utilizarse distintos niveles de limpieza:"},"1052":{"id":"/docs/red/v1/guias/crear-partida-35","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"La elección depende de si el cliente debe continuar conectado a otros canales o sesiones."},"1053":{"id":"/docs/red/v1/guias/crear-partida-36","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Puede producir objetos locales que todavía no están correctamente registrados en el contexto de red de la partida."},"1054":{"id":"/docs/red/v1/guias/crear-partida-37","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Las RFC son adecuadas para acciones. El estado debe modelarse como estado para que un jugador que entre posteriormente pueda obtener los valores actuales."},"1055":{"id":"/docs/red/v1/guias/crear-partida-38","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Salir de un canal no obliga a desconectar al cliente. Eco permite mantener la conexión y continuar en otros canales."},"1056":{"id":"/docs/red/v1/guias/crear-partida-39","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"Si varios clientes pueden modificar el mismo dato sin una autoridad clara, el estado puede entrar en conflicto. Define el propietario antes de diseñar la sincronización."},"1057":{"id":"/docs/red/v1/guias/crear-partida-40","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Ciclo de vida y gestión de los canales."},"1058":{"id":"/docs/red/v1/guias/crear-partida-41","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Identidad, propiedad y ciclo de vida de los objetos de red."},"1059":{"id":"/docs/red/v1/guias/crear-partida-42","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Cómo mantener el estado coherente entre participantes."},"1060":{"id":"/docs/red/v1/guias/crear-partida-43","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"RFC, destinatarios y comunicación de alto nivel."},"1061":{"id":"/docs/red/v1/guias/desconectar-limpiar","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"page","content":"Desconectar y limpiar la sesión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar"},"1062":{"id":"/docs/red/v1/guias/desconectar-limpiar-0","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar","content":"Cierra una sesión de Eco y evita conservar estado de una conexión anterior."},"1063":{"id":"/docs/red/v1/guias/desconectar-limpiar-1","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Desconectar y limpiar la sesión"},"1064":{"id":"/docs/red/v1/guias/desconectar-limpiar-2","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"Desconectar"},"1065":{"id":"/docs/red/v1/guias/desconectar-limpiar-3","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Canales y objetos"},"1066":{"id":"/docs/red/v1/guias/desconectar-limpiar-4","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Reconexion"},"1067":{"id":"/docs/red/v1/guias/desconectar-limpiar-5","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#errores-habituales","content":"Errores habituales"},"1068":{"id":"/docs/red/v1/guias/desconectar-limpiar-6","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Enviar durante la desconexión"},"1069":{"id":"/docs/red/v1/guias/desconectar-limpiar-7","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Reutilizar objetos destruidos"},"1070":{"id":"/docs/red/v1/guias/desconectar-limpiar-8","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Mezclar datos de dos sesiones"},"1071":{"id":"/docs/red/v1/guias/desconectar-limpiar-9","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Referencias"},"1072":{"id":"/docs/red/v1/guias/desconectar-limpiar-10","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Una desconexión no debería tratarse únicamente como cerrar un socket. El cliente mantiene jugadores, canales, objetos, colas y estado de conexión que deben quedar en un estado coherente antes de volver a conectarse."},"1073":{"id":"/docs/red/v1/guias/desconectar-limpiar-11","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"La operación de desconexión pertenece al cliente de red. Después de solicitarla, no asumas que el estado remoto desaparece de forma instantánea en el mismo frame."},"1074":{"id":"/docs/red/v1/guias/desconectar-limpiar-12","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Durante la desconexión los canales dejan de representar una sesión válida y los objetos asociados a ellos dejan de ser utilizables para enviar mensajes."},"1075":{"id":"/docs/red/v1/guias/desconectar-limpiar-13","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Una comprobación especialmente útil es `Objeto.PuedeEnviar`:"},"1076":{"id":"/docs/red/v1/guias/desconectar-limpiar-14","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"No conserves referencias a objetos de red de una sesión anterior para utilizarlas después de reconectar sin comprobar su registro y contexto."},"1077":{"id":"/docs/red/v1/guias/desconectar-limpiar-15","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Una nueva conexión debe reconstruir la sesión. No es correcto asumir que un `playerID`, `channelID`, `uid` o colección de objetos de la sesión anterior seguirá siendo válido."},"1078":{"id":"/docs/red/v1/guias/desconectar-limpiar-16","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"El hecho de que el mismo dispositivo o usuario vuelva a conectarse no convierte las dos sesiones de red en la misma sesión técnica."},"1079":{"id":"/docs/red/v1/guias/desconectar-limpiar-17","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Comprueba el estado de conexión y la posibilidad real de envío antes de lanzar RFC o cambios de estado."},"1080":{"id":"/docs/red/v1/guias/desconectar-limpiar-18","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Un objeto marcado como destruido o que ya no pertenece a un canal válido no debe recibir nuevas operaciones de red."},"1081":{"id":"/docs/red/v1/guias/desconectar-limpiar-19","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Limpia listeners, referencias y caches propios del juego cuando corresponda. Eco gestiona su estado de red, pero el juego sigue siendo responsable de sus propias referencias externas."},"1082":{"id":"/docs/red/v1/guias/desconectar-limpiar-20","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Estados de conexión y funcionamiento del cliente."},"1083":{"id":"/docs/red/v1/guias/desconectar-limpiar-21","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Ciclo de vida y posibilidad de envío de los objetos de red."},"1084":{"id":"/docs/red/v1/guias/diagnosticar-conexion","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"page","content":"Diagnosticar una conexión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion"},"1085":{"id":"/docs/red/v1/guias/diagnosticar-conexion-0","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion","content":"Identifica problemas de conexión, canales, paquetes y transporte utilizando el estado expuesto por Eco."},"1086":{"id":"/docs/red/v1/guias/diagnosticar-conexion-1","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#diagnosticar-una-conexión","content":"Diagnosticar una conexión"},"1087":{"id":"/docs/red/v1/guias/diagnosticar-conexion-2","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-la-conexión","content":"Comprobar la conexión"},"1088":{"id":"/docs/red/v1/guias/diagnosticar-conexion-3","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-canales","content":"Comprobar canales"},"1089":{"id":"/docs/red/v1/guias/diagnosticar-conexion-4","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-el-objeto","content":"Comprobar el objeto"},"1090":{"id":"/docs/red/v1/guias/diagnosticar-conexion-5","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#observar-tráfico","content":"Observar tráfico"},"1091":{"id":"/docs/red/v1/guias/diagnosticar-conexion-6","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#diagnóstico-por-capas","content":"Diagnóstico por capas"},"1092":{"id":"/docs/red/v1/guias/diagnosticar-conexion-7","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#udp","content":"UDP"},"1093":{"id":"/docs/red/v1/guias/diagnosticar-conexion-8","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Referencias"},"1094":{"id":"/docs/red/v1/guias/diagnosticar-conexion-9","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#diagnosticar-una-conexión","content":"Cuando algo falla en una sesión multijugador, conviene averiguar primero en qué capa se encuentra el problema: conexión, canal, objeto, comunicación o transporte."},"1095":{"id":"/docs/red/v1/guias/diagnosticar-conexion-10","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-la-conexión","content":"Desde `ClienteJuego` puedes comprobar si existe una conexión válida:"},"1096":{"id":"/docs/red/v1/guias/diagnosticar-conexion-11","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-la-conexión","content":"También existe información de intento de conexión, endpoint TCP, ping y uso de UDP."},"1097":{"id":"/docs/red/v1/guias/diagnosticar-conexion-12","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-canales","content":"No confundas estar conectado con pertenecer a un canal:"},"1098":{"id":"/docs/red/v1/guias/diagnosticar-conexion-13","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-canales","content":"En un cliente multicanal, consulta siempre el canal concreto que te interesa."},"1099":{"id":"/docs/red/v1/guias/diagnosticar-conexion-14","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-