id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#errores-habituales","content":"Errores habituales"},"877":{"id":"/docs/red/v1/guias/crear-partida-12","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Crear objetos antes de completar la unión"},"878":{"id":"/docs/red/v1/guias/crear-partida-13","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Utilizar RFC para representar todo el estado"},"879":{"id":"/docs/red/v1/guias/crear-partida-14","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Confundir desconexión con salida del canal"},"880":{"id":"/docs/red/v1/guias/crear-partida-15","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"No definir la autoridad"},"881":{"id":"/docs/red/v1/guias/crear-partida-16","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Véase también"},"882":{"id":"/docs/red/v1/guias/crear-partida-17","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Una partida en Eco puede entenderse como la combinación de una conexión de red, un canal y el estado de juego que vive dentro de ese canal."},"883":{"id":"/docs/red/v1/guias/crear-partida-18","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"El cliente necesita establecer primero una conexión con el servidor."},"884":{"id":"/docs/red/v1/guias/crear-partida-19","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"Antes de intentar entrar en la partida conviene esperar a que `isConnected` sea verdadero."},"885":{"id":"/docs/red/v1/guias/crear-partida-20","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"El servidor es quien mantiene el estado del canal. El cliente solicita entrar mediante `JoinChannel`."},"886":{"id":"/docs/red/v1/guias/crear-partida-21","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"La unión no es instantánea. Eco mantiene la solicitud como pendiente hasta recibir la respuesta del servidor."},"887":{"id":"/docs/red/v1/guias/crear-partida-22","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"Los jugadores, objetos dinámicos y estado asociado a la partida deben entenderse dentro del contexto del canal. La conexión puede permanecer activa mientras el cliente cambia de un canal a otro o participa en varios simultáneamente."},"888":{"id":"/docs/red/v1/guias/crear-partida-23","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"No es recomendable empezar a crear lógica de partida inmediatamente después de llamar a `JoinChannel`. Primero debe completarse la unión y, cuando corresponda, la carga del nivel asociado."},"889":{"id":"/docs/red/v1/guias/crear-partida-24","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"Durante esta transición Eco protege el flujo de paquetes para evitar que operaciones pertenecientes a una escena anterior sean procesadas fuera de contexto."},"890":{"id":"/docs/red/v1/guias/crear-partida-25","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Una vez dentro del canal se pueden crear los objetos dinámicos que representan el estado de la partida."},"891":{"id":"/docs/red/v1/guias/crear-partida-26","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Por ejemplo:"},"892":{"id":"/docs/red/v1/guias/crear-partida-27","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Los objetos deben tener un propietario claro cuando su estado vaya a ser modificado por un cliente."},"893":{"id":"/docs/red/v1/guias/crear-partida-28","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"El estado que necesitan los demás jugadores debe modelarse como datos de red, no como una sucesión de acciones."},"894":{"id":"/docs/red/v1/guias/crear-partida-29","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"Si el estado debe actualizarse de forma continua puede utilizarse un sistema de sincronización apropiado. Para prototipos sencillos, `AutoSincronizar` puede servir como punto de partida."},"895":{"id":"/docs/red/v1/guias/crear-partida-30","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Las acciones puntuales de la partida deben utilizar el sistema de comunicación correspondiente."},"896":{"id":"/docs/red/v1/guias/crear-partida-31","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Por ejemplo, cambiar la vida actual de una unidad representa un cambio de estado, mientras que solicitar que una unidad ejecute una habilidad representa una acción."},"897":{"id":"/docs/red/v1/guias/crear-partida-32","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"La partida debe poder reconstruirse desde el estado del canal y de sus objetos."},"898":{"id":"/docs/red/v1/guias/crear-partida-33","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"Dependiendo de cómo se configure el objeto o componente, el estado puede conservarse en servidor o ser enviado explícitamente al nuevo participante."},"899":{"id":"/docs/red/v1/guias/crear-partida-34","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"Al terminar una partida pueden utilizarse distintos niveles de limpieza:"},"900":{"id":"/docs/red/v1/guias/crear-partida-35","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"La elección depende de si el cliente debe continuar conectado a otros canales o sesiones."},"901":{"id":"/docs/red/v1/guias/crear-partida-36","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Puede producir objetos locales que todavía no están correctamente registrados en el contexto de red de la partida."},"902":{"id":"/docs/red/v1/guias/crear-partida-37","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Las RFC son adecuadas para acciones. El estado debe modelarse como estado para que un jugador que entre posteriormente pueda obtener los valores actuales."},"903":{"id":"/docs/red/v1/guias/crear-partida-38","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Salir de un canal no obliga a desconectar al cliente. Eco permite mantener la conexión y continuar en otros canales."},"904":{"id":"/docs/red/v1/guias/crear-partida-39","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"Si varios clientes pueden modificar el mismo dato sin una autoridad clara, el estado puede entrar en conflicto. Define el propietario antes de diseñar la sincronización."},"905":{"id":"/docs/red/v1/guias/crear-partida-40","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Ciclo de vida y gestión de los canales."},"906":{"id":"/docs/red/v1/guias/crear-partida-41","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Identidad, propiedad y ciclo de vida de los objetos de red."},"907":{"id":"/docs/red/v1/guias/crear-partida-42","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Cómo mantener el estado coherente entre participantes."},"908":{"id":"/docs/red/v1/guias/crear-partida-43","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"RFC, destinatarios y comunicación de alto nivel."},"909":{"id":"/docs/red/v1/guias/desconectar-limpiar","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"page","content":"Desconectar y limpiar la sesión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar"},"910":{"id":"/docs/red/v1/guias/desconectar-limpiar-0","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar","content":"Cierra una sesión de Eco y evita conservar estado de una conexión anterior."},"911":{"id":"/docs/red/v1/guias/desconectar-limpiar-1","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Desconectar y limpiar la sesión"},"912":{"id":"/docs/red/v1/guias/desconectar-limpiar-2","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"Desconectar"},"913":{"id":"/docs/red/v1/guias/desconectar-limpiar-3","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Canales y objetos"},"914":{"id":"/docs/red/v1/guias/desconectar-limpiar-4","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Reconexion"},"915":{"id":"/docs/red/v1/guias/desconectar-limpiar-5","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#errores-habituales","content":"Errores habituales"},"916":{"id":"/docs/red/v1/guias/desconectar-limpiar-6","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Enviar durante la desconexión"},"917":{"id":"/docs/red/v1/guias/desconectar-limpiar-7","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Reutilizar objetos destruidos"},"918":{"id":"/docs/red/v1/guias/desconectar-limpiar-8","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Mezclar datos de dos sesiones"},"919":{"id":"/docs/red/v1/guias/desconectar-limpiar-9","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Referencias"},"920":{"id":"/docs/red/v1/guias/desconectar-limpiar-10","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Una desconexión no debería tratarse únicamente como cerrar un socket. El cliente mantiene jugadores, canales, objetos, colas y estado de conexión que deben quedar en un estado coherente antes de volver a conectarse."},"921":{"id":"/docs/red/v1/guias/desconectar-limpiar-11","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"La operación de desconexión pertenece al cliente de red. Después de solicitarla, no asumas que el estado remoto desaparece de forma instantánea en el mismo frame."},"922":{"id":"/docs/red/v1/guias/desconectar-limpiar-12","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Durante la desconexión los canales dejan de representar una sesión válida y los objetos asociados a ellos dejan de ser utilizables para enviar mensajes."},"923":{"id":"/docs/red/v1/guias/desconectar-limpiar-13","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Una comprobación especialmente útil es `Objeto.PuedeEnviar`:"},"924":{"id":"/docs/red/v1/guias/desconectar-limpiar-14","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"No conserves referencias a objetos de red de una sesión anterior para utilizarlas después de reconectar sin comprobar su registro y contexto."},"925":{"id":"/docs/red/v1/guias/desconectar-limpiar-15","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Una nueva conexión debe reconstruir la sesión. No es correcto asumir que un `playerID`, `channelID`, `uid` o colección de objetos de la sesión anterior seguirá siendo válido."},"926":{"id":"/docs/red/v1/guias/desconectar-limpiar-16","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"El hecho de que el mismo dispositivo o usuario vuelva a conectarse no convierte las dos sesiones de red en la misma sesión técnica."},"927":{"id":"/docs/red/v1/guias/desconectar-limpiar-17","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Comprueba el estado de conexión y la posibilidad real de envío antes de lanzar RFC o cambios de estado."},"928":{"id":"/docs/red/v1/guias/desconectar-limpiar-18","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Un objeto marcado como destruido o que ya no pertenece a un canal válido no debe recibir nuevas operaciones de red."},"929":{"id":"/docs/red/v1/guias/desconectar-limpiar-19","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Limpia listeners, referencias y caches propios del juego cuando corresponda. Eco gestiona su estado de red, pero el juego sigue siendo responsable de sus propias referencias externas."},"930":{"id":"/docs/red/v1/guias/desconectar-limpiar-20","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Estados de conexión y funcionamiento del cliente."},"931":{"id":"/docs/red/v1/guias/desconectar-limpiar-21","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Ciclo de vida y posibilidad de envío de los objetos de red."},"932":{"id":"/docs/red/v1/guias/diagnosticar-conexion","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"page","content":"Diagnosticar una conexión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion"},"933":{"id":"/docs/red/v1/guias/diagnosticar-conexion-0","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion","content":"Identifica problemas de conexión, canales, paquetes y transporte utilizando el estado expuesto por Eco."},"934":{"id":"/docs/red/v1/guias/diagnosticar-conexion-1","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#diagnosticar-una-conexión","content":"Diagnosticar una conexión"},"935":{"id":"/docs/red/v1/guias/diagnosticar-conexion-2","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-la-conexión","content":"Comprobar la conexión"},"936":{"id":"/docs/red/v1/guias/diagnosticar-conexion-3","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-canales","content":"Comprobar canales"},"937":{"id":"/docs/red/v1/guias/diagnosticar-conexion-4","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":