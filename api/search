parada para todas las operaciones de red. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"698":{"id":"/docs/red/v1/guias/instanciar-destruir-49","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#saber-cuándo-ha-terminado-la-creación","content":"Por tanto, un patrón como este es más seguro:"},"699":{"id":"/docs/red/v1/guias/instanciar-destruir-50","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destruir-un-objeto","content":"Desde un `Componente` puede utilizarse:"},"700":{"id":"/docs/red/v1/guias/instanciar-destruir-51","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destruir-un-objeto","content":"La llamada delega en el `Objeto` asociado y solicita la destrucción de la entidad de red. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Componente.cs"},"701":{"id":"/docs/red/v1/guias/instanciar-destruir-52","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destruir-un-objeto","content":"También existe una sobrecarga con retraso y control sobre quién puede solicitarla:"},"702":{"id":"/docs/red/v1/guias/instanciar-destruir-53","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destruir-un-objeto","content":"El segundo parámetro permite exigir que la operación sólo se ejecute cuando corresponda al propietario."},"703":{"id":"/docs/red/v1/guias/instanciar-destruir-54","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destrucción-local-frente-a-destrucción-de-red","content":"No es equivalente hacer:"},"704":{"id":"/docs/red/v1/guias/instanciar-destruir-55","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destrucción-local-frente-a-destrucción-de-red","content":"a hacer:"},"705":{"id":"/docs/red/v1/guias/instanciar-destruir-56","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#destrucción-local-frente-a-destrucción-de-red","content":"La primera operación sólo actúa directamente sobre el `GameObject` local. La segunda utiliza la capa de red y permite que la destrucción se propague al resto de participantes y al servidor según el estado de la entidad."},"706":{"id":"/docs/red/v1/guias/instanciar-destruir-57","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#estado-de-destrucción","content":"Cuando se solicita la destrucción, Eco marca el objeto inmediatamente como destruido. Esto evita que se sigan enviando RFC entre la solicitud local y la confirmación del servidor. https\\://github.com/Nervelink/eco/blob/main/src/Assets/Pandora/Logica/Nucleo/Core/Red/Cliente/Objeto.cs"},"707":{"id":"/docs/red/v1/guias/instanciar-destruir-58","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#estado-de-destrucción","content":"Puede comprobarse mediante:"},"708":{"id":"/docs/red/v1/guias/instanciar-destruir-59","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#estado-de-destrucción","content":"Por eso el estado útil de un objeto dinámico puede visualizarse como:"},"709":{"id":"/docs/red/v1/guias/instanciar-destruir-60","page_id":"/docs/red/v1/guias/instanciar-destruir","tags":[],"type":"text","url":"/docs/red/v1/guias/instanciar-destruir#callbacks-de-ciclo-de-vida","content":"`Objeto` expone `onDestroy` para ejecutar lógica antes de las notificaciones normales de `OnDestroy` 