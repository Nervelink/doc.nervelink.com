-entidad#8-elegir-el-mecanismo-correcto","content":"Elegir el mecanismo correcto"},"2905":{"id":"/docs/red/v1/guias/sincronizar-entidad-10","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#9-ejemplo-completo","content":"Ejemplo completo"},"2906":{"id":"/docs/red/v1/guias/sincronizar-entidad-11","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#errores-habituales","content":"Errores habituales"},"2907":{"id":"/docs/red/v1/guias/sincronizar-entidad-12","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-todo-por-rfc","content":"Sincronizar todo por RFC"},"2908":{"id":"/docs/red/v1/guias/sincronizar-entidad-13","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#ignorar-la-propiedad","content":"Ignorar la propiedad"},"2909":{"id":"/docs/red/v1/guias/sincronizar-entidad-14","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#usar-autosincronizar-para-todo","content":"Usar `AutoSincronizar` para todo"},"2910":{"id":"/docs/red/v1/guias/sincronizar-entidad-15","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#confundir-lectura-con-sincronización","content":"Confundir lectura con sincronización"},"2911":{"id":"/docs/red/v1/guias/sincronizar-entidad-16","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#relación-con-tnet","content":"Relación con TNet"},"2912":{"id":"/docs/red/v1/guias/sincronizar-entidad-17","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Referencias"},"2913":{"id":"/docs/red/v1/guias/sincronizar-entidad-18","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-una-entidad","content":"Una vez creado un objeto de red, el siguiente paso habitual es mantener parte de su estado sincronizado entre los participantes."},"2914":{"id":"/docs/red/v1/guias/sincronizar-entidad-19","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-una-entidad","content":"La idea central es sencilla: **el objeto tiene un estado y un propietario, y Eco se encarga de propagar los cambios según el modelo de autoridad**."},"2915":{"id":"/docs/red/v1/guias/sincronizar-entidad-20","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#1-definir-el-componente","content":"Crea un `Componente` que represente el comportamiento de la entidad."},"2916":{"id":"/docs/red/v1/guias/sincronizar-entidad-21","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#1-definir-el-componente","content":"El `Componente` utiliza su `Objeto` asociado para acceder al estado de red."},"2917":{"id":"/docs/red/v1/guias/sincronizar-entidad-22","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#2-escribir-el-estado","content":"El estado puede escribirse mediante `Set`:"},"2918":{"id":"/docs/red/v1/guias/sincronizar-entidad-23","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#2-escribir-el-estado","content":"También puedes utilizar rutas jerárquicas cuando el estado tenga más estructura:"},"2919":{"id":"/docs/red/v1/guias/sincronizar-entidad-24","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#2-escribir-el-estado","content":"El valor se actualiza localmente antes de que Eco determine cómo debe propagarse."},"2920":{"id":"/docs/red/v1/guias/sincronizar-entidad-25","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#3-leer-el-estado","content":"Cualquier participante que disponga del objeto puede consultar los datos mediante `Get`:"},"2921":{"id":"/docs/red/v1/guias/sincronizar-entidad-26","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#3-leer-el-estado","content":"La lectura no implica comunicación con el servidor: consulta el estado local conocido por ese objeto."},"2922":{"id":"/docs/red/v1/guias/sincronizar-entidad-27","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#4-entender-la-autoridad","content":"El punto más importante es decidir quién puede producir el estado."},"2923":{"id":"/docs/red/v1/guias/sincronizar-entidad-28","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#4-entender-la-autoridad","content":"Cuando el cliente local es propietario, Eco puede distribuir el cambio y actualizar el estado persistente cuando corresponde."},"2924":{"id":"/docs/red/v1/guias/sincronizar-entidad-29","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#4-entender-la-autoridad","content":"Cuando el cliente no es propietario, un cambio puede requerir una solicitud al propietario en lugar de modificar unilateralmente la autoridad remota."},"2925":{"id":"/docs/red/v1/guias/sincronizar-entidad-30","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#5-sincronizar-un-estado-sencillo","content":"Para una propiedad discreta, el flujo normal puede ser tan simple como:"},"2926":{"id":"/docs/red/v1/guias/sincronizar-entidad-31","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#5-sincronizar-un-estado-sencillo","content":"Aquí `vida` es estado. No hace falta convertir cada valor en una llamada remota diferente como `CambiarVida(99)`, `CambiarVida(98)`, etc."},"2927":{"id":"/docs/red/v1/guias/sincronizar-entidad-32","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#6-qué-ocurre-si-todavía-no-se-puede-enviar","content":"Durante determinadas fases de conexión o entrada a canales, el objeto puede existir localmente pero todavía no estar listo para transmitir."},"2928":{"id":"/docs/red/v1/guias/sincronizar-entidad-33","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#6-qué-ocurre-si-todavía-no-se-puede-enviar","content":"En ese caso, Eco puede mantener los cambios pendientes y procesarlos cuando `PuedeEnviar` vuelva a ser verdadero."},"2929":{"id":"/docs/red/v1/guias/sincronizar-entidad-34","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#6-qué-ocurre-si-todavía-no-se-puede-enviar","content":"Esto evita que el gameplay tenga que conocer todos los estados transitorios de la conexión."},"2930":{"id":"/docs/red/v1/guias/sincronizar-entidad-35","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#7-sincronización-automática","content":"Cuando una propiedad de Unity debe sincronizarse periódicamente, `AutoSincronizar` puede evitar tener que escribir manualmente el código de comparación y envío."},"2931":{"id":"/docs/red/v1/guias/sincronizar-entidad-36","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#7-sincronización-automática","content":"Es especialmente útil durante prototipos o para componentes sencillos."},"2932":{"id":"/docs/red/v1/guias/sincronizar-entidad-37","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#7-sincronización-automática","content":"`AutoSincronizar` comprueba valores mediante reflexión y puede limitar la frecuencia de actualización con `updatesPerSecond`."},"2933":{"id":"/docs/red/v1/guias/sincronizar-entidad-38","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Necesidad"},"2934":{"id":"/docs/red/v1/guias/sincronizar-entidad-39","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Mecanismo"},"2935":{"id":"/docs/red/v1/guias/sincronizar-entidad-40","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Propiedad persistente de una entidad"},"2936":{"id":"/docs/red/v1/guias/sincronizar-entidad-41","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"`Set` / estado del objeto"},"2937":{"id":"/docs/red/v1/guias/sincronizar-entidad-42","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Acción puntual"},"2938":{"id":"/docs/red/v1/guias/sincronizar-entidad-43","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"RFC"},"2939":{"id":"/docs/red/v1/guias/sincronizar-entidad-44","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Campo de Unity durante prototipo"},"2940":{"id":"/docs/red/v1/guias/sincronizar-entidad-45","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"`AutoSincronizar`"},"2941":{"id":"/docs/red/v1/guias/sincronizar-entidad-46","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Estado muy frecuente y crítico"},"2942":{"id":"/docs/red/v1/guias/sincronizar-entidad-47","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Sistema específico optimizado"},"2943":{"id":"/docs/red/v1/guias/sincronizar-entidad-48","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Estado que debe sobrevivir a nuevos jugadores"},"2944":{"id":"/docs/red/v1/guias/sincronizar-entidad-49","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Persistencia del estado"},"2945":{"id":"/docs/red/v1/guias/sincronizar-entidad-50","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Una regla útil es distinguir **estado** de **acción**."},"2946":{"id":"/docs/red/v1/guias/sincronizar-entidad-51","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"El primero suele ser candidato a sincronización; el segundo suele expresarse mediante una comunicación de evento o RFC."},"2947":{"id":"/docs/red/v1/guias/sincronizar-entidad-52","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#9-ejemplo-completo","content":"La idea importante del ejemplo no es la clase concreta, sino el reparto de responsabilidades:"},"2948":{"id":"/docs/red/v1/guias/sincronizar-entidad-53","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-todo-por-rfc","content":"Generar una RFC por cada cambio de propiedad suele complicar el sistema y puede aumentar el tráfico innecesariamente."},"2949":{"id":"/docs/red/v1/guias/sincronizar-entidad-54","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#ignorar-la-propiedad","content":"Si varios clientes pueden escribir el mismo estado sin un criterio de autoridad, la documentación del estado deja de representar una única fuente de verdad."},"2950":{"id":"/docs/red/v1/guias/sincronizar-entidad-55","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#usar-autosincronizar-para-todo","content":"Es cómodo, pero su implementación basada en reflexión y comprobaciones periódicas puede resultar innecesaria en sistemas críticos o de alta frecuencia."},"2951":{"id":"/docs/red/v1/guias/sincronizar-entidad-56","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#confundir-lectura-con-sincronización","content":"`Get` devuelve el estado que el objeto conoce localmente. No es una consulta remota al servidor."},"2952":{"id":"/docs/red/v1/guias/sincronizar-entidad-57","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#relación-con-tnet","content":"El modelo es equivalente al flujo tradicional de `TNObject` y `TNAutoSync`, pero en Eco los nombres públicos son `Objeto`, `Componente` y `AutoSincronizar`."},"2953":{"id":"/docs/red/v1/guias/sincronizar-entidad-58","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#relación-con-tnet","content":"La referencia principal para el comportamiento sigue siendo el código de `Nervelink/eco`."},"2954":{"id":"/docs/red/v1/guias/sincronizar-entidad-59","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Identidad, propiedad y estado de los objetos de Eco."},"2955":{"id":"/docs/red/v1/guias/sincronizar-entidad-60","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Funcionamiento detallado del sistema de sincronización."},"2956":{"id":"/docs/red/v1/guias/sincronizar-entidad-61","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Referencia de la arquitectura original."},"2957":{"id":"/docs/red/v1/guias/sincronizar-entidad-62","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Referencia generada sobre el repositorio actual de TNet."},"2958":{"id":"/docs/red/v1/guias/sincronizar-jugador","page_id":"/docs/red/v1/guias/sincronizar-jugador","type":"page","content":"Sincronizar los datos del jugador","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/sincronizar-jugador"},"2959":{"id":"/docs/red/v1/guias/sincronizar-jugador-0","page_id":"/docs/red/v1/guias/sincronizar-jugador","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-jugador","content":"Gestiona y sincroniza los datos asociados al jugador local."},"2960":{"id":"/docs/red