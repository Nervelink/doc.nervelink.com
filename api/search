izar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#fiabilidad","content":"Fiabilidad"},"1298":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-6","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#autoridad","content":"Autoridad"},"1299":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-7","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#persistencia","content":"Persistencia"},"1300":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-8","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","type":"heading","tags":[],"url":"/docs/red/v1/ejemplos/auto-sincronizar#fuente","content":"Fuente"},"1301":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-9","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"`AutoSincronizar` sincroniza automáticamente una lista de campos o propiedades de un componente asociado a un `Objeto`."},"1302":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-10","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#autosincronizar","content":"Es una herramienta de conveniencia y prototipado, no un sustituto universal de una arquitectura de sincronización específica."},"1303":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-11","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"Cada entrada contiene:"},"1304":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-12","page_id":"/docs/red/v1/ejemplos/auto-sincronizar","tags":[],"type":"text","url":"/docs/red/v1/ejemplos/auto-sincronizar#configuración","content":"El componente localiza el campo o propiedad mediante reflexión al iniciar."},"1305":{"id":"/docs/red/v1/ejemplos/auto-sincronizar-13","page_id":"/doc