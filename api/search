."},"638":{"id":"/docs/red/v1/guias/sincronizar-entidad","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"page","content":"Sincronizar una entidad","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad"},"639":{"id":"/docs/red/v1/guias/sincronizar-entidad-0","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad","content":"Sincroniza el estado de una entidad de red utilizando la autoridad y el sistema de datos de Eco."},"640":{"id":"/docs/red/v1/guias/sincronizar-entidad-1","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-una-entidad","content":"Sincronizar una entidad"},"641":{"id":"/docs/red/v1/guias/sincronizar-entidad-2","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#1-definir-el-componente","content":"1\\. Definir el componente"},"642":{"id":"/docs/red/v1/guias/sincronizar-entidad-3","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#2-escribir-el-estado","content":"2\\. Escribir el estado"},"643":{"id":"/docs/red/v1/guias/sincronizar-entidad-4","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#3-leer-el-estado","content":"3\\. Leer el estado"},"644":{"id":"/docs/red/v1/guias/sincronizar-entidad-5","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#4-entender-la-autoridad","content":"4\\. Entender la autoridad"},"645":{"id":"/docs/red/v1/guias/sincronizar-entidad-6","page_id":"/docs/red/v1/guias/sincronizar-entidad","type":"heading","tags":[],"url":"/docs/red/v1/guias/sincronizar-entidad#5-sincronizar-un-estado-sencillo","content":"5\\. Sincronizar un e