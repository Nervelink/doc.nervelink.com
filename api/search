/equivalencias#equivalencias-eco--tnet","content":"`TList<T>`"},"551":{"id":"/docs/red/v1/referencia/equivalencias-35","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Colección interna"},"552":{"id":"/docs/red/v1/referencia/equivalencias-36","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`Serializacion`"},"553":{"id":"/docs/red/v1/referencia/equivalencias-37","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`TNet.Serialization`"},"554":{"id":"/docs/red/v1/referencia/equivalencias-38","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Serialización y conversiones"},"555":{"id":"/docs/red/v1/referencia/equivalencias-39","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`ClienteJuego`"},"556":{"id":"/docs/red/v1/referencia/equivalencias-40","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`GameClient`"},"557":{"id":"/docs/red/v1/referencia/equivalencias-41","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"Implementación del cliente"},"558":{"id":"/docs/red/v1/referencia/equivalencias-42","page_id":"/docs/red/v1/referencia/equivalencias","tags":[],"type":"text","url":"/docs/red/v1/referencia/equivalencias#equivalencias-eco--tnet","content":"`ServidorJuego`"},"559":{"id":"/docs/red/v1/referencia/equivalencias-43","page_id":"/docs/red/v1/refere