","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/cambiar-nivel"},"441":{"id":"/docs/red/v1/guias/cambiar-nivel-0","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel","content":"Coordina el cambio de nivel de un canal sin tratarlo como una carga de escena local."},"442":{"id":"/docs/red/v1/guias/cambiar-nivel-1","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cambiar-el-nivel-de-un-canal","content":"Cambiar el nivel de un canal"},"443":{"id":"/docs/red/v1/guias/cambiar-nivel-2","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"444":{"id":"/docs/red/v1/guias/cambiar-nivel-3","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"Solicitar el cambio"},"445":{"id":"/docs/red/v1/guias/cambiar-nivel-4","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"Durante la transición"},"446":{"id":"/docs/red/v1/guias/cambiar-nivel-5","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"Cambiar de nivel no es abandonar el canal"},"447":{"id":"/docs/red/v1/guias/cambiar-nivel-6","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#errores-habituales","content":"Errores habituales"},"448":{"id":"/docs/red/v1/guias/cambiar-nivel-7","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#cargar-la-escena-directamente-en-unity","content":"Cargar la escena directamente en Unity"},"449":{"id":"/docs/red/v1/guias/cambiar-nivel-8","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#operar-sobre-objetos-demasiado-pronto","content":"Operar sobre objetos demasiado pronto"},"450":{"id":"/docs/red/v1/guias/cambiar-nivel-9","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#ignorar-el-contexto-multicanal","content":"Ignorar el contexto multicanal"},"451":{"id":"/docs/red/v1/guias/cambiar-nivel-10","page_id":"/docs/red/v1/guias/cambiar-nivel","type":"heading","tags":[],"url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Referencias"},"452":{"id":"/docs/red/v1/guias/cambiar-nivel-11","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-el-nivel-de-un-canal","content":"En Eco, cambiar el nivel de un canal es una operación de red. El cambio debe coordinarse con el servidor y con el estado del canal; no es equivalente a llamar directamente a `SceneManager.LoadScene` en cada cliente."},"453":{"id":"/docs/red/v1/guias/cambiar-nivel-12","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cuándo-utilizarlo","content":"Utiliza el cambio de nivel del canal cuando todos los participantes de un canal deban pasar a un nuevo estado o escena coordinadamente."},"454":{"id":"/docs/red/v1/guias/cambiar-nivel-13","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"Desde el cliente, la operación se realiza sobre el canal concreto:"},"455":{"id":"/docs/red/v1/guias/cambiar-nivel-14","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#solicitar-el-cambio","content":"La selección del canal es importante cuando el cliente participa en varios canales: el cambio afecta al contexto indicado y no convierte automáticamente el resto de canales en candidatos al cambio."},"456":{"id":"/docs/red/v1/guias/cambiar-nivel-15","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"La entrada en un canal y los cambios de nivel tienen estados transitorios. Durante estas fases Eco evita que ciertas operaciones de objetos y paquetes pertenecientes al contexto anterior se procesen fuera de orden."},"457":{"id":"/docs/red/v1/guias/cambiar-nivel-16","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"Por eso no conviene asumir que inmediatamente después de solicitar el cambio:"},"458":{"id":"/docs/red/v1/guias/cambiar-nivel-17","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#durante-la-transición","content":"El código de juego debe esperar a los callbacks o estados apropiados antes de empezar a operar con el nuevo contenido."},"459":{"id":"/docs/red/v1/guias/cambiar-nivel-18","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"El canal continúa siendo el mismo ámbito lógico:"},"460":{"id":"/docs/red/v1/guias/cambiar-nivel-19","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cambiar-de-nivel-no-es-abandonar-el-canal","content":"Por tanto, las operaciones de salida (`LeaveChannel`) y las de cambio de nivel cumplen funciones diferentes."},"461":{"id":"/docs/red/v1/guias/cambiar-nivel-20","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#cargar-la-escena-directamente-en-unity","content":"Puede dejar al cliente fuera de sincronía respecto al servidor. El cambio debe pasar por la infraestructura de Eco cuando el nivel forma parte del estado del canal."},"462":{"id":"/docs/red/v1/guias/cambiar-nivel-21","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#operar-sobre-objetos-demasiado-pronto","content":"Durante la transición algunos objetos pueden no estar todavía registrados. Comprueba `hasBeenRegistered`, pertenencia al canal y los callbacks apropiados antes de utilizarlos."},"463":{"id":"/docs/red/v1/guias/cambiar-nivel-22","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#ignorar-el-contexto-multicanal","content":"Si el cliente está en varios canales, especifica siempre el canal que debe cambiar. No presupongas que el canal activo del juego es el único contexto de red existente."},"464":{"id":"/docs/red/v1/guias/cambiar-nivel-23","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Estado, jugadores y ciclo de vida de un canal."},"465":{"id":"/docs/red/v1/guias/cambiar-nivel-24","page_id":"/docs/red/v1/guias/cambiar-nivel","tags":[],"type":"text","url":"/docs/red/v1/guias/cambiar-nivel#referencias","content":"Gestión de varios ámbitos de red desde una misma conexión."},"466":{"id":"/docs/red/v1/guias/crear-partida","page_id":"/docs/red/v1/guias/crear-partida","type":"page","content":"Crear una partida","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/crear-partida"},"467":{"id":"/docs/red/v1/guias/crear-partida-0","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida","content":"Flujo completo para conectar jugadores, crear un canal y preparar el estado inicial de una partida."},"468":{"id":"/docs/red/v1/guias/crear-partida-1","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Crear una partida"},"469":{"id":"/docs/red/v1/guias/crear-partida-2","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"1\\. Conectar el cliente"},"470":{"id":"/docs/red/v1/guias/crear-partida-3","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"2\\. Crear o seleccionar el canal"},"471":{"id":"/docs/red/v1/guias/crear-partida-4","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"3\\. Esperar la entrada al canal"},"472":{"id":"/docs/red/v1/guias/crear-partida-5","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"4\\. Crear el estado de la partida"},"473":{"id":"/docs/red/v1/guias/crear-partida-6","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"5\\. Sincronizar el estado inicial"},"474":{"id":"/docs/red/v1/guias/crear-partida-7","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"6\\. Enviar acciones de juego"},"475":{"id":"/docs/red/v1/guias/crear-partida-8","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"7\\. Un segundo jugador entra"},"476":{"id":"/docs/red/v1/guias/crear-partida-9","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"8\\. Finalizar la partida"},"477":{"id":"/docs/red/v1/guias/crear-partida-10","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#flujo-completo","content":"Flujo completo"},"478":{"id":"/docs/red/v1/guias/crear-partida-11","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#errores-habituales","content":"Errores habituales"},"479":{"id":"/docs/red/v1/guias/crear-partida-12","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Crear objetos antes de completar la unión"},"480":{"id":"/docs/red/v1/guias/crear-partida-13","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Utilizar RFC para representar todo el estado"},"481":{"id":"/docs/red/v1/guias/crear-partida-14","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Confundir desconexión con salida del canal"},"482":{"id":"/docs/red/v1/guias/crear-partida-15","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"No definir la autoridad"},"483":{"id":"/docs/red/v1/guias/crear-partida-16","page_id":"/docs/red/v1/guias/crear-partida","type":"heading","tags":[],"url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Véase también"},"484":{"id":"/docs/red/v1/guias/crear-partida-17","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-una-partida","content":"Una partida en Eco puede entenderse como la combinación de una conexión de red, un canal y el estado de juego que vive dentro de ese canal."},"485":{"id":"/docs/red/v1/guias/crear-partida-18","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"El cliente necesita establecer primero una conexión con el servidor."},"486":{"id":"/docs/red/v1/guias/crear-partida-19","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#1-conectar-el-cliente","content":"Antes de intentar entrar en la partida conviene esperar a que `isConnected` sea verdadero."},"487":{"id":"/docs/red/v1/guias/crear-partida-20","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"El servidor es quien mantiene el estado del canal. El cliente solicita entrar mediante `JoinChannel`."},"488":{"id":"/docs/red/v1/guias/crear-partida-21","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"La unión no es instantánea. Eco mantiene la solicitud como pendiente hasta recibir la respuesta del servidor."},"489":{"id":"/docs/red/v1/guias/crear-partida-22","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#2-crear-o-seleccionar-el-canal","content":"Los jugadores, objetos dinámicos y estado asociado a la partida deben entenderse dentro del contexto del canal. La conexión puede permanecer activa mientras el cliente cambia de un canal a otro o participa en varios simultáneamente."},"490":{"id":"/docs/red/v1/guias/crear-partida-23","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"No es recomendable empezar a crear lógica de partida inmediatamente después de llamar a `JoinChannel`. Primero debe completarse la unión y, cuando corresponda, la carga del nivel asociado."},"491":{"id":"/docs/red/v1/guias/crear-partida-24","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#3-esperar-la-entrada-al-canal","content":"Durante esta transición Eco protege el flujo de paquetes para evitar que operaciones pertenecientes a una escena anterior sean procesadas fuera de contexto."},"492":{"id":"/docs/red/v1/guias/crear-partida-25","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Una vez dentro del canal se pueden crear los objetos dinámicos que representan el estado de la partida."},"493":{"id":"/docs/red/v1/guias/crear-partida-26","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Por ejemplo:"},"494":{"id":"/docs/red/v1/guias/crear-partida-27","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#4-crear-el-estado-de-la-partida","content":"Los objetos deben tener un propietario claro cuando su estado vaya a ser modificado por un cliente."},"495":{"id":"/docs/red/v1/guias/crear-partida-28","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"El estado que necesitan los demás jugadores debe modelarse como datos de red, no como una sucesión de acciones."},"496":{"id":"/docs/red/v1/guias/crear-partida-29","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#5-sincronizar-el-estado-inicial","content":"Si el estado debe actualizarse de forma continua puede utilizarse un sistema de sincronización apropiado. Para prototipos sencillos, `AutoSincronizar` puede servir como punto de partida."},"497":{"id":"/docs/red/v1/guias/crear-partida-30","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Las acciones puntuales de la partida deben utilizar el sistema de comunicación correspondiente."},"498":{"id":"/docs/red/v1/guias/crear-partida-31","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#6-enviar-acciones-de-juego","content":"Por ejemplo, cambiar la vida actual de una unidad representa un cambio de estado, mientras que solicitar que una unidad ejecute una habilidad representa una acción."},"499":{"id":"/docs/red/v1/guias/crear-partida-32","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"La partida debe poder reconstruirse desde el estado del canal y de sus objetos."},"500":{"id":"/docs/red/v1/guias/crear-partida-33","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#7-un-segundo-jugador-entra","content":"Dependiendo de cómo se configure el objeto o componente, el estado puede conservarse en servidor o ser enviado explícitamente al nuevo participante."},"501":{"id":"/docs/red/v1/guias/crear-partida-34","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"Al terminar una partida pueden utilizarse distintos niveles de limpieza:"},"502":{"id":"/docs/red/v1/guias/crear-partida-35","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#8-finalizar-la-partida","content":"La elección depende de si el cliente debe continuar conectado a otros canales o sesiones."},"503":{"id":"/docs/red/v1/guias/crear-partida-36","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#crear-objetos-antes-de-completar-la-unión","content":"Puede producir objetos locales que todavía no están correctamente registrados en el contexto de red de la partida."},"504":{"id":"/docs/red/v1/guias/crear-partida-37","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#utilizar-rfc-para-representar-todo-el-estado","content":"Las RFC son adecuadas para acciones. El estado debe modelarse como estado para que un jugador que entre posteriormente pueda obtener los valores actuales."},"505":{"id":"/docs/red/v1/guias/crear-partida-38","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#confundir-desconexión-con-salida-del-canal","content":"Salir de un canal no obliga a desconectar al cliente. Eco permite mantener la conexión y continuar en otros canales."},"506":{"id":"/docs/red/v1/guias/crear-partida-39","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#no-definir-la-autoridad","content":"Si varios clientes pueden modificar el mismo dato sin una autoridad clara, el estado puede entrar en conflicto. Define el propietario antes de diseñar la sincronización."},"507":{"id":"/docs/red/v1/guias/crear-partida-40","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Ciclo de vida y gestión de los canales."},"508":{"id":"/docs/red/v1/guias/crear-partida-41","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Identidad, propiedad y ciclo de vida de los objetos de red."},"509":{"id":"/docs/red/v1/guias/crear-partida-42","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"Cómo mantener el estado coherente entre participantes."},"510":{"id":"/docs/red/v1/guias/crear-partida-43","page_id":"/docs/red/v1/guias/crear-partida","tags":[],"type":"text","url":"/docs/red/v1/guias/crear-partida#véase-también","content":"RFC, destinatarios y comunicación de alto nivel."},"511":{"id":"/docs/red/v1/guias/desconectar-limpiar","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"page","content":"Desconectar y limpiar la sesión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar"},"512":{"id":"/docs/red/v1/guias/desconectar-limpiar-0","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar","content":"Cierra una sesión de Eco y evita conservar estado de una conexión anterior."},"513":{"id":"/docs/red/v1/guias/desconectar-limpiar-1","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Desconectar y limpiar la sesión"},"514":{"id":"/docs/red/v1/guias/desconectar-limpiar-2","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"Desconectar"},"515":{"id":"/docs/red/v1/guias/desconectar-limpiar-3","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Canales y objetos"},"516":{"id":"/docs/red/v1/guias/desconectar-limpiar-4","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Reconexion"},"517":{"id":"/docs/red/v1/guias/desconectar-limpiar-5","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#errores-habituales","content":"Errores habituales"},"518":{"id":"/docs/red/v1/guias/desconectar-limpiar-6","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Enviar durante la desconexión"},"519":{"id":"/docs/red/v1/guias/desconectar-limpiar-7","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Reutilizar objetos destruidos"},"520":{"id":"/docs/red/v1/guias/desconectar-limpiar-8","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Mezclar datos de dos sesiones"},"521":{"id":"/docs/red/v1/guias/desconectar-limpiar-9","page_id":"/docs/red/v1/guias/desconectar-limpiar","type":"heading","tags":[],"url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Referencias"},"522":{"id":"/docs/red/v1/guias/desconectar-limpiar-10","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar-y-limpiar-la-sesión","content":"Una desconexión no debería tratarse únicamente como cerrar un socket. El cliente mantiene jugadores, canales, objetos, colas y estado de conexión que deben quedar en un estado coherente antes de volver a conectarse."},"523":{"id":"/docs/red/v1/guias/desconectar-limpiar-11","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#desconectar","content":"La operación de desconexión pertenece al cliente de red. Después de solicitarla, no asumas que el estado remoto desaparece de forma instantánea en el mismo frame."},"524":{"id":"/docs/red/v1/guias/desconectar-limpiar-12","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Durante la desconexión los canales dejan de representar una sesión válida y los objetos asociados a ellos dejan de ser utilizables para enviar mensajes."},"525":{"id":"/docs/red/v1/guias/desconectar-limpiar-13","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"Una comprobación especialmente útil es `Objeto.PuedeEnviar`:"},"526":{"id":"/docs/red/v1/guias/desconectar-limpiar-14","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#canales-y-objetos","content":"No conserves referencias a objetos de red de una sesión anterior para utilizarlas después de reconectar sin comprobar su registro y contexto."},"527":{"id":"/docs/red/v1/guias/desconectar-limpiar-15","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"Una nueva conexión debe reconstruir la sesión. No es correcto asumir que un `playerID`, `channelID`, `uid` o colección de objetos de la sesión anterior seguirá siendo válido."},"528":{"id":"/docs/red/v1/guias/desconectar-limpiar-16","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reconexion","content":"El hecho de que el mismo dispositivo o usuario vuelva a conectarse no convierte las dos sesiones de red en la misma sesión técnica."},"529":{"id":"/docs/red/v1/guias/desconectar-limpiar-17","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#enviar-durante-la-desconexión","content":"Comprueba el estado de conexión y la posibilidad real de envío antes de lanzar RFC o cambios de estado."},"530":{"id":"/docs/red/v1/guias/desconectar-limpiar-18","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#reutilizar-objetos-destruidos","content":"Un objeto marcado como destruido o que ya no pertenece a un canal válido no debe recibir nuevas operaciones de red."},"531":{"id":"/docs/red/v1/guias/desconectar-limpiar-19","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#mezclar-datos-de-dos-sesiones","content":"Limpia listeners, referencias y caches propios del juego cuando corresponda. Eco gestiona su estado de red, pero el juego sigue siendo responsable de sus propias referencias externas."},"532":{"id":"/docs/red/v1/guias/desconectar-limpiar-20","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Estados de conexión y funcionamiento del cliente."},"533":{"id":"/docs/red/v1/guias/desconectar-limpiar-21","page_id":"/docs/red/v1/guias/desconectar-limpiar","tags":[],"type":"text","url":"/docs/red/v1/guias/desconectar-limpiar#referencias","content":"Ciclo de vida y posibilidad de envío de los objetos de red."},"534":{"id":"/docs/red/v1/guias/diagnosticar-conexion","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"page","content":"Diagnosticar una conexión","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion"},"535":{"id":"/docs/red/v1/guias/diagnosticar-conexion-0","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion","content":"Identifica problemas de conexión, canales, paquetes y transporte utilizando el estado expuesto por Eco."},"536":{"id":"/docs/red/v1/guias/diagnosticar-conexion-1","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#diagnosticar-una-conexión","content":"Diagnosticar una conexión"},"537":{"id":"/docs/red/v1/guias/diagnosticar-conexion-2","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-la-conexión","content":"Comprobar la conexión"},"538":{"id":"/docs/red/v1/guias/diagnosticar-conexion-3","page_id":"/docs/red/v1/guias/diagnosticar-conexion","type":"heading","tags":[],"url":"/docs/red/v1/guias/diagnosticar-conexion#comprobar-canales","content":"Comprobar canales"},"539":{"id":"/docs/red/v1/guias/diagnosticar-conexion-4","page_id":