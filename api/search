/sincronizar-entidad-46","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Estado muy frecuente y crítico"},"652":{"id":"/docs/red/v1/guias/sincronizar-entidad-47","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Sistema específico optimizado"},"653":{"id":"/docs/red/v1/guias/sincronizar-entidad-48","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Estado que debe sobrevivir a nuevos jugadores"},"654":{"id":"/docs/red/v1/guias/sincronizar-entidad-49","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Persistencia del estado"},"655":{"id":"/docs/red/v1/guias/sincronizar-entidad-50","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"Una regla útil es distinguir **estado** de **acción**."},"656":{"id":"/docs/red/v1/guias/sincronizar-entidad-51","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#8-elegir-el-mecanismo-correcto","content":"El primero suele ser candidato a sincronización; el segundo suele expresarse mediante una comunicación de evento o RFC."},"657":{"id":"/docs/red/v1/guias/sincronizar-entidad-52","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#9-ejemplo-completo","content":"La idea importante del ejemplo no es la clase concreta, sino el reparto de responsabilidades:"},"658":{"id":"/docs/red/v1/guias/sincronizar-entidad-53","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#sincronizar-todo-por-rfc","content":"Generar una RFC por cada cambio de propiedad suele complicar el sistema y puede aumentar el tráfico innecesariamente."},"659":{"id":"/docs/red/v1/guias/sincronizar-entidad-54","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#ignorar-la-propiedad","content":"Si varios clientes pueden escribir el mismo estado sin un criterio de autoridad, la documentación del estado deja de representar una única fuente de verdad."},"660":{"id":"/docs/red/v1/guias/sincronizar-entidad-55","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#usar-autosincronizar-para-todo","content":"Es cómodo, pero su implementación basada en reflexión y comprobaciones periódicas puede resultar innecesaria en sistemas críticos o de alta frecuencia."},"661":{"id":"/docs/red/v1/guias/sincronizar-entidad-56","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#confundir-lectura-con-sincronización","content":"`Get` devuelve el estado que el objeto conoce localmente. No es una consulta remota al servidor."},"662":{"id":"/docs/red/v1/guias/sincronizar-entidad-57","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#relación-con-tnet","content":"El modelo es equivalente al flujo tradicional de `TNObject` y `TNAutoSync`, pero en Eco los nombres públicos son `Objeto`, `Componente` y `AutoSincronizar`."},"663":{"id":"/docs/red/v1/guias/sincronizar-entidad-58","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#relación-con-tnet","content":"La referencia principal para el comportamiento sigue siendo el código de `Nervelink/eco`."},"664":{"id":"/docs/red/v1/guias/sincronizar-entidad-59","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Identidad, propiedad y estado de los objetos de Eco."},"665":{"id":"/docs/red/v1/guias/sincronizar-entidad-60","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Funcionamiento detallado del sistema de sincronización."},"666":{"id":"/docs/red/v1/guias/sincronizar-entidad-61","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Referencia de la arquitectura original."},"667":{"id":"/docs/red/v1/guias/sincronizar-entidad-62","page_id":"/docs/red/v1/guias/sincronizar-entidad","tags":[],"type":"text","url":"/docs/red/v1/guias/sincronizar-entidad#referencias","content":"Referencia generada sobre el repositorio actual de TNet."},"668":{"id":"/docs/red/v1/modelo/canales","page_id":"/docs/red/v1/modelo/canales","type":"page","content":"Canales","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo/canales"},"669":{"id":"/docs/red/v1/modelo/canales-0","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales","content":"Ámbitos de estado compartido en Eco y gestión de la pertenencia de los jugadores."},"670":{"id":"/docs/red/v1/modelo/canales-1","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#canales","content":"Canales"},"671":{"id":"/docs/red/v1/modelo/canales-2","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#modelo","content":"Modelo"},"672":{"id":"/docs/red/v1/modelo/canales-3","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#estado-de-un-canal","content":"Estado de un canal"},"673":{"id":"/docs/red/v1/modelo/canales-4","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"Unirse a un canal"},"674":{"id":"/docs/red/v1/modelo/canales-5","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"Múltiples canales simultáneos"},"675":{"id":"/docs/red/v1/modelo/canales-6","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#consultar-y-abandonar","content":"Consultar y abandonar"},"676":{"id":"/docs/red/v1/modelo/canales-7","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"Persistencia y propiedad"},"677":{"id":"/docs/red/v1/modelo/canales-8","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#nivel-y-host","content":"Nivel y host"},"678":{"id":"/docs/red/v1/modelo/canales-9","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"Correspondencia con TNet"},"679":{"id":"/docs/red/v1/modelo/canales-10","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#referencias","content":"Referencias"},"680":{"id":"/docs/red/v1/modelo/canales-11","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Un `Canal` define un ámbito de estado compartido dentro del servidor de Eco. Los jugadores que forman parte de un canal pueden recibir la información que ese canal distribuye, incluyendo mensajes y estado asociado a sus objetos."},"681":{"id":"/docs/red/v1/modelo/canales-12","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Una conexión no está limitada a un único canal. Eco mantiene una colección de canales activos por cliente, por lo que un mismo jugador puede participar simultáneamente en varios ámbitos de red."},"682":{"id":"/docs/red/v1/modelo/canales-13","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#modelo","content":"El mismo jugador puede aparecer en varios canales. En el cliente, esta pertenencia se representa mediante una colección interna de `Canal` mantenida por `ClienteJuego`. La API expone esa colección mediante `channels`."},"683":{"id":"/docs/red/v1/modelo/canales-14","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#estado-de-un-canal","content":"`Canal` mantiene información suficiente para representar tanto su configuración como su estado de red. Entre sus propiedades se encuentran `id`, `password`, `level`, `isPersistent`, `isClosed`, `isLeaving`, `playerLimit`, `jugadores`, `rfcs`, `created`, `destroyed` y `host`."},"684":{"id":"/docs/red/v1/modelo/canales-15","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"El cliente utiliza `ClienteJuego.JoinChannel` para solicitar la entrada en un canal. La solicitud incluye identificador, contraseña, nivel, persistencia y límite de jugadores."},"685":{"id":"/docs/red/v1/modelo/canales-16","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"Durante el proceso de unión, Eco registra el canal como pendiente hasta recibir la respuesta del servidor."},"686":{"id":"/docs/red/v1/modelo/canales-17","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"La pertenencia a canales es acumulativa. Un cliente puede participar simultáneamente en varios canales:"},"687":{"id":"/docs/red/v1/modelo/canales-18","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"`IsInChannel(id)` comprueba la pertenencia y `GetChannel(id)` obtiene la instancia local."},"688":{"id":"/docs/red/v1/modelo/canales-19","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"Dos canales distintos no implican dos conexiones de socket distintas. La conexión y el transporte pertenecen a una capa inferior; el canal delimita el estado y los destinatarios."},"689":{"id":"/docs/red/v1/modelo/canales-20","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#consultar-y-abandonar","content":"Salir de un canal no implica desconectarse del servidor."},"690":{"id":"/docs/red/v1/modelo/canales-21","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"Un canal puede ser persistente. Cuando el último jugador abandona, Eco puede destruir objetos no persistentes, transferir la propiedad de otros objetos o cerrar y reiniciar el canal según su configuración."},"691":{"id":"/docs/red/v1/modelo/canales-22","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"También mantiene objetos dinámicos y RFC asociadas para poder reconstruir el estado cuando corresponde."},"692":{"id":"/docs/red/v1/modelo/canales-23","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#nivel-y-host","content":"Cada canal puede tener un `level` y un `host`. El cambio de nivel se coordina a través del sistema de red y el host puede cambiar cuando abandona el canal."},"693":{"id":"/docs/red/v1/modelo/canales-24","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"TNet"},"694":{"id":"/docs/red/v1/modelo/canales-25","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"Eco"},"695":{"id":"/docs/red/v1/modelo/canales-26","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNChannel` / `Channel`"},"696":{"id":"/docs/red/v1/modelo/canales-27","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`Canal`"},"697":{"id":"/docs/red/v1/modelo/canales-28","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.JoinChannel`"},"698":{"id":"/docs/red/v1/modelo/canales-29","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.JoinChannel`"},"699":{"id":"/docs/red/v1/modelo/canales-30","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.LeaveChannel`"},"700":{"id":"/docs/red/v1/modelo/canales-31","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.LeaveChannel`"},"701":{"id":"/docs/red/v1/modelo/canales-32","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.IsInChannel`"},"702":{"id":"/docs/red/v1/modelo/canales-33","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.IsInChannel`"},"703":{"id":"/docs/red/v1/modelo/canales-34","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.GetChannel`"},"704":{"id":"/docs/red/v1/modelo/canales-35","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.GetChannel`"},"705":{"id":"/docs/red/v1/modelo/canales-36","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#referencias","content":"Código fuente de la implementación de canales."},"706":{"id":"/docs/red/v1/modelo/canales-37","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#referencias","content":"Repositorio upstream."},"707":{"id":"/docs/red/v1/modelo/canales-38","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#referencias","content":"Referencia generada sobre la implementación actual de TNet."},"708":{"id":"/docs/red/v1/modelo","page_id":"/docs/red/v1/modelo","type":"page","content":"Modelo de red","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo"},"709":{"id":"/docs/red/v1/modelo-0","page_id":"/docs/red/v1/modelo","tags":[],"type":"text","url":"/docs/red/v1/modelo","content":"Las entidades que forman el estado de red y sus relaciones."},"710":{"id":"/docs/red/v1/modelo-1","page_id":"/docs/red/v1/modelo","type":"heading","tags":[],"url":"/docs/red/v1/modelo#modelo-de-red","content":"Modelo de red"},"711":{"id":"/docs/red/v1/modelo-2","page_id":"/docs/red/v1/modelo","tags":[],"type":"text","url":"/docs/red/v1/modelo#modelo-de-red","content":"Eco organiza el estado compartido alrededor de canales, objetos, jugadores y componentes."},"712":{"id":"/docs/red/v1/modelo-3","page_id":"/docs/red/v1/modelo","tags":[],"type":"text","url":"/docs/red/v1/modelo#modelo-de-red","content":"Ámbitos de estado compartido y pertenencia de los jugadores."},"713":{"id":"/docs/red/v1/modelo-4","page_id":"/docs/red/v1/modelo","tags":[],"type":"text","url":"/docs/red/v1/modelo#modelo-de-red","content":"Identidad de red, ownership, ciclo de vida y datos asociados."},"714":{"id":"/docs/red/v1/modelo/objetos","page_id":"/docs/red/v1/modelo/objetos","type":"page","content":"Objetos","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo/objetos"},"715":{"id":"/docs/red/v1/modelo/objetos-0","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos","content":"Identidad, ciclo de vida y propiedad de los objetos de red de Eco."},"716":{"id":"/docs/red/v1/modelo/objetos-1","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#objetos","content":"Objetos"},"717":{"id":"/docs/red/v1/modelo/objetos-2","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#identidad","content":"Identidad"},"718":{"id":"/docs/red/v1/modelo/objetos-3","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#canal-y-registro","content":"Canal y registro"},"719":{"id":"/docs/red/v1/modelo/objetos-4","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#propiedad","content":"Propiedad"},"720":{"id":"/docs/red/v1/modelo/objetos-5","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#componentes","content":"Componentes"},"721":{"id":"/docs/red/v1/modelo/objetos-6","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#datos","content":"Datos"},"722":{"id":"/docs/red/v1/modelo/objetos-7","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"Capacidad de envío"},"723":{"id":"/docs/red/v1/modelo/objetos-8","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#ciclo-de-vida-y-transferencia","content":"Ciclo de vida y transferencia"},"724":{"id":"/docs/red/v1/modelo/objetos-9","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#relación-con-eco","content":"Relación con Eco"},"725":{"id":"/docs/red/v1/modelo/objetos-10","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"726":{"id":"/docs/red/v1/modelo/objetos-11","page_id":"/docs/red/v1/modelo/objetos","type":"heading","tags":[],"url":"/docs/red/v1/modelo/objetos#referencias","content":"Referencias"},"727":{"id":"/docs/red/v1/modelo/objetos-12","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#objetos","content":"Un `Objeto` es la identidad de red asociada a un `GameObject` de Unity. Permite a Eco localizar una entidad, conocer su canal, determinar su propietario y asociar los `Componente` que implementan su comportamiento de red."},"728":{"id":"/docs/red/v1/modelo/objetos-13","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#objetos","content":"Un objeto no es simplemente un contenedor para RPC. Es la identidad de red sobre la que Eco construye direccionamiento, propiedad, estado y ciclo de vida."},"729":{"id":"/docs/red/v1/modelo/objetos-14","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Cada objeto tiene un `id` y un `uid`."},"730":{"id":"/docs/red/v1/modelo/objetos-15","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Tipo"},"731":{"id":"/docs/red/v1/modelo/objetos-16","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Rango"},"732":{"id":"/docs/red/v1/modelo/objetos-17","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Uso"},"733":{"id":"/docs/red/v1/modelo/objetos-18","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Estático"},"734":{"id":"/docs/red/v1/modelo/objetos-19","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"`1`–`32767`"},"735":{"id":"/docs/red/v1/modelo/objetos-20","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Objetos que ya existen en la escena"},"736":{"id":"/docs/red/v1/modelo/objetos-21","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Dinámico"},"737":{"id":"/docs/red/v1/modelo/objetos-22","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"`32768`–`16777215`"},"738":{"id":"/docs/red/v1/modelo/objetos-23","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Objetos creados durante la sesión"},"739":{"id":"/docs/red/v1/modelo/objetos-24","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"El `uid` combina canal e identificador del objeto:"},"740":{"id":"/docs/red/v1/modelo/objetos-25","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#identidad","content":"Los objetos estáticos y dinámicos tienen ciclos de vida diferentes. Por ejemplo, los objetos estáticos no permiten cambiar su propietario de la misma forma que los dinámicos."},"741":{"id":"/docs/red/v1/modelo/objetos-26","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#canal-y-registro","content":"Cada objeto tiene asociado un `channelID`. `hasBeenRegistered` indica que su creación ya terminó y que tiene un identificador de red asignado. `hasBeenDestroyed` bloquea el uso del objeto cuando comienza su destrucción."},"742":{"id":"/docs/red/v1/modelo/objetos-27","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#propiedad","content":"Las propiedades principales son:"},"743":{"id":"/docs/red/v1/modelo/objetos-28","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#propiedad","content":"`isMine` comprueba la propiedad local, `owner` devuelve el `Jugador` propietario y `ownerID` expone su identificador."},"744":{"id":"/docs/red/v1/modelo/objetos-29","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#propiedad","content":"Ser visible para un jugador no implica que sea suyo. La propiedad representa autoridad para determinadas operaciones de red."},"745":{"id":"/docs/red/v1/modelo/objetos-30","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#componentes","content":"Los `Componente` contienen el comportamiento de red asociado al `Objeto`."},"746":{"id":"/docs/red/v1/modelo/objetos-31","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#componentes","content":"Un `Componente` busca el `Objeto` en su jerarquía de Unity y expone accesos de conveniencia para datos, instanciación y destrucción."},"747":{"id":"/docs/red/v1/modelo/objetos-32","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#datos","content":"Cada objeto puede mantener un `Nodo` de datos:"},"748":{"id":"/docs/red/v1/modelo/objetos-33","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#datos","content":"El cambio se aplica localmente y, cuando la sincronización está activa, Eco decide cómo propagarlo según propiedad y disponibilidad del objeto para enviar. Los cambios pueden quedar en cola mientras el objeto no puede transmitir."},"749":{"id":"/docs/red/v1/modelo/objetos-34","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"`PuedeEnviar` comprueba que el objeto tenga un identificador válido, no esté destruido, pertenezca a un canal del cliente y no esté todavía completando la entrada en ese canal."},"750":{"id":"/docs/red/v1/modelo/objetos-35","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#capacidad-de-envío","content":"Esto resulta especialmente importante durante cambios de escena y uniones a canales."},"751":{"id":"/docs/red/v1/modelo/objetos-36","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#ciclo-de-vida-y-transferencia","content":"`Objeto` expone callbacks de red para destrucción y transferencia:"},"752":{"id":"/docs/red/v1/modelo/objetos-37","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#ciclo-de-vida-y-transferencia","content":"Estos callbacks permiten separar el ciclo de vida de red del ciclo de vida de Unity."},"753":{"id":"/docs/red/v1/modelo/objetos-38","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Eco"},"754":{"id":"/docs/red/v1/modelo/objetos-39","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"TNet"},"755":{"id":"/docs/red/v1/modelo/objetos-40","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","content":"Función"},"756":{"id":"/docs/red/v1/modelo/objetos-41","page_id":"/docs/red/v1/modelo/objetos","tags":[],"type":"text","url":"/docs/red/v1/modelo/objetos#correspondencia-con-tnet","con