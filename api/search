/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"Al asignar una implementación, Eco pasa al estado de verificación y envía el handshake de identidad sobre la conexión proporcionada."},"451":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-11","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#conexión-personalizada","content":"`IConnection` sustituye el transporte. No convierte automáticamente el protocolo de Eco en otro protocolo ni elimina las reglas de canales, objetos o sincronización."},"452":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-12","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#steam","content":"El repositorio incluye un módulo `Steam` y referencias a paquetes standalone de Steam Networking. La integración está diseñada para transportar la comunicación de Eco utilizando la infraestructura de Steam en lugar de depender únicamente de sockets directos."},"453":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-13","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"juegos distribuidos mediante Steam;"},"454":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-14","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"NAT traversal gestionado por Steam;"},"455":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-15","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"conexiones entre usuarios sin publicar endpoints TCP directamente;"},"456":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-16","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#casos-de-uso","content":"integración del networking con una API de transporte existente."},"457":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-17","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#fuentes","content":"Código y material de integración Steam."},"458":{"id":"/docs/red/v1/avanzado/steam-y-conexiones-18","page_id":"/docs/red/v1/avanzado/steam-y-conexiones","tags":[],"type":"text","url":"/docs/red/v1/avanzado/steam-y-conexiones#fuentes","content":"Punto donde se integra `IConnection`."},"459":{"id":"/docs/red/v1/avanzado/transform-suave","page_id":"/docs/red/v1/avanzado/transform-suave","type":"page","content":"TransformSuave","breadcrumbs":["Docs","Red","Red","Contenido","Funciones avanzadas"],"tags":[],"url":"/docs/red/v1/avanzado/transform-suave"},"460":{"id":"/docs/red/v1/avanzado/transform-suave-0","page_id":"/docs/red/v1/avanzado/transform-suave","tags":[],"type":"text","url":"/docs/red/v1/avanzado/transform-suave","content":"Interpolación visual de transformaciones recibidas desde la red."},"461":{"id":"/docs/red/v1/avanzado/transform-suave-1","page_id":"/docs/red/v1/avanzado/transform-suave","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/transform-suave#transformsuave","content":"TransformSuave"},"462":{"id":"/docs/red/v1/avanzado/transform-suave-2","page_id":"/docs/red/v1/avanzado/transform-suave","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/transform-suave#problema","content":"Problema"},"463":{"id":"/docs/red/v1/avanzado/transform-suave-3","page_id":"/docs/red/v1/avanzado/transform-suave","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/transform-suave#patrón","content":"Patrón"},"464":{"id":"/docs/red/v1/avanzado/transform-suave-4","page_id":"/docs/red/v1/avanzado/transform-suave","type":"heading","tags":[],"url":"/docs/red/v1/avanzado/transform-suave#cuándo-usarlo","cont