unicacion#referencia-a-tnet","content":"`Canal`"},"247":{"id":"/docs/red/v1/comunicacion-63","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"RFC"},"248":{"id":"/docs/red/v1/comunicacion-64","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"RFC"},"249":{"id":"/docs/red/v1/comunicacion-65","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"La documentación de TNet es útil para entender el diseño original y localizar conceptos equivalentes, pero la referencia normativa para Eco es el repositorio `Nervelink/eco`."},"250":{"id":"/docs/red/v1/comunicacion-66","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Código fuente de la implementación actual de Eco."},"251":{"id":"/docs/red/v1/comunicacion-67","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Repositorio upstream del que procede la base de Eco."},"252":{"id":"/docs/red/v1/comunicacion-68","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Documentación generada del repositorio actual de TNet para contrastar arquitectura y evolución upstream."},"253":{"id":"/docs/red/v1/conceptos","page_id":"/docs/red/v1/conceptos","type":"page","content":"Conceptos fundamentales","breadcrumbs":["Docs","Red","Red","Conceptos"],"tags":[],"url":"/docs/red/v1/conceptos"},"254":{"id":"/docs/red/v1/conceptos-0","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"255":{"id":"/docs/red/v1/conceptos-1","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Conceptos fundamentales"},"256":{"id":"/docs/red/v1/conceptos-2","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#conexión","content":"Conexión"},"257":{"id":"/docs/red/v1/conceptos-3","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#jugador","content":"Jugador"},"258":{"id":"/docs/red/v1/conceptos-4","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#canal","content":"Canal"},"259":{"id":"/docs/red/v1/conceptos-5","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#objeto","content":"Objeto"},"260":{"id":"/docs/red/v1/conceptos-6","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#componente","content":"Componente"},"261":{"id":"/docs/red/v1/conceptos-7","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#propietario","content":"Propietario"},"262":{"id":"/docs/red/v1/conceptos-8","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#paquete","content":"Paquete"},"263":{"id":"/docs/red/v1/conceptos-9","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#buffer","content":"Buffer"},"264":{"id":"/docs/red/v1/conceptos-10","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#estado","content":"Estado"},"265":{"id":"/docs/red/v1/conceptos-11","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"266":{"id":"/docs/red/v1/conceptos-12","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"267":{"id":"/docs/red/v1/conceptos-13","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#referencias-upstream","content":"Referencias upstream"},"268":{"id":"/docs/red/v1/conceptos-14","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Antes de trabajar con Eco conviene entender unas pocas piezas que aparecen constantemente en su API. Eco hereda el modelo conceptual de TNet, pero la documentación utiliza siempre los nombres de Eco."},"269":{"id":"/docs/red/v1/conceptos-15","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Una conexión representa la comunicación con el servidor; un jugador representa a quién pertenece esa conexión; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"270":{"id":"/docs/red/v1/conceptos-16","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. Es responsable de llevar y recibir los datos, pero no define por sí sola qué objetos o estado debe conocer el cliente."},"271":{"id":"/docs/red/v1/conceptos-17","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conexión","content":"Por eso una conexión no debe confundirse con un canal. La misma conexión puede participar en diferentes canales según el estado de la sesión."},"272":{"id":"/docs/red/v1/conceptos-18","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. El jugador está asociado a una conexión y sirve para identificar al participante cuando Eco necesita expresar propiedad, destinatarios o presencia dentro de un canal."},"273":{"id":"/docs/red/v1/conceptos-19","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#jugador","content":"El jugador no es necesariamente la entidad jugable que existe en el mundo del juego. Esa entidad puede estar representada por un `Objeto` independiente."},"274":{"id":"/docs/red/v1/conceptos-20","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Los jugadores pueden entrar y salir de canales y el servidor utiliza el canal como contexto para gestionar objetos, mensajes y persistencia."},"275":{"id":"/docs/red/v1/conceptos-21","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#canal","content":"La participación en varios canales es una capacidad importante de Eco. No debe modelarse como si el cliente sólo pudiera tener un canal activo."},"276":{"id":"/docs/red/v1/conceptos-22","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"277":{"id":"/docs/red/v1/conceptos-23","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"Un objeto puede entenderse como la unidad sobre la que se construye el estado de una entidad dentro de la red:"},"278":{"id":"/docs/red/v1/conceptos-24","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"El objeto no representa por sí mismo toda la lógica de gameplay. Su función es proporcionar la identidad y el contexto de red sobre el que trabajan sus componentes."},"279":{"id":"/docs/red/v1/conceptos-25","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Es el equivalente conceptual del componente de comportamiento de TNet y permite separar la identidad de red de la funcionalidad concreta."},"280":{"id":"/docs/red/v1/conceptos-26","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#componente","content":"Esta separación es especialmente útil cuando una misma entidad necesita varias responsabilidades de red: sincronización, llamadas remotas, lógica de propiedad, etc."},"281":{"id":"/docs/red/v1/conceptos-27","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"Eco mantiene información de propiedad sobre los objetos de red. El propietario identifica al participante que tiene autoridad sobre determinadas operaciones del objeto."},"282":{"id":"/docs/red/v1/conceptos-28","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"La propiedad no equivale necesariamente a que el objeto sólo exista para ese jugador. El objeto puede ser visible para otros participantes mientras uno de ellos mantiene su autoridad."},"283":{"id":"/docs/red/v1/conceptos-29","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"La semántica exacta de `isMine`, propietarios y transferencia de propiedad se documentará en la sección específica de objetos."},"284":{"id":"/docs/red/v1/conceptos-30","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"Un `Paquete` representa una unidad de datos del protocolo de Eco. Los paquetes transportan comandos, eventos y datos entre clientes y servidor."},"285":{"id":"/docs/red/v1/conceptos-31","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"Conceptualmente:"},"286":{"id":"/docs/red/v1/conceptos-32","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"El paquete pertenece a la capa de protocolo. No es equivalente a un evento de gameplay: un evento de juego puede terminar representándose mediante uno o varios tipos de mensaje de red."},"287":{"id":"/docs/red/v1/conceptos-33","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"288":{"id":"/docs/red/v1/conceptos-34","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#buffer","content":"El buffer es deliberadamente una capa inferior a los objetos y componentes. Normalmente una característica de gameplay no debería manipularlo directamente salvo que esté implementando serialización o un protocolo específico."},"289":{"id":"/docs/red/v1/conceptos-35","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#estado","content":"Eco diferencia conceptualmente entre enviar una acción y mantener un estado de red. Una llamada remota puede comunicar que algo ocurrió, mientras que la sincronización de estado permite que un cliente conozca el valor actual de una propiedad o conjunto de datos."},"290":{"id":"/docs/red/v1/conceptos-36","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#estado","content":"Esta distinción será importante al documentar `RFC`, sincronización automática, sincronización personalizada y los mecanismos basados en datos."},"291":{"id":"/docs/red/v1/conceptos-37","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#relación-entre-conceptos","content":"La idea clave es que estas piezas no son alternativas entre sí. Forman capas distintas del modelo de red."},"292":{"id":"/docs/red/v1/conceptos-38","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"Concepto Eco"},"293":{"id":"/docs/red/v1/conceptos-39","page_id":"/do