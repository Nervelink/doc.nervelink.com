rtida."},"346":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-18","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"No todos los proyectos lo requieren."},"347":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-19","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Arquitectura"},"348":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-20","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Lobby"},"349":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-21","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Cliente → IP fija"},"350":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-22","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"No"},"351":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-23","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Servidor dedicado listado"},"352":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-24","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Normalmente sí"},"353":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-25","page_id":"/docs/red/v1/avanzado/lobby-y-discovery","tags":[],"type":"text","url":"/docs/red/v1/avanzado/lobby-y-discovery#cuándo-necesitas-un-lobby","content":"Matchmaking propio"},"354":{"id":"/docs/red/v1/avanzado/lobby-y-discovery-26","page_id":"/docs/red/v1/avanzado/lobb