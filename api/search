1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#upnp-y-nat","content":"`UPnP` permite a una aplicación solicitar al router la creación de un mapeo de puertos sin que el usuario tenga que configurar manualmente el forwarding."},"1029":{"id":"/docs/red/v1/avanzado/upnp-10","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#el-problema","content":"Un servidor puede escuchar correctamente en su máquina y, sin embargo, no ser accesible desde Internet porque el router utiliza NAT."},"1030":{"id":"/docs/red/v1/avanzado/upnp-11","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#el-problema","content":"El puerto debe estar accesible desde el exterior para que clientes remotos puedan conectarse directamente."},"1031":{"id":"/docs/red/v1/avanzado/upnp-12","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#qué-aporta-upnp","content":"No todos los routers admiten UPnP y algunas redes lo deshabilitan por seguridad."},"1032":{"id":"/docs/red/v1/avanzado/upnp-13","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#detectar-soporte","content":"Comprueba que exista un dispositivo UPnP compatible antes de intentar crear reglas."},"1033":{"id":"/docs/red/v1/avanzado/upnp-14","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#resolver-dirección","content":"Determina la dirección LAN y el puerto TCP/UDP que utilizará Eco."},"1034":{"id":"/docs/red/v1/avanzado/upnp-15","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#crear-mapeo","content":"Solicita al router el forwarding para el puerto correspondiente."},"1035":{"id":"/docs/red/v1/avanzado/upnp-16","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#verificar-desde-fuera","content":"La existencia de la regla no garantiza que el ISP o firewall permita el tráfico. Prueba desde otra red."},"1036":{"id":"/docs/red/v1/avanzado/upnp-17","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#verificar-desde-fuera","content":"CGNAT, firewalls, doble NAT o políticas del router pueden impedir conexiones entrantes aunque la solicitud UPnP sea correcta."},"1037":{"id":"/docs/red/v1/avanzado/upnp-18","page_id":"/docs/red/v1/avanzado/upnp","tags":[],"type":"text","url":"/docs/red/v1/avanzado/upnp#verificar-desde-fuera","content":"Implementación actual de las utilidades UPnP."},"1038":{"id":"/docs/red/v1/comunicacion/destinatarios","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"page","content":"Destinatarios","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/destinatarios"},"1039":{"id":"/docs/red/v1/comunicacion/destinatarios-0","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios","content":"Cómo Eco determina quién recibe un mensaje dentro de un canal."},"1040":{"id":"/docs/red/v1/comunicacion/destinatarios-1","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Destinatarios"},"1041":{"id":"/docs/red/v1/comunicacion/destinatarios-2","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Contexto de canal"},"1042":{"id":"/docs/red/v1/comunicacion/destinatarios-3","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivos habituales"},"1043":{"id":"/docs/red/v1/comunicacion/destinatarios-4","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Propietario frente a canal"},"1044":{"id":"/docs/red/v1/comunicacion/destinatarios-5","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Comunicación persistente"},"1045":{"id":"/docs/red/v1/comunicacion/destinatarios-6","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#elección-práctica","content":"Elección práctica"},"1046":{"id":"/docs/red/v1/comunicacion/destinatarios-7","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#listas-de-jugadores","content":"Listas de jugadores"},"1047":{"id":"/docs/red/v1/comunicacion/destinatarios-8","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#echo-y-llamadas-reenviadas","content":"Echo y llamadas reenviadas"},"1048":{"id":"/docs/red/v1/comunicacion/destinatarios-9","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"Relación con persistencia"},"1049":{"id":"/docs/red/v1/comunicacion/destinatarios-10","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Relación con TNet"},"1050":{"id":"/docs/red/v1/comunicacion/destinatarios-11","page_id":"/docs/red/v1/comunicacion/destinatarios","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Referencias"},"1051":{"id":"/docs/red/v1/comunicacion/destinatarios-12","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Enviar un mensaje no significa necesariamente enviarlo a todos los participantes. Eco permite elegir el ámbito de destinatarios según el tipo de comunicación y el estado que se quiere mantener."},"1052":{"id":"/docs/red/v1/comunicacion/destinatarios-13","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#destinatarios","content":"Antes de enviar un mensaje conviene decidir quién necesita conocerlo: el propietario, los demás jugadores, todo el canal o también los jugadores que entren posteriormente."},"1053":{"id":"/docs/red/v1/comunicacion/destinatarios-14","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Los mensajes asociados a objetos se interpretan dentro de un `Canal`. El canal determina qué jugadores forman parte del ámbito de difusión."},"1054":{"id":"/docs/red/v1/comunicacion/destinatarios-15","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"A partir de ese contexto, Eco puede excluir al emisor, incluirlo, conservar el mensaje para futuros participantes o dirigirlo a un participante concreto."},"1055":{"id":"/docs/red/v1/comunicacion/destinatarios-16","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivo conceptual"},"1056":{"id":"/docs/red/v1/comunicacion/destinatarios-17","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Uso"},"1057":{"id":"/docs/red/v1/comunicacion/destinatarios-18","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Todos`"},"1058":{"id":"/docs/red/v1/comunicacion/destinatarios-19","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos los jugadores del canal."},"1059":{"id":"/docs/red/v1/comunicacion/destinatarios-20","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Otros`"},"1060":{"id":"/docs/red/v1/comunicacion/destinatarios-21","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos salvo el emisor."},"1061":{"id":"/docs/red/v1/comunicacion/destinatarios-22","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Propietario"},"1062":{"id":"/docs/red/v1/comunicacion/destinatarios-23","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"El jugador que posee el objeto."},"1063":{"id":"/docs/red/v1/comunicacion/destinatarios-24","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Persistente"},"1064":{"id":"/docs/red/v1/comunicacion/destinatarios-25","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"También debe estar disponible para participantes posteriores."},"1065":{"id":"/docs/red/v1/comunicacion/destinatarios-26","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Jugador concreto"},"1066":{"id":"/docs/red/v1/comunicacion/destinatarios-27","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Un único participante identificado."},"1067":{"id":"/docs/red/v1/comunicacion/destinatarios-28","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Los nombres exactos disponibles dependen de la API de `Objetivo` y del método utilizado para enviar el mensaje."},"1068":{"id":"/docs/red/v1/comunicacion/destinatarios-29","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"La propiedad y la visibilidad son conceptos diferentes:"},"1069":{"id":"/docs/red/v1/comunicacion/destinatarios-30","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Que un objeto tenga propietario no significa que únicamente ese jugador pueda recibir sus actualizaciones."},"1070":{"id":"/docs/red/v1/comunicacion/destinatarios-31","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Un mensaje marcado para persistir puede formar parte del estado que Eco mantiene asociado al canal u objeto. Esto resulta útil cuando el contenido debe estar disponible también para jugadores que todavía no estaban conectados cuando ocurrió la comunicación."},"1071":{"id":"/docs/red/v1/comunicacion/destinatarios-32","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"No debe utilizarse persistencia sólo porque un mensaje se considere importante: debe existir una necesidad real de reconstruir ese estado posteriormente."},"1072":{"id":"/docs/red/v1/comunicacion/destinatarios-33","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#listas-de-jugadores","content":"La arquitectura de TNet/Eco también contempla el envío a una lista concreta de jugadores, no sólo a un único ID. Esta opción es especialmente útil para grupos seleccionados que no coinciden con todos los miembros del canal."},"1073":{"id":"/docs/red/v1/comunicacion/destinatarios-34","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#echo-y-llamadas-reenviadas","content":"El protocolo distingue comunicaciones como `ForwardToAll`, `ForwardToOthers` y sus variantes persistentes. Estas operaciones permiten que el servidor reenvíe el contenido sin que el cliente tenga que construir manualmente un paquete distinto para cada receptor."},"1074":{"id":"/docs/red/v1/comunicacion/destinatarios-35","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"Hay que separar dos preguntas:"},"1075":{"id":"/docs/red/v1/comunicacion/destinatarios-36","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"La primera es una decisión de destinatario. La segunda es una decisión de persistencia. Pueden combinarse, pero no son el mismo concepto."},"1076":{"id":"/docs/red/v1/comunicacion/destinatarios-37","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Eco conserva el modelo de objetivos de TNet, pero utiliza la nomenclatura propia del proyecto. Las equivalencias deben comprobarse siempre contra la implementación actual de `Eco`, `Objeto` y `Paquete`."},"1077":{"id":"/docs/red/v1/comunicacion/destinatarios-38","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Cómo construir llamadas remotas y decidir su comportamiento."},"1078":{"id":"/docs/red/v1/comunicacion/destinatarios-39","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Aplicación práctica del alcance por canal."},"1079":{"id":"/docs/red/v1/comunicacion/destinatarios-40","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Repositorio upstream."},"1080":{"id":"/docs/red/v1/comunicacion","page_id":"/docs/red/v1/comunicacion","type":"page","content":"Comunicación","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion"},"1081":{"id":"/docs/red/v1/comunicacion-0","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion","content":"Cómo Eco decide qué comunicar, a quién, con qué mecanismo y cómo conservar el estado."},"1082":{"id":"/docs/red/v1/comunicacion-1","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación","content":"Comunicación"},"1083":{"id":"/docs/red/v1/comunicacion-2","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#árbol-de-decisión","content":"Árbol de decisión"},"1084":{"id":"/docs/red/v1/comunicacion-3","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"Creación frente a método"},"1085":{"id":"/docs/red/v1/comunicacion-4","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Estado frente a operaciones remotas"},"1086":{"id":"/docs/red/v1/comunicacion-5","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#autoridad","content":"Autoridad"},"1087":{"id":"/docs/red/v1/comunicacion-6","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Relación con TNet"},"1088":{"id":"/docs/red/v1/comunicacion-7","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#referencias","content":"Referencias"},"1089":{"id":"/docs/red/v1/comunicacion-8","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"La comunicación de Eco distingue entre **creación**, **ejecución de métodos** y **sincronización de estado**. La terminología pública actual es:"},"1090":{"id":"/docs/red/v1/comunicacion-9","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Si vienes de TNet, verás que `RCC`, `RFC` y `LCR` han sido refactorizados en Eco como `RCR`, `RMR` y `RCL`, respectivamente. En esta documentación usamos siempre los nombres de Eco salvo cuando explicamos compatibilidad histórica."},"1091":{"id":"/docs/red/v1/comunicacion-10","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Ejecutar un método remotamente."},"1092":{"id":"/docs/red/v1/comunicacion-11","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Crear un objeto mediante la red."},"1093":{"id":"/docs/red/v1/comunicacion-12","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Solicitud de creación local dentro del flujo de red."},"1094":{"id":"/docs/red/v1/comunicacion-13","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Mantener propiedades y datos de una entidad coherentes entre participantes."},"1095":{"id":"/docs/red/v1/comunicacion-14","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"Crear una entidad y ejecutar una operación sobre una entidad existente son problemas distintos."},"1096":{"id":"/docs/red/v1/comunicacion-15","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"No utilices un método remoto como sustituto conceptual de la creación de una entidad."},"1097":{"id":"/docs/red/v1/comunicacion-16","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa `RMR` para acciones, comandos o hechos puntuales que requieren ejecutar un método remoto."},"1098":{"id":"/docs/red/v1/comunicacion-17","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa sincronización para valores que deben poder consultarse en cualquier momento: vida, inventario, configuración o estado de una entidad."},"1099":{"id":"/docs/red/v1/comunicacion-18","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa los mecanismos de creación cuando necesitas incorporar una entidad al modelo de red."},"1100":{"id":"/docs/red/v1/comunicacion-19","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"La comunicación no elimina la autoridad. Un cliente puede solicitar una operación, pero la autoridad de la partida y las reglas de validación siguen siendo parte del diseño de seguridad y consistencia."},"1101":{"id":"/docs/red/v1/comunicacion-20","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"Que una operación llegue correctamente por red no significa que sea válida. La validación importante debe permanecer en el lado que controla la autoridad real."},"1102":{"id":"/docs/red/v1/comunicacion-21","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Eco"},"1103":{"id":"/docs/red/v1/comunicacion-22","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"TNet"},"1104":{"id":"/docs/red/v1/comunicacion-23","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Significado"},"1105":{"id":"/docs/red/v1/comunicacion-24","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCR`"},"1106":{"id":"/docs/red/v1/comunicacion-25","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCC`"},"1107":{"id":"/docs/red/v1/comunicacion-26","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Creación Remota"},"1108":{"id":"/docs/red/v1/comunicacion-27","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RMR`"},"1109":{"id":"/docs/red/v1/comunicacion-28","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RFC`"},"1110":{"id":"/docs/red/v1/comunicacion-29","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Método Remoto"},"1111":{"id":"/docs/red/v1/comunicacion-30","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCL`"},"1112":{"id":"/docs/red/v1/comunicacion-31","page_id":"/docs/red/v1/comunicacion","tags":[],"ty