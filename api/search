profunda-29","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Nodo` y `Buffer` trabajan a niveles diferentes."},"4295":{"id":"/docs/red/v1/transporte/serializacion-profunda-30","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"Herramienta"},"4296":{"id":"/docs/red/v1/transporte/serializacion-profunda-31","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"Problema que resuelve"},"4297":{"id":"/docs/red/v1/transporte/serializacion-profunda-32","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Buffer`"},"4298":{"id":"/docs/red/v1/transporte/serializacion-profunda-33","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"transporte binario y protocolo"},"4299":{"id":"/docs/red/v1/transporte/serializacion-profunda-34","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"`Nodo`"},"4300":{"id":"/docs/red/v1/transporte/serializacion-profunda-35","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion-profunda#nodo-no-sustituye-a-buffer","content":"datos jerárquicos y estado estructurado"},"4301":{"id":"/docs/red/v1/transporte/serializacion-profunda-36","page_id":"/docs/red/v1/transporte/serializacion-profunda","tags":[],"type":"text","url":"/docs/red/v1/transporte/se