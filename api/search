es#referencias-upstream","content":"Repositorio upstream del que procede esta arquitectura."},"186":{"id":"/docs/red/v1/canales-108","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#referencias-upstream","content":"Documentación generada sobre el repositorio actual de TNet para contrastar conceptos y evolución."},"187":{"id":"/docs/red/v1/cliente","page_id":"/docs/red/v1/cliente","type":"page","content":"Cliente","breadcrumbs":["Docs","Red","Red","Cliente"],"tags":[],"url":"/docs/red/v1/cliente"},"188":{"id":"/docs/red/v1/cliente-0","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente","content":"Ciclo de vida del cliente de Eco, conexión, transporte y gestión de la sesión de red."},"189":{"id":"/docs/red/v1/cliente-1","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#cliente","content":"Cliente"},"190":{"id":"/docs/red/v1/cliente-2","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#flujo-general","content":"Flujo general"},"191":{"id":"/docs/red/v1/cliente-3","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#estado-de-conexión","content":"Estado de conexión"},"192":{"id":"/docs/red/v1/cliente-4","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#conexión-tcp","content":"Conexión TCP"},"193":{"id":"/docs/red/v1/cliente-5","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#udp","content":"UDP"},"194":{"id":"/docs/red/v1/cliente-6","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#procesamiento-de-paquetes","content":"Procesamiento de paquetes"},"195":{"id":"/docs/red/v1/cliente-7","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#handshake-y-tiempo-del-servidor","content":"Handshake y tiempo del servidor"},"196":{"id":"/docs/red/v1/cliente-8","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#ping-y-supervisión","content":"Ping y supervisión"},"197":{"id":"/docs/red/v1/cliente-9","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#canales-desde-el-cliente","content":"Canales desde el cliente"},"198":{"id":"/docs/red/v1/cliente-10","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#protección-durante-la-entrada-a-un-canal","content":"Protección durante la entrada a un canal"},"199":{"id":"/docs/red/v1/cliente-11","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#jugador-local","content":"Jugador local"},"200":{"id":"/docs/red/v1/cliente-12","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#datos-del-servidor","content":"Datos del servidor"},"201":{"id":"/docs/red/v1/cliente-13","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#desconexión","content":"Desconexión"},"202":{"id":"/docs/red/v1/cliente-14","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#cliente-local-sin-sockets","content":"Cliente local sin sockets"},"203":{"id":"/docs/red/v1/cliente-15","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#referencia-a-tnet","content":"Referencia a TNet"},"204":{"id":"/docs/red/v1/cliente-16","page_id":"/docs/red/v1/cliente","type":"heading","tags":[],"url":"/docs/red/v1/cliente#referencias","content":"Referencias"},"205":{"id":"/docs/red/v1/cliente-17","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#cliente","content":"El cliente es la parte de Eco que mantiene la conexión con el servidor, procesa los paquetes entrantes, envía solicitudes y conserva el estado de la sesión local."},"206":{"id":"/docs/red/v1/cliente-18","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#cliente","content":"En el uso habitual de Eco se trabaja con su fachada pública. Internamente, el procesamiento de red está concentrado en `ClienteJuego` y en los protocolos de transporte que utiliza."},"207":{"id":"/docs/red/v1/cliente-19","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#flujo-general","content":"`ClienteJuego` mantiene el protocolo TCP como transporte principal y puede habilitar UDP para tráfico apropiado para datagramas. También permite proporcionar una conexión personalizada mediante `IConnection`. fileciteturn80file0"},"208":{"id":"/docs/red/v1/cliente-20","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"El cliente expone varios estados que conviene distinguir:"},"209":{"id":"/docs/red/v1/cliente-21","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Estado"},"210":{"id":"/docs/red/v1/cliente-22","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Significado"},"211":{"id":"/docs/red/v1/cliente-23","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"`isConnected`"},"212":{"id":"/docs/red/v1/cliente-24","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Existe una conexión funcional con el servidor o un servidor local"},"213":{"id":"/docs/red/v1/cliente-25","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"`isTryingToConnect`"},"214":{"id":"/docs/red/v1/cliente-26","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Se está intentando establecer la conexión"},"215":{"id":"/docs/red/v1/cliente-27","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"`isJoiningChannel`"},"216":{"id":"/docs/red/v1/cliente-28","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Hay una o más operaciones de entrada a canales pendientes"},"217":{"id":"/docs/red/v1/cliente-29","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"`isInChannel`"},"218":{"id":"/docs/red/v1/cliente-30","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"El cliente pertenece actualmente a uno o más canales"},"219":{"id":"/docs/red/v1/cliente-31","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"`stage`"},"220":{"id":"/docs/red/v1/cliente-32","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"Fase actual del protocolo TCP"},"221":{"id":"/docs/red/v1/cliente-33","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#estado-de-conexión","content":"La implementación mantiene además una colección explícita de canales y otra de canales pendientes de entrada. Esto es importante porque un cliente de Eco no se modela como miembro de un único canal. fileciteturn80file0"},"222":{"id":"/docs/red/v1/cliente-34","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#conexión-tcp","content":"TCP es el transporte principal de `ClienteJuego`."},"223":{"id":"/docs/red/v1/cliente-35","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#conexión-tcp","content":"La instancia mantiene un `ProtocoloTcp` interno y expone el protocolo mediante `protocol`. También puede asignarse una implementación de `IConnection` como transporte personalizado. fileciteturn80file0"},"224":{"id":"/docs/red/v1/cliente-36","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#conexión-tcp","content":"La conexión puede establecerse contra un servidor remoto o contra un `ServidorJuego` local sin utilizar sockets. Este segundo modo es especialmente útil para pruebas, ejecución local y escenarios en los que el cliente y el servidor viven dentro del mismo proceso."},"225":{"id":"/docs/red/v1/cliente-37","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#udp","content":"UDP es opcional y se utiliza para tráfico que puede beneficiarse de menor latencia o de un modelo no fiable."},"226":{"id":"/docs/red/v1/cliente-38","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#udp","content":"El cliente expone:"},"227":{"id":"/docs/red/v1/cliente-39","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#udp","content":"La implementación comprueba que exista un endpoint UDP del servidor y que el listener local esté activo antes de considerar que UDP puede utilizarse. fileciteturn80file0"},"228":{"id":"/docs/red/v1/cliente-40","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#udp","content":"El envío de paquetes distingue entre comunicaciones fiables y no fiables. Cuando el paquete requiere fiabilidad, `ClienteJuego` utiliza TCP; cuando no la requiere y UDP está disponible, puede enviarlo por UDP. fileciteturn26file0"},"229":{"id":"/docs/red/v1/cliente-41","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#procesamiento-de-paquetes","content":"El cliente procesa los paquetes entrantes en `ProcessPackets()`."},"230":{"id":"/docs/red/v1/cliente-42","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#procesamiento-de-paquetes","content":"De forma simplificada:"},"231":{"id":"/docs/red/v1/cliente-43","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#procesamiento-de-paquetes","content":"Durante el procesamiento, Eco identifica el tipo mediante `Paquete` y delega el tratamiento correspondiente. El cliente mantiene también contadores de paquetes y bytes enviados y recibidos. fileciteturn39file0"},"232":{"id":"/docs/red/v1/cliente-44","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#procesamiento-de-paquetes","content":"El tiempo de procesamiento puede limitarse mediante la configuración de `USE_MAX_PACKET_TIME`, especialmente durante procesos como la entrada a un canal. Esto permite evitar que una gran cantidad de paquetes bloquee un frame completo. fileciteturn80file0"},"233":{"id":"/docs/red/v1/cliente-45","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#handshake-y-tiempo-del-servidor","content":"La conexión comienza con una fase de verificación del protocolo."},"234":{"id":"/docs/red/v1/cliente-46","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#handshake-y-tiempo-del-servidor","content":"Cuando se recibe `ResponseID`, el cliente obtiene el identificador de jugador y sincroniza su reloj con el servidor. `serverTime` y `serverUptime` se calculan a partir de esa diferencia temporal. fileciteturn39file0"},"235":{"id":"/docs/red/v1/cliente-47","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#ping-y-supervisión","content":"El cliente envía periódicamente solicitudes de ping al servidor. El ping sirve tanto para medir latencia como para mantener viva la conexión y confirmar que el servidor sigue siendo accesible."},"236":{"id":"/docs/red/v1/cliente-48","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#ping-y-supervisión","content":"La propiedad `ping` devuelve la latencia actual cuando existe una conexión. fileciteturn39file0"},"237":{"id":"/docs/red/v1/cliente-49","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#canales-desde-el-cliente","content":"El cliente conserva una lista de los canales en los que participa:"},"238":{"id":"/docs/red/v1/cliente-50","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#canales-desde-el-cliente","content":"Y permite comprobar un canal concreto:"},"239":{"id":"/docs/red/v1/cliente-51","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#canales-desde-el-cliente","content":"También dispone de operaciones para:"},"240":{"id":"/docs/red/v1/cliente-52","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#canales-desde-el-cliente","content":"Estas operaciones generan paquetes de protocolo; el cliente no modifica unilateralmente el estado del servidor. fileciteturn27file0"},"241":{"id":"/docs/red/v1/cliente-53","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#protección-durante-la-entrada-a-un-canal","content":"`JoinChannel` añade el canal a una colección de entradas pendientes antes de que llegue la respuesta del servidor."},"242":{"id":"/docs/red/v1/cliente-54","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#protección-durante-la-entrada-a-un-canal","content":"Esto tiene una finalidad importante: impedir que se envíen paquetes entre la orden de cambiar de escena o canal y la confirmación correspondiente. El código documenta explícitamente que esta protección evita que llamadas de la escena anterior terminen ejecutándose cuando la nueva escena ya está cargada. fileciteturn27file0"},"243":{"id":"/docs/red/v1/cliente-55","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#jugador-local","content":"El jugador local del cliente está asociado al protocolo TCP y se expone mediante la información de jugador de `ClienteJuego`."},"244":{"id":"/docs/red/v1/cliente-56","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#jugador-local","content":"La implementación permite trabajar con:"},"245":{"id":"/docs/red/v1/cliente-57","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#jugador-local","content":"El cliente puede actualizar sus datos de jugador mediante `SetPlayerData()` y sincronizar explícitamente el árbol completo mediante `SyncPlayerData()`. fileciteturn80file0"},"246":{"id":"/docs/red/v1/cliente-58","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#datos-del-servidor","content":"El cliente conserva un `Nodo` con la configuración asociada al servidor conectado."},"247":{"id":"/docs/red/v1/cliente-59","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#datos-del-servidor","content":"La modificación de esos datos está restringida al estado administrativo del cliente; al cambiarse se genera una solicitud específica hacia el servidor. fileciteturn80file0"},"248":{"id":"/docs/red/v1/cliente-60","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#desconexión","content":"`Disconnect()` finaliza la conexión y limpia el estado de sesión asociado. En el modo de servidor local también detiene el servidor embebido."},"249":{"id":"/docs/red/v1/cliente-61","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#desconexión","content":"Durante la desconexión se vacían los canales, jugadores conocidos, operaciones pendientes, callbacks y recursos UDP asociados a la sesión. fileciteturn26file0"},"250":{"id":"/docs/red/v1/cliente-62","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#cliente-local-sin-sockets","content":"Eco permite ejecutar un `ServidorJuego` y un `ClienteJuego` dentro del mismo proceso."},"251":{"id":"/docs/red/v1/cliente-63","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#cliente-local-sin-sockets","content":"Este modo conserva el flujo lógico de cliente/servidor y resulta útil para pruebas y entornos locales. `ClienteJuego.Connect(ServidorJuego)` establece esta conexión local. fileciteturn26file0"},"252":{"id":"/docs/red/v1/cliente-64","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"La arquitectura de esta capa procede de `GameClient` de TNet 3 y conserva su separación entre cliente, TCP, UDP, canales y servidor local."},"253":{"id":"/docs/red/v1/cliente-65","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"Eco"},"254":{"id":"/docs/red/v1/cliente-66","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"TNet"},"255":{"id":"/docs/red/v1/cliente-67","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`ClienteJuego`"},"256":{"id":"/docs/red/v1/cliente-68","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`GameClient`"},"257":{"id":"/docs/red/v1/cliente-69","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`ProtocoloTcp`"},"258":{"id":"/docs/red/v1/cliente-70","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`TcpProtocol`"},"259":{"id":"/docs/red/v1/cliente-71","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`ProtocoloUdp`"},"260":{"id":"/docs/red/v1/cliente-72","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`UdpProtocol`"},"261":{"id":"/docs/red/v1/cliente-73","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Paquete`"},"262":{"id":"/docs/red/v1/cliente-74","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Packet` / `TNPacket`"},"263":{"id":"/docs/red/v1/cliente-75","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Canal`"},"264":{"id":"/docs/red/v1/cliente-76","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Channel` / `TNChannel`"},"265":{"id":"/docs/red/v1/cliente-77","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Jugador`"},"266":{"id":"/docs/red/v1/cliente-78","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"`Player`"},"267":{"id":"/docs/red/v1/cliente-79","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencia-a-tnet","content":"La nomenclatura y las APIs documentadas aquí corresponden al repositorio `Nervelink/eco`."},"268":{"id":"/docs/red/v1/cliente-80","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencias","content":"Código fuente de la implementación actual."},"269":{"id":"/docs/red/v1/cliente-81","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencias","content":"Repositorio upstream de la arquitectura heredada."},"270":{"id":"/docs/red/v1/cliente-82","page_id":"/docs/red/v1/cliente","tags":[],"type":"text","url":"/docs/red/v1/cliente#referencias","content":"Referencia generada para explorar la arquitectura actual de TNet."},"271":{"id":"/docs/red/v1/comunicacion","page_id":"/docs/red/v1/comunicacion","type":"page","content":"Comunicación","breadcrumbs":["Docs","Red","Red","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion"},"272":{"id":"/docs/red/v1/comunicacion-0","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion","content":"Cómo Eco representa, dirige y procesa la comunicación entre objetos, componentes, clientes y servidor."},"273":{"id":"/docs/red/v1/comunicacion-1","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación","content":"Comunicación"},"274":{"id":"/docs/red/v1/comunicacion-2","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#capas-de-comunicación","content":"Capas de comunicación"},"275":{"id":"/docs/red/v1/comunicacion-3","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#rfc","content":"RFC"},"276":{"id":"/docs/red/v1/comunicacion-4","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#destinatarios","content":"Destinatarios"},"277":{"id":"/docs/red/v1/comunicacion-5","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#rfc-persistentes","content":"RFC persistentes"},"278":{"id":"/docs/red/v1/comunicacion-6","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación-a-través-de-componente","content":"Comunicación a través de `Componente`"},"279":{"id":"/docs/red/v1/comunicacion-7","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#el-canal-como-contexto","content":"El canal como contexto"},"280":{"id":"/docs/red/v1/comunicacion-8","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#paquetes-y-buffers","content":"Paquetes y buffers"},"281":{"id":"/docs/red/v1/comunicacion-9","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#cliente-y-servidor","content":"Cliente y servidor"},"282":{"id":"/docs/red/v1/comunicacion-10","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Comunicación y estado"},"283":{"id":"/docs/red/v1/comunicacion-11","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"Referencia a TNet"},"284":{"id":"/docs/red/v1/comunicacion-12","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#referencias","content":"Referencias"},"285":{"id":"/docs/red/v1/comunicacion-13","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"La comunicación de Eco se apoya en dos niveles que conviene mantener separados: el protocolo de red, representado por `Paquete` y `Buffer`, y la comunicación de alto nivel asociada a `Objeto` y `Componente`."},"286":{"id":"/docs/red/v1/comunicacion-14","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Un `Paquete` transporta datos. Un `Objeto` da contexto de red a esos datos. Los mecanismos de llamadas remotas y sincronización determinan qué comportamiento se ejecuta y quién debe recibirlo."},"287":{"id":"/docs/red/v1/comunicacion-15","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#capas-de-comunicación","content":"Estas capas no son intercambiables. El protocolo puede transportar mensajes sin conocer la lógica del juego, mientras que un objeto puede utilizar distintos tipos de mensajes para expresar acciones o cambios de estado."},"288":{"id":"/docs/red/v1/comunicacion-16","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc","content":"Eco conserva el concepto de **Remote Function Call** de TNet. Una RFC identifica una función asociada a un objeto y contiene los datos necesarios para ejecutarla remotamente."},"289":{"id":"/docs/red/v1/comunicacion-17","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc","content":"En `Canal`, las RFC se almacenan con:"},"290":{"id":"/docs/red/v1/comunicacion-18","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc","content":"El `uid` contiene el identificador del objeto y el identificador compacto de la función. Cuando la función no utiliza un identificador numérico, se almacena también su nombre. El canal puede reconstruir el paquete correspondiente a partir de estos datos. fileciteturn63file0"},"291":{"id":"/docs/red/v1/comunicacion-19","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#destinatarios","content":"Una llamada remota no implica necesariamente \"enviar a todos\". El sistema de objetos de Eco permite expresar distintos destinatarios y, en el caso de los datos persistentes, utilizar un recorrido diferente al de una comunicación efímera."},"292":{"id":"/docs/red/v1/comunicacion-20","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#destinatarios","content":"En la implementación de `Objeto`, por ejemplo, los cambios de datos pueden enviarse a `Objetivo.Otros`, al propietario del objeto o mediante objetivos persistentes según el caso. fileciteturn54file0"},"293":{"id":"/docs/red/v1/comunicacion-21","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#destinatarios","content":"La documentación específica de `Objetivo` y de cada modo de RFC se desarrollará en las páginas de referencia de esta sección."},"294":{"id":"/docs/red/v1/comunicacion-22","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc-persistentes","content":"Una característica importante del modelo de Eco es que algunas comunicaciones pueden quedar asociadas al estado persistente del objeto o del canal."},"295":{"id":"/docs/red/v1/comunicacion-23","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc-persistentes","content":"`Canal` conserva las RFC asociadas a objetos dinámicos y puede exportarlas junto con los datos de creación del objeto. Al importar un objeto, el canal restaura sus datos y vuelve a distribuir las RFC guardadas. fileciteturn63file0"},"296":{"id":"/docs/red/v1/comunicacion-24","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#rfc-persistentes","content":"Esto significa que una RFC persistente no debe entenderse simplemente como un mensaje que llega más tarde. Puede formar parte del estado necesario para reconstruir el estado de red de un objeto."},"297":{"id":"/docs/red/v1/comunicacion-25","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-a-través-de-componente","content":"La clase `Componente` está diseñada para que un comportamiento de Unity pueda trabajar con su `Objeto` asociado sin tener que resolverlo manualmente cada vez."},"298":{"id":"/docs/red/v1/comunicacion-26","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-a-través-de-componente","content":"El patrón es:"},"299":{"id":"/docs/red/v1/comunicacion-27","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-a-través-de-componente","content":"`Componente` también proporciona `Instantiate`, `DestroySelf`, `Get` y `Set` como accesos de conveniencia sobre el objeto de red. fileciteturn60file0"},"300":{"id":"/docs/red/v1/comunicacion-28","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#el-canal-como-contexto","content":"Las RFC almacenadas por Eco pertenecen al canal. Una entrada de RFC incluye el identificador del objeto, y el paquete que la representa incluye también el identificador del canal. fileciteturn62file0"},"301":{"id":"/docs/red/v1/comunicacion-29","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#el-canal-como-contexto","content":"Esto evita tratar una función remota como un mensaje global independiente del estado de sesión:"},"302":{"id":"/docs/red/v1/comunicacion-30","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#el-canal-como-contexto","content":"El mismo identificador de objeto puede tener sentido dentro del contexto de un canal diferente, por lo que el contexto del canal forma parte de la dirección efectiva del mensaje."},"303":{"id":"/docs/red/v1/comunicacion-31","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#paquetes-y-buffers","content":"`ClienteJuego` crea los paquetes mediante `CrearPaquete` y los finaliza mediante `EnviarPaquete`. Según el tipo de comunicación, el envío puede utilizar TCP o UDP; la selección de transporte se realiza por debajo de esta capa. fileciteturn26file0"},"304":{"id":"/docs/red/v1/comunicacion-32","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#paquetes-y-buffers","content":"Esto permite que la capa de gameplay trabaje con objetos y comandos sin tener que construir directamente las estructuras de sockets."},"305":{"id":"/docs/red/v1/comunicacion-33","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#cliente-y-servidor","content":"En el cliente, `ClienteJuego` mantiene la cola y el procesamiento de paquetes y conoce los canales en los que participa. En el servidor, `ServidorJuego` mantiene los jugadores y canales activos y procesa las operaciones de red. fileciteturn23file0 fileciteturn36file0"},"306":{"id":"/docs/red/v1/comunicacion-34","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#cliente-y-servidor","content":"El flujo conceptual es:"},"307":{"id":"/docs/red/v1/comunicacion-35","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"No todo lo que viaja por la red debe modelarse como una RFC."},"308":{"id":"/docs/red/v1/comunicacion-36","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Una forma útil de separar conceptos es:"},"309":{"id":"/docs/red/v1/comunicacion-37","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Necesidad"},"310":{"id":"/docs/red/v1/comunicacion-38","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Mecanismo conceptual"},"311":{"id":"/docs/red/v1/comunicacion-39","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Ejecutar comportamiento remoto"},"312":{"id":"/docs/red/v1/comunicacion-40","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"RFC"},"313":{"id":"/docs/red/v1/comunicacion-41","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Restaurar comportamiento/estado guardado"},"314":{"id":"/docs/red/v1/comunicacion-42","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"RFC persistente / estado del canal"},"315":{"id":"/docs/red/v1/comunicacion-43","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Actualizar datos de un objeto"},"316":{"id":"/docs/red/v1/comunicacion-44","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"`Set` / datos del objeto"},"317":{"id":"/docs/red/v1/comunicacion-45","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Mover datos binarios de protocolo"},"318":{"id":"/docs/red/v1/comunicacion-46","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"`Paquete` + `Buffer`"},"319":{"id":"/docs/red/v1/comunicacion-47","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Sincronizar un estado continuamente"},"320":{"id":"/docs/red/v1/comunicacion-48","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"Sistema de sincronización específico"},"321":{"id":"/docs/red/v1/comunicacion-49","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación-y-estado","content":"La elección concreta entre RFC, datos y sincronización debe hacerse según la semántica del dato, no simplemente porque RFC sea el mecanismo más visible."},"322":{"id":"/docs/red/v1/comunicacion-50","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"Eco mantiene aquí la arquitectura heredada de TNet, pero la nomenclatura pública se ha adaptado:"},"323":{"id":"/docs/red/v1/comunicacion-51","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"TNet"},"324":{"id":"/docs/red/v1/comunicacion-52","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"Eco"},"325":{"id":"/docs/red/v1/comunicacion-53","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`TNObject`"},"326":{"id":"/docs/red/v1/comunicacion-54","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`Objeto`"},"327":{"id":"/docs/red/v1/comunicacion-55","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`TNBehaviour`"},"328":{"id":"/docs/red/v1/comunicacion-56","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`Componente`"},"329":{"id":"/docs/red/v1/comunicacion-57","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`TNPacket`"},"330":{"id":"/docs/red/v1/comunicacion-58","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`Paquete`"},"331":{"id":"/docs/red/v1/comunicacion-59","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`TNBuffer`"},"332":{"id":"/docs/red/v1/comunicacion-60","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`Buffer`"},"333":{"id":"/docs/red/v1/comunicacion-61","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`TNChannel`"},"334":{"id":"/docs/red/v1/comunicacion-62","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"`Canal`"},"335":{"id":"/docs/red/v1/comunicacion-63","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"RFC"},"336":{"id":"/docs/red/v1/comunicacion-64","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"RFC"},"337":{"id":"/docs/red/v1/comunicacion-65","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencia-a-tnet","content":"La documentación de TNet es útil para entender el diseño original y localizar conceptos equivalentes, pero la referencia normativa para Eco es el repositorio `Nervelink/eco`."},"338":{"id":"/docs/red/v1/comunicacion-66","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Código fuente de la implementación actual de Eco."},"339":{"id":"/docs/red/v1/comunicacion-67","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Repositorio upstream del que procede la base de Eco."},"340":{"id":"/docs/red/v1/comunicacion-68","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Documentación generada del repositorio actual de TNet para contrastar arquitectura y evolución upstream."},"341":{"id":"/docs/red/v1/conceptos","page_id":"/docs/red/v1/conceptos","type":"page","content":"Conceptos fundamentales","breadcrumbs":["Docs","Red","Red","Conceptos"],"tags":[],"url":"/docs/red/v1/conceptos"},"342":{"id":"/docs/red/v1/conceptos-0","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos","content":"Las piezas que forman el modelo de red de Eco y cómo se relacionan entre sí."},"343":{"id":"/docs/red/v1/conceptos-1","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Conceptos fundamentales"},"344":{"id":"/docs/red/v1/conceptos-2","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#conexión","content":"Conexión"},"345":{"id":"/docs/red/v1/conceptos-3","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#jugador","content":"Jugador"},"346":{"id":"/docs/red/v1/conceptos-4","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#canal","content":"Canal"},"347":{"id":"/docs/red/v1/conceptos-5","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#objeto","content":"Objeto"},"348":{"id":"/docs/red/v1/conceptos-6","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#componente","content":"Componente"},"349":{"id":"/docs/red/v1/conceptos-7","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#propietario","content":"Propietario"},"350":{"id":"/docs/red/v1/conceptos-8","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#paquete","content":"Paquete"},"351":{"id":"/docs/red/v1/conceptos-9","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#buffer","content":"Buffer"},"352":{"id":"/docs/red/v1/conceptos-10","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#estado","content":"Estado"},"353":{"id":"/docs/red/v1/conceptos-11","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#relación-entre-conceptos","content":"Relación entre conceptos"},"354":{"id":"/docs/red/v1/conceptos-12","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"Correspondencia con TNet"},"355":{"id":"/docs/red/v1/conceptos-13","page_id":"/docs/red/v1/conceptos","type":"heading","tags":[],"url":"/docs/red/v1/conceptos#referencias-upstream","content":"Referencias upstream"},"356":{"id":"/docs/red/v1/conceptos-14","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Antes de trabajar con Eco conviene entender unas pocas piezas que aparecen constantemente en su API. Eco hereda el modelo conceptual de TNet, pero la documentación utiliza siempre los nombres de Eco."},"357":{"id":"/docs/red/v1/conceptos-15","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conceptos-fundamentales","content":"Una conexión representa la comunicación con el servidor; un jugador representa a quién pertenece esa conexión; un canal define un ámbito de estado compartido; un objeto representa una entidad de red; y sus componentes implementan el comportamiento."},"358":{"id":"/docs/red/v1/conceptos-16","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conexión","content":"La conexión representa el vínculo de transporte entre una instancia del juego y el servidor. Es responsable de llevar y recibir los datos, pero no define por sí sola qué objetos o estado debe conocer el cliente."},"359":{"id":"/docs/red/v1/conceptos-17","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#conexión","content":"Por eso una conexión no debe confundirse con un canal. La misma conexión puede participar en diferentes canales según el estado de la sesión."},"360":{"id":"/docs/red/v1/conceptos-18","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#jugador","content":"Un `Jugador` representa a un participante de la sesión dentro de la infraestructura de red. El jugador está asociado a una conexión y sirve para identificar al participante cuando Eco necesita expresar propiedad, destinatarios o presencia dentro de un canal."},"361":{"id":"/docs/red/v1/conceptos-19","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#jugador","content":"El jugador no es necesariamente la entidad jugable que existe en el mundo del juego. Esa entidad puede estar representada por un `Objeto` independiente."},"362":{"id":"/docs/red/v1/conceptos-20","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#canal","content":"Un `Canal` define un ámbito de estado compartido. Los jugadores pueden entrar y salir de canales y el servidor utiliza el canal como contexto para gestionar objetos, mensajes y persistencia."},"363":{"id":"/docs/red/v1/conceptos-21","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#canal","content":"La participación en varios canales es una capacidad importante de Eco. No debe modelarse como si el cliente sólo pudiera tener un canal activo."},"364":{"id":"/docs/red/v1/conceptos-22","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"Un `Objeto` es una identidad de red que Eco puede registrar, localizar, sincronizar y destruir."},"365":{"id":"/docs/red/v1/conceptos-23","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"Un objeto puede entenderse como la unidad sobre la que se construye el estado de una entidad dentro de la red:"},"366":{"id":"/docs/red/v1/conceptos-24","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#objeto","content":"El objeto no representa por sí mismo toda la lógica de gameplay. Su función es proporcionar la identidad y el contexto de red sobre el que trabajan sus componentes."},"367":{"id":"/docs/red/v1/conceptos-25","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#componente","content":"Un `Componente` contiene comportamiento de red asociado a un `Objeto`. Es el equivalente conceptual del componente de comportamiento de TNet y permite separar la identidad de red de la funcionalidad concreta."},"368":{"id":"/docs/red/v1/conceptos-26","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#componente","content":"Esta separación es especialmente útil cuando una misma entidad necesita varias responsabilidades de red: sincronización, llamadas remotas, lógica de propiedad, etc."},"369":{"id":"/docs/red/v1/conceptos-27","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"Eco mantiene información de propiedad sobre los objetos de red. El propietario identifica al participante que tiene autoridad sobre determinadas operaciones del objeto."},"370":{"id":"/docs/red/v1/conceptos-28","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"La propiedad no equivale necesariamente a que el objeto sólo exista para ese jugador. El objeto puede ser visible para otros participantes mientras uno de ellos mantiene su autoridad."},"371":{"id":"/docs/red/v1/conceptos-29","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#propietario","content":"La semántica exacta de `isMine`, propietarios y transferencia de propiedad se documentará en la sección específica de objetos."},"372":{"id":"/docs/red/v1/conceptos-30","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"Un `Paquete` representa una unidad de datos del protocolo de Eco. Los paquetes transportan comandos, eventos y datos entre clientes y servidor."},"373":{"id":"/docs/red/v1/conceptos-31","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"Conceptualmente:"},"374":{"id":"/docs/red/v1/conceptos-32","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#paquete","content":"El paquete pertenece a la capa de protocolo. No es equivalente a un evento de gameplay: un evento de juego puede terminar representándose mediante uno o varios tipos de mensaje de red."},"375":{"id":"/docs/red/v1/conceptos-33","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#buffer","content":"Un `Buffer` proporciona las operaciones de lectura y escritura utilizadas para serializar los datos que Eco intercambia."},"376":{"id":"/docs/red/v1/conceptos-34","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#buffer","content":"El buffer es deliberadamente una capa inferior a los objetos y componentes. Normalmente una característica de gameplay no debería manipularlo directamente salvo que esté implementando serialización o un protocolo específico."},"377":{"id":"/docs/red/v1/conceptos-35","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#estado","content":"Eco diferencia conceptualmente entre enviar una acción y mantener un estado de red. Una llamada remota puede comunicar que algo ocurrió, mientras que la sincronización de estado permite que un cliente conozca el valor actual de una propiedad o conjunto de datos."},"378":{"id":"/docs/red/v1/conceptos-36","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#estado","content":"Esta distinción será importante al documentar `RFC`, sincronización automática, sincronización personalizada y los mecanismos basados en datos."},"379":{"id":"/docs/red/v1/conceptos-37","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#relación-entre-conceptos","content":"La idea clave es que estas piezas no son alternativas entre sí. Forman capas distintas del modelo de red."},"380":{"id":"/docs/red/v1/conceptos-38","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"Concepto Eco"},"381":{"id":"/docs/red/v1/conceptos-39","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"TNet histórico"},"382":{"id":"/docs/red/v1/conceptos-40","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"Función"},"383":{"id":"/docs/red/v1/conceptos-41","page_id":"/docs/red/v1/conceptos","tags":[],"type":"text","url":"/docs/red/v1/conceptos#correspondencia-con-tnet","content":"`Eco