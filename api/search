o de datos asociado al antiguo `TNObject`."},"562":{"id":"/docs/red/v1/comunicacion/sincronizacion-43","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#relación-con-tnet","content":"La fuente de verdad para Eco sigue siendo `Nervelink/eco`."},"563":{"id":"/docs/red/v1/comunicacion/sincronizacion-44","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Código fuente de la implementación actual."},"564":{"id":"/docs/red/v1/comunicacion/sincronizacion-45","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Repositorio upstream."},"565":{"id":"/docs/red/v1/comunicacion/sincronizacion-46","page_id":"/docs/red/v1/comunicacion/sincronizacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/sincronizacion#referencias","content":"Referencia generada sobre el TNet actual."},"566":{"id":"/docs/red/v1/modelo/canales","page_id":"/docs/red/v1/modelo/canales","type":"page","content":"Canales","breadcrumbs":["Docs","Red","Red","Contenido","Modelo de red"],"tags":[],"url":"/docs/red/v1/modelo/canales"},"567":{"id":"/docs/red/v1/modelo/canales-0","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales","content":"Ámbitos de estado compartido en Eco y gestión de la pertenencia de los jugadores."},"568":{"id":"/docs/red/v1/modelo/canales-1","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#canales","content":"Canales"},"569":{"id":"/docs/red/v1/modelo/canales-2","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#modelo","content":"Modelo"},"570":{"id":"/docs/red/v1/modelo/canales-3","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#estado-de-un-canal","content":"Estado de un canal"},"571":{"id":"/docs/red/v1/modelo/canales-4","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"Unirse a un canal"},"572":{"id":"/docs/red/v1/modelo/canales-5","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"Múltiples canales simultáneos"},"573":{"id":"/docs/red/v1/modelo/canales-6","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#consultar-y-abandonar","content":"Consultar y abandonar"},"574":{"id":"/docs/red/v1/modelo/canales-7","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"Persistencia y propiedad"},"575":{"id":"/docs/red/v1/modelo/canales-8","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#nivel-y-host","content":"Nivel y host"},"576":{"id":"/docs/red/v1/modelo/canales-9","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"Correspondencia con TNet"},"577":{"id":"/docs/red/v1/modelo/canales-10","page_id":"/docs/red/v1/modelo/canales","type":"heading","tags":[],"url":"/docs/red/v1/modelo/canales#referencias","content":"Referencias"},"578":{"id":"/docs/red/v1/modelo/canales-11","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Un `Canal` define un ámbito de estado compartido dentro del servidor de Eco. Los jugadores que forman parte de un canal pueden recibir la información que ese canal distribuye, incluyendo mensajes y estado asociado a sus objetos."},"579":{"id":"/docs/red/v1/modelo/canales-12","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#canales","content":"Una conexión no está limitada a un único canal. Eco mantiene una colección de canales activos por cliente, por lo que un mismo jugador puede participar simultáneamente en varios ámbitos de red."},"580":{"id":"/docs/red/v1/modelo/canales-13","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#modelo","content":"El mismo jugador puede aparecer en varios canales. En el cliente, esta pertenencia se representa mediante una colección interna de `Canal` mantenida por `ClienteJuego`. La API expone esa colección mediante `channels`."},"581":{"id":"/docs/red/v1/modelo/canales-14","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#estado-de-un-canal","content":"`Canal` mantiene información suficiente para representar tanto su configuración como su estado de red. Entre sus propiedades se encuentran `id`, `password`, `level`, `isPersistent`, `isClosed`, `isLeaving`, `playerLimit`, `jugadores`, `rfcs`, `created`, `destroyed` y `host`."},"582":{"id":"/docs/red/v1/modelo/canales-15","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"El cliente utiliza `ClienteJuego.JoinChannel` para solicitar la entrada en un canal. La solicitud incluye identificador, contraseña, nivel, persistencia y límite de jugadores."},"583":{"id":"/docs/red/v1/modelo/canales-16","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#unirse-a-un-canal","content":"Durante el proceso de unión, Eco registra el canal como pendiente hasta recibir la respuesta del servidor."},"584":{"id":"/docs/red/v1/modelo/canales-17","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"La pertenencia a canales es acumulativa. Un cliente puede participar simultáneamente en varios canales:"},"585":{"id":"/docs/red/v1/modelo/canales-18","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"`IsInChannel(id)` comprueba la pertenencia y `GetChannel(id)` obtiene la instancia local."},"586":{"id":"/docs/red/v1/modelo/canales-19","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#múltiples-canales-simultáneos","content":"Dos canales distintos no implican dos conexiones de socket distintas. La conexión y el transporte pertenecen a una capa inferior; el canal delimita el estado y los destinatarios."},"587":{"id":"/docs/red/v1/modelo/canales-20","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#consultar-y-abandonar","content":"Salir de un canal no implica desconectarse del servidor."},"588":{"id":"/docs/red/v1/modelo/canales-21","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"Un canal puede ser persistente. Cuando el último jugador abandona, Eco puede destruir objetos no persistentes, transferir la propiedad de otros objetos o cerrar y reiniciar el canal según su configuración."},"589":{"id":"/docs/red/v1/modelo/canales-22","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#persistencia-y-propiedad","content":"También mantiene objetos dinámicos y RFC asociadas para poder reconstruir el estado cuando corresponde."},"590":{"id":"/docs/red/v1/modelo/canales-23","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#nivel-y-host","content":"Cada canal puede tener un `level` y un `host`. El cambio de nivel se coordina a través del sistema de red y el host puede cambiar cuando abandona el canal."},"591":{"id":"/docs/red/v1/modelo/canales-24","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"TNet"},"592":{"id":"/docs/red/v1/modelo/canales-25","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"Eco"},"593":{"id":"/docs/red/v1/modelo/canales-26","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNChannel` / `Channel`"},"594":{"id":"/docs/red/v1/modelo/canales-27","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`Canal`"},"595":{"id":"/docs/red/v1/modelo/canales-28","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.JoinChannel`"},"596":{"id":"/docs/red/v1/modelo/canales-29","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.JoinChannel`"},"597":{"id":"/docs/red/v1/modelo/canales-30","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.LeaveChannel`"},"598":{"id":"/docs/red/v1/modelo/canales-31","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.LeaveChannel`"},"599":{"id":"/docs/red/v1/modelo/canales-32","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`TNManager.IsInChannel`"},"600":{"id":"/docs/red/v1/modelo/canales-33","page_id":"/docs/red/v1/modelo/canales","tags":[],"type":"text","url":"/docs/red/v1/modelo/canales#correspondencia-con-tnet","content":"`ClienteJuego.IsInChannel`"},"601":{"id":"/docs/red/v1/modelo/canales-34","page_id":"/docs/red/v1/modelo/canales","tags":[]