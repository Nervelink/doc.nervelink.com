inaria. La nomenclatura de Eco utiliza `Nodo` y `Serializacion`."},"1068":{"id":"/docs/red/v1/transporte/serializacion-34","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Código de `Nodo`, `Buffer` y serialización."},"1069":{"id":"/docs/red/v1/transporte/serializacion-35","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Repositorio upstream de la implementación heredada."},"1070":{"id":"/docs/red/v1/transporte/serializacion-36","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Referencia externa para contrastar el sistema de serialización de TNet."},"1071":{"id":"/docs/red/v1/transporte/tcp-udp","page_id":"/docs/red/v1/transporte/tcp-udp","type":"page","content":"TCP y UDP","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/tcp-udp"},"1072":{"id":"/docs/red/v1/transporte/tcp-udp-0","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp","content":"Cómo Eco combina transporte fiable y transporte de baja latencia."},"1073":{"id":"/docs/red/v1/transporte/tcp-udp-1","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"TCP y UDP"},"1074":{"id":"/docs/red/v1/transporte/tcp-udp-2","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP"},"1075":{"id":"/docs/red/v1/transporte/tcp-udp-3","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#udp","content":"UDP"},"1076":{"id":"/docs/red/v1/transporte/tcp-udp-4","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/