ias/diagnosticar-conexion-23","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Estados y propiedades del cliente de Eco."},"2441":{"id":"/docs/red/v1/guias/diagnosticar-conexion-24","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Paquetes, buffers, serialización y protocolos."},"2442":{"id":"/docs/red/v1/guias/diagnosticar-conexion-25","page_id":"/docs/red/v1/guias/diagnosticar-conexion","tags":[],"type":"text","url":"/docs/red/v1/guias/diagnosticar-conexion#referencias","content":"Restricciones conocidas de la integración."},"2443":{"id":"/docs/red/v1/guias/enviar-accion","page_id":"/docs/red/v1/guias/enviar-accion","type":"page","content":"Enviar una acción","breadcrumbs":["Docs","Red","Red","Contenido","Guías"],"tags":[],"url":"/docs/red/v1/guias/enviar-accion"},"2444":{"id":"/docs/red/v1/guias/enviar-accion-0","page_id":"/docs/red/v1/guias/enviar-accion","tags":[],"type":"text","url":"/docs/red/v1/guias/enviar-accion","content":"Ejecuta una acción remotamente mediante RFC y elige correctamente sus destinatarios."},"2445":{"id":"/docs/red/v1/guias/enviar-accion-1","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#enviar-una-acción","content":"Enviar una acción"},"2446":{"id":"/docs/red/v1/guias/enviar-accion-2","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#1-crear-el-comportamiento-remoto","content":"Crear el comportamiento remoto"},"2447":{"id":"/docs/red/v1/guias/enviar-accion-3","page_id":"/docs/red/v1/guias/enviar-accion","type":"heading","tags":[],"url":"/docs/red/v1/guias/enviar-accion#2-enviar-la-acción","content":"Enviar la acción"},"2448":{"id":"/docs/red/v1/guias/enviar-accion-4","page_id":"/docs/red/v1/guias/enviar-accion","type"