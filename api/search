uentes-41","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#eco-es-una-implementación-nueva-de-networking","content":"No. Eco parte de TNet 3 y conserva gran parte de su arquitectura y comportamiento, pero utiliza la nomenclatura y organización de Nervelink y puede incorporar cambios propios."},"367":{"id":"/docs/red/v1/preguntas-frecuentes-42","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#eco-es-simplemente-un-renombrado-de-tnet","content":"No conviene tratarlo como un reemplazo mecánico de nombres. Aunque existen equivalencias directas como `TNManager` → `Eco`, `TNObject` → `Objeto` y `TNBehaviour` → `Componente`, la documentación debe seguir la implementación de Eco."},"368":{"id":"/docs/red/v1/preguntas-frecuentes-43","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-repositorio-debo-consultar","content":"Para usar Eco, consulta primero:"},"369":{"id":"/docs/red/v1/preguntas-frecuentes-44","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-repositorio-debo-consultar","content":"Implementación actual de Nervelink."},"370":{"id":"/docs/red/v1/preguntas-frecuentes-45","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-repositorio-debo-consultar","content":"Para comparar el origen de una característica:"},"371":{"id":"/docs/red/v1/preguntas-frecuentes-46","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-repositorio-debo-consultar","content":"Repositorio upstream."},"372":{"id":"/docs/red/v1/preguntas-frecuentes-47","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-repositorio-debo-consultar","content":"Referencia de arquitectura y navegación sobre el repositorio upstream."},"373":{"id":"/docs/red/v1/preguntas-frecuentes-48","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#un-cliente-sólo-puede-estar-en-un-canal","content":"No. Una conexión puede pertenecer simultáneamente a varios `Canal`. La pertenencia a canales es una capa lógica sobre la conexión de red."},"374":{"id":"/docs/red/v1/preguntas-frecuentes-49","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#un-cliente-sólo-puede-estar-en-un-canal","content":"Consulta Canales para conocer cómo se gestionan entradas, salidas y estados múltiples."},"375":{"id":"/docs/red/v1/preguntas-frecuentes-50","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"No."},"376":{"id":"/docs/red/v1/preguntas-frecuentes-51","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Concepto"},"377":{"id":"/docs/red/v1/preguntas-frecuentes-52","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Función"},"378":{"id":"/docs/red/v1/preguntas-frecuentes-53","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Conexión"},"379":{"id":"/docs/red/v1/preguntas-frecuentes-54","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Comunicación con el servidor."},"380":{"id":"/docs/red/v1/preguntas-frecuentes-55","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Canal"},"381":{"id":"/docs/red/v1/preguntas-frecuentes-56","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Ámbito de estado y participantes."},"382":{"id":"/docs/red/v1/preguntas-frecuentes-57","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Objeto"},"383":{"id":"/docs/red/v1/preguntas-frecuentes-58","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Identidad de una entidad de red."},"384":{"id":"/docs/red/v1/preguntas-frecuentes-59","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Jugador"},"385":{"id":"/docs/red/v1/preguntas-frecuentes-60","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#canal-y-conexión-son-lo-mismo","content":"Participante de la sesión."},"386":{"id":"/docs/red/v1/preguntas-frecuentes-61","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#entrar-en-un-canal-significa-que-ya-puedo-enviar-inmediatamente","content":"No necesariamente. Durante la unión existen estados transitorios. Debes esperar a que el canal haya quedado registrado en la sesión y a que el objeto pueda enviar. `Objeto.PuedeEnviar` existe precisamente para comprobar esta condición en operaciones asociadas a objetos."},"387":{"id":"/docs/red/v1/preguntas-frecuentes-62","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#puedo-abandonar-un-canal-sin-desconectarme","content":"Sí. Salir de un `Canal` no termina la conexión con el servidor. La misma conexión puede continuar participando en otros canales."},"388":{"id":"/docs/red/v1/preguntas-frecuentes-63","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-diferencia-hay-entre-objeto-y-componente","content":"`Objeto` proporciona la identidad de red, propiedad, canal, datos y ciclo de vida. `Componente` aporta comportamiento asociado a ese objeto."},"389":{"id":"/docs/red/v1/preguntas-frecuentes-64","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-diferencia-hay-entre-id-y-uid","content":"`id` identifica el objeto dentro de su contexto de canal. `uid` combina la identidad del objeto con el canal para permitir una identificación global del objeto de red."},"390":{"id":"/docs/red/v1/preguntas-frecuentes-65","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#puedo-cambiar-el-propietario-de-cualquier-objeto","content":"No. Los objetos estáticos tienen restricciones distintas de los objetos dinámicos. En Eco, el cambio de propietario se valida además contra la pertenencia del jugador destino al canal del objeto."},"391":{"id":"/docs/red/v1/preguntas-frecuentes-66","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-significa-ismine","content":"Indica si el propietario del objeto es el jugador local. No significa que el objeto sea visible únicamente para ese jugador."},"392":{"id":"/docs/red/v1/preguntas-frecuentes-67","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#rfc-o-sincronización","content":"Usa RFC para acciones o eventos puntuales y sincronización para mantener propiedades o estado."},"393":{"id":"/docs/red/v1/preguntas-frecuentes-68","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#rfc-o-sincronización","content":"Consulta Comunicación y Sincronización."},"394":{"id":"/docs/red/v1/preguntas-frecuentes-69","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-ocurre-cuando-llamo-a-objetoset-y-todavía-no-puede-enviar","content":"El valor se aplica localmente y el cambio puede quedar pendiente para transmitirse cuando el objeto vuelva a estar en condiciones de enviar. Esto es importante durante uniones, transiciones de canal y otros estados temporales."},"395":{"id":"/docs/red/v1/preguntas-frecuentes-70","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#debo-usar-autosincronizar-para-todo","content":"No. Es una herramienta de conveniencia para casos sencillos y prototipos. Los sistemas críticos suelen beneficiarse de un estado explícito, autoridad clara y una frecuencia de actualización diseñada para cada dato."},"396":{"id":"/docs/red/v1/preguntas-frecuentes-71","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#la-sincronización-siempre-pasa-por-el-propietario","content":"La implementación de `Objeto.Set` está diseñada para que las solicitudes de cambio pasen por el propietario cuando el emisor no es el propietario local. Esto ayuda a mantener una fuente de autoridad única para el estado del objeto."},"397":{"id":"/docs/red/v1/preguntas-frecuentes-72","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#tcp-y-udp-se-pueden-utilizar-indistintamente","content":"No. TCP ofrece entrega fiable y ordenada. UDP está pensado para tráfico donde la pérdida o el procesamiento de valores intermedios puede ser aceptable."},"398":{"id":"/docs/red/v1/preguntas-frecuentes-73","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#usar-udp-hace-automáticamente-una-operación-más-rápida","content":"No. El transporte afecta a latencia, fiabilidad y coste, pero la semántica de la operación sigue siendo responsabilidad del diseño de comunicación."},"399":{"id":"/docs/red/v1/preguntas-frecuentes-74","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-es-un-buffer","content":"Es el contenedor binario que Eco utiliza para escribir y leer datos que forman parte de los mensajes de red. Se encuentra por debajo del nivel de gameplay y del protocolo."},"400":{"id":"/docs/red/v1/preguntas-frecuentes-75","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#puedo-ejecutar-cliente-y-servidor-dentro-de-la-misma-instancia-de-unity","content":"Sí. Eco dispone de un modo de servidor local que conecta `ClienteJuego` y `ServidorJuego` dentro del mismo proceso. Es útil para pruebas, pero no sustituye a una prueba de red real entre procesos o máquinas."},"401":{"id":"/docs/red/v1/preguntas-frecuentes-76","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#el-servidor-siempre-es-multihilo","content":"La implementación está preparada para ejecución multihilo y puede compilarse con `SINGLE_THREADED` cuando se necesita ejecutar el procesamiento sin el hilo de red dedicado."},"402":{"id":"/docs/red/v1/preguntas-frecuentes-77","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-persiste-realmente-el-servidor","content":"Depende del mecanismo utilizado. Eco distingue entre datos del servidor, estado de canal, datos de jugadores, objetos persistentes y RFC guardadas. No todo dato que existe durante una sesión se convierte automáticamente en una partida persistida."},"403":{"id":"/docs/red/v1/preguntas-frecuentes-78","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#dónde-miro-cuando-un-mensaje-no-llega","content":"Sigue la cadena de abajo hacia arriba:"},"404":{"id":"/docs/red/v1/preguntas-frecuentes-79","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#comprueba-la-operación","content":"Confirma que el juego realmente está llamando al método esperado."},"405":{"id":"/docs/red/v1/preguntas-frecuentes-80","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#comprueba-el-objeto-y-el-canal","content":"Verifica `id`, `channelID`, `hasBeenRegistered` y `PuedeEnviar` cuando la operación depende de un `Objeto`."},"406":{"id":"/docs/red/v1/preguntas-frecuentes-81","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#comprueba-el-protocolo","content":"Determina qué `Paquete` está representando la operación."},"407":{"id":"/docs/red/v1/preguntas-frecuentes-82","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#comprueba-transporte-y-servidor","content":"Revisa TCP/UDP, recepción del servidor y el procesamiento del paquete."},"408":{"id":"/docs/red/v1/preguntas-frecuentes-83","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#qué-hago-si-una-api-de-tnet-no-existe-en-eco","content":"No la sustituyas automáticamente por una función con el mismo nombre aproximado. Busca primero la equivalencia en Equivalencias Eco ↔ TNet y después confirma la implementación actual en el repositorio de Eco."},"409":{"id":"/docs/red/v1/preguntas-frecuentes-84","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#dónde-está-el-código-principal-de-eco","content":"La red comienza principalmente en:"},"410":{"id":"/docs/red/v1/preguntas-frecuentes-85","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#dónde-está-el-código-principal-de-eco","content":"La estructura se divide en cliente, común, servidor y componentes relacionados con protocolo, transporte y serialización."},"411":{"id":"/docs/red/v1/preguntas-frecuentes-86","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#por-dónde-debería-empezar-a-estudiar-eco","content":"La ruta recomendada es:"},"412":{"id":"/docs/red/v1/preguntas-frecuentes-87","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#por-dónde-debería-empezar-a-estudiar-eco","content":"Recorrido inicial y modelo mental de Eco."},"413":{"id":"/docs/red/v1/preguntas-frecuentes-88","page_id":"/docs/red/v1/preguntas-frecuentes","tags":[],"type":"text","url":"/docs/red/v1/preguntas-frecuentes#por-dónde-debería-empezar-a-estudiar-eco","content":"Workflows prácticos para integrar la red en un proyecto."},"414":{"id":"/docs/red/v1/requisitos","page_id":"/docs/red/v1/requisitos","type":"page","content":"Requisitos y limitaciones","breadcrumbs":["Docs","Red","Red","Introducción"],"tags":[],"url":"/docs/red/v1/requisitos"},"415":{"id":"/docs/red/v1/requisitos-0","page_id":"/docs/red/v1/requisitos","tags":[],"type":"text","url":"/docs/red/v1/requisitos","content":"Compatibilidad, dependencias, restricciones y condiciones que afectan a una integración de Eco."},"416":{"id":"/docs/red/v1/requisitos-1","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#requisitos-y-limitaciones","content":"Requisitos y limitaciones"},"417":{"id":"/docs/red/v1/requisitos-2","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#matriz-de-integración","content":"Matriz de integración"},"418":{"id":"/docs/red/v1/requisitos-3","page_id":"/docs/red/v1/requisitos","type":"heading","tags":[],"url":"/docs/red/v1/requisitos#componentes-del-entorno","content":"Componentes del entorno"},"419":{"id"