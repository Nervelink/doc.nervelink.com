v1/comunicacion/destinatarios-16","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivo conceptual"},"297":{"id":"/docs/red/v1/comunicacion/destinatarios-17","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Uso"},"298":{"id":"/docs/red/v1/comunicacion/destinatarios-18","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Todos`"},"299":{"id":"/docs/red/v1/comunicacion/destinatarios-19","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos los jugadores del canal."},"300":{"id":"/docs/red/v1/comunicacion/destinatarios-20","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Otros`"},"301":{"id":"/docs/red/v1/comunicacion/destinatarios-21","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos salvo el emisor."},"302":{"id":"/docs/red/v1/comunicacion/destinatarios-22","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Propietario"},"303":{"id":"/docs/red/v1/comunicacion/destinatarios-23","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"El jugador que posee el objeto."},"304":{"id":"/docs/red/v1/comunicacion/destinatarios-24","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Persistente"},"305":{"id":"/docs/red/v1/comunicacion/destinatarios-25","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"También debe estar disponible para participantes posteriores."},"306":{"id":"/docs/red/v1/comunicacion/destinatarios-26","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Jugador concreto"},"307":{"id":"/docs/red/v1/comunicacion/destinatarios-27","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Un único participante identificado."},"308":{"id":"/docs/red/v1/comunicacion/destinatarios-28","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Los nombres exactos disponibles dependen de la API de `Objetivo` y del método utilizado para enviar el mensaje."},"309":{"id":"/docs/red/v1/comunicacion/destinatarios-29","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"La propiedad y la visibilidad son conceptos diferentes:"},"310":{"id":"/docs/red/v1/comunicacion/destinatarios-30","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Que un objeto tenga propietario no significa que únicamente ese jugador pueda recibir sus actualizaciones."},"311":{"id":"/docs/red/v1/comunicacion/destinatarios-31","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Un mensaje marcado para persistir puede formar parte del estado que Eco mantiene asociado al canal u objeto. Esto resulta útil cuando el contenido debe estar disponible también para jugadores que todavía no estaban conectados cuando ocurrió la comunicación."},"312":{"id":"/docs/red/v1/comunicacion/destinatarios-32","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"No debe utilizarse persistencia sólo porque un mensaje se considere importante: debe existir una necesidad real de reconstruir ese estado posteriormente."},"313":{"id":"/docs/red/v1/comunicacion/destinatarios-33","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#listas-de-jugadores","content":"La arquitectura de TNet/Eco también contempla el envío a una lista concreta de jugadores, no sólo a un único ID. Esta opción es especialmente útil para grupos seleccionados que no coinciden con todos los miembros del canal."},"314":{"id":"/docs/red/v1/comunicacion/destinatarios-34","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#echo-y-llamadas-reenviadas","content":"El protocolo distingue comunicaciones como `ForwardToAll`, `ForwardToOthers` y sus variantes persistentes. Estas operaciones permiten que el servidor reenvíe el contenido sin que el cliente tenga que construir manualmente un paquete distinto para cada receptor."},"315":{"id":"/docs/red/v1/comunicacion/destinatarios-35","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"Hay que separar dos preguntas:"},"316":{"id":"/docs/red/v1/comunicacion/destinatarios-36","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"La primera es una decisión de destinatario. La segunda es una decisión de persistencia. Pueden combinarse, pero no son el mismo concepto."},"317":{"id":"/docs/red/v1/comunicacion/destinatarios-37","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Eco conserva el modelo de objetivos de TNet, pero utiliza la nomenclatura propia del proyecto. Las equivalencias deben comprobarse siempre contra la implementación actual de `Eco`, `Objeto` y `Paquete`."},"318":{"id":"/docs/red/v1/comunicacion/destinatarios-38","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Cómo construir llamadas remotas y decidir su comportamiento."},"319":{"id":"/docs/red/v1/comunicacion/destinatarios-39","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Aplicación práctica del alcance por canal."},"320":{"id":"/docs/red/v1/comunicacion/destinatarios-40","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Repositorio upstream."},"321":{"id":"/docs/red/v1/comunicacion","page_id":"/docs/red/v1/comunicacion","type":"page","content":"Comunicación","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion"},"322":{"id":"/docs/red/v1/comunicacion-0","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion","content":"Cómo Eco decide qué comunicar, a quién, con qué mecanismo y cómo conservar el estado."},"323":{"id":"/docs/red/v1/comunicacion-1","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación","content":"Comunicación"},"324":{"id":"/docs/red/v1/comunicacion-2","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#árbol-de-decisión","content":"Árbol de decisión"},"325":{"id":"/docs/red/v1/comunicacion-3","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#flujo-de-una-rfc","content":"Flujo de una RFC"},"326":{"id":"/docs/red/v1/comunicacion-4","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#definir-la-operación-step","content":"Definir la operación"},"327":{"id":"/docs/red/v1/comunicacion-5","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#elegir-el-alcance-step","content":"Elegir el alcance"},"328":{"id":"/docs/red/v1/comunicacion-6","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#serializar-los-parámetros-step","content":"Serializar los parámetros"},"329":{"id":"/docs/red/v1/comunicacion-7","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#procesar-en-destino-step","content":"Procesar en destino"},"330":{"id":"/docs/red/v1/comunicacion-8","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#estado-frente-a-eventos","content":"Estado frente a eventos"},"331":{"id":"/docs/red/v1/comunicacion-9","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#autoridad","content":"Autoridad"},"332":{"id":"/docs/red/v1/comunicacion-10","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#referencias","content":"Referencias"},"333":{"id":"/docs/red/v1/comunicacion-11","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"La comunicación de Eco se divide en dos problemas: **ejecutar algo** y **mantener algo sincronizado**. Las RFC resuelven principalmente el primero; `Set`, `Nodo` y los sistemas de sincronización resuelven el segundo."},"334":{"id":"/docs/red/v1/comunicacion-12","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"No empieces por `Send`. Empieza por definir si estás enviando una acción, un estado, una respuesta o información que debe persistir para futuros participantes."},"335":{"id":"/docs/red/v1/comunicacion-13","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Ejecutar acciones o notificaciones remotas."},"336":{"id":"/docs/red/v1/comunicacion-14","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Mantener propiedades y datos de una entidad coherentes entre participantes."},"337":{"id":"/docs/red/v1/comunicacion-15","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Determinar quién debe recibir una operación."},"338":{"id":"/docs/red/v1/comunicacion-16","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"RFC persistentes, coordinación y patrones heredados de TNet que Eco mantiene."},"339":{"id":"/docs/red/v1/comunicacion-17","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#definir-la-operación-step","content":"Declara la función remota en un `Componente` asociado a un `Objeto`."},"340":{"id":"/docs/red/v1/comunicacion-18","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#elegir-el-alcance-step","content":"Determina si deben recibirla todos, otros jugadores, un jugador concreto o un conjunto determinado."},"341":{"id":"/docs/red/v1/comunicacion-19","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#serializar-los-parámetros-step","content":"Eco transforma los parámetros en datos transportables sin que el gameplay necesite construir directamente el `Buffer`."},"342":{"id":"/docs/red/v1/comunicacion-20","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#procesar-en-destino-step","content":"El receptor resuelve el objeto, localiza la RFC y ejecuta la función correspondiente."},"343":{"id":"/docs/red/v1/comunicacion-21","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-eventos","content":"Usa RFC para hechos puntuales: disparar un arma, abrir una puerta, reproducir una animación o solicitar una acción."},"344":{"id":"/docs/red/v1/comunicacion-22","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-eventos","content":"Usa sincronización para valores que deben poder consultarse en cualquier momento: vida, inventario, configuración o estado de una entidad."},"345":{"id":"/docs/red/v1/comunicacion-23","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"La comunicación no elimina la autoridad. Un cliente puede solicitar una operación, pero el servidor y el propietario del objeto siguen siendo parte del diseño de seguridad y consistencia."},"346":{"id":"/docs/red/v1/comunicacion-24","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"La validación importante debe permanecer en el lado que controla la autoridad real. Una RFC recibida correctamente no significa que la acción sea válida desde las reglas del juego."},"347":{"id":"/docs/red/v1/comunicacion-25","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Sintaxis y ciclo de una llamada remota."},"348":{"id":"/docs/red/v1/comunicacion-26","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Estado, `Set`, `Get` y colas de sincronización."},"349":{"id":"/docs/red/v1/comunicacion-27","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Objetivos de una comunicación."},"350":{"id":"/docs/red/v1/comunicacion-28","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Workflow práctico para una RFC."},"351":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"page","content":"RFC avanzadas","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas"},"352":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-0","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas","content":"RFC, llamadas persistentes, respuesta y patrones de comunicación de Eco."},"353":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-1","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-avanzadas","content":"RFC avanzadas"},"354":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-2","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-básica","content":"RFC básica"},"355":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-3","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#destinatarios","content":"Destinatarios"},"356":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-4","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"RFC persistente"},"357":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-5","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-sin-eco-al-cliente","content":"RFC sin eco al cliente"},"358":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-6","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#esperar-confirmación","content":"Esperar confirmación"},"359":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-7","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"RFC frente a sincronización"},"360":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-8","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#errores-habituales","content":"Errores habituales"},"361":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-9","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rfc-avanzadas#referencias","content":"Referencias"},"362":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-10","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-avanzadas","content":"Las RFC (Remote Function Calls) son el mecanismo principal de Eco para ejecutar una función en otro extremo de la sesión. Una RFC describe una acción o notificación; no debe utilizarse como sustituto de un estado que necesita mantenerse sincronizado."},"363":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-11","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-básica","content":"Una función marcada como RFC puede ser invocada a través del `Objeto` que contiene el componente:"},"364":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-12","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-básica","content":"La llamada transporta la identidad del objeto, el identificador o nombre de la RFC y sus parámetros."},"365":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-13","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#destinatarios","content":"Eco hereda el modelo de objetivos de TNet. Entre los casos habituales están:"},"366":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-14","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#destinatarios","content":"La selección del destino forma parte de la semántica de la llamada y debe hacerse explícitamente."},"367":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-15","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"Una RFC normal representa un evento puntual. Una RFC guardada representa una operación que además queda registrada en el estado del canal para que pueda reproducirse cuando corresponda."},"368":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-16","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"Esto es útil para:"},"369":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-17","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"construir objetos o estado inicial;"},"370":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-18","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"registrar una acción que nuevos jugadores necesitan reconstruir;"},"371":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-19","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"almacenar una operación en el orden en que debe restaurarse."},"372":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-20","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-persistente","content":"No conviene guardar indiscriminadamente todas las acciones: el historial persistente debe ser suficientemente pequeño y determinista."},"373":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-21","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-sin-eco-al-cliente","content":"TNet incluye un modo `NoneSaved` para almacenar una RFC en servidor sin reenviarla a los clientes actuales. Eco conserva la idea: permite guardar datos para futuros participantes sin convertirlos en un evento inmediato para todos."},"374":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-22","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#esperar-confirmación","content":"El flujo de red puede necesitar esperar a que llamadas previas hayan terminado antes de continuar con una operación dependiente. TNet documenta `WaitForBounceBack` para este escenario, y Eco debe tratar este patrón como una herramienta de coordinación, no como un bloqueo del hilo principal."},"375":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-23","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"Necesidad"},"376":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-24","page_id":"/docs/red/v1/comunicacion/rfc-avanzadas","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rfc-avanzadas#rfc-frente-a-sincronización","content":"Mecanismo"},"377":{"id":"/docs/red/v1/comunicacion/rfc-avanzadas-25","page_id":"/do