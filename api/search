ica, unión automática y el cliente de juego."},"74":{"id":"/docs/red/v1/arquitectura-46","page_id":"/docs/red/v1/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/arquitectura#referencias","content":"Código fuente de la implementación de Eco."},"75":{"id":"/docs/red/v1/arquitectura-47","page_id":"/docs/red/v1/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/arquitectura#referencias","content":"Repositorio original del que procede la base de Eco."},"76":{"id":"/docs/red/v1/arquitectura-48","page_id":"/docs/red/v1/arquitectura","tags":[],"type":"text","url":"/docs/red/v1/arquitectura#referencias","content":"Documentación generada sobre el repositorio actual de TNet, útil para contrastar arquitectura y evolución upstream."},"77":{"id":"/docs/red/v1/canales","page_id":"/docs/red/v1/canales","type":"page","content":"Canales","breadcrumbs":["Docs","Red","Red","Canales"],"tags":[],"url":"/docs/red/v1/canales"},"78":{"id":"/docs/red/v1/canales-0","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales","content":"Ámbitos de estado compartido en Eco y gestión de la pertenencia de los jugadores."},"79":{"id":"/docs/red/v1/canales-1","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#canales","content":"Canales"},"80":{"id":"/docs/red/v1/canales-2","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#modelo","content":"Modelo"},"81":{"id":"/docs/red/v1/canales-3","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#estado-de-un-canal","content":"Estado de un canal"},"82":{"id":"/docs/red/v1/canales-4","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#unirse-a-un-canal","content":"Unirse a un canal"},"83":{"id":"/docs/red/v1/canales-5","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#múltiples-canales-simultáneos","content":"Múltiples canales simultáneos"},"84":{"id":"/docs/red/v1/canales-6","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#consultar-canales","content":"Consultar canales"},"85":{"id":"/docs/red/v1/canales-7","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#salir-de-un-canal","content":"Salir de un canal"},"86":{"id":"/docs/red/v1/canales-8","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#persistencia","content":"Persistencia"},"87":{"id":"/docs/red/v1/canales-9","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#límite-de-jugadores","content":"Límite de jugadores"},"88":{"id":"/docs/red/v1/canales-10","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#cierre-y-eliminación","content":"Cierre y eliminación"},"89":{"id":"/docs/red/v1/canales-11","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#nivel-asociado-al-canal","content":"Nivel asociado al canal"},"90":{"id":"/docs/red/v1/canales-12","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#host-del-canal","content":"Host del canal"},"91":{"id":"/docs/red/v1/canales-13","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#objetos-dentro-del-canal","content":"Objetos dentro del canal"},"92":{"id":"/docs/red/v1/canales-14","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#propiedad-de-objetos-al-salir","content":"Propiedad de objetos al salir"},"93":{"id":"/docs/red/v1/canales-15","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#flujo-recomendado","content":"Flujo recomendado"},"94":{"id":"/docs/red/v1/canales-16","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"Correspondencia con TNet"},"95":{"id":"/docs/red/v1/canales-17","page_id":"/docs/red/v1/canales","type":"heading","tags":[],"url":"/docs/red/v1/canales#referencias-upstream","content":"Referencias upstream"},"96":{"id":"/docs/red/v1/canales-18","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#canales","content":"Un `Canal` define un ámbito de estado compartido dentro del servidor de Eco. Los jugadores que forman parte de un canal pueden recibir la información que ese canal distribuye, incluyendo mensajes y estado asociado a sus objetos."},"97":{"id":"/docs/red/v1/canales-19","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#canales","content":"Una conexión no está limitada a un único canal. Eco mantiene una colección de canales activos por cliente, por lo que un mismo jugador puede participar simultáneamente en varios ámbitos de red."},"98":{"id":"/docs/red/v1/canales-20","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#modelo","content":"El mismo jugador puede aparecer en varios canales. En el cliente, esta pertenencia se representa mediante una colección interna de `Canal` mantenida por `ClienteJuego`. La API expone esa colección mediante `channels`. citeeco-client-game"},"99":{"id":"/docs/red/v1/canales-21","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`Canal` mantiene información suficiente para representar tanto su configuración como su estado de red. Entre sus propiedades se encuentran:"},"100":{"id":"/docs/red/v1/canales-22","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Propiedad"},"101":{"id":"/docs/red/v1/canales-23","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Función"},"102":{"id":"/docs/red/v1/canales-24","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`id`"},"103":{"id":"/docs/red/v1/canales-25","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Identificador del canal."},"104":{"id":"/docs/red/v1/canales-26","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`password`"},"105":{"id":"/docs/red/v1/canales-27","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Contraseña del canal."},"106":{"id":"/docs/red/v1/canales-28","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`level`"},"107":{"id":"/docs/red/v1/canales-29","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Nivel asociado al canal."},"108":{"id":"/docs/red/v1/canales-30","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`isPersistent`"},"109":{"id":"/docs/red/v1/canales-31","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Indica si el canal debe conservarse cuando queda sin jugadores."},"110":{"id":"/docs/red/v1/canales-32","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`isClosed`"},"111":{"id":"/docs/red/v1/canales-33","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Impide nuevas incorporaciones al canal."},"112":{"id":"/docs/red/v1/canales-34","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`isLeaving`"},"113":{"id":"/docs/red/v1/canales-35","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Indica que el cliente está saliendo del canal."},"114":{"id":"/docs/red/v1/canales-36","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`playerLimit`"},"115":{"id":"/docs/red/v1/canales-37","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Límite máximo de jugadores."},"116":{"id":"/docs/red/v1/canales-38","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`jugadores`"},"117":{"id":"/docs/red/v1/canales-39","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Jugadores presentes en el canal."},"118":{"id":"/docs/red/v1/canales-40","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`rfcs`"},"119":{"id":"/docs/red/v1/canales-41","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Llamadas remotas almacenadas para el estado del canal."},"120":{"id":"/docs/red/v1/canales-42","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`created`"},"121":{"id":"/docs/red/v1/canales-43","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Objetos dinámicos creados dentro del canal."},"122":{"id":"/docs/red/v1/canales-44","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`destroyed`"},"123":{"id":"/docs/red/v1/canales-45","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Identificadores de objetos destruidos."},"124":{"id":"/docs/red/v1/canales-46","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"`host`"},"125":{"id":"/docs/red/v1/canales-47","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"Jugador que actúa como host del canal."},"126":{"id":"/docs/red/v1/canales-48","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#estado-de-un-canal","content":"La implementación también mantiene estructuras internas para localizar objetos dinámicos rápidamente y para cargar datos del canal de forma diferida. citeeco-canal"},"127":{"id":"/docs/red/v1/canales-49","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"El cliente utiliza `ClienteJuego.JoinChannel` para solicitar la entrada en un canal. La solicitud incluye:"},"128":{"id":"/docs/red/v1/canales-50","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"identificador del canal;"},"129":{"id":"/docs/red/v1/canales-51","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"contraseña, si existe;"},"130":{"id":"/docs/red/v1/canales-52","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"nivel que debe cargarse;"},"131":{"id":"/docs/red/v1/canales-53","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"si el canal es persistente;"},"132":{"id":"/docs/red/v1/canales-54","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"límite de jugadores."},"133":{"id":"/docs/red/v1/canales-55","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"El método no permite solicitar de nuevo un canal en el que el cliente ya está presente. Una vez enviada la solicitud, Eco registra el canal como pendiente de unión hasta recibir la respuesta del servidor. citeeco-join-channel"},"134":{"id":"/docs/red/v1/canales-56","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#unirse-a-un-canal","content":"Durante el proceso de unión, Eco bloquea temporalmente el envío de determinados paquetes para evitar que mensajes pertenecientes a la escena anterior se procesen después de solicitar el cambio de nivel. El propio código documenta esta protección como parte del flujo de `JoinChannel`. citeeco-join-channel"},"135":{"id":"/docs/red/v1/canales-57","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#múltiples-canales-simultáneos","content":"La pertenencia a canales es acumulativa. Un cliente puede unirse a un segundo canal sin abandonar el primero:"},"136":{"id":"/docs/red/v1/canales-58","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#múltiples-canales-simultáneos","content":"Después de completar ambas operaciones, `ClienteJuego.channels` contiene los dos canales. `IsInChannel(id)` permite comprobar la pertenencia a uno concreto, mientras que `GetChannel(id)` obtiene la instancia local del canal. citeeco-cliente-canales"},"137":{"id":"/docs/red/v1/canales-59","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#múltiples-canales-simultáneos","content":"Esto permite utilizar los canales como ámbitos independientes. Un diseño de juego podría, por ejemplo, utilizar un canal persistente para un mundo y otros canales temporales para partidas, eventos o actividades aisladas."},"138":{"id":"/docs/red/v1/canales-60","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#múltiples-canales-simultáneos","content":"Dos canales distintos no implican dos conexiones de socket distintas. La conexión y el transporte se gestionan en una capa inferior; los canales delimitan el estado y los destinatarios dentro de esa conexión."},"139":{"id":"/docs/red/v1/canales-61","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#consultar-canales","content":"Eco proporciona varias operaciones para inspeccionar la pertenencia del cliente:"},"140":{"id":"/docs/red/v1/canales-62","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#consultar-canales","content":"`isJoiningChannel` representa cualquier unión pendiente, mientras que `IsJoiningChannel(id)` permite consultar una unión concreta. citeeco-cliente-canales"},"141":{"id":"/docs/red/v1/canales-63","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#salir-de-un-canal","content":"Para abandonar un canal concreto se utiliza `LeaveChannel(id)`. La operación marca primero el canal como `isLeaving` para evitar solicitudes duplicadas y envía la petición al servidor. citeeco-leave-channel"},"142":{"id":"/docs/red/v1/canales-64","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#salir-de-un-canal","content":"También existe `LeaveAllChannels()`, que recorre los canales actuales y solicita la salida de cada uno de ellos. citeeco-leave-all"},"143":{"id":"/docs/red/v1/canales-65","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#salir-de-un-canal","content":"Salir de un canal no equivale a desconectarse del servidor. El cliente puede permanecer conectado mientras abandona uno o varios canales y continúa participando en otros."},"144":{"id":"/docs/red/v1/canales-66","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"Un canal puede marcarse como persistente mediante `isPersistent`. Esta propiedad afecta a su ciclo de vida cuando queda sin jugadores."},"145":{"id":"/docs/red/v1/canales-67","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"En la implementación de `Canal`, cuando el último jugador abandona:"},"146":{"id":"/docs/red/v1/canales-68","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"los objetos no persistentes asociados a ese jugador pueden destruirse;"},"147":{"id":"/docs/red/v1/canales-69","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"otros objetos pueden transferir su propietario a otro jugador;"},"148":{"id":"/docs/red/v1/canales-70","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"un canal no persistente puede cerrarse y reiniciarse cuando queda vacío."},"149":{"id":"/docs/red/v1/canales-71","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"El comportamiento concreto está implementado en `Canal.RemovePlayer`. citeeco-canal-remove"},"150":{"id":"/docs/red/v1/canales-72","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#persistencia","content":"En otras palabras, la persistencia del canal y la persistencia de un objeto son conceptos relacionados, pero no equivalentes."},"151":{"id":"/docs/red/v1/canales-73","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#límite-de-jugadores","content":"Cada canal tiene un `playerLimit`. El valor por defecto de la implementación es `65535` y `JoinChannel` normaliza cualquier valor superior a ese máximo antes de enviar la solicitud. citeeco-canal citeeco-join-channel"},"152":{"id":"/docs/red/v1/canales-74","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#límite-de-jugadores","content":"El límite puede modificarse posteriormente con:"},"153":{"id":"/docs/red/v1/canales-75","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#límite-de-jugadores","content":"La operación sólo se envía cuando el cliente está conectado y pertenece al canal indicado. citeeco-set-player-limit"},"154":{"id":"/docs/red/v1/canales-76","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#cierre-y-eliminación","content":"Cerrar un canal evita que nuevos jugadores puedan incorporarse y es una operación irreversible para ese canal. La API expone `CloseChannel(channelID)` para solicitar este cambio. citeeco-close-channel"},"155":{"id":"/docs/red/v1/canales-77","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#cierre-y-eliminación","content":"Eliminar un canal es una operación diferente y se solicita mediante `DeleteChannel(id, disconnect)`. El segundo parámetro permite indicar si la operación debe producir además una desconexión. citeeco-delete-channel"},"156":{"id":"/docs/red/v1/canales-78","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#nivel-asociado-al-canal","content":"Cada canal puede tener asociado un `level`. Eco permite cambiar el nivel de un canal mediante:"},"157":{"id":"/docs/red/v1/canales-79","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#nivel-asociado-al-canal","content":"La operación se restringe a canales en los que el cliente ya está presente. citeeco-load-level"},"158":{"id":"/docs/red/v1/canales-80","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#nivel-asociado-al-canal","content":"Esto es importante en juegos donde el cambio de escena forma parte del estado compartido del canal: la carga del nivel no es simplemente una operación local de Unity, sino una operación coordinada por la infraestructura de red."},"159":{"id":"/docs/red/v1/canales-81","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#host-del-canal","content":"Cada canal mantiene un `host`. En el cliente, `GetHost(channelID)` devuelve el jugador que actualmente actúa como host del canal, siempre que el cliente pertenezca a ese canal. citeeco-host"},"160":{"id":"/docs/red/v1/canales-82","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#host-del-canal","content":"La implementación del canal también contempla qué ocurre cuando el host abandona: primero se limpia la referencia y el servidor puede reasignar el papel dentro del flujo de salida. citeeco-canal-remove"},"161":{"id":"/docs/red/v1/canales-83","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#objetos-dentro-del-canal","content":"Los canales almacenan información sobre los objetos dinámicos creados dentro de ellos. `Canal` mantiene:"},"162":{"id":"/docs/red/v1/canales-84","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#objetos-dentro-del-canal","content":"Los objetos creados dinámicamente tienen identificadores únicos y el canal conserva su información de creación para poder exportarlos, importarlos o reconstruir su estado cuando corresponde. citeeco-canal-objects"},"163":{"id":"/docs/red/v1/canales-85","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#objetos-dentro-del-canal","content":"Los identificadores dinámicos comienzan por encima de `32767`; el rango inferior está reservado para objetos existentes en la escena. citeeco-canal"},"164":{"id":"/docs/red/v1/canales-86","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#propiedad-de-objetos-al-salir","content":"Cuando un jugador abandona un canal, Eco revisa los objetos dinámicos creados por ese jugador."},"165":{"id":"/docs/red/v1/canales-87","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#propiedad-de-objetos-al-salir","content":"Los objetos marcados para destruirse al abandonar se eliminan y sus RFC asociados se limpian. Los objetos que deben sobrevivir pueden transferir su propietario a otro jugador del canal. citeeco-canal-remove"},"166":{"id":"/docs/red/v1/canales-88","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#propiedad-de-objetos-al-salir","content":"Este mecanismo hace que la salida de un jugador sea también una operación de mantenimiento del estado del canal."},"167":{"id":"/docs/red/v1/canales-89","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#flujo-recomendado","content":"La ventaja del modelo es que la vida del cliente, la conexión y la pertenencia a canales son estados independientes."},"168":{"id":"/docs/red/v1/canales-90","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"Eco mantiene prácticamente el mismo modelo de canales de TNet, pero utiliza sus propios nombres:"},"169":{"id":"/docs/red/v1/canales-91","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"TNet"},"170":{"id":"/docs/red/v1/canales-92","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"Eco"},"171":{"id":"/docs/red/v1/canales-93","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"`TNChannel` / `Channel`"},"172":{"id":"/docs/red/v1/canales-94","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"`Canal`"},"173":{"id":"/docs/red/v1/canales-95","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"`TNManager.JoinChannel`"},"174":{"id":"/docs/red/v1/canales-96","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/red/v1/canales#correspondencia-con-tnet","content":"`ClienteJuego.JoinChannel`"},"175":{"id":"/docs/red/v1/canales-97","page_id":"/docs/red/v1/canales","tags":[],"type":"text","url":"/docs/re