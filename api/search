ia/ciclo-de-vida-0","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida","content":"Qué ocurre desde el arranque hasta la desconexión de un participante."},"3157":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-1","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#arranque","content":"Arranque"},"3158":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-2","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#entrada-en-un-canal","content":"Entrada en un canal"},"3159":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-3","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#creación-de-objetos","content":"Creación de objetos"},"3160":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-4","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","type":"heading","tags":[],"url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"Desconexión"},"3161":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-5","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida","content":"Una sesión de red debe entenderse como un ciclo completo, no como una llamada aislada a conectar."},"3162":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-6","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#arranque","content":"El sistema de red debe inicializarse antes de que otros sistemas dependan de un estado conectado. Los sistemas de gameplay deberían poder representar explícitamente estados como `Desconectado`, `Conectando`, `Conectado` y `EnPartida`."},"3163":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-7","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#entrada-en-un-canal","content":"El canal define el ámbito en el que el participante recibe objetos y datos. Entrar en un canal no significa necesariamente estar autorizado para todas las acciones del juego: esa decisión pertenece al dominio."},"3164":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-8","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#creación-de-objetos","content":"Un cliente que entra tarde debe poder recibir suficiente estado para reconstruir la escena de gameplay. Esto es una de las razones por las que la persistencia y el estado sincronizado deben diseñarse desde el principio."},"3165":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-9","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"La salida debe provocar una política explícita para cada recurso propiedad del participante: destruir, transferir, conservar temporalmente o convertirlo en propiedad del servidor."},"3166":{"id":"/docs/red/v1/ingenieria/ciclo-de-vida-10","page_id":"/docs/red/v1/ingenieria/ciclo-de-vida","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/ciclo-de-vida#desconexión","content":"Diseña la desconexión antes de terminar el sistema de ownership. Si no existe una política clara, aparecerán objetos huérfanos, estados inconsistentes o recursos perdidos."},"3167":{"id":"/docs/red/v1/ingenieria/compatibilidad","page_id":"/docs/red/v1/ingenieria/compatibilidad","type":"page","content":"Compatibilidad","breadcrumbs":["Docs","Red","Red","Contenido","Ingeniería"],"tags":[],"url":"/docs/red/v1/ingenieria/compatibilidad"},"3168":{"id":"/docs/red/v1/ingenieria/compatibilidad-0","page_id":"/docs/red/v1/ingenieria/compatibilidad","tags":[],"type":"text","url":"/docs/red/v1/ingenieria/compatibilidad","content":"Qué debe comprobarse al integrar Eco en un proyecto real."},"3169":{"id":"/docs/red/v1/ingenieria/compatibilidad-1","page