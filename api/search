id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#sensor","content":"Sensor"},"840":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-3","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#jugador-y-pendientes","content":"Jugador y pendientes"},"841":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-4","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#detectortecho","content":"DetectorTecho"},"842":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-5","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#por-qué-no-mover-todo-a-un-rigidbody","content":"Por qué no mover todo a un Rigidbody"},"843":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-6","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","content":"`Locomocion` es la capa que recibe la velocidad calculada por el controlador y se encarga de afinar y aplicar el movimiento sobre el GameObject."},"844":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-7","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#sensor","content":"El sensor comprueba información del entorno necesaria para saber si el personaje está sobre una superficie, cómo responde a pendientes y cuándo deben actualizarse sus comprobaciones."},"845":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-8","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#sensor","content":"Los controladores utilizan métodos como `ComprobarSuelo`, `EnSuelo`, `RangoExtendidoSensor` y `ActualizarSensor` para coordinar estas comprobaciones con el ciclo físico."},"846":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-9","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#jugador-y-pendientes","content":"`Jugador` añade `limitePendiente` y `gravedadPendiente`. El estado puede pasar a `Deslizando` cuando la superficie excede el límite configurado."},"847":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-10","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#detectortecho","content":"`DetectorTecho` es una capa específica del jugador que registra colisiones que representan un techo y permite reaccionar ante golpes verticales durante el salto."},"848":{"id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores-11","page_id":"/docs/personaje/v1/fundamentos/locomocion-y-sensores","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/locomocion-y-sensores#por-qué-no-mover-todo-a-un-rigidbody","content":"La arquitectura mantiene el cálculo de movimiento en los controladores y centraliza la aplicación física en `Locomocion`, lo que facilita reutilizar la misma infraestructura entre distintos tipos de personaje."},"849":{"id":"/docs/personaje/v1/fundamentos/suavizado","page_id":"/docs/personaje/v1/fundamentos/suavizado","type":"page","content":"Suavizado","breadcrumbs":["Docs","Personaje","Personaje","Contenido","Fundamentos"],"tags":[],"url":"/docs/personaje/v1/fundamentos/suavizado"},"850":{"id":"/docs/personaje/v1/fundamentos/suavizado-0","page_id":"/docs/personaje/v1/fundamentos/suavizado","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/suavizado","content":"Herramientas de transición visual para posición y rotación."},"851":{"id":"/docs/personaje/v1/fundamentos/suavizado-1","page_id":"/docs/personaje/v1/fundamentos/suavizado","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/suavizado#cuándo-utilizarlo","content":"Cuándo utilizarlo"},"852":{"id":"/docs/personaje/v1/fundamentos/suavizado-2","page_id":"/docs/personaje/v1/fundamentos/suavizado","type":"heading","tags":[],"url":"/docs/personaje/v1/fundamentos/suavizado#qué-no-hace","content":"Qué no hace"},"853":{"id":"/docs/personaje/v1/fundamentos/suavizado-3","page_id":"/docs/personaje/v1/fundamentos/suavizado","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/suavizado","content":"El módulo incluye `SuavizadoPosicion` y `SuavizadoRotacion` para evitar transiciones bruscas entre estados de transform."},"854":{"id":"/docs/personaje/v1/fundamentos/suavizado-4","page_id":"/docs/personaje/v1/fundamentos/suavizado","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/suavizado#cuándo-utilizarlo","content":"Es útil cuando una posición o rotación cambia por una fuente discreta: red, teletransporte, cambio de objetivo o actualización externa."},"855":{"id":"/docs/personaje/v1/fundamentos/suavizado-5","page_id":"/docs/personaje/v1/fundamentos/suavizado","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/suavizado#qué-no-hace","content":"El suavizado no resuelve la autoridad, la predicción ni la sincronización. Sólo decide cómo llegar visualmente de un estado a otro."},"856":{"id":"/docs/personaje/v1/fundamentos/suavizado-6","page_id":"/docs/personaje/v1/fundamentos/suavizado","tags":[],"type":"text","url":"/docs/personaje/v1/fundamentos/suavizado#qué-no-hace","content":"En un juego en red puede utilizarse junto a Eco, pero debe permanecer separado del estado autoritativo que se sincroniza."},"857":{"id":"/docs/personaje/v1/guias/configurar-entrada","page_id":"/docs/personaje/v1/guias/configurar-entrada","type":"page","content":"Configurar la e