1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"Los mensajes asociados a objetos se interpretan dentro de un `Canal`. El canal determina qué jugadores forman parte del ámbito de difusión."},"1095":{"id":"/docs/red/v1/comunicacion/destinatarios-15","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#contexto-de-canal","content":"A partir de ese contexto, Eco puede excluir al emisor, incluirlo, conservar el mensaje para futuros participantes o dirigirlo a un participante concreto."},"1096":{"id":"/docs/red/v1/comunicacion/destinatarios-16","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Objetivo conceptual"},"1097":{"id":"/docs/red/v1/comunicacion/destinatarios-17","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Uso"},"1098":{"id":"/docs/red/v1/comunicacion/destinatarios-18","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Todos`"},"1099":{"id":"/docs/red/v1/comunicacion/destinatarios-19","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos los jugadores del canal."},"1100":{"id":"/docs/red/v1/comunicacion/destinatarios-20","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"`Otros`"},"1101":{"id":"/docs/red/v1/comunicacion/destinatarios-21","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Todos salvo el emisor."},"1102":{"id":"/docs/red/v1/comunicacion/destinatarios-22","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Propietario"},"1103":{"id":"/docs/red/v1/comunicacion/destinatarios-23","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"El jugador que posee el objeto."},"1104":{"id":"/docs/red/v1/comunicacion/destinatarios-24","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Persistente"},"1105":{"id":"/docs/red/v1/comunicacion/destinatarios-25","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"También debe estar disponible para participantes posteriores."},"1106":{"id":"/docs/red/v1/comunicacion/destinatarios-26","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Jugador concreto"},"1107":{"id":"/docs/red/v1/comunicacion/destinatarios-27","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Un único participante identificado."},"1108":{"id":"/docs/red/v1/comunicacion/destinatarios-28","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#objetivos-habituales","content":"Los nombres exactos disponibles dependen de la API de `Objetivo` y del método utilizado para enviar el mensaje."},"1109":{"id":"/docs/red/v1/comunicacion/destinatarios-29","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"La propiedad y la visibilidad son conceptos diferentes:"},"1110":{"id":"/docs/red/v1/comunicacion/destinatarios-30","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#propietario-frente-a-canal","content":"Que un objeto tenga propietario no significa que únicamente ese jugador pueda recibir sus actualizaciones."},"1111":{"id":"/docs/red/v1/comunicacion/destinatarios-31","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"Un mensaje marcado para persistir puede formar parte del estado que Eco mantiene asociado al canal u objeto. Esto resulta útil cuando el contenido debe estar disponible también para jugadores que todavía no estaban conectados cuando ocurrió la comunicación."},"1112":{"id":"/docs/red/v1/comunicacion/destinatarios-32","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#comunicación-persistente","content":"No debe utilizarse persistencia sólo porque un mensaje se considere importante: debe existir una necesidad real de reconstruir ese estado posteriormente."},"1113":{"id":"/docs/red/v1/comunicacion/destinatarios-33","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#listas-de-jugadores","content":"La arquitectura de TNet/Eco también contempla el envío a una lista concreta de jugadores, no sólo a un único ID. Esta opción es especialmente útil para grupos seleccionados que no coinciden con todos los miembros del canal."},"1114":{"id":"/docs/red/v1/comunicacion/destinatarios-34","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#echo-y-llamadas-reenviadas","content":"El protocolo distingue comunicaciones como `ForwardToAll`, `ForwardToOthers` y sus variantes persistentes. Estas operaciones permiten que el servidor reenvíe el contenido sin que el cliente tenga que construir manualmente un paquete distinto para cada receptor."},"1115":{"id":"/docs/red/v1/comunicacion/destinatarios-35","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"Hay que separar dos preguntas:"},"1116":{"id":"/docs/red/v1/comunicacion/destinatarios-36","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-persistencia","content":"La primera es una decisión de destinatario. La segunda es una decisión de persistencia. Pueden combinarse, pero no son el mismo concepto."},"1117":{"id":"/docs/red/v1/comunicacion/destinatarios-37","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#relación-con-tnet","content":"Eco conserva el modelo de objetivos de TNet, pero utiliza la nomenclatura propia del proyecto. Las equivalencias deben comprobarse siempre contra la implementación actual de `Eco`, `Objeto` y `Paquete`."},"1118":{"id":"/docs/red/v1/comunicacion/destinatarios-38","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Cómo construir llamadas remotas y decidir su comportamiento."},"1119":{"id":"/docs/red/v1/comunicacion/destinatarios-39","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Aplicación práctica del alcance por canal."},"1120":{"id":"/docs/red/v1/comunicacion/destinatarios-40","page_id":"/docs/red/v1/comunicacion/destinatarios","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/destinatarios#referencias","content":"Repositorio upstream."},"1121":{"id":"/docs/red/v1/comunicacion","page_id":"/docs/red/v1/comunicacion","type":"page","content":"Comunicación","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion"},"1122":{"id":"/docs/red/v1/comunicacion-0","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion","content":"Cómo Eco decide qué comunicar, a quién, con qué mecanismo y cómo conservar el estado."},"1123":{"id":"/docs/red/v1/comunicacion-1","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#comunicación","content":"Comunicación"},"1124":{"id":"/docs/red/v1/comunicacion-2","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#árbol-de-decisión","content":"Árbol de decisión"},"1125":{"id":"/docs/red/v1/comunicacion-3","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"Creación frente a método"},"1126":{"id":"/docs/red/v1/comunicacion-4","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Estado frente a operaciones remotas"},"1127":{"id":"/docs/red/v1/comunicacion-5","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#autoridad","content":"Autoridad"},"1128":{"id":"/docs/red/v1/comunicacion-6","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Relación con TNet"},"1129":{"id":"/docs/red/v1/comunicacion-7","page_id":"/docs/red/v1/comunicacion","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion#referencias","content":"Referencias"},"1130":{"id":"/docs/red/v1/comunicacion-8","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"La comunicación de Eco distingue entre **creación**, **ejecución de métodos** y **sincronización de estado**. La terminología pública actual es:"},"1131":{"id":"/docs/red/v1/comunicacion-9","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Si vienes de TNet, verás que `RCC`, `RFC` y `LCR` han sido refactorizados en Eco como `RCR`, `RMR` y `RCL`, respectivamente. En esta documentación usamos siempre los nombres de Eco salvo cuando explicamos compatibilidad histórica."},"1132":{"id":"/docs/red/v1/comunicacion-10","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Ejecutar un método remotamente."},"1133":{"id":"/docs/red/v1/comunicacion-11","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Crear un objeto mediante la red."},"1134":{"id":"/docs/red/v1/comunicacion-12","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Solicitud de creación local dentro del flujo de red."},"1135":{"id":"/docs/red/v1/comunicacion-13","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#comunicación","content":"Mantener propiedades y datos de una entidad coherentes entre participantes."},"1136":{"id":"/docs/red/v1/comunicacion-14","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"Crear una entidad y ejecutar una operación sobre una entidad existente son problemas distintos."},"1137":{"id":"/docs/red/v1/comunicacion-15","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#creación-frente-a-método","content":"No utilices un método remoto como sustituto conceptual de la creación de una entidad."},"1138":{"id":"/docs/red/v1/comunicacion-16","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa `RMR` para acciones, comandos o hechos puntuales que requieren ejecutar un método remoto."},"1139":{"id":"/docs/red/v1/comunicacion-17","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa sincronización para valores que deben poder consultarse en cualquier momento: vida, inventario, configuración o estado de una entidad."},"1140":{"id":"/docs/red/v1/comunicacion-18","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#estado-frente-a-operaciones-remotas","content":"Usa los mecanismos de creación cuando necesitas incorporar una entidad al modelo de red."},"1141":{"id":"/docs/red/v1/comunicacion-19","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"La comunicación no elimina la autoridad. Un cliente puede solicitar una operación, pero la autoridad de la partida y las reglas de validación siguen siendo parte del diseño de seguridad y consistencia."},"1142":{"id":"/docs/red/v1/comunicacion-20","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#autoridad","content":"Que una operación llegue correctamente por red no significa que sea válida. La validación importante debe permanecer en el lado que controla la autoridad real."},"1143":{"id":"/docs/red/v1/comunicacion-21","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Eco"},"1144":{"id":"/docs/red/v1/comunicacion-22","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"TNet"},"1145":{"id":"/docs/red/v1/comunicacion-23","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Significado"},"1146":{"id":"/docs/red/v1/comunicacion-24","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCR`"},"1147":{"id":"/docs/red/v1/comunicacion-25","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCC`"},"1148":{"id":"/docs/red/v1/comunicacion-26","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Creación Remota"},"1149":{"id":"/docs/red/v1/comunicacion-27","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RMR`"},"1150":{"id":"/docs/red/v1/comunicacion-28","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RFC`"},"1151":{"id":"/docs/red/v1/comunicacion-29","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Método Remoto"},"1152":{"id":"/docs/red/v1/comunicacion-30","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`RCL`"},"1153":{"id":"/docs/red/v1/comunicacion-31","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"`LCR`"},"1154":{"id":"/docs/red/v1/comunicacion-32","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Red Creación Local"},"1155":{"id":"/docs/red/v1/comunicacion-33","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#relación-con-tnet","content":"Consulta Migración de TNet a Eco para más diferencias."},"1156":{"id":"/docs/red/v1/comunicacion-34","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Método Remoto."},"1157":{"id":"/docs/red/v1/comunicacion-35","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Creación Remota."},"1158":{"id":"/docs/red/v1/comunicacion-36","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Red Creación Local."},"1159":{"id":"/docs/red/v1/comunicacion-37","page_id":"/docs/red/v1/comunicacion","tags":[],"type":"text","url":"/docs/red/v1/comunicacion#referencias","content":"Decide quién debe recibir una operación."},"1160":{"id":"/docs/red/v1/comunicacion/rcl","page_id":"/docs/red/v1/comunicacion/rcl","type":"page","content":"RCL","breadcrumbs":["Docs","Red","Red","Contenido","Comunicación"],"tags":[],"url":"/docs/red/v1/comunicacion/rcl"},"1161":{"id":"/docs/red/v1/comunicacion/rcl-0","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl","content":"Red Creación Local, el mecanismo de Eco para solicitar una creación local dentro del flujo de red."},"1162":{"id":"/docs/red/v1/comunicacion/rcl-1","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"RCL — Red Creación Local"},"1163":{"id":"/docs/red/v1/comunicacion/rcl-2","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"Diferencia con RCR"},"1164":{"id":"/docs/red/v1/comunicacion/rcl-3","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#ciclo-conceptual","content":"Ciclo conceptual"},"1165":{"id":"/docs/red/v1/comunicacion/rcl-4","page_id":"/docs/red/v1/comunicacion/rcl","type":"heading","tags":[],"url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Cuándo documentarlo"},"1166":{"id":"/docs/red/v1/comunicacion/rcl-5","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"En Eco, el concepto histórico `LCR` (*Local Creation Request / Call*) de TNet se denomina **RCL — Red Creación Local**."},"1167":{"id":"/docs/red/v1/comunicacion/rcl-6","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#rcl--red-creación-local","content":"RCL pertenece al conjunto de mecanismos de creación y sirve para representar la solicitud de que una entidad sea creada localmente en el contexto adecuado de red."},"1168":{"id":"/docs/red/v1/comunicacion/rcl-7","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#diferencia-con-rcr","content":"La diferencia no debe entenderse únicamente como «cliente» frente a «servidor». Lo relevante es quién origina la operación y qué parte del flujo de creación debe resolverse de forma local o remota."},"1169":{"id":"/docs/red/v1/comunicacion/rcl-8","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"RCL es especialmente útil cuando se describen workflows de creación donde el código local inicia la incorporación de una entidad al modelo de red."},"1170":{"id":"/docs/red/v1/comunicacion/rcl-9","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Para una integración habitual, el desarrollador debería pensar primero en el resultado deseado —crear un objeto de red válido— y después elegir el mecanismo de creación adecuado."},"1171":{"id":"/docs/red/v1/comunicacion/rcl-10","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","url":"/docs/red/v1/comunicacion/rcl#cuándo-documentarlo","content":"Red Creación Remota."},"1172":{"id":"/docs/red/v1/comunicacion/rcl-11","page_id":"/docs/red/v1/comunicacion/rcl","tags":[],"type":"text","