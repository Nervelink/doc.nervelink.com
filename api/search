 conocer el ámbito en el que debe realizar la operación."},"1103":{"id":"/docs/red/v1/transporte/paquetes-34","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#canal-dentro-del-protocolo","content":"Esto permite que una misma conexión participe en varios canales sin mezclar sus estados."},"1104":{"id":"/docs/red/v1/transporte/paquetes-35","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#objetos-y-paquetes","content":"Las operaciones relacionadas con objetos incluyen habitualmente un identificador de objeto. En RFC, el identificador puede combinar el objeto con un identificador compacto de función."},"1105":{"id":"/docs/red/v1/transporte/paquetes-36","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#objetos-y-paquetes","content":"Cuando no existe un identificador numérico para la función, Eco puede transportar el nombre de la función."},"1106":{"id":"/docs/red/v1/transporte/paquetes-37","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#fiabilidad","content":"Los paquetes se escriben sobre buffers y después se envían mediante las rutas fiables o rápidas que correspondan. La elección de TCP o UDP no cambia el significado del paquete: cambia cómo se transporta."},"1107":{"id":"/docs/red/v1/transporte/paquetes-38","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#paquetes-personalizados","content":"El servidor y el cliente pueden exponer manejadores para paquetes que no formen parte del procesamiento estándar. Esto permite extender el protocolo cuando una aplicación necesita una operación específica."},"1108":{"id":"/docs/red/v1/transporte/paquetes-39","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#paquetes-personalizados","content":"Los paquetes personalizados deben mantener una definición clara del formato binario y de quién es responsable de procesarlos."},"1109":{"id":"/docs/red/v1/transporte/paquetes-40","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"`Paquete` corresponde conceptualmente al sistema de `Packet`/`TNPacket` de TNet. La enumeración y los nombres de Eco son la referencia válida para este proyecto."},"1110":{"id":"/docs/red/v1/transporte/paquetes-41","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Implementación actual de los tipos de paquete."},"1111":{"id":"/docs/red/v1/transporte/paquetes-42","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Repositorio upstream."},"1112":{"id":"/docs/red/v1/transporte/paquetes-43","page_id":"/docs/red/v1/transporte/paquetes","tags":[],"type":"text","url":"/docs/red/v1/transporte/paquetes#relación-con-tnet","content":"Referencia para contrastar el protocolo heredado."},"1113":{"id":"/docs/red/v1/transporte/serializacion","page_id":"/docs/red/v1/transporte/serializacion","type":"page","content":"Serialización","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/serializacion"},"1114":{"id":"/docs/red/v1/transporte/serializacion-0","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion","content":"Cómo Eco convierte datos entre representaciones estructuradas y binarias."},"1115":{"id":"/docs/red/v1/transporte/serializacion-1","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización","content":"Serialización"},"1116":{"id":"/docs/red/v1/transporte/serializacion-2","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#nodo","content":"Nodo"},"1117":{"id":"/docs/red/v1/transporte/serializacion-3","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Serialización binaria"},"1118":{"id":"/docs/red/v1/transporte/serializacion-4","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"Serialización de tipos"},"1119":{"id":"/docs/red/v1/transporte/serializacion-5","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Nodo frente a binario"},"1120":{"id":"/docs/red/v1/transporte/serializacion-6","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"Relación con Buffer"},"1121":{"id":"/docs/red/v1/transporte/serializacion-7","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-paquete","content":"Relación con Paquete"},"1122":{"id":"/docs/red/v1/transporte/serializacion-8","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#relación-con-tnet","content":"Relación con TNet"},"1123":{"id":"/docs/red/v1/transporte/serializacion-9","page_id":"/docs/red/v1/transporte/serializacion","type":"heading","tags":[],"url":"/docs/red/v1/transporte/serializacion#referencias","content":"Referencias"},"1124":{"id":"/docs/red/v1/transporte/serializacion-10","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"La serialización es la capa que transforma los datos que utiliza Eco en una representación que puede escribirse en un `Buffer`, almacenarse o enviarse por la red."},"1125":{"id":"/docs/red/v1/transporte/serializacion-11","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"Eco distingue principalmente entre datos estructurados mediante `Nodo` y serialización binaria mediante `IBinarySerializable` y `Serializacion`."},"1126":{"id":"/docs/red/v1/transporte/serializacion-12","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización","content":"`Nodo` describe datos. `Buffer` contiene bytes. `Paquete` describe un mensaje del protocolo. No son tres nombres para la misma cosa."},"1127":{"id":"/docs/red/v1/transporte/serializacion-13","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo","content":"`Nodo` es una estructura jerárquica formada por nombre, valor y nodos hijos. Permite representar datos con rutas y convertir valores entre tipos compatibles."},"1128":{"id":"/docs/red/v1/transporte/serializacion-14","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo","content":"Entre sus operaciones están `AddChild`, `GetChild`, `SetChild`, `GetHierarchy` y `SetHierarchy`."},"1129":{"id":"/docs/red/v1/transporte/serializacion-15","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Las clases que necesitan controlar cómo se representan sus datos pueden implementar `IBinarySerializable`:"},"1130":{"id":"/docs/red/v1/transporte/serializacion-16","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-binaria","content":"Esto permite definir una representación específica cuando la serialización automática no sea suficiente o cuando sea importante reducir el tamaño de los datos."},"1131":{"id":"/docs/red/v1/transporte/serializacion-17","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"`Serializacion` proporciona extensiones para escribir y leer tipos básicos, estructuras de Unity, arrays, listas y objetos compatibles con el sistema de Eco."},"1132":{"id":"/docs/red/v1/transporte/serializacion-18","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#serialización-de-tipos","content":"La resolución de tipos puede utilizar nombres serializados y cachés de tipo para evitar repetir el trabajo de reflexión."},"1133":{"id":"/docs/red/v1/transporte/serializacion-19","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Los dos mecanismos responden a necesidades distintas:"},"1134":{"id":"/docs/red/v1/transporte/serializacion-20","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Necesidad"},"1135":{"id":"/docs/red/v1/transporte/serializacion-21","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Mecanismo"},"1136":{"id":"/docs/red/v1/transporte/serializacion-22","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Datos jerárquicos y configurables"},"1137":{"id":"/docs/red/v1/transporte/serializacion-23","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo`"},"1138":{"id":"/docs/red/v1/transporte/serializacion-24","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Mensajes compactos de red"},"1139":{"id":"/docs/red/v1/transporte/serializacion-25","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Serialización binaria"},"1140":{"id":"/docs/red/v1/transporte/serializacion-26","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Formato personalizado de una clase"},"1141":{"id":"/docs/red/v1/transporte/serializacion-27","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`IBinarySerializable`"},"1142":{"id":"/docs/red/v1/transporte/serializacion-28","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"Persistencia estructurada"},"1143":{"id":"/docs/red/v1/transporte/serializacion-29","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#nodo-frente-a-binario","content":"`Nodo` + serialización"},"1144":{"id":"/docs/red/v1/transporte/serializacion-30","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"El resultado de una serialización binaria termina normalmente en un `Buffer`:"},"1145":{"id":"/docs/red/v1/transporte/serializacion-31","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-buffer","content":"El `Buffer` no decide qué significa el dato. Sólo proporciona el soporte de lectura y escritura binaria."},"1146":{"id":"/docs/red/v1/transporte/serializacion-32","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-paquete","content":"Un `Paquete` añade significado de protocolo al flujo binario. Por ejemplo, dos mensajes pueden transportar datos con la misma representación binaria pero utilizar diferentes tipos de paquete y, por tanto, tener comportamientos distintos."},"1147":{"id":"/docs/red/v1/transporte/serializacion-33","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#relación-con-tnet","content":"Eco conserva el modelo de serialización heredado de TNet, incluyendo `DataNode`, `IBinarySerializable` y la infraestructura de escritura y lectura binaria. La nomenclatura de Eco utiliza `Nodo` y `Serializacion`."},"1148":{"id":"/docs/red/v1/transporte/serializacion-34","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Código de `Nodo`, `Buffer` y serialización."},"1149":{"id":"/docs/red/v1/transporte/serializacion-35","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Repositorio upstream de la implementación heredada."},"1150":{"id":"/docs/red/v1/transporte/serializacion-36","page_id":"/docs/red/v1/transporte/serializacion","tags":[],"type":"text","url":"/docs/red/v1/transporte/serializacion#referencias","content":"Referencia externa para contrastar el sistema de serialización de TNet."},"1151":{"id":"/docs/red/v1/transporte/tcp-udp","page_id":"/docs/red/v1/transporte/tcp-udp","type":"page","content":"TCP y UDP","breadcrumbs":["Docs","Red","Red","Contenido","Transporte"],"tags":[],"url":"/docs/red/v1/transporte/tcp-udp"},"1152":{"id":"/docs/red/v1/transporte/tcp-udp-0","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp","content":"Cómo Eco combina transporte fiable y transporte de baja latencia."},"1153":{"id":"/docs/red/v1/transporte/tcp-udp-1","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"TCP y UDP"},"1154":{"id":"/docs/red/v1/transporte/tcp-udp-2","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP"},"1155":{"id":"/docs/red/v1/transporte/tcp-udp-3","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#udp","content":"UDP"},"1156":{"id":"/docs/red/v1/transporte/tcp-udp-4","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#activación","content":"Activación"},"1157":{"id":"/docs/red/v1/transporte/tcp-udp-5","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Qué transporte elegir"},"1158":{"id":"/docs/red/v1/transporte/tcp-udp-6","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"`Send` y `SendQuickly`"},"1159":{"id":"/docs/red/v1/transporte/tcp-udp-7","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"Nagle y latencia TCP"},"1160":{"id":"/docs/red/v1/transporte/tcp-udp-8","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"Servidor"},"1161":{"id":"/docs/red/v1/transporte/tcp-udp-9","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Restricciones de plataforma"},"1162":{"id":"/docs/red/v1/transporte/tcp-udp-10","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"Relación con Paquete"},"1163":{"id":"/docs/red/v1/transporte/tcp-udp-11","page_id":"/docs/red/v1/transporte/tcp-udp","type":"heading","tags":[],"url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Relación con TNet"},"1164":{"id":"/docs/red/v1/transporte/tcp-udp-12","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp-y-udp","content":"Eco dispone de un transporte principal basado en TCP y de una ruta UDP para tráfico que puede beneficiarse de menor latencia o tolerar pérdida de paquetes."},"1165":{"id":"/docs/red/v1/transporte/tcp-udp-13","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"TCP es la vía principal de comunicación del cliente con el servidor. Se utiliza para operaciones que necesitan entrega fiable y ordenada."},"1166":{"id":"/docs/red/v1/transporte/tcp-udp-14","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#tcp","content":"El cliente mantiene `ProtocoloTcp` como su protocolo principal y expone el estado de conexión a través de `ClienteJuego`."},"1167":{"id":"/docs/red/v1/transporte/tcp-udp-15","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#udp","content":"Cuando está disponible, `ProtocoloUdp` permite enviar tráfico que no necesita las garantías completas de TCP."},"1168":{"id":"/docs/red/v1/transporte/tcp-udp-16","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#udp","content":"El cliente puede comprobar `canUseUDP` y conocer el puerto de escucha mediante `listeningPort`."},"1169":{"id":"/docs/red/v1/transporte/tcp-udp-17","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#activación","content":"UDP no se considera disponible simplemente porque exista una instancia del protocolo. El servidor debe proporcionar un puerto UDP y el cliente debe completar su activación."},"1170":{"id":"/docs/red/v1/transporte/tcp-udp-18","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"La elección depende de la semántica del mensaje:"},"1171":{"id":"/docs/red/v1/transporte/tcp-udp-19","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Característica"},"1172":{"id":"/docs/red/v1/transporte/tcp-udp-20","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"TCP"},"1173":{"id":"/docs/red/v1/transporte/tcp-udp-21","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"UDP"},"1174":{"id":"/docs/red/v1/transporte/tcp-udp-22","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Entrega fiable"},"1175":{"id":"/docs/red/v1/transporte/tcp-udp-23","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"1176":{"id":"/docs/red/v1/transporte/tcp-udp-24","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"1177":{"id":"/docs/red/v1/transporte/tcp-udp-25","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Orden de llegada"},"1178":{"id":"/docs/red/v1/transporte/tcp-udp-26","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"1179":{"id":"/docs/red/v1/transporte/tcp-udp-27","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No garantizado"},"1180":{"id":"/docs/red/v1/transporte/tcp-udp-28","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Retransmisión"},"1181":{"id":"/docs/red/v1/transporte/tcp-udp-29","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Sí"},"1182":{"id":"/docs/red/v1/transporte/tcp-udp-30","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No"},"1183":{"id":"/docs/red/v1/transporte/tcp-udp-31","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Latencia potencial"},"1184":{"id":"/docs/red/v1/transporte/tcp-udp-32","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Mayor bajo pérdida/congestión"},"1185":{"id":"/docs/red/v1/transporte/tcp-udp-33","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Menor para tráfico tolerante a pérdida"},"1186":{"id":"/docs/red/v1/transporte/tcp-udp-34","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Estado crítico"},"1187":{"id":"/docs/red/v1/transporte/tcp-udp-35","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Adecuado"},"1188":{"id":"/docs/red/v1/transporte/tcp-udp-36","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No suele ser adecuado"},"1189":{"id":"/docs/red/v1/transporte/tcp-udp-37","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Actualizaciones frecuentes"},"1190":{"id":"/docs/red/v1/transporte/tcp-udp-38","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Puede ser adecuado"},"1191":{"id":"/docs/red/v1/transporte/tcp-udp-39","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"Suele ser más apropiado"},"1192":{"id":"/docs/red/v1/transporte/tcp-udp-40","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#qué-transporte-elegir","content":"No se debe elegir UDP simplemente por ser más rápido: si el dato necesita entrega garantizada, hay que utilizar un mecanismo fiable."},"1193":{"id":"/docs/red/v1/transporte/tcp-udp-41","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"Eco abstrae gran parte de esta decisión detrás de sus operaciones de envío. `Send` representa el camino normal, mientras que `SendQuickly` permite utilizar el camino optimizado para datos donde la fiabilidad completa no sea necesaria."},"1194":{"id":"/docs/red/v1/transporte/tcp-udp-42","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#send-y-sendquickly","content":"La capa de gameplay no debería construir datagramas manualmente salvo que esté implementando una extensión de transporte."},"1195":{"id":"/docs/red/v1/transporte/tcp-udp-43","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"`ClienteJuego.noDelay` permite activar o desactivar el algoritmo de Nagle. Activarlo puede reducir la latencia de pequeños mensajes a costa de aumentar el tráfico."},"1196":{"id":"/docs/red/v1/transporte/tcp-udp-44","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#nagle-y-latencia-tcp","content":"La misma configuración se comunica al servidor para mantener el comportamiento coherente del socket TCP."},"1197":{"id":"/docs/red/v1/transporte/tcp-udp-45","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"`ServidorJuego` puede abrir un puerto TCP y, opcionalmente, un puerto UDP al arrancar."},"1198":{"id":"/docs/red/v1/transporte/tcp-udp-46","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#servidor","content":"El puerto UDP sólo se activa cuando se proporciona uno válido durante el arranque."},"1199":{"id":"/docs/red/v1/transporte/tcp-udp-47","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"La disponibilidad de UDP depende de la plataforma y de las compilaciones de Eco. Algunas configuraciones, como determinados entornos antiguos de Unity o modos de modificación, deshabilitan explícitamente UDP."},"1200":{"id":"/docs/red/v1/transporte/tcp-udp-48","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#restricciones-de-plataforma","content":"Por eso la aplicación debe consultar la disponibilidad real (`canUseUDP`) en lugar de asumir que UDP siempre está disponible."},"1201":{"id":"/docs/red/v1/transporte/tcp-udp-49","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El transporte no cambia el significado de un `Paquete`."},"1202":{"id":"/docs/red/v1/transporte/tcp-udp-50","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-paquete","content":"El mismo concepto de protocolo puede utilizar distintas rutas de transporte según el tipo de mensaje."},"1203":{"id":"/docs/red/v1/transporte/tcp-udp-51","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"El modelo corresponde al de los protocolos TCP y UDP de TNet, pero Eco utiliza `ProtocoloTcp`, `ProtocoloUdp`, `ClienteJuego` y `ServidorJuego` como API interna."},"1204":{"id":"/docs/red/v1/transporte/tcp-udp-52","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión cliente de TCP, UDP y envío de paquetes."},"1205":{"id":"/docs/red/v1/transporte/tcp-udp-53","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Gestión servidor de listeners TCP/UDP."},"1206":{"id":"/docs/red/v1/transporte/tcp-udp-54","page_id":"/docs/red/v1/transporte/tcp-udp","tags":[],"type":"text","url":"/docs/red/v1/transporte/tcp-udp#relación-con-tnet","content":"Repositorio upstream."}},"count":1206},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":672,"2":260,"3":336,"4":365,"5":1018,"6":1019,"7":1020,"8":556,"9":1128,"10":185,"11":184,"12":183,"13":334,"14":267,"15":268,"16":1086,"17":246,"18":1021,"19":269,"20":671,"21":829,"22":584,"23":673,"24":261,"25":255,"26":337,"27":1189,"28":868,"29":897,"30":1138,"31":190,"32":193,"33":198,"34":207,"35":212,"36":614,"37":1064,"38":460,"39":694,"40":462,"41":691,"42":707,"43":8